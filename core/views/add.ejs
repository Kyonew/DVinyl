<%- include('../../views/partials/header') %>

<%# ZXing rather than html5-qrcode: the latter hands its decoder a canvas sized to the
    CSS width of the viewfinder, so on a phone an EAN-13 arrives at roughly 2 pixels per
    bar and never decodes (issue #121). ZXing decodes the camera frame at its native
    resolution instead. Served from the instance, with the version in the filename: the
    scanner is reached from a phone on the local network, which is exactly where outbound
    access to a CDN is least certain, and a publish upstream can no longer change what
    every instance runs without a commit here. %>
<script src="<%= baseUrl %>/vendor/zxing-0.23.0.umd.min.js"></script>

<div class="max-w-screen-lg mx-auto pb-20 px-4">
    
    <div class="text-center mb-8 md:mb-12 pt-4 md:pt-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-primary-theme/10 text-primary-theme mb-4">
            <i class="fa-solid fa-<%= plugin.icon %> text-3xl"></i>
        </div>
        <h1 class="text-3xl md:text-4xl font-black"><%= t('add_' + plugin.i18nKey + '.title', { defaultValue: t('add_vinyl.title') }) %></h1>
        <p class="opacity-60 mt-2"><%= t('add_' + plugin.i18nKey + '.desc', { defaultValue: t('add_vinyl.desc') }) %></p>
    </div>

    <form action="<%= baseUrl %>/search-<%= plugin.id %>" method="POST" class="max-w-2xl mx-auto mb-10">
        <% if (plugin.searchFormPartial && plugin.partialsPath) { %>
            <%- include('../../' + plugin.partialsPath + '/' + plugin.searchFormPartial, { zone: 'top', searchType: locals.searchType }) %>
        <% } else if (locals.searchType) { %>
            <input type="hidden" name="type" value="<%= searchType %>">
        <% } %>
        <% if (locals.scanned_barcode) { %>
            <%# Keeps the scanned code on the item when its product name has to be fixed by hand %>
            <input type="hidden" name="scanned_barcode" value="<%= scanned_barcode %>">
        <% } %>
        <div class="flex flex-col sm:flex-row gap-3">
            <div class="flex-grow relative group">
                <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none z-10">
                    <i class="fa-solid fa-search opacity-50 group-focus-within:text-primary-theme transition-colors"></i>
                </div>
                <input type="text" name="query" value="<%= locals.searchQuery || '' %>"
                    class="block w-full p-4 pl-12 text-base bg-black/5 dark:bg-white/5 border border-transparent focus:border-primary-theme rounded-2xl focus:ring-2 focus:ring-primary-theme/50 placeholder-opacity-50 transition-all outline-none"
                    placeholder="<%= t('add_' + plugin.i18nKey + '.search_placeholder', { defaultValue: t('add_vinyl.search_placeholder') }) %>" autofocus required>
            </div>
            <button type="submit"
                class="bg-primary-theme hover:brightness-110 text-white font-bold px-8 py-4 rounded-2xl shadow-lg shadow-primary-theme/20 transition-all active:scale-95 flex items-center justify-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-search"></i>
                <%= t('common.search') %>
            </button>
        </div>

        <% if (plugin.searchFormPartial && plugin.partialsPath) { %>
            <%- include('../../' + plugin.partialsPath + '/' + plugin.searchFormPartial, { zone: 'bottom', searchType: locals.searchType }) %>
        <% } %>

        <div class="flex items-center gap-3 mt-4 justify-center">
            <span class="text-xs font-bold uppercase opacity-30"><%= t('add_vinyl.separator_or') %></span>
        </div>

        <div class="flex flex-col items-center justify-center mt-6 gap-3">
            <button type="button" id="start-scan"
                class="bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-6 py-3 rounded-xl font-bold text-sm transition-all flex items-center gap-2 active:scale-95">
                <i class="fa-solid fa-barcode"></i>
                <%= t('add_' + plugin.i18nKey + '.btn_scan', { defaultValue: t('add_vinyl.btn_scan') }) %>
            </button>

            <% if (plugin.getManualDefaults) { %>
                <a href="<%= baseUrl %>/add-<%= plugin.id %>/manual"
                    class="text-xs text-primary-theme hover:underline font-bold transition-all flex items-center gap-1.5 mt-2">
                    <i class="fa-solid fa-keyboard"></i>
                    <%= t('add_' + plugin.i18nKey + '.manual_entry', { defaultValue: t('add_vinyl.manual_entry') }) %>
                </a>
            <% } %>
        </div>

        <%# The video element is ours rather than the library's: ZXing only ever reads the
            frames, so how big it looks on screen no longer has anything to do with what
            the decoder sees. %>
        <div id="reader" class="hidden mt-6 rounded-2xl overflow-hidden shadow-lg border border-black/10 dark:border-white/10">
            <video id="reader-video" class="w-full block bg-black" muted playsinline></video>
        </div>
        <p id="scan-hint" class="hidden mt-3 text-center text-xs opacity-60 max-w-md mx-auto leading-relaxed"></p>
    </form>

    <% if (locals.results) { %>
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-xl font-bold transition-colors"><%= t('add_' + plugin.i18nKey + '.results_title', { defaultValue: t('add_vinyl.results_title') }) %></h2>
            <span class="bg-black/10 dark:bg-white/10 text-xs font-mono px-2 py-1 rounded opacity-70 transition-colors"><%= results.length %></span>
        </div>

        <% if (results.length === 0) { %>
            <div class="text-center py-12 card-theme bg-opacity-50 rounded-xl border-dashed opacity-70 transition-colors">
                <i class="fa-solid <%= locals.error ? 'fa-barcode' : 'fa-ghost' %> text-4xl mb-3 opacity-50"></i>
                <%# An empty list and a failed lookup read the same to the user unless we say so %>
                <p><%= locals.error || t('add_' + plugin.i18nKey + '.no_results', { defaultValue: t('add_vinyl.no_results') }) %></p>
            </div>
        <% } else { %>
            <% 
                const aspect = plugin.aspectRatioClass || 'aspect-[2/3]';
            %>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                <% results.forEach(item => { %>
                    <%
                        const confirmParams = [];
                        if (locals.searchType && locals.searchType !== plugin.id) confirmParams.push('type=' + encodeURIComponent(searchType));
                        if (locals.scanned_barcode) confirmParams.push('barcode=' + encodeURIComponent(scanned_barcode));
                        const confirmQs = confirmParams.length ? '?' + confirmParams.join('&') : '';
                    %>
                    <a href="<%= baseUrl %>/confirm-<%= plugin.id %>/<%= item.id || item.hardcover_id || item.tmdb_id || item.igdb_id %><%- confirmQs %>" class="card-theme rounded-xl overflow-hidden hover:border-primary-theme transition-all group flex flex-col hover:shadow-lg hover:-translate-y-1">
                        <div class="relative <%= aspect %> bg-black/5 dark:bg-white/5">
                            <% if (item.cover_image && !item.cover_image.includes('spacer.gif')) { %>
                                <img src="<%= item.cover_image %>" onerror="this.onerror=null; this.src='<%= baseUrl %>/ressources/logo.png';" class="w-full h-full object-cover">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center opacity-30">
                                    <i class="fa-solid fa-<%= plugin.icon %> text-3xl"></i>
                                </div>
                            <% } %>
                        </div>

                        <div class="p-3 flex flex-col flex-grow">
                            <h3 class="font-bold text-sm leading-tight mb-1 line-clamp-2 transition-colors"><%= item.title %></h3>
                            <% const creatorLine = item.artist || item.author || item.director || item.developer || item.creator; %>
                            <% if (creatorLine) { %>
                                <p class="opacity-60 text-xs mb-1 transition-colors line-clamp-1"><%= creatorLine %></p>
                            <% } %>
                            <p class="opacity-40 text-[10px] mb-2 transition-colors"><%= item.country ? item.country + ' • ' : '' %><%= item.year %></p>

                            <% if (item.is_advanced_cd) { %>
                                <div class="flex items-center gap-1 mb-2">
                                    <span class="text-[10px] font-bold text-white px-2 py-0.5 rounded-full shadow-md truncate max-w-full <%= item.is_advanced_cd === 'sacd' ? 'bg-red-600/90' : 'bg-blue-600/90' %>">
                                        <%= item.is_advanced_cd === 'sacd' ? t('media.sacd') : t('media.cdr') %>
                                    </span>
                                </div>
                            <% } %>

                            <% if (item.variant_info) { %>
                                <div class="flex items-center gap-1 mb-3">
                                    <span class="w-2 h-2 rounded-full bg-primary-theme inline-block flex-shrink-0"></span>
                                    <span class="text-[10px] opacity-70 truncate max-w-full font-medium italic"><%= item.variant_info %></span>
                                </div>
                            <% } %>

                            <div class="flex flex-wrap gap-1 mt-auto">
                                <% if (Array.isArray(item.format)) { %>
                                    <% item.format.slice(0, 2).forEach(fmt => { %>
                                        <span class="text-[9px] bg-black/5 dark:bg-white/10 opacity-70 px-1.5 py-0.5 rounded border border-transparent truncate max-w-full transition-colors"><%= fmt %></span>
                                    <% }) %>
                                <% } else if (item.format) { %>
                                    <span class="text-[9px] bg-black/5 dark:bg-white/10 opacity-70 px-1.5 py-0.5 rounded border border-transparent truncate max-w-full transition-colors">
                                        <%= t('media.' + item.format, { defaultValue: item.format }) %>
                                    </span>
                                <% } else if (item.pages) { %>
                                    <span class="text-[9px] bg-black/5 dark:bg-white/10 opacity-70 px-1.5 py-0.5 rounded border border-transparent truncate max-w-full transition-colors"><%= item.pages %> p.</span>
                                <% } %>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>
    <% } %>
</div>

<script>
    const scanTranslations = {
        btnDefault: '<i class="fa-solid fa-barcode text-primary-theme text-xl"></i> <span><%= t("add_" + plugin.i18nKey + ".btn_scan", { defaultValue: t("add_vinyl.btn_scan") }) %></span>',
        init: '<i class="fa-solid fa-spinner fa-spin text-xl"></i> <span><%= t("add_vinyl.scan_init") %></span>',
        stop: '<i class="fa-solid fa-xmark text-xl"></i> <span><%= t("add_vinyl.scan_stop") %></span>',
        found: '<i class="fa-solid fa-check text-xl"></i> <span><%= t("add_vinyl.scan_found") %></span>',
        error: <%- JSON.stringify(t("add_vinyl.scan_error")) %>,
        hint: <%- JSON.stringify(t("add_vinyl.scan_hint")) %>
    };

    // Restricted to the retail symbologies an item can actually carry: a decoder asked
    // for fewer formats rejects a bad read faster and misreads less often.
    const scanHints = new Map();
    scanHints.set(ZXing.DecodeHintType.POSSIBLE_FORMATS, [
        ZXing.BarcodeFormat.EAN_13,
        ZXing.BarcodeFormat.EAN_8,
        ZXing.BarcodeFormat.UPC_A,
        ZXing.BarcodeFormat.UPC_E
    ]);
    // Costs more work per frame, and earns it here: the frames come from a hand-held
    // camera, where a barcode is rarely square to the lens.
    scanHints.set(ZXing.DecodeHintType.TRY_HARDER, true);

    const codeReader = new ZXing.BrowserMultiFormatReader(scanHints);
    // Left at its default of 0, the reader re-decodes a full frame the instant the
    // previous one failed, which pins a phone's CPU for nothing. Roughly the 10fps the
    // scanner used to run at.
    codeReader.timeBetweenDecodingAttempts = 100;

    const scanButton = document.getElementById('start-scan');
    const readerDiv = document.getElementById('reader');
    const videoEl = document.getElementById('reader-video');
    const hintEl = document.getElementById('scan-hint');
    const searchInput = document.querySelector('input[name="query"]');
    const form = document.querySelector('form[action="<%= baseUrl %>/search-<%= plugin.id %>"]');
    let isScanning = false;
    let foundCode = false;
    let hintTimer = null;

    // A camera that opens and never decodes says nothing about why. After a while of
    // neither a result nor an error, offer what actually helps instead of leaving
    // someone to wonder whether the scanner is even running.
    const SCAN_HINT_DELAY_MS = 12000;

    function stopScan() {
        codeReader.reset();
        clearTimeout(hintTimer);
        readerDiv.classList.add('hidden');
        hintEl.classList.add('hidden');
        scanButton.classList.remove('bg-red-600', 'hover:bg-red-500', 'text-white');
        scanButton.classList.add('bg-black/5', 'dark:bg-white/5', 'hover:bg-black/10', 'dark:hover:bg-white/10');
        isScanning = false;
    }

    scanButton.addEventListener('click', () => {
        if (isScanning) {
            stopScan();
            scanButton.innerHTML = scanTranslations.btnDefault;
            return;
        }

        foundCode = false;
        readerDiv.classList.remove('hidden');
        scanButton.innerHTML = scanTranslations.init;

        // Asking for the largest frame the camera will give is the whole point of this
        // path: ZXing decodes the frame at the resolution it arrives in, so the stream
        // is what decides whether a barcode is readable, not how big the preview looks.
        // `ideal` rather than `exact` everywhere, so a laptop with no rear camera and a
        // phone that cannot do 1080p both fall back instead of failing to open.
        codeReader.decodeFromConstraints({
            video: {
                facingMode: { ideal: 'environment' },
                width: { ideal: 1920 },
                height: { ideal: 1080 }
            }
        }, videoEl, (result) => {
            // The error argument fires on every single frame that holds no code, which
            // is the normal state of a scanner, so only a result is worth reacting to.
            if (!result || foundCode) return;
            foundCode = true;
            stopScan();
            scanButton.innerHTML = scanTranslations.found;
            searchInput.value = result.getText();
            form.submit();
        }).then(() => {
            if (foundCode) return;
            isScanning = true;
            scanButton.innerHTML = scanTranslations.stop;

            scanButton.classList.remove('bg-black/5', 'dark:bg-white/5', 'hover:bg-black/10', 'dark:hover:bg-white/10');
            scanButton.classList.add('bg-red-600', 'hover:bg-red-500', 'text-white');

            hintTimer = setTimeout(() => {
                hintEl.textContent = scanTranslations.hint;
                hintEl.classList.remove('hidden');
            }, SCAN_HINT_DELAY_MS);
        }).catch(err => {
            console.error("Error starting scan", err);
            stopScan();
            scanButton.innerHTML = scanTranslations.error;
        });
    });

    // A stream left running holds the camera open, and its indicator light on, after
    // someone has already navigated away.
    window.addEventListener('pagehide', () => codeReader.reset());
</script>

<%- include('../../views/partials/footer') %>
