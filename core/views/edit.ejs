<%- include('../../views/partials/header', { shellBack: false }) %>

<div class="max-w-screen-xl mx-auto pb-20 px-4 max-sm:px-0 md:px-0">
    <nav class="flex mb-6 text-sm opacity-60 transition-colors">
        <a href="<%= baseUrl %><%= plugin.routePrefix %>/<%= item._id %>" class="hover:opacity-100 transition-opacity flex items-center py-2">
            <i class="fa-solid fa-arrow-left mr-2"></i> <%= t('common.cancel_back') %>
        </a>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left Side: Cover Image Preview -->
        <div class="lg:col-span-4 space-y-6">
            <div class="card-theme rounded-xl p-6 sticky top-24 transition-colors shadow-sm">
                <div class="<%= plugin.aspectRatioClass || 'aspect-[2/3]' %> rounded-lg overflow-hidden mb-4 shadow-lg relative group bg-black/5 dark:bg-white/5">
                    <img id="livePreview" src="<%= itemImageUrl(item.cover_image) %>" class="w-full h-full object-cover transition-all duration-500">
                </div>
                <h2 class="text-xl font-bold mb-1"><%= item.title %></h2>
                <p class="opacity-60 mb-4"><%= item[plugin.creatorField] %></p>
            </div>
        </div>

        <!-- Right Side: Forms -->
        <div class="lg:col-span-8">
            <div class="card-theme rounded-xl p-6 md:p-8 transition-colors shadow-sm">
                <h1 class="text-2xl font-bold mb-6 flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-primary-theme"></i> <%= t('edit_' + plugin.i18nKey + '.title', { defaultValue: t('generic.edit_title') }) %>
                </h1>

                <form action="<%= baseUrl %>/save-<%= plugin.id %>" method="POST" data-save-bar class="space-y-6">
                    <%# Where to land once saved, handed over by the item page. %>
                    <% if (locals.backUrl) { %>
                        <input type="hidden" name="return_to" value="<%= backUrl %>">
                    <% } %>
                    <%
                    // Preserve every schema field not covered by a visible input so an edit-save
                    // doesn't wipe it: genres/styles and external ids (tmdb_id/igdb_id/hardcover_slug...).
                    // Mirrors the fallback in confirm.ejs. The external id is excluded, it has
                    // its own editable block below and would otherwise be posted twice.
                    const editVisible = new Set(plugin.formFields
                        .filter(f => f.showIn.includes('edit'))
                        .map(f => f.name));
                    if (plugin.externalIdField) editVisible.add(plugin.externalIdField);
                    // The summary a source wrote is the owner's to rewrite (a board game's in
                    // their own language, say), whatever the type, so it gets an input of its
                    // own wherever the type stores one and declares none.
                    const summaryLabel = t('confirm_' + plugin.i18nKey + '.description_title', { defaultValue: t('confirm_book.description_title') });
                    const editSummary = Object.prototype.hasOwnProperty.call(plugin.storedFields || {}, 'description') && !editVisible.has('description');
                    if (editSummary) editVisible.add('description');

                    const editHidden = [];
                    Object.keys(plugin.storedFields || {}).forEach(k => {
                        if (editVisible.has(k)) return;
                        const v = item[k];
                        if (v === undefined || v === null) return;
                        // Scalars and string arrays (genres, styles...) are submitted; other objects
                        // (tracklist) already have dedicated custom inputs.
                        const isStringArray = Array.isArray(v) && v.every(x => typeof x === 'string');
                        if (typeof v === 'object' && !isStringArray) return;
                        editHidden.push(k);
                    });
                    editHidden.forEach(name => {
                        const hv = item[name];
                    %>
                        <input type="hidden" name="<%= name %>" value="<%= Array.isArray(hv) ? hv.join(', ') : (hv ?? '') %>">
                    <% }) %>

                    <%# The id tying the item to the site it came from (Discogs, TMDB, IGDB...).
                        Offered whether or not the item already carries one: an item added by
                        hand never got one, and that is exactly the item whose owner may want
                        to attach it later to unlock the metadata refresh and the estimate.
                        Skipped when the plugin already declares the id among its form fields
                        (lego's set number), which would otherwise print the input twice.
                        Emptying the input detaches the id: save-<plugin> unsets it, which is
                        how a wrong match from an import is undone. %>
                    <%
                        const extIdField = plugin.externalIdField;
                        const extIdInForm = extIdField
                            && (plugin.formFields || []).some(f => f.name === extIdField && f.showIn.includes('edit'));
                    %>
                    <% if (extIdField && !extIdInForm) { %>
                        <div class="bg-yellow-50 dark:bg-yellow-900/10 border border-yellow-200 dark:border-yellow-700/30 p-4 rounded-lg transition-colors">
                            <label class="block mb-2 text-sm font-bold text-yellow-700 dark:text-yellow-500"><%= t(plugin.externalIdLabel || 'common.external_id_label') %></label>
                            <div class="text-xs text-yellow-800/80 dark:text-yellow-200/60 mb-2"><%= t(plugin.externalIdHint || 'common.external_id_hint') %></div>
                            <input type="text" name="<%= extIdField %>" value="<%= item[extIdField] ?? '' %>" class="bg-white dark:bg-black/20 border border-yellow-300 dark:border-yellow-600/50 text-sm rounded-lg focus:ring-yellow-500 block w-full p-2.5 font-mono outline-none">
                        </div>
                    <% } %>

                    <!-- Main fields -->
                    <div class="space-y-6">
                        <% 
                        const mainFields = plugin.formFields.filter(f => f.showIn.includes('edit') && f.group === 'main' && f.type !== 'custom');
                        %>
                        <%- include('partials/field-grid', { fields: mainFields, item, isEdit: true }) %>
                    </div>

                    <% if (editSummary) { %>
                        <div>
                            <%- include('partials/fields/textarea', { field: { name: 'description', label: summaryLabel }, value: item.description }) %>
                        </div>
                    <% } %>

                    <!-- Custom inputs from formFields (like tracklist editor), end of the "album info" section -->
                    <%
                    const customFields = plugin.formFields.filter(f => f.showIn.includes('edit') && f.type === 'custom');
                    customFields.forEach(field => {
                    %>
                        <%- include('../../' + plugin.partialsPath + '/' + field.partial, { field, item }) %>
                    <% }) %>

                    <%- include('partials/item-images', { plugin, item }) %>

                    <!-- Metadata and other form fields -->
                    <div class="space-y-6">
                        <% 
                        const metaFields = plugin.formFields.filter(f => f.showIn.includes('edit') && f.group === 'metadata' && f.type !== 'custom');
                        %>
                        <%- include('partials/field-grid', { fields: metaFields, item, isEdit: true }) %>
                    </div>

                    <%# Fields the owner rewrote are kept across refreshes. Those a refresh has
                        since brought another value for are listed, each with a way to hand it
                        back to the source. %>
                    <% if (locals.canRefreshItem) {
                        const labelOf = name => {
                            if (name === 'description') return summaryLabel;
                            if (name === 'cover_image') return t('generic.kept_cover');
                            const declared = (plugin.formFields || []).find(f => f.name === name);
                            return declared ? t(declared.label) : name;
                        };
                        const sourceName = locals.refreshSourceName || t('generic.kept_source_fallback');
                    %>
                        <div class="rounded-xl border border-black/5 dark:border-white/10 p-4 space-y-3">
                            <p class="text-xs opacity-60"><i class="fa-solid fa-lock mr-1.5"></i><%= t('generic.kept_hint') %></p>
                            <% (locals.offeredSourceValues || []).forEach(offer => {
                                const shown = Array.isArray(offer.value) ? offer.value.map(v => typeof v === 'object' ? (v.name || '') : v).filter(Boolean).join(', ') : String(offer.value ?? '');
                            %>
                                <label class="flex items-start gap-3 bg-black/5 dark:bg-white/5 rounded-lg p-3 cursor-pointer">
                                    <input type="checkbox" name="revert_fields" value="<%= offer.field %>" class="mt-1 w-4 h-4 accent-primary-theme cursor-pointer">
                                    <span class="min-w-0 flex-grow">
                                        <span class="block text-sm font-bold"><%= t('generic.kept_use_source', { field: labelOf(offer.field), source: sourceName }) %></span>
                                        <% if (offer.field === 'cover_image' && shown) { %>
                                            <img src="<%= itemImageUrl(shown) %>" alt="" class="mt-2 h-20 rounded object-cover">
                                        <% } else if (shown) { %>
                                            <span class="block mt-1 text-xs opacity-60 line-clamp-3 whitespace-pre-line"><%= shown %></span>
                                        <% } else { %>
                                            <span class="block mt-1 text-xs opacity-40 italic"><%= t('generic.kept_source_empty') %></span>
                                        <% } %>
                                    </span>
                                </label>
                            <% }) %>
                        </div>
                    <% } %>

                    <input type="hidden" name="in_wishlist" value="<%= item.in_wishlist %>">
                    <input type="hidden" name="mongo_id" value="<%= item._id %>">
                    <input type="hidden" name="next_id" id="saveNextId" value="">

                    <div class="flex flex-col sm:flex-row gap-3">
                        <button type="submit" class="flex-1 text-white bg-primary-theme hover:brightness-110 font-bold rounded-xl text-lg px-5 py-4 transition-transform hover:scale-[1.01] flex items-center justify-center gap-2 shadow-lg shadow-primary-theme/20">
                            <i class="fa-solid fa-save"></i> <%= t('common.save_changes') %>
                        </button>
                        <%# Shown by the script below when the item was opened from a list
                            that has another item after it. %>
                        <button type="button" id="saveNextBtn" class="hidden sm:w-auto font-bold rounded-xl text-lg px-5 py-4 bg-black/5 dark:bg-white/10 hover:bg-primary-theme hover:text-white transition-all flex items-center justify-center gap-2">
                            <%= t('common.save_and_next') %> <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('partials/item-images-js', { plugin }) %>

<%- include('../../views/partials/browse-order') %>
<script>
    // "Save and next": goes on to the edit form of the item after this one in the list it
    // was opened from (remembered by views/partials/shelf-scroll-restore.ejs), reading
    // the list's next page when this item was the last of its page.
    (function () {
        var btn = document.getElementById('saveNextBtn');
        var form = btn && btn.closest('form');
        if (!form) return;
        var currentId = <%- JSON.stringify(String(item._id)) %>;
        var order;
        try { order = JSON.parse(sessionStorage.getItem('browseOrder') || 'null'); } catch (e) { order = null; }
        if (!order || !Array.isArray(order.items)) return;
        var index = order.items.findIndex(function (i) { return i.id === currentId; });
        if (index < 0) return;
        var next = order.items[index + 1] || null;
        if (!next && !(order.page < order.pages)) return;
        btn.classList.remove('hidden');

        async function nextPageFirst() {
            var url = new URL(order.url, location.origin);
            url.searchParams.set('page', String(order.page + 1));
            var path = url.pathname + url.search;
            var res = await fetch(path, { headers: { 'X-Requested-With': 'fetch', 'Accept': 'application/json' } });
            var data = await res.json();
            if (!data || !data.success) return null;
            // Parsed inert: only the item links are wanted, not the page's images.
            var holder = new DOMParser().parseFromString(data.html, 'text/html');
            var items = window.browseOrderItems(holder);
            if (!items.length) return null;
            // The next item's back arrow then returns to the page it is on.
            var returnTo = form.querySelector('input[name="return_to"]');
            if (returnTo && returnTo.value) returnTo.value = path;
            try {
                sessionStorage.setItem('browseOrder', JSON.stringify({
                    url: path, page: order.page + 1, pages: order.pages, items: items
                }));
            } catch (e) {}
            return items[0];
        }

        btn.addEventListener('click', async function () {
            if (!form.reportValidity()) return;
            btn.disabled = true;
            try {
                if (!next) next = await nextPageFirst();
            } catch (e) { next = null; }
            document.getElementById('saveNextId').value = next ? next.id : '';
            form.requestSubmit();
            btn.disabled = false;
        });
    })();
</script>

<%- include('../../views/partials/footer') %>
