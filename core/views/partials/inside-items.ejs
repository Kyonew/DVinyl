<%# What this item is kept in and what it keeps (core/insideItems.ts): the box a film of a
    boxset sits in, and the things a box holds, whatever their type. An editor puts the
    item in a box from here and takes things out of one. Expects: item, insideBox,
    boxContents. %>
<%
    const insideEditable = !!(locals.user && locals.canEditCollection && !locals.isShareView);
    const insideContents = locals.boxContents || [];
    const insideLinks = !locals.isShareView;
    const canPutInside = insideEditable && !locals.insideBox && insideContents.length === 0 && !item.in_wishlist;
    const insideImage = entry => entry.image ? itemImageUrl(entry.image) : (entry.cover || '/ressources/logo.png');
%>
<% if (locals.insideBox || insideContents.length > 0 || canPutInside) { %>
<section id="insideItems" class="pt-6 border-t border-black/10 dark:border-white/10 transition-colors">
    <% if (locals.insideBox) { %>
        <div class="flex flex-wrap items-center gap-3">
            <i class="fa-solid fa-box-open text-primary-theme" aria-hidden="true"></i>
            <span class="text-sm opacity-70"><%= t('inside.in_box') %></span>
            <% if (insideLinks) { %>
                <a href="<%= baseUrl %><%= insideBox.href %>" class="text-sm font-bold hover:text-primary-theme transition-colors"><%= insideBox.title %></a>
            <% } else { %>
                <span class="text-sm font-bold"><%= insideBox.title %></span>
            <% } %>
            <% if (insideEditable) { %>
                <button type="button" onclick="insideItems.takeOut('<%= item._id %>')"
                    class="ml-auto text-xs font-semibold opacity-70 hover:opacity-100 hover:text-primary-theme px-3 py-1.5 border border-black/10 dark:border-white/10 rounded-lg transition-colors">
                    <i class="fa-solid fa-arrow-up-from-bracket mr-1.5" aria-hidden="true"></i><%= t('inside.take_out') %>
                </button>
            <% } %>
        </div>
    <% } %>

    <% if (insideContents.length > 0) { %>
        <h3 class="text-xs font-bold uppercase tracking-widest opacity-50 mb-3"><%= t('inside.contents_title', { count: insideContents.length }) %></h3>
        <ul class="space-y-2">
            <% insideContents.forEach(entry => { %>
                <li class="flex items-center gap-3 p-2 rounded-xl bg-black/5 dark:bg-white/5">
                    <img src="<%= insideImage(entry) %>" alt="" loading="lazy" class="w-12 h-12 rounded-lg object-cover bg-black/5 dark:bg-white/5 flex-none">
                    <div class="min-w-0 flex-1">
                        <% if (insideLinks) { %>
                            <a href="<%= baseUrl %><%= entry.href %>" class="block text-sm font-bold truncate hover:text-primary-theme transition-colors"><%= entry.title %></a>
                        <% } else { %>
                            <span class="block text-sm font-bold truncate"><%= entry.title %></span>
                        <% } %>
                        <span class="block text-xs opacity-60 truncate"><%= [entry.type, entry.creator, entry.year].filter(Boolean).join(' · ') %></span>
                    </div>
                    <% if (insideEditable) { %>
                        <button type="button" onclick="insideItems.takeOut('<%= entry._id %>')" title="<%= t('inside.take_out') %>"
                            class="flex-none text-xs font-semibold opacity-60 hover:opacity-100 hover:text-primary-theme px-3 py-1.5 rounded-lg transition-colors">
                            <i class="fa-solid fa-arrow-up-from-bracket mr-1.5" aria-hidden="true"></i><%= t('inside.take_out') %>
                        </button>
                    <% } %>
                </li>
            <% }) %>
        </ul>
    <% } %>

    <% if (canPutInside) { %>
        <button type="button" onclick="insideItems.open()"
            class="text-sm opacity-70 hover:opacity-100 hover:text-primary-theme px-4 py-2 border border-black/10 dark:border-white/10 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
            <i class="fa-solid fa-box-open mr-2" aria-hidden="true"></i><%= t('inside.put_inside_btn') %>
        </button>
        <p class="mt-2 text-xs opacity-50"><%= t('inside.put_inside_hint') %></p>

        <div id="insidePicker" class="dv-overlay fixed inset-0 z-[70] hidden">
            <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="insideItems.close()"></div>
            <div role="dialog" aria-modal="true" aria-labelledby="insidePickerTitle"
                class="absolute left-1/2 top-[10vh] -translate-x-1/2 w-[calc(100%-2rem)] max-w-md card-theme border rounded-2xl shadow-2xl p-5">
                <h2 id="insidePickerTitle" class="text-lg font-extrabold mb-3"><%= t('inside.picker_title') %></h2>
                <input id="insidePickerQuery" type="search" autocomplete="off" placeholder="<%= t('inside.picker_placeholder') %>"
                    class="w-full bg-black/5 dark:bg-white/5 border border-transparent rounded-lg text-sm p-3 outline-none focus:ring-2 focus:ring-primary-theme">
                <ul id="insidePickerList" class="mt-3 max-h-[50vh] overflow-y-auto space-y-1"></ul>
                <p id="insidePickerEmpty" class="hidden mt-3 text-sm opacity-60"><%= t('inside.picker_empty') %></p>
                <p id="insidePickerError" class="hidden mt-3 text-sm text-red-500"></p>
            </div>
        </div>
    <% } %>
</section>

<% if (insideEditable) { %>
<script>
    const insideItems = (function () {
        const base = <%- JSON.stringify(baseUrl) %>;
        const itemId = <%- JSON.stringify(String(item._id)) %>;
        const failed = <%- JSON.stringify(t('errors.generic_server_error')) %>;
        const picker = document.getElementById('insidePicker');
        const query = document.getElementById('insidePickerQuery');
        const list = document.getElementById('insidePickerList');
        const empty = document.getElementById('insidePickerEmpty');
        const error = document.getElementById('insidePickerError');
        let timer = null;

        async function post(path, body) {
            const res = await fetch(base + path, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body || {})
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) throw new Error(data.error || failed);
            return data;
        }

        // Built node by node: every title is text someone typed.
        function render(items) {
            list.innerHTML = '';
            empty.classList.toggle('hidden', items.length > 0);
            items.forEach(box => {
                const li = document.createElement('li');
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'w-full flex items-center gap-3 p-2 rounded-xl text-left hover:bg-black/5 dark:hover:bg-white/5 transition-colors';
                const img = document.createElement('img');
                img.src = box.image || (base + '/ressources/logo.png');
                img.alt = '';
                img.className = 'w-10 h-10 rounded-lg object-cover bg-black/5 dark:bg-white/5 flex-none';
                const text = document.createElement('span');
                text.className = 'min-w-0';
                const title = document.createElement('span');
                title.className = 'block text-sm font-bold truncate';
                title.textContent = box.title;
                const meta = document.createElement('span');
                meta.className = 'block text-xs opacity-60 truncate';
                meta.textContent = [box.type, box.year].filter(Boolean).join(' · ');
                text.append(title, meta);
                button.append(img, text);
                button.addEventListener('click', () => choose(box.id));
                li.appendChild(button);
                list.appendChild(li);
            });
        }

        async function search() {
            try {
                const res = await fetch(base + '/api/inside/candidates?item=' + encodeURIComponent(itemId) + '&q=' + encodeURIComponent(query.value));
                const data = await res.json();
                render(data.items || []);
            } catch (e) { render([]); }
        }

        async function choose(boxId) {
            error.classList.add('hidden');
            try {
                await post('/api/inside/' + itemId, { box: boxId });
                window.location.reload();
            } catch (e) {
                error.textContent = e.message;
                error.classList.remove('hidden');
            }
        }

        if (query) {
            query.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(search, 200); });
            document.addEventListener('keydown', e => { if (e.key === 'Escape' && picker && !picker.classList.contains('hidden')) insideItems.close(); });
        }

        return {
            open() {
                picker.classList.remove('hidden');
                query.value = '';
                error.classList.add('hidden');
                search();
                query.focus();
            },
            close() { picker.classList.add('hidden'); },
            async takeOut(id) {
                try {
                    await post('/api/inside/' + id + '/out');
                    window.location.reload();
                } catch (e) { alert(e.message); }
            }
        };
    })();
</script>
<% } %>
<% } %>
