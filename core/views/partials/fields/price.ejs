<%# An amount of money: the price paid for a copy. Shown in the currency it was entered
    in, which stays with it; a new amount is taken in the currency of whoever types it. %>
<% const priceCurrency = (item && item.purchase_currency) || (locals.user && user.currency) || 'USD'; %>
<label class="block mb-2 text-sm font-bold uppercase tracking-widest opacity-60" for="field_<%= field.name %>">
    <%= t(field.label) %>
    <span class="text-xs opacity-50 ml-2 font-normal normal-case"><%= priceCurrency %></span>
</label>
<input type="number" id="field_<%= field.name %>" name="<%= field.name %>" min="0" step="0.01" inputmode="decimal"
    value="<%= value !== undefined && value !== null ? value : '' %>"
    class="bg-black/5 dark:bg-white/5 border border-transparent rounded-lg text-sm focus:ring-primary-theme block w-full p-3 outline-none"
    placeholder="0.00">
