<label class="block mb-2 text-sm font-bold uppercase tracking-widest opacity-60"><%= t(field.label) %></label>
<select name="<%= field.name %>" class="w-full bg-black/5 dark:bg-white/5 border border-transparent rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-primary-theme outline-none transition-all cursor-pointer">
  <%
    let finalOptions = field.options || [];
    // Preserve a stored value that isn't among the predefined options (e.g. a value an
    // external API introduced since) so editing doesn't silently reset it.
    const valStr = (value === undefined || value === null) ? '' : String(value);
    if (valStr && !finalOptions.some(o => String(o.value) === valStr)) {
      finalOptions = [{ value: valStr, label: valStr }, ...finalOptions];
    }
  %>
  <% if (finalOptions) { %>
    <% finalOptions.forEach(opt => { %>
      <option value="<%= opt.value %>" class="bg-white dark:bg-[#1a1a1a]" <%= (String(value) === String(opt.value)) ? 'selected' : '' %>><%= t(opt.label, { defaultValue: opt.label }) %></option>
    <% }) %>
  <% } %>
</select>
