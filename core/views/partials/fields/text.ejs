<% const isBarcodeField = field.name === 'barcode'; %>
<%
    // Values already known for this field, offered without constraining the input. The
    // route builds them per field name, so nothing here knows which fields have any.
    const fieldSuggestions = (typeof suggestions !== 'undefined' && suggestions && Array.isArray(suggestions[field.name]))
        ? suggestions[field.name]
        : [];
    const listId = `suggest-${field.name}`;
%>
<label class="block mb-2 text-sm font-bold uppercase tracking-widest opacity-60 <%= (isBarcodeField && locals.isEdit) ? 'flex items-center gap-2' : '' %>">
    <%= t(field.label) %>
    <% if (isBarcodeField && locals.isEdit) { %>
        <label class="cursor-pointer flex items-center ml-auto" title="<%= t('confirm_vinyl.barcode_locked') %>">
            <input type="checkbox" name="barcode_locked" class="hidden peer" <%= (item && item.barcode_locked) ? 'checked' : '' %>>
            <i class="fa-solid fa-unlock opacity-30 peer-checked:hidden"></i>
            <i class="fa-solid fa-lock text-primary-theme hidden peer-checked:block"></i>
        </label>
    <% } %>
</label>
<input type="text" name="<%= field.name %>" value="<%= value || '' %>" <%= field.required ? 'required' : '' %> <%- fieldSuggestions.length > 0 ? `list="${listId}"` : '' %> class="bg-black/5 dark:bg-white/5 border border-transparent rounded-lg text-sm focus:ring-primary-theme block w-full p-3 outline-none <%= isBarcodeField ? 'font-mono' : '' %>" placeholder="<%= field.placeholder ? t(field.placeholder) : '' %>">
<% if (fieldSuggestions.length > 0) { %>
    <datalist id="<%= listId %>">
        <% fieldSuggestions.forEach(suggestion => { %>
            <option value="<%= suggestion %>">
        <% }) %>
    </datalist>
<% } %>
