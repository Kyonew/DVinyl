<%
    /**
     * Lays a list of form fields out in rows, shared by the edit, confirm and manual add
     * forms. Callers filter the fields (which form, which group); this only arranges them.
     *
     * Two per row, except a long text field, which takes a row to itself: half a column is
     * not enough to read a synopsis or a set of notes in, and the pairing used to hand it
     * one purely by position. A lone field on its row is full width already.
     *
     * Expects: fields, item. Optional: isEdit, forwarded to the field partials.
     */
    const rows = [];
    let pending = null;
    for (const field of fields) {
        if (field.type === 'textarea' || field.type === 'rows') {
            if (pending) { rows.push([pending]); pending = null; }
            rows.push([field]);
        } else if (pending) {
            rows.push([pending, field]);
            pending = null;
        } else {
            pending = field;
        }
    }
    if (pending) rows.push([pending]);
%>
<% rows.forEach(row => { %>
    <div class="grid grid-cols-1 <%= row.length === 2 ? 'md:grid-cols-2' : '' %> gap-6">
        <% row.forEach(field => { const shown = fieldShownFor(field, item); %>
            <%# A field shown for some values of another one only (showWhen) carries them,
                for the script below to follow the other field as it changes. %>
            <div <% if (field.showWhen) { %>data-show-when-field="<%= field.showWhen.field %>" data-show-when-values="<%= JSON.stringify(field.showWhen.values) %>"<% } %> class="<%= shown ? '' : 'hidden' %>">
                <%# `location` is a core path every module carries, and the core draws it its
                    own way: a picker over the collection's shelves rather than the plain
                    text box its type asks for. %>
                <%# So is `purchase_price`, an amount in a currency rather than a bare number, and
                    `extra_formats`, boxes over the type's own formats. %>
                <%- include('fields/' + (field.name === 'location' ? 'location' : field.name === 'purchase_price' ? 'price' : field.name === 'extra_formats' ? 'formats' : field.type), { field, value: item[field.name], item, isEdit: locals.isEdit === true }) %>
            </div>
        <% }) %>
    </div>
<% }) %>

<% if (fields.some(f => f.showWhen)) { %>
<script>
    (function () {
        // Shows each conditional field while the field it follows holds one of its values,
        // and disables what it holds while hidden so the form does not post it: what was
        // stored stays. Wired once per page, whichever grid includes it first.
        if (window.__showWhenWired) { window.__showWhenSync && window.__showWhenSync(); return; }
        window.__showWhenWired = true;
        function valueOf(form, name) {
            const checked = form.querySelector('[name="' + name + '"]:checked');
            if (checked) return checked.value;
            const input = form.querySelector('select[name="' + name + '"], input[name="' + name + '"]:not([type=radio]):not([type=checkbox])');
            return input ? input.value : '';
        }
        function sync() {
            document.querySelectorAll('[data-show-when-field]').forEach(box => {
                const form = box.closest('form');
                if (!form) return;
                let values = [];
                try { values = JSON.parse(box.dataset.showWhenValues || '[]'); } catch (e) { values = []; }
                const shown = values.includes(valueOf(form, box.dataset.showWhenField));
                box.classList.toggle('hidden', !shown);
                box.querySelectorAll('input, select, textarea').forEach(el => { el.disabled = !shown; });
            });
        }
        window.__showWhenSync = sync;
        document.addEventListener('change', e => {
            if (e.target && e.target.name && document.querySelector('[data-show-when-field="' + e.target.name + '"]')) sync();
        });
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sync);
        else sync();
    })();
</script>
<% } %>
