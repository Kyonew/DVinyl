MONGODB_URL=mongodb://mongodb:27017/dvinyl # MongoDB connection URL (you can change if needed)

PASSJWT=SomeComplexPassword
SESSION_SECRET=AnotherComplexSecret

# HTTPS Configuration
PROD=false # Change to true ONLY if you use HTTPS. If not, leave as false.

# DVinyl
VINYL_PORT=3099 # Port for the DVinyl service

# Base URL for serving on a sub-path, leave empty to serve from root (default)
BASE_URL=

# OIDC / SSO login (optional). Leave unset to disable the feature entirely.
# OIDC_ISSUER_URL is your provider's issuer URL (Authentik, Keycloak, Authelia,
# pocketID...); endpoints are resolved automatically through OIDC discovery.
# OIDC_REDIRECT_URI must be the exact callback URL registered on your provider,
# always ending with /login/oidc/callback.
# SSO never creates accounts: users sign in with their password first, then
# link their identity from the Settings page.
# OIDC_ISSUER_URL=https://idp.example.com/application/o/dvinyl/
# OIDC_CLIENT_ID=YourOIDCClientID
# OIDC_CLIENT_SECRET=YourOIDCClientSecret
# OIDC_REDIRECT_URI=https://dvinyl.example.com/login/oidc/callback
# OIDC_BUTTON_LABEL=Sign in with Authentik

# Music
DISCOGS_TOKEN=YourDiscogsAPITokenHere

# Books
HARDCOVER_API_KEY=YourHardcoverAPIKeyHere

# DVDs
TMDB_API_KEY=YourTMDBAPIKeyHere

# Games
TWITCH_CLIENT_ID=YourTwitchClientIDHere
TWITCH_CLIENT_SECRET=YourTwitchClientSecretHere

# LEGO
REBRICKABLE_API_KEY=YourRebrickableAPIKeyHere
