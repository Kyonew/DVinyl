# MongoDB connection URL (you can change if needed)
MONGODB_URL=mongodb://mongodb:27017/dvinyl

PASSJWT=SomeComplexPassword
SESSION_SECRET=AnotherComplexSecret

# HTTPS Configuration
PROD=false # Change to true ONLY if you use HTTPS. If not, leave as false.

# DVinyl
VINYL_PORT=3099 # Port for the DVinyl service

# Base URL for serving on a sub-path, leave empty to serve from root (default)
BASE_URL=

# OIDC / SSO login (optional). Leave unset to disable the feature entirely.
# OIDC_ISSUER_URL is your provider's issuer URL (Authentik, Keycloak, Authelia,
# pocketID...); endpoints are resolved automatically through OIDC discovery.
# OIDC_REDIRECT_URI must be the exact callback URL registered on your provider,
# always ending with /login/oidc/callback.
# By default SSO never creates accounts: users sign in with their password
# first, then link their identity from the Settings page. See the auto-signup
# block below to provision accounts automatically from your IdP instead.
# OIDC_ISSUER_URL=https://idp.example.com/application/o/dvinyl/
# OIDC_CLIENT_ID=YourOIDCClientID
# OIDC_CLIENT_SECRET=YourOIDCClientSecret
# OIDC_REDIRECT_URI=https://dvinyl.example.com/login/oidc/callback
# OIDC_BUTTON_LABEL=Sign in with Authentik

# OIDC auto-provisioning (optional). When OIDC_ALLOW_SIGNUP=true, a successful
# SSO login for an unknown identity creates a DVinyl account on the fly (SSO
# only, no local password) instead of being rejected. The IdP must supply an
# email claim. A *verified* email (email_verified=true) is required only to
# attach the SSO identity to an existing local account with the same address
# (avoids account takeover); creating a brand-new account does not require it.
# OIDC_ALLOWED_GROUP restricts both signup AND every subsequent login to members
# of that IdP group; membership is re-checked on each login, so removing a user
# from the group in your IdP revokes their access. Leave empty to allow any user
# the IdP authenticates. Your IdP must expose group memberships in a claim (the
# default claim name is "groups"; override with OIDC_GROUPS_CLAIM if it differs).
# OIDC_ADMIN_GROUP grants instance admin rights to members of that group.
# OIDC_ALLOW_SIGNUP=true
# OIDC_ALLOWED_GROUP=allow_dvinyl_access
# OIDC_GROUPS_CLAIM=groups
# OIDC_ADMIN_GROUP=dvinyl_admins

# Dev only: allow a plain-HTTP (http://) issuer. openid-client requires HTTPS by
# default; set this to true ONLY for local testing against an http:// IdP. Never
# enable it in production. Use an HTTPS issuer instead.
# OIDC_ALLOW_INSECURE=true

# Music
DISCOGS_TOKEN=YourDiscogsAPITokenHere

# Books
HARDCOVER_API_KEY=YourHardcoverAPIKeyHere

# DVDs
TMDB_API_KEY=YourTMDBAPIKeyHere

# Games
TWITCH_CLIENT_ID=YourTwitchClientIDHere
TWITCH_CLIENT_SECRET=YourTwitchClientSecretHere

# LEGO
REBRICKABLE_API_KEY=YourRebrickableAPIKeyHere
