<%- include('partials/header') %>

    <div class="max-w-screen-xl mx-auto px-4 max-sm:px-0 pb-20 space-y-10">

        <!-- Distinct "console" banner: theme-aware (light/dark) but visually set apart
             from collection pages by its strong contrast block + server iconography -->
        <div data-settings-head class="md:mt-6 rounded-3xl md:rounded-[2rem] bg-neutral-100 text-neutral-900 dark:bg-neutral-900 dark:text-white border border-black/10 dark:border-white/10 shadow-xl overflow-hidden relative transition-colors">
            <div class="absolute inset-0 opacity-15 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-primary-theme via-transparent to-transparent"></div>
            <div class="relative p-5 md:p-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="flex items-center gap-5">
                    <div class="max-md:hidden w-14 h-14 rounded-2xl bg-primary-theme/15 text-primary-theme flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-server text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-black tracking-tight flex items-center gap-3">
                            <%= t('admin.instance.title') %> DVinyl
                        </h1>
                        <p class="max-md:hidden text-xs md:text-sm opacity-50 mt-1">
                            <%= t('admin.instance.subtitle') %>
                        </p>
                    </div>
                </div>
                <div class="max-md:hidden flex items-center gap-3">
                    <div class="text-[10px] font-black tracking-widest opacity-40 border border-black/15 dark:border-white/15 px-3 py-1 rounded-full">
                        v<%= appVersion %>
                    </div>
                </div>
            </div>

            <!-- Instance stats -->
            <div class="relative grid grid-cols-4 divide-x divide-black/10 dark:divide-white/10 border-t border-black/10 dark:border-white/10">
                <div class="px-1 py-3 md:p-6 text-center">
                    <p class="text-xl md:text-3xl font-black"><%= users.length %></p>
                    <p class="text-[9px] md:text-[10px] uppercase md:tracking-widest opacity-40 font-bold mt-1 truncate"><%= t('admin.instance.stat_users') %></p>
                </div>
                <div class="px-1 py-3 md:p-6 text-center">
                    <p class="text-xl md:text-3xl font-black"><%= (locals.collections || []).length %></p>
                    <p class="text-[9px] md:text-[10px] uppercase md:tracking-widest opacity-40 font-bold mt-1 truncate"><%= t('admin.instance.stat_collections') %></p>
                </div>
                <div class="px-1 py-3 md:p-6 text-center">
                    <p class="text-xl md:text-3xl font-black"><%= locals.itemsTotal || 0 %></p>
                    <p class="text-[9px] md:text-[10px] uppercase md:tracking-widest opacity-40 font-bold mt-1 truncate"><%= t('admin.instance.stat_items') %></p>
                </div>
                <div class="px-1 py-3 md:p-6 text-center">
                    <p class="text-xl md:text-3xl font-black"><%= blockedIps.length %></p>
                    <p class="text-[9px] md:text-[10px] uppercase md:tracking-widest opacity-40 font-bold mt-1 truncate"><%= t('admin.instance.stat_blocked') %></p>
                </div>
            </div>
        </div>

        <% if (locals.successMessage && !locals.newPassword && locals.messageIsError) { %>
            <div class="bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 p-4 rounded-2xl text-center mb-6 transition-colors">
                <p class="text-sm font-bold text-red-600 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <%= successMessage %>
                </p>
            </div>
        <% } else if (locals.successMessage && !locals.newPassword) { %>
            <div class="bg-primary-theme/10 border border-primary-theme/30 p-4 rounded-2xl text-center mb-6 transition-colors">
                <p class="text-sm font-bold text-primary-theme flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check-circle"></i>
                    <%= successMessage %>
                </p>
            </div>
        <% } %>

        <% if (locals.newPassword) { %>
            <div
                class="bg-primary-theme/10 border border-primary-theme/30 p-6 rounded-2xl text-center animate-pulse transition-colors">
                <h2 class="text-lg font-bold text-primary-theme mb-2">
                    <i class="fa-solid fa-check-circle"></i>
                    <%= successMessage %>
                </h2>
                <p class="text-sm opacity-70 mb-4">
                    <%= t('admin.temp_password_hint') %>
                </p>
                <div
                    class="bg-white dark:bg-black/50 p-4 rounded-xl inline-flex items-center gap-3 border border-primary-theme/30 shadow-sm overflow-hidden max-w-full">
                    <code class="text-xl md:text-2xl font-mono select-all break-all"><%= newPassword %></code>
                </div>
            </div>
            <% } %>

        <%- include('partials/settings-tabs', { tabs: [
            { id: 'collections', icon: 'layer-group', label: t('admin.instance.tabs.collections'), count: (locals.collections || []).length },
            { id: 'users', icon: 'users', label: t('admin.instance.tabs.users'), count: users.length },
            { id: 'backup', icon: 'database', label: t('admin.instance.tabs.backup') },
            { id: 'updates', icon: 'rocket', label: t('admin.instance.tabs.updates'), count: locals.updates && updates.available ? 1 : undefined },
            { id: 'security', icon: 'ban', label: t('admin.instance.tabs.security'), count: blockedIps.length },
            { id: 'ai', icon: 'wand-magic-sparkles', label: t('ai.title') },
            { id: 'logs', icon: 'satellite-dish', label: t('admin.instance.tabs.logs') }
        ] }) %>

                <%# The settings cards of this page share one layout: what it is and its switch on
                    top, its settings only once it is on, then where things stand in a band of its
                    own. Choices are buttons rather than menus where there are only a few, so every
                    option reads at a glance, and saving goes through the floating save bar. %>
                <% const switchTrack = "w-12 h-7 bg-black/10 dark:bg-white/10 rounded-full peer peer-focus-visible:ring-2 peer-focus-visible:ring-primary-theme/50 peer-checked:after:translate-x-5 after:content-[''] after:absolute after:top-1 after:left-1 after:bg-white after:rounded-full after:h-5 after:w-5 after:shadow after:transition-all peer-checked:bg-green-500 transition-colors";
                   const pill = 'cursor-pointer select-none px-4 py-2.5 rounded-xl text-sm font-bold bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 peer-checked:bg-primary-theme peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-primary-theme/50 transition-colors';
                   const fieldLabel = 'block text-sm font-bold mb-2';
                   const cardIcon = 'w-12 h-12 rounded-2xl bg-primary-theme/10 text-primary-theme hidden sm:flex items-center justify-center shrink-0';
                   const textInput = 'w-full bg-black/5 dark:bg-white/5 border border-transparent rounded-xl p-3 text-sm outline-none focus:ring-2 focus:ring-primary-theme/40 transition-colors'; %>

                <!-- ============ COLLECTIONS ============ -->
                <section data-tab-panel="collections">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between py-6 gap-4 mb-2">
                        <h2 class="text-xl md:text-2xl font-bold flex items-center gap-3 transition-colors">
                            <i class="fa-solid fa-layer-group text-primary-theme"></i>
                            <%= t('admin.collections.title', { count: (locals.collections || []).length }) %>
                        </h2>
                        <button onclick="toggleModal('createCollectionModal')"
                            class="flex items-center gap-2 bg-primary-theme hover:brightness-110 text-white px-5 py-3 rounded-2xl shadow-lg shadow-primary-theme/20 transition-all active:scale-95">
                            <i class="fa-solid fa-plus text-sm"></i>
                            <span class="text-xs font-black">
                                <%= t('admin.collections.create') %>
                            </span>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% (locals.collections || []).forEach(c => { %>
                            <div class="card-theme rounded-3xl p-6 shadow-sm transition-colors flex flex-col gap-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="overflow-hidden">
                                        <h3 class="text-lg font-black truncate flex items-center gap-2">
                                            <%= c.name %>
                                            <% if (c.isDefault) { %>
                                                <span title="<%= t('admin.collections.default_badge_hint') %>"
                                                    class="text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-primary-theme/10 text-primary-theme whitespace-nowrap cursor-help">
                                                    <%= t('admin.collections.default_badge') %>
                                                </span>
                                            <% } %>
                                        </h3>
                                        <p class="font-mono text-[10px] opacity-50 truncate"><%= c.slug %></p>
                                    </div>
                                    <div class="flex gap-2 shrink-0">
                                        <button onclick="toggleModal('collModal-<%= c._id %>')"
                                            class="flex items-center gap-2 bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-4 py-2 rounded-xl text-xs font-black transition-all">
                                            <i class="fa-solid fa-gear"></i>
                                            <%= t('admin.instance.manage') %>
                                        </button>
                                        <% if (!c.isDefault) { %>
                                            <form action="<%= baseUrl %>/admin/collections/<%= c._id %>/make-default" method="POST">
                                                <button type="submit"
                                                    class="bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white p-2 rounded-xl transition-colors"
                                                    title="<%= t('admin.collections.make_default') %>" aria-label="<%= t('admin.collections.make_default') %>">
                                                    <i class="fa-solid fa-house-flag"></i>
                                                </button>
                                            </form>
                                            <form action="<%= baseUrl %>/admin/collections/<%= c._id %>/delete" method="POST"
                                                onsubmit="return confirm(<%= JSON.stringify(t('admin.collections.confirm_delete', { name: c.name })) %>)">
                                                <button type="submit"
                                                    class="text-red-600 bg-red-100 dark:bg-red-500/10 p-2 rounded-xl transition-colors hover:brightness-110"
                                                    title="<%= t('admin.tooltips.delete') %>">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="flex items-center gap-5 text-xs opacity-70 border-t border-black/5 dark:border-white/5 pt-4">
                                    <span class="flex items-center gap-2">
                                        <i class="fa-solid fa-users opacity-50"></i>
                                        <%= (c.members || []).length %> <%= t('admin.collections.col_members').toLowerCase() %>
                                    </span>
                                    <span class="flex items-center gap-2">
                                        <i class="fa-solid fa-compact-disc opacity-50"></i>
                                        <%= c.itemCount || 0 %> <%= t('admin.instance.stat_items').toLowerCase() %>
                                    </span>
                                    <span class="flex items-center gap-2 ml-auto">
                                        <i class="fa-regular fa-calendar opacity-50"></i>
                                        <%= c.created_at ? new Date(c.created_at).toLocaleDateString(dateLocaleFor(currentLng)) : '-' %>
                                    </span>
                                </div>
                                <!-- Member avatars preview -->
                                <div class="flex -space-x-2">
                                    <% (c.members || []).slice(0, 8).forEach(m => { %>
                                        <img src="<%= baseUrl + (m.user.img || '/ressources/no-pp.jpg') %>"
                                            title="<%= m.user.username %> (<%= t('admin.members.role_' + m.role) %>)"
                                            class="w-8 h-8 rounded-full border-2 border-white dark:border-neutral-800 object-cover">
                                    <% }) %>
                                    <% if ((c.members || []).length > 8) { %>
                                        <span class="w-8 h-8 rounded-full bg-black/10 dark:bg-white/10 border-2 border-white dark:border-neutral-800 flex items-center justify-center text-[10px] font-black">
                                            +<%= c.members.length - 8 %>
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </section>

                <!-- ============ SELF-SERVICE COLLECTIONS (instance policy) ============ -->
                <section data-tab-panel="users">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between py-6 gap-4 mb-2">
                        <h2 class="text-xl md:text-2xl font-bold flex items-center gap-3 transition-colors">
                            <i class="fa-solid fa-user-plus text-primary-theme"></i>
                            <%= t('admin.instance.self_service_title') %>
                        </h2>
                    </div>

                    <% const memberOn = !!(locals.instanceSettings && instanceSettings.allowMemberCollectionCreation); %>
                    <form action="<%= baseUrl %>/admin/instance/settings" method="POST" data-save-bar data-toggle-card
                        class="card-theme rounded-3xl shadow-sm transition-colors overflow-hidden">
                        <label class="flex items-start gap-4 p-6 md:p-8 cursor-pointer">
                            <span class="<%= cardIcon %>"><i class="fa-solid fa-user-plus text-lg" aria-hidden="true"></i></span>
                            <span class="flex-1 min-w-0">
                                <span class="block text-lg font-bold"><%= t('admin.instance.allow_member_creation') %></span>
                                <span class="block text-sm opacity-70 mt-1 leading-relaxed max-w-2xl"><%= t('admin.instance.allow_member_creation_desc') %></span>
                            </span>
                            <span class="relative inline-flex items-center shrink-0 mt-1">
                                <input type="checkbox" id="allowMemberCollectionCreation" name="allowMemberCollectionCreation" <%= memberOn ? 'checked' : '' %>
                                    class="sr-only peer" aria-label="<%= t('admin.instance.allow_member_creation') %>" data-toggle-card-switch>
                                <span class="<%= switchTrack %>"></span>
                            </span>
                        </label>
                        <div class="px-6 md:px-8 pb-6 md:pb-8 <%= memberOn ? '' : 'hidden' %>" data-toggle-card-body>
                            <label for="maxCollectionsPerUser" class="<%= fieldLabel %>"><%= t('admin.instance.max_collections') %></label>
                            <div class="flex items-center gap-2" data-stepper>
                                <button type="button" class="w-11 h-11 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 font-black text-lg" data-step="-1" aria-label="-">−</button>
                                <input type="number" id="maxCollectionsPerUser" name="maxCollectionsPerUser" min="1" max="100"
                                    value="<%= locals.instanceSettings ? instanceSettings.maxCollectionsPerUser : 1 %>"
                                    class="w-20 text-center bg-black/5 dark:bg-white/5 border border-transparent rounded-xl p-2.5 text-base font-bold outline-none focus:ring-2 focus:ring-primary-theme/40">
                                <button type="button" class="w-11 h-11 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 font-black text-lg" data-step="1" aria-label="+">+</button>
                            </div>
                            <p class="text-sm opacity-60 mt-2 max-w-2xl"><%= t('admin.instance.max_collections_desc') %></p>
                        </div>
                    </form>
                </section>

                <!-- ============ AI ASSIST ============ -->
                <section data-tab-panel="ai">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between py-6 gap-4 mb-2">
                        <h2 class="text-xl md:text-2xl font-bold flex items-center gap-3 transition-colors">
                            <i class="fa-solid fa-wand-magic-sparkles text-primary-theme"></i>
                            <%= t('ai.title') %>
                        </h2>
                    </div>

                    <%# Driven by the script at the bottom of the page (ids kept): the fields stay
                        visible while it is off, since a key is entered before switching it on. %>
                    <div id="aiPanel" class="card-theme rounded-3xl shadow-sm transition-colors overflow-hidden">
                        <label class="flex items-start gap-4 p-6 md:p-8 cursor-pointer">
                            <span class="<%= cardIcon %>"><i class="fa-solid fa-wand-magic-sparkles text-lg" aria-hidden="true"></i></span>
                            <span class="flex-1 min-w-0">
                                <span class="block text-lg font-bold"><%= t('ai.enable') %></span>
                                <span class="block text-sm opacity-70 mt-1 leading-relaxed max-w-2xl"><%= t('ai.subtitle') %></span>
                            </span>
                            <span class="relative inline-flex items-center shrink-0 mt-1">
                                <input type="checkbox" id="aiEnabled" class="sr-only peer" aria-label="<%= t('ai.enable') %>">
                                <span class="<%= switchTrack %>"></span>
                            </span>
                        </label>

                        <div class="px-6 md:px-8 pb-6 md:pb-8 space-y-6">
                            <div id="aiFromEnvNotice"
                                class="hidden text-sm font-bold flex items-start gap-2 px-4 py-3 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400">
                                <%= t('ai.from_env') %>
                            </div>

                            <div class="grid sm:grid-cols-2 gap-6">
                                <div>
                                    <label for="aiProvider" class="<%= fieldLabel %>"><%= t('ai.provider') %></label>
                                    <select id="aiProvider" class="<%= textInput %> cursor-pointer"></select>
                                    <a id="aiGetKeyLink" href="#" target="_blank" rel="noopener"
                                        class="hidden mt-2 text-sm font-bold text-primary-theme hover:underline">
                                        <%= t('ai.get_key') %> <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                                    </a>
                                </div>

                                <div id="aiBaseUrlRow" class="hidden">
                                    <label for="aiBaseUrl" class="<%= fieldLabel %>"><%= t('ai.base_url') %></label>
                                    <input type="text" id="aiBaseUrl" placeholder="http://localhost:11434/v1" class="<%= textInput %> font-mono">
                                    <p class="text-sm opacity-60 mt-2"><%= t('ai.base_url_hint') %></p>
                                </div>

                                <div>
                                    <label for="aiModel" class="<%= fieldLabel %>"><%= t('ai.model') %></label>
                                    <input type="text" id="aiModel" class="<%= textInput %>">
                                </div>

                                <div>
                                    <label for="aiVisionModel" class="<%= fieldLabel %>"><%= t('ai.vision_model') %></label>
                                    <input type="text" id="aiVisionModel" class="<%= textInput %>">
                                    <p class="text-sm opacity-60 mt-2"><%= t('ai.vision_model_hint') %></p>
                                </div>

                                <div class="sm:col-span-2">
                                    <label for="aiApiKey" class="<%= fieldLabel %>"><%= t('ai.api_key') %></label>
                                    <div class="relative">
                                        <i class="fa-solid fa-key absolute left-4 top-1/2 -translate-y-1/2 text-sm opacity-40" aria-hidden="true"></i>
                                        <input type="password" id="aiApiKey" autocomplete="new-password" placeholder="<%= t('ai.api_key_hint') %>" class="<%= textInput %> pl-11">
                                    </div>
                                    <div id="aiKeySetLine" class="hidden flex items-center gap-3 text-sm mt-2">
                                        <i class="fa-solid fa-circle-check text-green-500" aria-hidden="true"></i>
                                        <span class="opacity-80 font-bold" id="aiKeyHintText"></span>
                                        <button type="button" id="aiClearKeyBtn" class="text-red-600 hover:underline font-bold"><%= t('ai.clear_key') %></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="border-t border-black/5 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] p-6 md:p-8 flex flex-col gap-4">
                            <div id="aiTestResult" class="hidden text-sm font-bold px-4 py-3 rounded-xl"></div>
                            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
                                <button type="button" id="aiTestBtn"
                                    class="flex items-center justify-center gap-2 bg-black/5 dark:bg-white/10 hover:brightness-110 px-5 py-3 rounded-xl text-sm font-bold transition-all active:scale-95">
                                    <i id="aiTestBtnIcon" class="fa-solid fa-bolt"></i><%= t('ai.test') %>
                                </button>
                                <button type="button" id="aiSaveBtn"
                                    class="flex items-center justify-center gap-2 bg-primary-theme hover:brightness-110 text-white px-5 py-3 rounded-xl text-sm font-bold shadow-lg shadow-primary-theme/20 transition-all active:scale-95">
                                    <i class="fa-solid fa-floppy-disk"></i><%= t('ai.save') %>
                                </button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ USERS ============ -->
                <section data-tab-panel="users">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between py-6 gap-4 mb-4">
                        <h2 class="text-xl md:text-2xl font-bold flex items-center gap-3 transition-colors">
                            <i class="fa-solid fa-users text-primary-theme"></i>
                            <%= t('admin.users_count', { count: users.length }) %>
                        </h2>
                        <button onclick="toggleModal('addUserModal')"
                            class="group relative flex items-center gap-3 bg-primary-theme hover:brightness-110 text-white px-5 py-3 rounded-2xl shadow-lg shadow-primary-theme/20 transition-all active:scale-95 overflow-hidden">
                            <div
                                class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform">
                            </div>
                            <i class="fa-solid fa-user-plus text-sm relative"></i>
                            <span class="text-xs font-black relative">
                                <%= t('admin.modal.title') %>
                            </span>
                        </button>
                    </div>

                    <div class="hidden md:block card-theme rounded-2xl overflow-hidden shadow-lg transition-colors">
                        <table class="w-full text-left text-sm opacity-80">
                            <thead class="bg-black/5 dark:bg-white/5 text-xs uppercase opacity-70 transition-colors">
                                <tr>
                                    <th class="px-6 py-4">
                                        <%= t('admin.table.user') %>
                                    </th>
                                    <th class="px-6 py-4">
                                        <%= t('admin.table.email') %>
                                    </th>
                                    <th class="px-6 py-4">
                                        <%= t('admin.instance.stat_collections') %>
                                    </th>
                                    <th class="px-6 py-4">
                                        <%= t('admin.table.home_collection') %>
                                    </th>
                                    <th class="px-6 py-4">
                                        <%= t('admin.table.last_change') %>
                                    </th>
                                    <th class="px-6 py-4 text-right">
                                        <%= t('admin.table.actions') %>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-black/5 dark:divide-white/5 transition-colors">
                                <% users.forEach(u=> {
                                    const memberOf = (locals.collections || []).filter(c => (c.members || []).some(m => String(m.user._id) === String(u._id)));
                                    // Instance admins are peers: hide destructive actions on OTHER admins.
                                    const isOtherAdmin = u.isAdmin && u._id.toString() !== user._id.toString();
                                %>
                                    <tr class="hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                                        <td class="px-6 py-4 font-medium flex items-center gap-3">
                                            <img src="<%= baseUrl + u.img %>"
                                                class="w-8 h-8 rounded-full border border-black/10 dark:border-white/10 object-cover">
                                            <%= u.username %>
                                            <% if (u.isAdmin) { %>
                                                <span class="text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-primary-theme/10 text-primary-theme">
                                                    <%= t('admin.instance.admin_badge') %>
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <%= u.email %>
                                        </td>
                                        <td class="px-6 py-4 text-xs opacity-70">
                                            <% if (memberOf.length > 0) { %>
                                                <%= memberOf.map(c => c.name).join(', ') %>
                                            <% } else { %>
                                                <span class="opacity-40">-</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <% if (memberOf.length > 0) { %>
                                                <form action="<%= baseUrl %>/admin/users/home-collection" method="POST">
                                                    <input type="hidden" name="userId" value="<%= u._id %>">
                                                    <select name="collectionId" onchange="this.form.submit()"
                                                        class="bg-black/5 dark:bg-white/5 border border-transparent text-xs rounded-lg focus:ring-primary-theme focus:border-primary-theme p-2 transition-colors outline-none cursor-pointer">
                                                        <option value="" class="bg-white dark:bg-[#1a1a1a]" <%=!u.homeCollectionId ? 'selected' : '' %>>
                                                            <%= t('admin.table.home_collection_last') %>
                                                        </option>
                                                        <% memberOf.forEach(c => { %>
                                                            <option value="<%= c._id %>" class="bg-white dark:bg-[#1a1a1a]"
                                                                <%=String(u.homeCollectionId)===String(c._id) ? 'selected' : '' %>>
                                                                <%= c.name %>
                                                            </option>
                                                        <% }) %>
                                                    </select>
                                                </form>
                                            <% } else { %>
                                                <span class="text-xs opacity-40">-</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 text-xs opacity-70">
                                            <%= new Date(u.lastChange).toLocaleDateString(dateLocaleFor(currentLng)) %>
                                        </td>
                                        <td class="px-6 py-4 text-right flex justify-end gap-2">
                                            <% if (!isOtherAdmin) { %>
                                            <form action="<%= baseUrl %>/admin/reset-password" method="POST"
                                                onsubmit="return confirm(<%= JSON.stringify(t('admin.confirm_reset', { name: u.username })) %>)">
                                                <input type="hidden" name="userId" value="<%= u._id %>">
                                                <button type="submit"
                                                    class="text-yellow-600 bg-yellow-100 dark:bg-yellow-500/10 p-2 rounded-lg transition-colors hover:brightness-110"
                                                    title="<%= t('admin.tooltips.reset_password') %>">
                                                    <i class="fa-solid fa-key"></i>
                                                </button>
                                            </form>
                                            <% } %>
                                            <% if (u._id.toString() !==user._id.toString() && !u.isAdmin) { %>
                                                <form action="<%= baseUrl %>/admin/delete-user" method="POST"
                                                    onsubmit="return confirm(<%= JSON.stringify(t('admin.confirm_delete_user', { name: u.username })) %>)">
                                                    <input type="hidden" name="userId" value="<%= u._id %>">
                                                    <button type="submit"
                                                        class="text-red-600 bg-red-100 dark:bg-red-500/10 p-2 rounded-lg transition-colors hover:brightness-110"
                                                        title="<%= t('admin.tooltips.delete') %>">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                                <% } %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <div class="md:hidden space-y-4">
                        <% users.forEach(u=> {
                            const isOtherAdmin = u.isAdmin && u._id.toString() !== user._id.toString();
                            const memberOf = (locals.collections || []).filter(c => (c.members || []).some(m => String(m.user._id) === String(u._id)));
                        %>
                            <div class="card-theme p-5 rounded-2xl shadow-sm space-y-4 transition-colors">
                                <div class="flex items-center gap-4">
                                    <img src="<%= baseUrl + u.img %>"
                                        class="w-12 h-12 rounded-full border border-black/10 dark:border-white/10 object-cover">
                                    <div class="overflow-hidden">
                                        <p class="font-bold truncate">
                                            <%= u.username %>
                                        </p>
                                        <p class="text-xs opacity-60 truncate">
                                            <%= u.email %>
                                        </p>
                                    </div>
                                </div>
                                <% if (memberOf.length > 0) { %>
                                    <form action="<%= baseUrl %>/admin/users/home-collection" method="POST"
                                        class="flex items-center justify-between gap-3 pt-4 border-t border-black/5 dark:border-white/5">
                                        <input type="hidden" name="userId" value="<%= u._id %>">
                                        <span class="text-[9px] opacity-50 uppercase font-bold tracking-wider">
                                            <%= t('admin.table.home_collection') %>
                                        </span>
                                        <select name="collectionId" onchange="this.form.submit()"
                                            class="bg-black/5 dark:bg-white/5 border border-transparent text-xs rounded-lg focus:ring-primary-theme focus:border-primary-theme p-2 transition-colors outline-none cursor-pointer">
                                            <option value="" class="bg-white dark:bg-[#1a1a1a]" <%=!u.homeCollectionId ? 'selected' : '' %>>
                                                <%= t('admin.table.home_collection_last') %>
                                            </option>
                                            <% memberOf.forEach(c => { %>
                                                <option value="<%= c._id %>" class="bg-white dark:bg-[#1a1a1a]"
                                                    <%=String(u.homeCollectionId)===String(c._id) ? 'selected' : '' %>>
                                                    <%= c.name %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </form>
                                <% } %>
                                <div
                                    class="flex items-center justify-between pt-4 border-t border-black/5 dark:border-white/5">
                                    <div class="flex flex-col">
                                        <span class="text-[9px] opacity-50 uppercase font-bold tracking-wider">
                                            <%= t('admin.table.last_change') %>
                                        </span>
                                        <span class="text-xs opacity-70">
                                            <%= new Date(u.lastChange).toLocaleDateString(dateLocaleFor(currentLng)) %>
                                        </span>
                                    </div>
                                    <div class="flex gap-2">
                                        <% if (!isOtherAdmin) { %>
                                        <form action="<%= baseUrl %>/admin/reset-password" method="POST"
                                            onsubmit="return confirm(<%= JSON.stringify(t('admin.confirm_reset', { name: u.username })) %>)">
                                            <input type="hidden" name="userId" value="<%= u._id %>">
                                            <button type="submit"
                                                class="text-yellow-600 bg-yellow-50 dark:bg-yellow-500/10 px-4 py-2 rounded-xl border border-yellow-200 dark:border-yellow-500/20 text-sm font-bold">
                                                <i class="fa-solid fa-key"></i>
                                            </button>
                                        </form>
                                        <% } %>
                                        <% if (u._id.toString() !==user._id.toString() && !u.isAdmin) { %>
                                            <form action="<%= baseUrl %>/admin/delete-user" method="POST"
                                                onsubmit="return confirm(<%= JSON.stringify(t('admin.confirm_delete_user', { name: u.username })) %>)">
                                                <input type="hidden" name="userId" value="<%= u._id %>">
                                                <button type="submit"
                                                    class="text-red-600 bg-red-50 dark:bg-red-500/10 px-4 py-2 rounded-xl border border-red-200 dark:border-red-500/20 text-sm font-bold">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                            <% } %>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </section>

                <!-- ============ INSTANCE BACKUP (whole instance, not a single collection) ============ -->
                <section data-tab-panel="backup">
                    <div class="flex items-center gap-4 mb-6">
                        <h2 class="text-xl font-bold flex items-center gap-2 transition-colors whitespace-nowrap">
                            <i class="fa-solid fa-database text-primary-theme"></i>
                            <%= t('admin.instance.backup_title') %>
                        </h2>
                        <div class="flex-grow border-t border-black/10 dark:border-white/10 transition-colors"></div>
                    </div>

                    <div class="card-theme rounded-3xl p-6 md:p-8 shadow-sm transition-colors border border-amber-500/20">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                            <div class="max-w-xl">
                                <h2 class="text-xl font-bold flex items-center gap-2 mb-2">
                                    <i class="fa-solid fa-server text-primary-theme"></i>
                                    <%= t('admin.instance.backup_title') %>
                                </h2>
                                <p class="text-sm opacity-60 mb-3">
                                    <%= t('admin.instance.backup_subtitle') %>
                                </p>
                                <p class="text-xs font-bold text-amber-600 dark:text-amber-400 flex items-start gap-2">
                                    <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
                                    <%= t('admin.instance.backup_warning') %>
                                </p>
                            </div>
                            <div class="flex flex-wrap gap-3">
                                <a href="<%= baseUrl %>/backup/export-archive"
                                    class="flex-1 sm:flex-none bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-6 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-file-zipper"></i>
                                    <%= t('admin.backup.export_zip_btn') %>
                                </a>
                                <a href="<%= baseUrl %>/backup/export"
                                    class="flex-1 sm:flex-none bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-6 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-file-code"></i>
                                    <%= t('admin.backup.export_json_btn') %>
                                </a>
                                <label
                                    class="flex-1 sm:flex-none bg-amber-500/10 text-amber-600 dark:text-amber-400 hover:bg-amber-500 hover:text-white px-6 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2 cursor-pointer">
                                    <i class="fa-solid fa-file-import"></i>
                                    <%= t('admin.backup.import_btn') %>
                                        <input type="file" id="backupInput" class="hidden" accept=".json,.zip,application/zip">
                                </label>
                            </div>
                        </div>
                    </div>

                    <% const bak = locals.backups || { enabled: false, frequency: 'daily', format: 'zip', keep: 7, files: [], folder: '', chosenFolder: '', defaultFolder: '', folderLocked: false, folderPersists: true };
                       const bakT = (key, params) => t('admin.instance.scheduled_backups.' + key, { ...params, interpolation: { escapeValue: false } });
                       const bakDate = (date) => new Date(date).toLocaleString(dateLocaleFor(currentLng), { dateStyle: 'medium', timeStyle: 'short' });
                       const bakSize = (bytes) => bytes >= 1048576 ? (bytes / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(bytes / 1024)) + ' KB'; %>
                    <div class="card-theme rounded-3xl shadow-sm transition-colors mt-6 overflow-hidden">
                        <form action="<%= baseUrl %>/admin/instance/backups" method="POST" data-save-bar data-toggle-card>
                            <label class="flex items-start gap-4 p-6 md:p-8 cursor-pointer">
                                <span class="w-12 h-12 rounded-2xl bg-primary-theme/10 text-primary-theme hidden sm:flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-clock-rotate-left text-lg" aria-hidden="true"></i>
                                </span>
                                <span class="flex-1 min-w-0">
                                    <span class="block text-lg font-bold"><%= bakT('title') %></span>
                                    <span class="block text-sm opacity-70 mt-1 leading-relaxed max-w-2xl"><%= bakT('toggle_desc') %></span>
                                </span>
                                <span class="relative inline-flex items-center shrink-0 mt-1" title="<%= bakT('toggle') %>">
                                    <input type="checkbox" name="enabled" <%= bak.enabled ? 'checked' : '' %> class="sr-only peer" aria-label="<%= bakT('toggle') %>" data-toggle-card-switch>
                                    <span class="<%= switchTrack %>"></span>
                                </span>
                            </label>

                            <div class="px-6 md:px-8 pb-6 md:pb-8 space-y-6 <%= bak.enabled ? '' : 'hidden' %>" data-toggle-card-body>
                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                                    <div>
                                        <span class="<%= fieldLabel %>"><%= bakT('frequency') %></span>
                                        <div class="flex flex-wrap gap-2">
                                            <% [['daily', 'fa-sun'], ['weekly', 'fa-calendar-week']].forEach(([value, icon]) => { %>
                                                <label class="relative">
                                                    <input type="radio" name="frequency" value="<%= value %>" class="sr-only peer" <%= bak.frequency === value ? 'checked' : '' %>>
                                                    <span class="<%= pill %> inline-flex items-center gap-2"><i class="fa-solid <%= icon %> text-xs" aria-hidden="true"></i><%= bakT(value) %></span>
                                                </label>
                                            <% }) %>
                                        </div>
                                    </div>
                                    <div>
                                        <label for="backupKeep" class="<%= fieldLabel %>"><%= bakT('keep') %></label>
                                        <div class="flex items-center gap-2" data-stepper>
                                            <button type="button" class="w-11 h-11 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 font-black text-lg" data-step="-1" aria-label="-">−</button>
                                            <input type="number" id="backupKeep" name="keep" min="1" max="90" value="<%= bak.keep %>"
                                                class="w-20 text-center bg-black/5 dark:bg-white/5 border border-transparent rounded-xl p-2.5 text-base font-bold outline-none focus:ring-2 focus:ring-primary-theme/40">
                                            <button type="button" class="w-11 h-11 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 font-black text-lg" data-step="1" aria-label="+">+</button>
                                        </div>
                                        <p class="text-sm opacity-60 mt-2"><%= bakT('keep_hint') %></p>
                                    </div>
                                </div>

                                <div>
                                    <span class="<%= fieldLabel %>"><%= bakT('format') %></span>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <% [['zip', 'fa-file-zipper'], ['json', 'fa-file-code']].forEach(([value, icon]) => { %>
                                            <label class="relative cursor-pointer">
                                                <input type="radio" name="format" value="<%= value %>" class="sr-only peer" <%= bak.format === value ? 'checked' : '' %>>
                                                <span class="flex items-start gap-3 h-full p-4 rounded-2xl border-2 border-black/5 dark:border-white/10 peer-checked:border-primary-theme peer-checked:bg-primary-theme/5 peer-focus-visible:ring-2 peer-focus-visible:ring-primary-theme/50 transition-colors">
                                                    <i class="fa-solid <%= icon %> text-xl text-primary-theme mt-0.5" aria-hidden="true"></i>
                                                    <span>
                                                        <span class="block text-sm font-bold"><%= bakT(value + '_title') %></span>
                                                        <span class="block text-sm opacity-60 mt-0.5"><%= bakT(value + '_desc') %></span>
                                                    </span>
                                                </span>
                                            </label>
                                        <% }) %>
                                    </div>
                                </div>

                                <div>
                                    <label for="backupFolder" class="<%= fieldLabel %>"><%= bakT('folder') %></label>
                                    <div class="relative">
                                        <i class="fa-solid fa-folder-open absolute left-4 top-1/2 -translate-y-1/2 text-sm opacity-40" aria-hidden="true"></i>
                                        <input type="text" id="backupFolder" name="folder" spellcheck="false" autocapitalize="none" autocorrect="off"
                                            value="<%= bak.folderLocked ? bak.folder : bak.chosenFolder %>" placeholder="<%= bak.defaultFolder %>" <%= bak.folderLocked ? 'disabled' : '' %>
                                            class="w-full font-mono bg-black/5 dark:bg-white/5 border border-transparent rounded-xl py-3 pl-11 pr-4 text-sm outline-none focus:ring-2 focus:ring-primary-theme/40 disabled:opacity-60 disabled:cursor-not-allowed">
                                    </div>
                                    <p class="text-sm opacity-60 mt-2 leading-relaxed max-w-3xl"><%= bakT(bak.folderLocked ? 'folder_locked' : 'folder_hint') %></p>
                                    <% if (!bak.folderPersists) { %>
                                        <p class="text-sm font-bold text-amber-600 dark:text-amber-400 flex items-start gap-2 mt-3 p-3 rounded-xl bg-amber-500/10">
                                            <i class="fa-solid fa-triangle-exclamation mt-0.5" aria-hidden="true"></i><%= bakT('folder_not_mounted') %>
                                        </p>
                                    <% } %>
                                </div>

                                <p class="text-sm flex items-start gap-3 p-4 rounded-2xl bg-black/5 dark:bg-white/5">
                                    <i class="fa-solid fa-lock text-primary-theme mt-0.5" aria-hidden="true"></i>
                                    <span class="opacity-80"><%= bakT('folder_private') %></span>
                                </p>
                            </div>
                        </form>

                        <div class="border-t border-black/5 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] p-6 md:p-8 space-y-5">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                <div class="flex items-start gap-3 min-w-0">
                                    <% if (bak.running) { %>
                                        <i class="fa-solid fa-circle-notch fa-spin text-primary-theme text-lg mt-0.5" aria-hidden="true"></i>
                                        <p class="text-sm font-bold text-primary-theme"><%= bakT('running') %></p>
                                    <% } else if (bak.lastError) { %>
                                        <i class="fa-solid fa-circle-xmark text-red-500 text-lg mt-0.5" aria-hidden="true"></i>
                                        <div class="min-w-0">
                                            <p class="text-sm font-bold text-red-600 dark:text-red-400 break-words"><%= bakT('last_error', { date: bakDate(bak.lastAttemptAt), error: bak.lastError }) %></p>
                                            <% if (bak.lastSuccessAt) { %><p class="text-sm opacity-60 mt-1"><%= bakT('last_success', { date: bakDate(bak.lastSuccessAt), size: bakSize(bak.lastSize) }) %></p><% } %>
                                        </div>
                                    <% } else if (bak.lastSuccessAt) { %>
                                        <i class="fa-solid fa-circle-check text-green-500 text-lg mt-0.5" aria-hidden="true"></i>
                                        <p class="text-sm font-semibold"><%= bakT('last_success', { date: bakDate(bak.lastSuccessAt), size: bakSize(bak.lastSize) }) %></p>
                                    <% } else { %>
                                        <i class="fa-regular fa-circle text-lg opacity-40 mt-0.5" aria-hidden="true"></i>
                                        <p class="text-sm opacity-70"><%= bakT('never') %></p>
                                    <% } %>
                                </div>
                                <form action="<%= baseUrl %>/admin/instance/backups/run" method="POST" class="shrink-0">
                                    <button type="submit" <%= bak.running ? 'disabled' : '' %>
                                        class="w-full sm:w-auto flex items-center justify-center gap-2 bg-primary-theme text-white hover:brightness-110 disabled:opacity-50 px-5 py-3 rounded-xl text-sm font-bold shadow-lg shadow-primary-theme/20 transition-all active:scale-95">
                                        <i class="fa-solid fa-play" aria-hidden="true"></i><%= bakT('run_now') %>
                                    </button>
                                </form>
                            </div>

                            <% if (bak.files.length > 0) { %>
                                <div>
                                    <p class="text-sm font-bold mb-2"><%= bakT('files') %></p>
                                    <ul class="rounded-2xl bg-black/5 dark:bg-white/5 divide-y divide-black/5 dark:divide-white/5 overflow-hidden">
                                        <% bak.files.forEach(file => { %>
                                            <li class="flex items-center gap-3 px-4 py-3">
                                                <i class="fa-solid <%= /\.zip$/i.test(file.name) ? 'fa-file-zipper' : 'fa-file-code' %> opacity-50" aria-hidden="true"></i>
                                                <span class="font-mono text-sm truncate min-w-0 flex-1"><%= file.name %></span>
                                                <span class="text-sm opacity-60 shrink-0"><%= bakSize(file.size) %></span>
                                                <a href="<%= baseUrl %>/admin/instance/backups/<%= file.name %>" title="<%= bakT('download') %>" aria-label="<%= bakT('download') %>"
                                                    class="shrink-0 w-9 h-9 rounded-xl flex items-center justify-center text-primary-theme hover:bg-primary-theme hover:text-white transition-colors">
                                                    <i class="fa-solid fa-download" aria-hidden="true"></i>
                                                </a>
                                            </li>
                                        <% }) %>
                                    </ul>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <%# Copies of the images items link to (#136): what makes a backup carry
                        every picture, not only the uploaded ones. %>
                    <% const imgDl = locals.imageDownload || { enabled: false }; %>
                    <div class="card-theme rounded-3xl shadow-sm transition-colors mt-6 overflow-hidden">
                        <form action="<%= baseUrl %>/admin/instance/images" method="POST" data-save-bar>
                            <label class="flex items-start gap-4 p-6 md:p-8 cursor-pointer">
                                <span class="w-12 h-12 rounded-2xl bg-primary-theme/10 text-primary-theme hidden sm:flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-images text-lg" aria-hidden="true"></i>
                                </span>
                                <span class="flex-1 min-w-0">
                                    <span class="block text-lg font-bold"><%= t('image_download.toggle') %></span>
                                    <span class="block text-sm opacity-70 mt-1 leading-relaxed max-w-2xl"><%= t('image_download.toggle_desc') %></span>
                                </span>
                                <span class="relative inline-flex items-center shrink-0 mt-1">
                                    <input type="checkbox" name="enabled" <%= imgDl.enabled ? 'checked' : '' %> class="sr-only peer" aria-label="<%= t('image_download.toggle') %>">
                                    <span class="<%= switchTrack %>"></span>
                                </span>
                            </label>
                        </form>
                        <div class="border-t border-black/5 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] p-6 md:p-8">
                            <p class="text-sm font-bold"><%= t('image_download.existing_title') %></p>
                            <p class="text-sm opacity-60 mt-1 mb-4 max-w-2xl"><%= t('image_download.existing_desc') %></p>
                            <%- include('partials/image-download-run', { statusUrl: '/admin/instance/images', runUrl: '/admin/instance/images/run' }) %>
                        </div>
                    </div>

                </section>

                <!-- ============ UPDATES ============ -->
                <section data-tab-panel="updates">
                    <% const upd = locals.updates || { enabled: false, current: appVersion, available: false }; %>
                    <div class="flex items-center gap-4 mb-6">
                        <h2 class="text-xl font-bold flex items-center gap-2 transition-colors whitespace-nowrap">
                            <i class="fa-solid fa-rocket text-primary-theme"></i>
                            <%= t('admin.instance.updates.title') %>
                        </h2>
                        <div class="flex-grow border-t border-black/10 dark:border-white/10 transition-colors"></div>
                    </div>

                    <div class="card-theme rounded-3xl shadow-sm transition-colors overflow-hidden">
                        <form action="<%= baseUrl %>/admin/instance/updates" method="POST" data-save-bar>
                            <label class="flex items-start gap-4 p-6 md:p-8 cursor-pointer">
                                <span class="<%= cardIcon %>"><i class="fa-solid fa-rocket text-lg" aria-hidden="true"></i></span>
                                <span class="flex-1 min-w-0">
                                    <span class="block text-lg font-bold"><%= t('admin.instance.updates.toggle') %></span>
                                    <span class="block text-sm opacity-70 mt-1 leading-relaxed max-w-2xl"><%= t('admin.instance.updates.toggle_desc') %></span>
                                </span>
                                <span class="relative inline-flex items-center shrink-0 mt-1">
                                    <input type="checkbox" name="enabled" <%= upd.enabled ? 'checked' : '' %> class="sr-only peer" aria-label="<%= t('admin.instance.updates.toggle') %>">
                                    <span class="<%= switchTrack %>"></span>
                                </span>
                            </label>
                        </form>
                        <div class="border-t border-black/5 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] p-6 md:p-8">
                            <% if (upd.available) { %>
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                    <div class="flex items-start gap-3">
                                        <i class="fa-solid fa-circle-up text-primary-theme text-lg mt-0.5" aria-hidden="true"></i>
                                        <p class="text-sm font-bold"><%= t('admin.instance.updates.available', { version: upd.latest, current: upd.current }) %></p>
                                    </div>
                                    <a href="<%= upd.url %>" target="_blank" rel="noopener noreferrer"
                                        class="shrink-0 flex items-center justify-center gap-2 bg-primary-theme hover:brightness-110 text-white px-5 py-3 rounded-xl text-sm font-bold shadow-lg shadow-primary-theme/20">
                                        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i><%= t('admin.instance.updates.release_notes') %>
                                    </a>
                                </div>
                            <% } else { %>
                                <div class="flex items-start gap-3">
                                    <i class="fa-solid <%= upd.enabled && upd.checkedAt ? 'fa-circle-check text-green-500' : 'fa-circle-info opacity-40' %> text-lg mt-0.5" aria-hidden="true"></i>
                                    <p class="text-sm">
                                        <span class="font-semibold"><%= t('admin.instance.updates.running', { version: upd.current }) %></span>
                                        <% if (upd.enabled && upd.checkedAt) { %>
                                            <% const checked = new Date(upd.checkedAt).toLocaleString(dateLocaleFor(currentLng), { dateStyle: 'medium', timeStyle: 'short' }); %>
                                            <span class="block opacity-60 mt-0.5"><%= t('admin.instance.updates.checked_up_to_date', { date: checked }) %></span>
                                        <% } %>
                                    </p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </section>

                <!-- ============ BLOCKED IPS ============ -->
                <section data-tab-panel="security">
                    <h2 class="text-xl font-bold mb-6 flex items-center gap-2 transition-colors">
                        <i class="fa-solid fa-ban text-red-500"></i>
                        <%= t('admin.blocked_ips_title', { count: blockedIps.length }) %>
                    </h2>
                    <% if(blockedIps.length> 0) { %>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                            <% blockedIps.forEach(ip=> { %>
                                <div
                                    class="card-theme p-5 rounded-2xl flex justify-between items-center group hover:border-red-500/50 transition-colors shadow-sm">
                                    <div class="overflow-hidden">
                                        <span class="block font-mono font-bold truncate">
                                            <%= ip.ip %>
                                        </span>
                                        <span class="text-[10px] opacity-50 uppercase tracking-tighter">
                                            <%= new Date(ip.createdAt).toLocaleDateString(dateLocaleFor(currentLng)) %>
                                        </span>
                                    </div>
                                    <form action="<%= baseUrl %>/admin/unblock-ip" method="POST">
                                        <input type="hidden" name="ipId" value="<%= ip._id %>">
                                        <button type="submit"
                                            class="h-10 w-10 flex items-center justify-center bg-black/5 dark:bg-white/5 opacity-60 hover:text-green-500 hover:opacity-100 rounded-xl transition-colors"
                                            title="<%= t('admin.tooltips.unblock') %>">
                                            <i class="fa-solid fa-lock-open"></i>
                                        </button>
                                    </form>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div
                                class="p-12 border-2 border-dashed border-black/10 dark:border-white/10 rounded-3xl text-center opacity-50 transition-colors">
                                <i class="fa-solid fa-shield-check text-4xl mb-3 opacity-30 block"></i>
                                <%= t('admin.no_blocked_ips') %>
                            </div>
                            <% } %>
                </section>

                <!-- ============ LOGIN LOGS ============ -->
                <section data-tab-panel="logs">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
                        <h2 class="text-xl font-bold flex items-center gap-2 transition-colors">
                            <i class="fa-solid fa-satellite-dish text-primary-theme"></i>
                            <%= t('admin.logs_title') %>
                        </h2>
                        <div class="flex items-center gap-3">
                            <div class="md:hidden text-[10px] uppercase font-bold opacity-50 flex items-center gap-1">
                                <i class="fa-solid fa-left-right animate-pulse"></i> Scroll
                            </div>
                            <div class="flex items-center gap-2">
                                <input type="number" id="deleteLogsCount" min="1" placeholder="<%= t('admin.logs_delete_last.count_placeholder') %>"
                                    class="w-24 bg-black/5 dark:bg-white/5 rounded-xl px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-red-500/30">
                                <button onclick="confirmDeleteLastLogs()"
                                    class="flex items-center gap-2 bg-red-500/10 hover:bg-red-500 text-red-500 hover:text-white border border-red-500/20 hover:border-red-500 font-black text-xs px-4 py-2 rounded-xl transition-all active:scale-95"
                                    title="<%= t('admin.logs_delete_last.btn') %>">
                                    <i class="fa-solid fa-trash"></i>
                                    <span class="hidden sm:inline"><%= t('admin.logs_delete_last.btn') %></span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card-theme rounded-2xl overflow-hidden shadow-lg transition-colors">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm opacity-80 min-w-[700px]">
                                <thead
                                    class="bg-black/5 dark:bg-white/5 text-xs uppercase opacity-70 transition-colors">
                                    <tr>
                                        <th class="px-6 py-4">
                                            <%= t('admin.table.user') %>
                                        </th>
                                        <th class="px-6 py-4">
                                            <%= t('admin.table.loc') %>
                                        </th>
                                        <th class="px-6 py-4">
                                            <%= t('admin.table.ip_device') %>
                                        </th>
                                        <th class="px-6 py-4">
                                            <%= t('admin.table.date') %>
                                        </th>
                                        <th class="px-6 py-4 text-right">
                                            <%= t('admin.table.security') %>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-black/5 dark:divide-white/5 transition-colors">
                                    <% logs.forEach(log=> { %>
                                        <tr class="hover:bg-black/5 dark:hover:bg-white/5 transition-colors group">
                                            <td class="px-6 py-4">
                                                <div class="font-bold">
                                                    <%= log.username %>
                                                </div>
                                                <div class="text-[10px] opacity-60 truncate">
                                                    <%= log.email %>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4">
                                                <% if(log.country && log.country !=='XX' ) { %>
                                                    <div class="flex items-center gap-2">
                                                        <img src="https://flagcdn.com/24x18/<%= log.country.toLowerCase() %>.png"
                                                            class="rounded-sm shadow-sm" alt="Flag">
                                                        <span class="font-mono text-xs">
                                                            <%= log.country %>
                                                        </span>
                                                    </div>
                                                    <div class="text-[10px] opacity-60 uppercase">
                                                        <%= log.city %>
                                                    </div>
                                                    <% } else { %>
                                                        <span class="opacity-50 text-xs"><i
                                                                class="fa-solid fa-globe"></i>
                                                            <%= t('admin.local_connection') %>
                                                        </span>
                                                        <% } %>
                                            </td>
                                            <td class="px-6 py-4">
                                                <div class="text-primary-theme font-mono text-xs mb-1">
                                                    <%= log.ip %>
                                                </div>
                                                <div class="text-[10px] opacity-60 max-w-[120px] truncate"
                                                    title="<%= log.userAgent %>">
                                                    <%= log.userAgent.includes('Windows') ? 'Windows' :
                                                        (log.userAgent.includes('Mac') ? 'Mac' : 'Mobile/Linux' ) %>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 text-[10px] whitespace-nowrap">
                                                <% const diff=Math.floor((new Date() - new Date(log.timestamp)) /
                                                    60000); let timeText=diff < 60 ? t('admin.time_ago_min', { count:
                                                    diff }) : new
                                                    Date(log.timestamp).toLocaleDateString(dateLocaleFor(currentLng)); %>
                                                    <%= timeText %>
                                            </td>
                                            <td class="px-6 py-4 text-right">
                                                <div class="flex justify-end gap-2 opacity-100 transition-opacity">
                                                    <% if (log.user) { %>
                                                        <form action="<%= baseUrl %>/admin/reset-password" method="POST"
                                                            onsubmit="return confirm(<%= JSON.stringify(t('admin.confirm_reset', { name: log.username })) %>)">
                                                            <input type="hidden" name="userId" value="<%= log.user %>">
                                                            <button type="submit"
                                                                class="bg-black/5 dark:bg-white/5 hover:bg-yellow-500 hover:text-white p-2 rounded-xl border border-transparent transition-colors"
                                                                title="<%= t('admin.tooltips.reset_password') %>">
                                                                <i class="fa-solid fa-key"></i>
                                                            </button>
                                                        </form>
                                                        <% } %>
                                                            <form action="<%= baseUrl %>/admin/block-ip" method="POST"
                                                                onsubmit="return confirm(<%= JSON.stringify(t('admin.confirm_block_ip', { ip: log.ip })) %>)">
                                                                <input type="hidden" name="ipAddress"
                                                                    value="<%= log.ip %>">
                                                                <button type="submit"
                                                                    class="bg-black/5 dark:bg-white/5 hover:bg-red-600 hover:text-white p-2 rounded-xl border border-transparent transition-colors"
                                                                    title="<%= t('admin.tooltips.block') %>">
                                                                    <i class="fa-solid fa-ban"></i>
                                                                </button>
                                                            </form>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

    </div>

