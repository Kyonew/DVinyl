    <%- include('partials/footer') %>

        <script>
            function toggleModal(id) {
                const modal = document.getElementById(id);
                modal.classList.toggle('hidden');
                document.body.style.overflow = modal.classList.contains('hidden') ? 'auto' : 'hidden';
            }

            async function confirmDeleteLastLogs() {
                const count = parseInt(document.getElementById('deleteLogsCount')?.value);
                if (!count || count < 1) return;

                const message = <%- JSON.stringify(t('admin.logs_delete_last.confirm')) %>.replace('{{count}}', count);
                if (!confirm(message)) return;

                try {
                    const response = await fetch('<%= baseUrl %>/admin/delete-last-logs', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ count })
                    });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.error || 'Erreur');
                    window.location.reload();
                } catch (err) {
                    alert(err.message);
                }
            }

            // A settings card shows its settings once its switch is on; they are still posted
            // while hidden, so turning it off keeps them for later. A stepper moves its number
            // within the input's bounds.
            document.querySelectorAll('[data-toggle-card]').forEach(card => {
                const toggle = card.querySelector('[data-toggle-card-switch]');
                const body = card.querySelector('[data-toggle-card-body]');
                if (toggle && body) toggle.addEventListener('change', () => body.classList.toggle('hidden', !toggle.checked));
            });
            document.querySelectorAll('[data-stepper]').forEach(stepper => {
                const input = stepper.querySelector('input[type="number"]');
                stepper.querySelectorAll('[data-step]').forEach(button => button.addEventListener('click', () => {
                    const next = Math.min(Number(input.max) || 100, Math.max(Number(input.min) || 1, (Number(input.value) || 0) + Number(button.dataset.step)));
                    input.value = String(next);
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                }));
            });

            // ---- AI assist panel ----
            (function () {
                const panel = document.getElementById('aiPanel');
                if (!panel) return;

                const enabledEl = document.getElementById('aiEnabled');
                const providerEl = document.getElementById('aiProvider');
                const baseUrlRow = document.getElementById('aiBaseUrlRow');
                const baseUrlEl = document.getElementById('aiBaseUrl');
                const modelEl = document.getElementById('aiModel');
                const visionModelEl = document.getElementById('aiVisionModel');
                const apiKeyEl = document.getElementById('aiApiKey');
                const keySetLine = document.getElementById('aiKeySetLine');
                const keyHintText = document.getElementById('aiKeyHintText');
                const clearKeyBtn = document.getElementById('aiClearKeyBtn');
                const getKeyLink = document.getElementById('aiGetKeyLink');
                const fromEnvNotice = document.getElementById('aiFromEnvNotice');
                const testBtn = document.getElementById('aiTestBtn');
                const testBtnIcon = document.getElementById('aiTestBtnIcon');
                const saveBtn = document.getElementById('aiSaveBtn');
                const testResult = document.getElementById('aiTestResult');

                let providers = [];
                let pendingClear = false;

                function setDisabled(disabled) {
                    // enabledEl is deliberately excluded: even when the rest of the panel is
                    // locked by an env-provided config, the toggle must stay clickable so a
                    // key-less local-endpoint env config (no AI_API_KEY) can still be turned
                    // on by hand: resolveCandidate() only force-enables when an env key is
                    // present, so without this the toggle would be the only way to flip
                    // `enabled` and it would be stuck disabled.
                    [providerEl, baseUrlEl, modelEl, visionModelEl, apiKeyEl, clearKeyBtn, saveBtn, testBtn]
                        .forEach(el => { if (el) el.disabled = disabled; });
                }

                function syncProviderFields() {
                    const preset = providers.find(p => p.id === providerEl.value);
                    baseUrlRow.classList.toggle('hidden', providerEl.value !== 'custom');
                    if (preset && preset.docsUrl) {
                        getKeyLink.href = preset.docsUrl;
                        getKeyLink.classList.remove('hidden');
                    } else {
                        getKeyLink.classList.add('hidden');
                    }
                }

                function showResult(el, ok, text) {
                    el.textContent = text;
                    el.classList.remove('hidden', 'bg-green-500/10', 'text-green-600', 'bg-red-500/10', 'text-red-600');
                    el.classList.add(ok ? 'bg-green-500/10' : 'bg-red-500/10', ok ? 'text-green-600' : 'text-red-600');
                }

                async function loadAiSettings() {
                    const response = await fetch('<%= baseUrl %>/admin/instance/ai');
                    if (!response.ok) return;
                    const data = await response.json();

                    providers = data.providers || [];
                    providerEl.innerHTML = providers.map(p => `<option value="${p.id}" class="bg-white dark:bg-[#1a1a1a]">${p.label}</option>`).join('');

                    enabledEl.checked = data.enabled;
                    providerEl.value = data.provider;
                    baseUrlEl.value = data.baseUrl || '';
                    modelEl.value = data.model || '';
                    visionModelEl.value = data.visionModel || '';
                    apiKeyEl.value = '';

                    if (data.hasKey) {
                        keyHintText.textContent = <%- JSON.stringify(t('ai.api_key_set', { hint: '__HINT__' })) %>.replace('__HINT__', data.keyHint);
                        keySetLine.classList.remove('hidden');
                    } else {
                        keySetLine.classList.add('hidden');
                    }

                    syncProviderFields();
                    fromEnvNotice.classList.toggle('hidden', !data.fromEnv);
                    setDisabled(data.fromEnv);
                }

                providerEl.addEventListener('change', () => {
                    syncProviderFields();
                    const preset = providers.find(p => p.id === providerEl.value);
                    // A custom endpoint has no default, and a hosted provider's model ids mean
                    // nothing to it: the vision model would otherwise be saved as one.
                    if (preset) {
                        modelEl.value = preset.defaultModel;
                        visionModelEl.value = preset.defaultVisionModel;
                    }
                });

                clearKeyBtn.addEventListener('click', () => {
                    pendingClear = true;
                    apiKeyEl.value = '';
                    keySetLine.classList.add('hidden');
                });

                // If the user clears the key and then types/pastes a new one, that new
                // input supersedes the pending clear, otherwise the save would still send
                // the clear sentinel and silently discard what they just typed.
                apiKeyEl.addEventListener('input', () => {
                    pendingClear = false;
                });

                async function persistAiSettings() {
                    testResult.classList.add('hidden');
                    try {
                        const response = await fetch('<%= baseUrl %>/admin/instance/ai', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                enabled: enabledEl.checked,
                                provider: providerEl.value,
                                baseUrl: baseUrlEl.value,
                                model: modelEl.value,
                                visionModel: visionModelEl.value,
                                apiKey: pendingClear ? '__clear__' : apiKeyEl.value
                            })
                        });
                        const data = await response.json();
                        if (!response.ok || !data.success) throw new Error(data.error || 'Error');
                        pendingClear = false;
                        showResult(testResult, true, <%- JSON.stringify(t('ai.saved')) %>);
                        await loadAiSettings();
                    } catch (err) {
                        showResult(testResult, false, err.message);
                    }
                }

                saveBtn.addEventListener('click', persistAiSettings);

                // The enable toggle is the one field a user expects to take effect the
                // moment they flip it, without a separate Save click; every other field
                // still needs Save since typing a key/model is not itself a decision to commit.
                enabledEl.addEventListener('change', persistAiSettings);

                testBtn.addEventListener('click', async () => {
                    testBtn.disabled = true;
                    testBtn.classList.add('opacity-50', 'cursor-not-allowed');
                    testBtnIcon.className = 'fa-solid fa-spinner fa-spin text-sm';
                    try {
                        // Tests whatever is currently in the form, not the saved config, so a
                        // freshly typed/pasted key can be tried before deciding to Save it. A
                        // blank apiKey field falls back to the already-stored key server-side.
                        const response = await fetch('<%= baseUrl %>/admin/instance/ai/test', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                provider: providerEl.value,
                                baseUrl: baseUrlEl.value,
                                model: modelEl.value,
                                visionModel: visionModelEl.value,
                                apiKey: pendingClear ? '' : apiKeyEl.value
                            })
                        });
                        const data = await response.json();
                        if (!response.ok || !data.success) throw new Error(data.error || 'Error');
                        showResult(testResult, true, <%- JSON.stringify(t('ai.test_ok', { model: '__MODEL__' })) %>.replace('__MODEL__', data.model));
                    } catch (err) {
                        showResult(testResult, false, <%- JSON.stringify(t('ai.test_failed', { error: '__ERROR__' })) %>.replace('__ERROR__', err.message));
                    } finally {
                        testBtn.disabled = false;
                        testBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                        testBtnIcon.className = 'fa-solid fa-bolt text-sm';
                    }
                });

                loadAiSettings();
            })();

            document.getElementById('backupInput').onchange = function (e) {
                const file = e.target.files[0];
                if (!file) return;
                if (confirm(<%- JSON.stringify(t('admin.instance.backup_confirm_import')) %>)) {
                    (async () => {
                        try {
                            const isArchive = file.name.toLowerCase().endsWith('.zip');
                            let response;
                            if (isArchive) {
                                const form = new FormData();
                                form.append('backup', file);
                                response = await fetch('<%= baseUrl %>/backup/import-archive', { method: 'POST', body: form });
                            } else {
                                const backupData = JSON.parse(await file.text());
                                response = await fetch('<%= baseUrl %>/backup/import', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(backupData)
                                });
                            }
                            if (response.ok) {
                                const result = await response.json();
                                alert(result.warning || <%- JSON.stringify(t('admin.backup.import_success')) %>);
                                window.location.href = '<%= baseUrl %>/login';
                            } else {
                                // A refusal worded for the reader (a collection backup
                                // posted here) says what to do instead.
                                const failure = await response.json().catch(() => ({}));
                                alert(failure.userMessage || <%- JSON.stringify(t('admin.backup.import_error')) %>);
                            }
                        } catch (err) {
                            alert(<%- JSON.stringify(t('admin.backup.file_error')) %>);
                        }
                    })();
                }
                this.value = '';
            };
        </script>
