<%# Scroll restoration, shared by the collection and wishlist pages.
    Back from an item's page, the listing reopens on the right page and filters (they
    are in the URL) but at the top. Opening an item from the results records the scroll
    offset, the listing URL and the item id; coming back to that same URL puts the
    offset back, the way the browser's own Back button does. When the layout reflowed
    in between (a rotated phone, another column count) and the offset no longer shows
    the item, the item is centered instead.
    Generic over the active view: anything under #shelfResults that carries a
    data-item-id (grid card, table row, shelf spine) and leads to the item counts. %>
<script>
(function () {
    var KEY = 'shelfReturn';
    var shelfResults = document.getElementById('shelfResults');
    if (!shelfResults) return;

    function currentListUrl() { return location.pathname + location.search; }
    function forget() { try { sessionStorage.removeItem(KEY); } catch (err) {} }

    // Listened for on the document, and registered after the views' own handlers, so a
    // click one of them turned into something else (a selection, the shelf's sheet) is
    // already marked as handled when it gets here and leaves nothing behind.
    document.addEventListener('click', function (e) {
        if (e.defaultPrevented || !shelfResults.contains(e.target)) return;
        var item = e.target.closest('[data-item-id]');
        var link = e.target.closest('a[href]');
        if (!item || !link || !item.contains(link)) return;
        try {
            sessionStorage.setItem(KEY, JSON.stringify({
                url: currentListUrl(),
                y: window.scrollY || 0,
                id: item.getAttribute('data-item-id') || ''
            }));
        } catch (err) {}
    });

    function restore() {
        var saved;
        try { saved = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (err) { saved = null; }
        // Read once: whichever listing loads next consumes it, so a record nobody came
        // back for cannot fire later on an unrelated visit to the same URL.
        forget();
        if (!saved || saved.url !== currentListUrl()) return;

        var maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        window.scrollTo(0, Math.min(saved.y || 0, maxY));

        // The item may be gone (deleted, moved to the other list, sorted onto another
        // page): the offset alone is then the best guess. Partly on screen counts as
        // shown, since the item tapped was often cut by an edge of the screen.
        var item = saved.id ? shelfResults.querySelector('[data-item-id="' + CSS.escape(saved.id) + '"]') : null;
        if (!item) return;
        var r = item.getBoundingClientRect();
        if (r.bottom <= 0 || r.top >= window.innerHeight) item.scrollIntoView({ block: 'center' });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', restore);
    } else {
        restore();
    }

    // Back to a page kept in the browser's cache: the browser put the scroll back
    // itself and this script did not run again, so the record is dropped here.
    window.addEventListener('pageshow', function (e) {
        if (e.persisted) forget();
    });
})();
</script>
