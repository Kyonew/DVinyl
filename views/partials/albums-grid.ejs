<%# Item grid shared by the home, collection and wishlist pages.
    Params: albums, and optionally
      size            typography of the card body ('collection' | 'wishlist' | 'home')
      gridClass       column classes, defaults to the collection grid
      gridId          id set on the grid element
      wishlist        adds the "received it" button under each card
      badgeSize       forwarded to cover-badge ('compact' for the tighter cards)
      reserveExtraRow keeps the decorated row's height so cards stay aligned

    The tile ratio is the collection-wide setting: the grid stays uniform whatever
    it holds, and a plugin's own ratio only shows on its detail page and forms.
    The tile itself lives in item-cover, shared with the cross-collection search. %>
<%
    const gridAspect = (locals.settings && settings.aspectRatioClass) || 'aspect-square';
    const gridClass = locals.gridClass || 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5';
    const cardSize = locals.size || 'collection';
    const showReceived = locals.wishlist === true && locals.canEditCollection;
%>
<div class="grid <%= gridClass %> gap-4 md:gap-6" <% if (locals.gridId) { %>id="<%= locals.gridId %>"<% } %>>
    <% albums.forEach(album => { %>
        <%
            const itemPlugin = registry.getByKind(album.kind);
            const routePrefix = itemPlugin ? itemPlugin.routePrefix : '/album';
        %>
        <div class="album-card group relative card-theme rounded-xl overflow-hidden hover:border-primary-theme transition-all duration-300 hover:shadow-lg hover:-translate-y-1 flex flex-col justify-between"
            data-location="<%= locals.isShareView ? '' : (album.location || '') %>"
            data-format="<%= album.format || album.media_type || '' %>"
            <% if (locals.selectable) { %>data-id="<%= album._id %>"<% } %>>
            <% if (locals.selectable) { %>
                <div class="select-checkbox-overlay hidden absolute top-2 left-2 z-20 items-center justify-center w-6 h-6 rounded-md bg-white/90 dark:bg-black/70 border border-black/10 dark:border-white/20 shadow">
                    <input type="checkbox" class="album-select-checkbox w-[18px] h-[18px] accent-primary-theme cursor-pointer">
                </div>
            <% } %>
            <a href="<%= baseUrl + routePrefix %>/<%= album._id %>" class="block flex-grow">
                <%- include('item-cover', { item: album, plugin: itemPlugin, gridAspect, settings, badgeSize: locals.badgeSize || '' }) %>
                <%- include('item-card-body', { item: album, plugin: itemPlugin, size: cardSize, reserveExtraRow: locals.reserveExtraRow === true }) %>
            </a>
            <% if (showReceived) { %>
                <button onclick="moveToCollection('<%= album._id %>', '<%= routePrefix %>')"
                    class="w-full py-2.5 md:py-2 bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white text-primary-theme text-[10px] md:text-xs font-bold uppercase transition-colors flex items-center justify-center gap-1.5 border-t border-black/10 dark:border-white/10 active:brightness-90 mt-auto">
                    <i class="fa-solid fa-check"></i>
                    <span><%= t('wishlist.btn_received') %></span>
                </button>
            <% } %>
        </div>
    <% }) %>
</div>
