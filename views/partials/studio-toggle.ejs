<%# A switch row of the Personnalisation studio's panel: `name`, `checked`, `title`, `desc`. %>
<label class="flex items-center justify-between gap-3 p-3 rounded-xl bg-black/5 dark:bg-white/5 cursor-pointer">
    <span class="min-w-0">
        <span class="block text-sm font-bold"><%= title %></span>
        <% if (locals.desc) { %><span class="block text-xs opacity-50 mt-0.5"><%= desc %></span><% } %>
    </span>
    <span class="relative inline-flex items-center shrink-0">
        <input type="checkbox" name="<%= name %>" class="sr-only peer" <%= checked ? 'checked' : '' %>>
        <span class="w-10 h-6 bg-black/10 dark:bg-white/10 rounded-full peer peer-checked:after:translate-x-4 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-theme"></span>
    </span>
</label>
