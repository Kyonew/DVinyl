<%#
  Card body shared by every grid (collection, wishlist, dashboard).
  Params: item, plugin, size ('collection' | 'wishlist' | 'home'),
          reserveExtraRow (keeps the decorated row's height even when empty, so a grid
          whose items rarely carry one stays aligned),
          placement ('below' by default, 'overlay' laid over the bottom of the cover on a
          shade, 'hidden' kept for screen readers only), see core/cardStyle.ts,
          frameless (the card has no frame: the text sits under the cover with no padding
          of its own, as on a phone).

  Which lines to show is resolved by core/cardFields.ts from what the plugin declares.
  Only the typography stays per context, since the three grids are not the same size.
%>
<%
  const cardSizes = {
    // The max-md: parts go with the frameless phone card of albums-grid: no inner
    // padding, and the title and its first line at reading size.
    collection: {
      wrap: 'p-3 max-md:px-0.5 max-md:pt-2 max-md:pb-0',
      title: 'font-bold text-sm max-md:text-[15px] max-md:font-semibold truncate',
      lead: 'text-xs max-md:text-[13px] opacity-60 truncate mb-2 max-md:mb-1'
    },
    wishlist: {
      wrap: 'p-3 max-md:px-0.5 max-md:pt-2 max-md:pb-0',
      title: 'font-bold text-xs md:text-sm max-md:text-[15px] max-md:font-semibold truncate leading-tight mb-0.5',
      lead: 'text-[10px] md:text-xs max-md:text-[13px] opacity-60 truncate mb-2 max-md:mb-1'
    },
    home: {
      wrap: 'p-3 md:p-4 max-md:px-0.5 max-md:pt-2 max-md:pb-0',
      title: 'font-bold truncate text-sm md:text-base max-md:text-[15px] max-md:font-semibold leading-tight',
      lead: 'text-xs max-md:text-[13px] opacity-60 truncate'
    }
  };
  const cs = cardSizes[locals.size] || cardSizes.collection;
  const wrapClass = {
    overlay: 'absolute inset-x-0 bottom-0 z-20 px-3 pb-3 pt-10 bg-gradient-to-t from-black/90 via-black/60 to-transparent text-white',
    hidden: 'sr-only'
  }[locals.placement] || (locals.frameless ? 'px-0.5 pt-2 md:pt-2.5 pb-0' : cs.wrap);

  const cardLines = getCardLines(plugin, item, { lang: currentLng, isShareView: locals.isShareView === true });
  const plainLines = cardLines.filter(l => l.style === 'text');
  const markedLines = cardLines.filter(l => l.style !== 'text');
  // Only what looks like one of our own keys goes through t(): a collection names its own
  // fields and options in plain words, and a one-word name that happens to be a catalogue
  // section ("media", "status") comes back as an i18next error message otherwise.
  const tr = s => isTranslationKey(s) ? t(s, { defaultValue: s }) : s;
  const valueText = l => l.translateValue ? tr(l.value) : l.value;
  const lineText = l => (l.showLabel ? tr(l.label) + ' : ' : '') + valueText(l);
  // The collection's search term, passed down by the page that ran it.
  const hit = s => highlightMatches(s, locals.querySearch);
%>
<div class="<%= wrapClass %>">
    <h3 class="<%= cs.title %>" title="<%= item.title %>"><%- hit(item.title) %></h3>

    <%# What this item holds, when it holds anything: a show says which seasons are owned,
        which is the only thing telling two lines of the same shelf apart from here. %>
    <% if (locals.item.containsLabel) { %>
        <p class="text-[10px] md:text-xs font-bold text-primary-theme truncate transition-colors">
            <%= t(item.containsLabel.key, item.containsLabel.params) %>
        </p>
    <% } %>

    <% plainLines.forEach((line, i) => { %>
        <p class="<%= i === 0 ? cs.lead : 'text-[10px] md:text-xs opacity-60 truncate' %>" title="<%= lineText(line) %>">
            <% if (line.showLabel) { %><span class="opacity-70"><%= tr(line.label) %> :</span> <% } %><%- hit(valueText(line)) %>
        </p>
    <% }) %>

    <% if (markedLines.length > 0 || locals.reserveExtraRow) { %>
        <div class="flex items-center gap-1.5 mt-1 min-w-0 overflow-hidden <%= locals.reserveExtraRow ? 'h-4' : '' %>">
            <% markedLines.forEach(line => { %>
                <% if (line.style === 'pill') { %>
                    <span class="text-[9px] md:text-[10px] opacity-60 bg-black/5 dark:bg-white/10 px-1.5 py-0.5 rounded border border-transparent truncate max-w-[50%] font-medium transition-colors" title="<%= lineText(line) %>">
                        <%- hit(valueText(line)) %>
                    </span>
                <% } else { %>
                    <div class="flex items-center gap-1 min-w-0 truncate" title="<%= lineText(line) %>">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary-theme inline-block flex-shrink-0"></span>
                        <span class="text-[9px] md:text-[10px] opacity-60 truncate"><%- hit(valueText(line)) %></span>
                    </div>
                <% } %>
            <% }) %>
        </div>
    <% } %>
</div>
