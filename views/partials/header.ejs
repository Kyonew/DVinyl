<!DOCTYPE html>
<% 
  const isDark = (typeof locals.isDark !== 'undefined') ? locals.isDark : true;
  const currentLng = (typeof locals.currentLng !== 'undefined') ? locals.currentLng : 'fr';
  const THEMES = (typeof locals.allThemes !== 'undefined') ? locals.allThemes : {};
  
  const rawCategory = (typeof locals.currentType !== 'undefined') ? locals.currentType : (locals.detectedType || 'home');

  // Theme key derived from the registry: matches collectionType, id, /add-<id>, routePrefix or a pathAlias
  let themeKey = 'home';
  if (typeof registry !== 'undefined' && registry) {
      const themePlugin = registry.getAll().find(p =>
          rawCategory === p.collectionType ||
          rawCategory === p.id ||
          rawCategory === 'add-' + p.id ||
          rawCategory === p.routePrefix.replace('/', '') ||
          (p.pathAliases || []).includes(rawCategory)
      );
      if (themePlugin) themeKey = themePlugin.collectionType;
  }

  let activePresetKey = 'default';
  if (typeof settings !== 'undefined' && settings && settings.theme) {
        if (settings.theme[themeKey] && settings.theme[themeKey].preset) {
          activePresetKey = settings.theme[themeKey].preset;
      } 
      else if (settings.theme.home && settings.theme.home.preset) {
          activePresetKey = settings.theme.home.preset;
      }
  }

  const safeFallback = { 
      light: { bg: '#e2e8f0', card: '#ffffff', navbar: '#1e293b', navText: '#ffffff', text: '#0f172a', subtext: '#475569', highlight: '#10b981' },
      dark: { bg: '#171717', card: '#262626', navbar: '#0a0a0a', navText: '#ffffff', text: '#ffffff', subtext: '#a3a3a3', highlight: '#10b981' }
  };

  const activeTheme = (THEMES[activePresetKey]) ? THEMES[activePresetKey] : (THEMES['default'] || safeFallback);

  // Accent as separate channels. Tailwind can only honour an opacity modifier
  // (bg-primary-theme/10) when the colour is written as rgb(... / <alpha-value>);
  // handed a bare var() it drops the modifier and paints the accent at full
  // strength, turning every faint tint into a solid block.
  const rgbChannels = (hex) => {
      const raw = String(hex || '').trim().replace('#', '');
      const full = raw.length === 3 ? raw.split('').map(c => c + c).join('') : raw;
      if (!/^[0-9a-f]{6}$/i.test(full)) return '16 185 129'; // preset default
      const n = parseInt(full, 16);
      return `${(n >> 16) & 255} ${(n >> 8) & 255} ${n & 255}`;
  };

  // The browser chrome (Android status bar, Safari toolbar) is tinted to match the navbar
  // of the mode the page opens in; the theme toggle below swaps it on the fly.
  const navColorLight = activeTheme.light.navbar || '#0f0f0f';
  const navColorDark = activeTheme.dark.navbar || '#0f0f0f';
  const navColor = isDark ? navColorDark : navColorLight;
  // iOS paints the status bar text white over the page with black-translucent, which
  // vanishes on a light navbar. A light navbar gets the default style (dark text on an
  // opaque bar) instead.
  const isLightColor = (hex) => {
      const [r, g, b] = rgbChannels(hex).split(' ').map(Number);
      return (0.299 * r + 0.587 * g + 0.114 * b) > 160;
  };
  const statusBarStyle = isLightColor(navColor) ? 'default' : 'black-translucent';

  // On a phone, a signed-in member gets the bottom tab bar (partials/shell/tab-bar, from
  // the footer, on the same condition). It replaces the avatar menu and the burger there;
  // share views and signed-out pages keep the burger.
  const showTabBar = Boolean(locals.user) && !locals.isShareView
      && typeof settings !== 'undefined' && settings && typeof registry !== 'undefined' && registry;
%>

<html lang="<%= currentLng %>" class="<%= isDark ? 'dark' : '' %>">
<head>
  <meta charset="UTF-8" />
  <%# viewport-fit=cover lets the page run under the notch and the home indicator once
      installed; the safe-area paddings in the style block below keep content clear of them. %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>DVinyl</title>
  
  <%# Served from the instance rather than cdn.tailwindcss.com. The Play CDN is a
      script that has to run before a single utility class exists, so anything that
      stops it reaching the browser - an ad blocker, a DNS filter, a company network,
      or simply an install with no outbound internet - leaves every page here with no
      layout at all (issue #133). Same build, same runtime config below. %>
  <script src="<%= baseUrl %>/vendor/tailwind-3.4.17.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            theme: {
                bg: 'var(--bg-page)',
                card: 'var(--bg-card)',
                nav: 'var(--bg-nav)',
                text: 'var(--text-main)',
                subtext: 'var(--text-sub)',
                highlight: 'var(--highlight)'
            },
            // Same variable as theme.highlight, declared as a colour of its own so
            // Tailwind generates the whole family: border-, ring-, shadow-, accent-
            // had no rule at all, and no hover:/focus:/peer-checked: variant existed,
            // because a class written by hand in the <style> block below is invisible
            // to the variant machinery.
            'primary-theme': 'rgb(var(--highlight-rgb) / <alpha-value>)'
          }
        }
      }
    };
  </script>

  <%# Both served from the instance, for the same reason as Tailwind above: an ad blocker, a
      DNS filter or an instance with no outbound access takes them out, and every icon in the
      interface is a Font Awesome glyph while every dropdown and modal is driven by Flowbite.
      See public/vendor/README.md for how to update them. %>
  <link rel="stylesheet" href="<%= baseUrl %>/vendor/font-awesome-6.7.2/css/all.min.css">
  <script src="<%= baseUrl %>/vendor/flowbite-1.6.5.min.js"></script>
  <link rel="icon" type="image/png" href="<%= baseUrl %>/ressources/logo.png">

  <style>
    :root {
        --bg-page: <%= activeTheme.light.bg %>;
        --bg-card: <%= activeTheme.light.card %>;
        --bg-nav:  <%= activeTheme.light.navbar %>;
        --text-main: <%= activeTheme.light.text %>;
        --text-sub: <%= activeTheme.light.subtext %>;
        --highlight: <%= activeTheme.light.highlight %>;
        --highlight-rgb: <%= rgbChannels(activeTheme.light.highlight) %>;
        
        --shadow-color: 0 0 0 rgba(0,0,0,0.05);
        --border-color: rgba(0,0,0,0.1);
    }

    html.dark {
        --bg-page: <%= activeTheme.dark.bg %>;
        --bg-card: <%= activeTheme.dark.card %>;
        --bg-nav:  <%= activeTheme.dark.navbar %>;
        --text-main: <%= activeTheme.dark.text %>;
        --text-sub: <%= activeTheme.dark.subtext %>;
        --highlight: <%= activeTheme.dark.highlight %>;
        --highlight-rgb: <%= rgbChannels(activeTheme.dark.highlight) %>;
        
        --shadow-color: 0 0 20px <%= activeTheme.dark.highlight %>20;
        --border-color: rgba(255,255,255,0.1);
    }

    body {
        background-color: var(--bg-page) !important;
        color: var(--text-main) !important;
    }

    .nav-custom {
        background-color: var(--bg-nav) !important;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-main) !important;
    }

    /* Tailwind generates the colour itself now, so this only carries what it cannot
       know: a solid accent background is always paired with white text. No !important,
       so a hover: variant on the same element can still take over. Tinted backgrounds
       (bg-primary-theme/10) are a different class and keep their own text colour. */
    .bg-primary-theme { color: #fff; }

    .card-theme {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color);
        color: var(--text-main) !important;
    }
    
    #page-loader {
      background-color: var(--bg-page);
      color: var(--text-main);
    }

    /* Safe areas, all zero outside an installed app on a notched device. The navbar
       grows under the status bar so its colour fills it, the footer clears the home
       indicator, and the sides clear the notch in landscape. */
    body {
      padding-left: env(safe-area-inset-left);
      padding-right: env(safe-area-inset-right);
    }
    nav.nav-custom { padding-top: env(safe-area-inset-top); }
    footer.nav-custom { padding-bottom: env(safe-area-inset-bottom); }
    #saveBar, #toastContainer { margin-bottom: env(safe-area-inset-bottom); }
    /* Docked to the bottom edge on phones only; from md up it floats above it. */
    @media (max-width: 767px) {
      #bulkBarPanel { padding-bottom: calc(0.75rem + env(safe-area-inset-bottom)); }
    }

    /* Phone tab bar (partials/shell/tab-bar). Its height is kept free at the bottom of
       the page, and what docks to the bottom edge sits on top of it instead. */
    @media (max-width: 767px) {
      body.has-tab-bar {
        --tab-bar-h: 4rem;
        padding-bottom: calc(var(--tab-bar-h) + env(safe-area-inset-bottom));
      }
      body.has-tab-bar footer.nav-custom { padding-bottom: 0; }
      body.has-tab-bar #saveBar,
      body.has-tab-bar #toastContainer { margin-bottom: calc(var(--tab-bar-h) + env(safe-area-inset-bottom)); }
      body.has-tab-bar #bulkActionBar { bottom: calc(var(--tab-bar-h) + env(safe-area-inset-bottom)); }
      body.has-tab-bar #bulkBarPanel { padding-bottom: 0.75rem; }
    }
  </style>

  <link rel="manifest" href="<%= baseUrl %>/manifest.json">
  <meta name="theme-color" content="<%= navColor %>" data-light="<%= navColorLight %>" data-dark="<%= navColorDark %>">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="<%= statusBarStyle %>">
  <meta name="apple-mobile-web-app-title" content="DVinyl">
  <link rel="apple-touch-icon" href="<%= baseUrl %>/ressources/icone-192.png">
</head>

<body class="font-sans transition-colors duration-300 min-h-screen flex flex-col <%= showTabBar ? 'has-tab-bar' : '' %>">
    
  <div id="page-loader" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center transition-opacity duration-500">
    <div class="relative">
        <i class="fa-solid fa-compact-disc fa-spin text-6xl text-primary-theme drop-shadow-md"></i>
    </div>
  </div>

  <nav class="nav-custom transition-colors duration-300">
      <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto px-2.5 <%= showTabBar ? 'py-3' : 'py-4' %> sm:p-4">
      <a href="<%= baseUrl || '/' %>" class="flex items-center space-x-3 group">
        <img src="<%= baseUrl %>/ressources/logo.png" alt="Logo" class="h-8 w-8 rounded-full object-cover group-hover:rotate-12 transition-transform">
        <span class="self-center text-2xl font-semibold text-inherit"><%= locals.activeCollection && locals.activeCollection.name ? activeCollection.name : 'Vinyl' %></span>
      </a>

      <div class="flex items-center md:order-2 gap-4">

        <% if (locals.user) { %>
        <%# Search spans every collection, so it belongs next to the account rather than
            among the shortcuts, which are per collection and chosen by the user. %>
        <a href="<%= baseUrl %>/search" title="<%= t('nav.search') %>" aria-label="<%= t('nav.search') %>"
          class="w-8 h-8 flex items-center justify-center rounded-full bg-black/5 dark:bg-white/10 text-[var(--text-sub)] hover:text-primary-theme hover:bg-black/10 dark:hover:bg-white/20 transition-colors">
          <i class="fa-solid fa-magnifying-glass text-sm"></i>
        </a>

        <button type="button" class="<%= showTabBar ? 'hidden md:flex' : 'flex' %> text-sm bg-black/5 dark:bg-white/10 rounded-full focus:ring-4 focus:ring-gray-300 dark:focus:ring-gray-600" id="user-menu-button" data-dropdown-toggle="user-dropdown">
          <img class="w-8 h-8 rounded-full object-cover" src="<%= baseUrl + user.img %>" alt="user photo">
        </button>
  
        <div class="z-50 hidden my-4 text-base list-none card-theme rounded-lg shadow-xl min-w-[200px]" id="user-dropdown">          
          <div class="flex justify-center py-4 rounded-t-lg">
            <img src="<%= baseUrl + user.img %>" alt="user photo" class="w-20 h-20 rounded-full border-4 border-white dark:border-white/10 object-cover shadow-lg">
          </div>
       
          <div class="divide-y divide-black/5 dark:divide-white/10">
            <div class="px-4 pt-1 pb-3 text-center">
              <span class="block text-sm font-bold opacity-90 text-[var(--text-main)]"><%= user.username %></span>
              <span class="block text-xs opacity-60 truncate text-[var(--text-sub)]"><%= user.email %></span>
            </div>
            <%- include('shell/user-menu') %>
          </div>
        </div>
        <% } else if (locals.isShareView) { %>
          <span class="flex items-center gap-2 text-xs font-black uppercase tracking-widest text-primary-theme">
            <i class="fa-solid fa-eye"></i>
            <%= t('nav.share_view') %>
          </span>
        <% } else { %>
          <a href="<%= baseUrl %>/login" class="text-sm font-bold text-primary-theme hover:underline"><%= t('nav.login') %></a>
        <% } %>

        <% if (!showTabBar) { %>
        <button data-collapse-toggle="navbar-user" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm opacity-70 rounded-lg md:hidden hover:bg-black/5 dark:hover:bg-white/10 focus:outline-none text-[var(--text-main)]">
          <i class="fa-solid fa-bars text-xl"></i>
        </button>
        <% } %>
      </div>

      <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1" id="navbar-user">
        <%- include('shell/nav-shortcuts', { shortcutsVariant: 'bar' }) %>
      </div>
    </div>
    <% if (showTabBar) { %>
    <div class="md:hidden">
      <%- include('shell/nav-shortcuts', { shortcutsVariant: 'pills', shortcutsExclude: ['global_home', 'global_collection', 'global_lists'] }) %>
    </div>
    <% } %>
  </nav>

  <% if (locals.user && locals.canCreateCollection) { %>
  <!-- Self-service collection creation, opened from the user dropdown. Self-contained
       (its own toggle script) since the header is included by every page. -->
  <div id="newCollectionModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="absolute inset-0" data-new-collection-close></div>
    <div class="relative card-theme rounded-[2rem] p-8 md:p-10 shadow-2xl w-full max-w-md">
      <button type="button" data-new-collection-close
        class="absolute top-5 right-5 w-9 h-9 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors text-[var(--text-main)]">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <h3 class="text-2xl font-black mb-8 text-[var(--text-main)]"><%= t('nav.new_collection') %></h3>
      <form action="<%= baseUrl %>/collection/create" method="POST" class="space-y-6">
        <input type="text" name="name" required maxlength="60" autocomplete="off"
          placeholder="<%= t('admin.collections.name_placeholder') %>"
          class="w-full p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-sm text-[var(--text-main)] focus:outline-none focus:border-primary-theme transition-colors">
        <button type="submit"
          class="w-full flex items-center justify-center gap-2 bg-primary-theme hover:brightness-110 text-white px-6 py-4 rounded-2xl shadow-lg shadow-primary-theme/20 transition-all active:scale-95">
          <i class="fa-solid fa-plus text-sm"></i>
          <span class="text-xs font-black"><%= t('admin.collections.create') %></span>
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <script>
    document.body.classList.add('js-ready');
    const navTranslations = {
        themeDark: <%- JSON.stringify(t('nav.theme_dark')) %>,
        themeLight: <%- JSON.stringify(t('nav.theme_light')) %>
    };
    
    document.addEventListener('DOMContentLoaded', () => {
        // The account menu is rendered twice (desktop dropdown, phone account sheet), so
        // every toggle, icon and label is updated, not just the first.
        const htmlElement = document.documentElement;

        function updateButtonVisuals() {
            const isDark = htmlElement.classList.contains('dark');
            const themeColorMeta = document.querySelector('meta[name="theme-color"]');
            if (themeColorMeta) {
                themeColorMeta.setAttribute('content', isDark ? themeColorMeta.dataset.dark : themeColorMeta.dataset.light);
            }
            document.querySelectorAll('[data-theme-icon]').forEach(icon => {
                icon.className = isDark
                    ? 'fa-solid fa-sun w-5 text-center text-yellow-400'
                    : 'fa-solid fa-moon w-5 text-center text-indigo-500';
            });
            document.querySelectorAll('[data-theme-text]').forEach(text => {
                text.textContent = isDark ? navTranslations.themeLight : navTranslations.themeDark;
            });
        }

        updateButtonVisuals();

        document.querySelectorAll('[data-theme-toggle]').forEach(themeToggleBtn => {
            themeToggleBtn.addEventListener('click', async () => {
                htmlElement.classList.toggle('dark');
                updateButtonVisuals();
                const newTheme = htmlElement.classList.contains('dark') ? 'dark' : 'light';
                try {
                    await fetch('<%= baseUrl %>/settings/update-theme', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ theme: newTheme })
                    });
                } catch (e) { console.error('Theme update failed', e); }
            });
        });
    });
    
    // New-collection modal (only rendered when the user is allowed to create one)
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('newCollectionModal');
        if (!modal) return;

        const setOpen = (open) => {
            modal.classList.toggle('hidden', !open);
            modal.classList.toggle('flex', open);
            if (open) modal.querySelector('input[name="name"]')?.focus();
        };

        document.querySelectorAll('[data-new-collection-open]')
            .forEach(el => el.addEventListener('click', () => setOpen(true)));
        modal.querySelectorAll('[data-new-collection-close]')
            .forEach(el => el.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') setOpen(false);
        });
    });

    window.addEventListener('load', () => {
        const loader = document.getElementById('page-loader');
        if(loader) {
            loader.style.opacity = '0';
            setTimeout(() => { loader.remove(); }, 500);
        }
    });
  </script>

  <main class="px-2.5 py-6 sm:p-6 flex-1">
