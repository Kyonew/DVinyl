<!DOCTYPE html>
<% 
  const isDark = (typeof locals.isDark !== 'undefined') ? locals.isDark : true;
  const currentLng = (typeof locals.currentLng !== 'undefined') ? locals.currentLng : 'fr';
  
  const rawCategory = (typeof locals.currentType !== 'undefined') ? locals.currentType : (locals.detectedType || 'home');

  // Theme key derived from the registry: matches collectionType, id, /add-<id>, routePrefix or a pathAlias
  let themeKey = 'home';
  if (typeof registry !== 'undefined' && registry) {
      const themePlugin = registry.getAll().find(p =>
          rawCategory === p.collectionType ||
          rawCategory === p.id ||
          rawCategory === 'add-' + p.id ||
          rawCategory === p.routePrefix.replace('/', '') ||
          (p.pathAliases || []).includes(rawCategory)
      );
      if (themePlugin) themeKey = themePlugin.collectionType;
  }

  // The preset picked for that part of the app, or the collection's own palette
  // (core/theme.ts), with the text colour that reads on its accent.
  const activeTheme = resolveTheme(typeof settings !== 'undefined' ? settings : null, themeKey);

  // Accent as separate channels. Tailwind can only honour an opacity modifier
  // (bg-primary-theme/10) when the colour is written as rgb(... / <alpha-value>);
  // handed a bare var() it drops the modifier and paints the accent at full
  // strength, turning every faint tint into a solid block.
  const rgbChannels = (hex) => {
      const raw = String(hex || '').trim().replace('#', '');
      const full = raw.length === 3 ? raw.split('').map(c => c + c).join('') : raw;
      if (!/^[0-9a-f]{6}$/i.test(full)) return '16 185 129'; // preset default
      const n = parseInt(full, 16);
      return `${(n >> 16) & 255} ${(n >> 8) & 255} ${n & 255}`;
  };

  // The browser chrome (Android status bar, Safari toolbar) is tinted to match the navbar
  // of the mode the page opens in; the theme toggle below swaps it on the fly.
  const navColorLight = activeTheme.light.navbar || '#0f0f0f';
  const navColorDark = activeTheme.dark.navbar || '#0f0f0f';
  const navColor = isDark ? navColorDark : navColorLight;
  // iOS paints the status bar text white over the page with black-translucent, which
  // vanishes on a light navbar. A light navbar gets the default style (dark text on an
  // opaque bar) instead.
  const isLightColor = (hex) => {
      const [r, g, b] = rgbChannels(hex).split(' ').map(Number);
      return (0.299 * r + 0.587 * g + 0.114 * b) > 160;
  };
  const statusBarStyle = isLightColor(navColor) ? 'default' : 'black-translucent';

  // On a phone, a signed-in member gets the bottom tab bar (partials/shell/tab-bar, from
  // the footer, on the same condition). It replaces the avatar menu and the burger there;
  // share views and signed-out pages keep the burger.
  const showTabBar = Boolean(locals.user) && !locals.isShareView
      && typeof settings !== 'undefined' && settings && typeof registry !== 'undefined' && registry;

  // Wherever the tab bar shows, a phone has no top bar either, as in an app: each page
  // opens on its own title, and the tab bar is how one moves between sections.
  const hideTopBarOnPhone = showTabBar;
  // Tab roots never get a back button. Any deeper page gets one on a phone (right under,
  // at the head of <main>) and in an installed app on a larger screen, where no browser
  // toolbar offers one (see the standalone rules in the style block).
  const tabRoots = ['/', '/dashboard', '/collection', '/lists', '/wishlist', '/account'];
  const showBackButton = !tabRoots.includes(locals.currentPath || '/');

  // The collection's layout (core/layout.ts): which navigation large screens get, and
  // the density, radius, scale, width and font of the whole interface.
  const shellNav = locals.layout || resolveLayout(typeof settings !== 'undefined' ? settings : null);
  const shellCanAdd = showTabBar && Boolean(locals.canEditCollection) && registry.getEnabled(settings).length > 0;
%>

<html lang="<%= currentLng %>" class="<%= isDark ? 'dark' : '' %>"
  data-nav="<%= shellNav.nav %>" data-sidebar-state="<%= shellNav.sidebarState %>" data-dock-labels="<%= shellNav.dockLabels ? 'true' : 'false' %>"
  data-heading-font="<%= shellNav.headingFont === 'same' ? 'same' : 'own' %>" data-heading-case="<%= shellNav.headingCase %>"
  data-theme="<%= activeTheme.name %>">
<head>
  <meta charset="UTF-8" />
  <%# viewport-fit=cover lets the page run under the notch and the home indicator once
      installed; the safe-area paddings in the style block below keep content clear of them. %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>DVinyl</title>
  
  <%# Served from the instance rather than cdn.tailwindcss.com. The Play CDN is a
      script that has to run before a single utility class exists, so anything that
      stops it reaching the browser - an ad blocker, a DNS filter, a company network,
      or simply an install with no outbound internet - leaves every page here with no
      layout at all (issue #133). Same build, same runtime config below. %>
  <script src="<%= baseUrl %>/vendor/tailwind-3.4.17.min.js"></script>
  <script>
    // Density, radius, font and content width come from the layout (core/layout.ts) as
    // CSS variables, so every padding, gap, corner and max-w-screen-xl of every page
    // follows it without a template knowing. Margins, widths and heights stay put: they
    // carry structure (icon sizes, the tab bar, aspect boxes) more than breathing room.
    const dvScaled = (factorVar, entries) => Object.fromEntries(
      Object.entries(entries).map(([key, rem]) => [key, `calc(${rem}rem * var(${factorVar}))`])
    );
    const dvSpacing = dvScaled('--dv-space', {
      0.5: 0.125, 1: 0.25, 1.5: 0.375, 2: 0.5, 2.5: 0.625, 3: 0.75, 3.5: 0.875, 4: 1, 5: 1.25,
      6: 1.5, 7: 1.75, 8: 2, 9: 2.25, 10: 2.5, 11: 2.75, 12: 3, 14: 3.5, 16: 4, 20: 5, 24: 6,
      28: 7, 32: 8, 36: 9, 40: 10, 44: 11, 48: 12
    });
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          padding: dvSpacing,
          gap: dvSpacing,
          space: dvSpacing,
          borderRadius: dvScaled('--dv-radius', { sm: 0.125, DEFAULT: 0.25, md: 0.375, lg: 0.5, xl: 0.75, '2xl': 1, '3xl': 1.5 }),
          fontFamily: { sans: 'var(--dv-font)' },
          maxWidth: { 'screen-xl': 'var(--dv-content-max)' },
          colors: {
            theme: {
                bg: 'var(--bg-page)',
                card: 'var(--bg-card)',
                nav: 'var(--bg-nav)',
                text: 'var(--text-main)',
                subtext: 'var(--text-sub)',
                highlight: 'var(--highlight)'
            },
            // Same variable as theme.highlight, declared as a colour of its own so
            // Tailwind generates the whole family: border-, ring-, shadow-, accent-
            // had no rule at all, and no hover:/focus:/peer-checked: variant existed,
            // because a class written by hand in the <style> block below is invisible
            // to the variant machinery.
            'primary-theme': 'rgb(var(--highlight-rgb) / <alpha-value>)'
          }
        }
      }
    };
  </script>

  <%# Both served from the instance, for the same reason as Tailwind above: an ad blocker, a
      DNS filter or an instance with no outbound access takes them out, and every icon in the
      interface is a Font Awesome glyph while every dropdown and modal is driven by Flowbite.
      See public/vendor/README.md for how to update them. %>
  <link rel="stylesheet" href="<%= baseUrl %>/vendor/font-awesome-6.7.2/css/all.min.css">
  <script src="<%= baseUrl %>/vendor/flowbite-1.6.5.min.js"></script>
  <link rel="icon" type="image/png" href="<%= baseUrl %>/ressources/logo.png">

  <% shellNav.fontStylesheets.forEach(sheet => { %>
  <link rel="stylesheet" href="<%= baseUrl %>/vendor/fonts/<%= sheet %>">
  <% }) %>
  <%- include('shell/styles', { activeTheme, rgbChannels, layout: shellNav }) %>
  <script>
    if (window.navigator.standalone === true) document.documentElement.classList.add('is-standalone');
  </script>
  <% if (locals.studioPreview) { %>
  <%# Inside the Personnalisation studio's preview: every page reached from here, by a
      link or a search form, stays in the preview and keeps showing the draft
      (core/lookDraft.ts). %>
  <script>
    (function () {
      const inPreview = (href) => {
        const url = new URL(href, window.location.href);
        if (url.origin !== window.location.origin) return null;
        url.searchParams.set('studio', '1');
        return url.toString();
      };
      document.addEventListener('click', (event) => {
        const link = event.target.closest('a[href]');
        if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
        const href = inPreview(link.getAttribute('href'));
        if (href) link.href = href;
      }, true);
      document.addEventListener('submit', (event) => {
        const form = event.target;
        if ((form.getAttribute('method') || 'get').toLowerCase() !== 'get' || form.querySelector('input[name="studio"]')) return;
        const flag = document.createElement('input');
        Object.assign(flag, { type: 'hidden', name: 'studio', value: '1' });
        form.appendChild(flag);
      }, true);
    })();
  </script>
  <% } %>

  <link rel="manifest" href="<%= baseUrl %>/manifest.json">
  <meta name="theme-color" content="<%= navColor %>" data-light="<%= navColorLight %>" data-dark="<%= navColorDark %>">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="<%= statusBarStyle %>">
  <meta name="apple-mobile-web-app-title" content="DVinyl">
  <link rel="apple-touch-icon" href="<%= baseUrl %>/ressources/icone-192.png">
</head>

<body class="font-sans transition-colors duration-300 min-h-screen flex flex-col <%= showTabBar ? 'has-tab-bar' : '' %> <%= hideTopBarOnPhone ? 'no-top-bar' : '' %>">
    
  <div id="page-loader" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center transition-opacity duration-500">
    <div class="relative">
        <i class="fa-solid fa-compact-disc fa-spin text-6xl text-primary-theme drop-shadow-md"></i>
    </div>
  </div>

  <%- include('shell/top-bar', { shellNav, showTabBar, hideTopBarOnPhone, showBackButton }) %>
  <% if (shellNav.nav === 'left' || shellNav.nav === 'right') { %>
    <%- include('shell/sidebar', { shellNav, showBackButton, shellCanAdd }) %>
  <% } else if (shellNav.nav === 'bottom') { %>
    <%- include('shell/dock', { shellNav, showBackButton, shellCanAdd }) %>
  <% } %>

  <% if (locals.user && locals.canCreateCollection) { %>
  <!-- Self-service collection creation, opened from the user dropdown. Self-contained
       (its own toggle script) since the header is included by every page. -->
  <div id="newCollectionModal" class="dv-overlay fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="absolute inset-0" data-new-collection-close></div>
    <div class="dv-pop relative card-theme rounded-[2rem] p-8 md:p-10 shadow-2xl w-full max-w-md">
      <button type="button" data-new-collection-close
        class="absolute top-5 right-5 w-9 h-9 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors text-[var(--text-main)]">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <h3 class="text-2xl font-black mb-8 text-[var(--text-main)]"><%= t('nav.new_collection') %></h3>
      <form action="<%= baseUrl %>/collection/create" method="POST" class="space-y-6">
        <input type="text" name="name" required maxlength="60" autocomplete="off"
          placeholder="<%= t('admin.collections.name_placeholder') %>"
          class="w-full p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-sm text-[var(--text-main)] focus:outline-none focus:border-primary-theme transition-colors">
        <button type="submit"
          class="w-full flex items-center justify-center gap-2 bg-primary-theme hover:brightness-110 text-white px-6 py-4 rounded-2xl shadow-lg shadow-primary-theme/20 transition-all active:scale-95">
          <i class="fa-solid fa-plus text-sm"></i>
          <span class="text-xs font-black"><%= t('admin.collections.create') %></span>
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <script>
    document.body.classList.add('js-ready');

    // Delegated: the phone's back button sits at the head of <main>, after this script.
    document.addEventListener('click', event => {
        if (!event.target.closest('[data-standalone-back], [data-app-back]')) return;
        // Opened straight on this page (a shared link, a home screen shortcut): there
        // is nothing to go back to, so the collection stands in for it.
        if (window.history.length > 1) window.history.back();
        else window.location.href = '<%= baseUrl %>/collection';
    });
    const navTranslations = {
        themeDark: <%- JSON.stringify(t('nav.theme_dark')) %>,
        themeLight: <%- JSON.stringify(t('nav.theme_light')) %>
    };
    
    document.addEventListener('DOMContentLoaded', () => {
        // The account menu is rendered twice (desktop dropdown, phone account sheet), so
        // every toggle, icon and label is updated, not just the first.
        const htmlElement = document.documentElement;

        function updateButtonVisuals() {
            const isDark = htmlElement.classList.contains('dark');
            const themeColorMeta = document.querySelector('meta[name="theme-color"]');
            if (themeColorMeta) {
                themeColorMeta.setAttribute('content', isDark ? themeColorMeta.dataset.dark : themeColorMeta.dataset.light);
            }
            document.querySelectorAll('[data-theme-icon]').forEach(icon => {
                icon.className = isDark
                    ? 'fa-solid fa-sun w-5 text-center text-yellow-400'
                    : 'fa-solid fa-moon w-5 text-center text-indigo-500';
            });
            document.querySelectorAll('[data-theme-text]').forEach(text => {
                text.textContent = isDark ? navTranslations.themeLight : navTranslations.themeDark;
            });
        }

        updateButtonVisuals();

        document.querySelectorAll('[data-theme-toggle]').forEach(themeToggleBtn => {
            themeToggleBtn.addEventListener('click', async () => {
                htmlElement.classList.toggle('dark');
                updateButtonVisuals();
                const newTheme = htmlElement.classList.contains('dark') ? 'dark' : 'light';
                try {
                    await fetch('<%= baseUrl %>/settings/update-theme', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ theme: newTheme })
                    });
                } catch (e) { console.error('Theme update failed', e); }
            });
        });
    });
    
    // New-collection modal (only rendered when the user is allowed to create one)
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('newCollectionModal');
        if (!modal) return;

        const setOpen = (open) => {
            modal.classList.toggle('hidden', !open);
            modal.classList.toggle('flex', open);
            if (open) modal.querySelector('input[name="name"]')?.focus();
        };

        document.querySelectorAll('[data-new-collection-open]')
            .forEach(el => el.addEventListener('click', () => setOpen(true)));
        modal.querySelectorAll('[data-new-collection-close]')
            .forEach(el => el.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') setOpen(false);
        });
    });

    // A sticky top bar: what sticks under it (settings tabs) starts where it ends.
    <% if (shellNav.nav === 'top' && shellNav.sticky) { %>
    (() => {
        const bar = document.getElementById('dvTopBar');
        if (!bar || !window.ResizeObserver) return;
        const margin = <%= shellNav.topStyle === 'floating' ? 16 : 0 %>;
        new ResizeObserver(() => {
            document.documentElement.style.setProperty('--dv-sticky-top', (bar.offsetHeight + margin) + 'px');
        }).observe(bar);
    })();
    <% } %>

    window.addEventListener('load', () => {
        const loader = document.getElementById('page-loader');
        if(loader) {
            loader.style.opacity = '0';
            setTimeout(() => { loader.remove(); }, 500);
        }
    });
  </script>

  <main class="px-4 py-6 sm:p-6 flex-1">
  <%# Phone, deep page: the top bar is gone, so the way back sits here. A page that opens
      on a back link of its own (an item, a form, a list) passes shellBack: false. %>
  <% if (hideTopBarOnPhone && showBackButton && locals.shellBack !== false) { %>
    <button type="button" data-app-back
      class="md:hidden mb-3 h-10 pr-3 flex items-center gap-1.5 text-primary-theme font-semibold">
      <i class="fa-solid fa-chevron-left" aria-hidden="true"></i><%= t('nav.back') %>
    </button>
  <% } %>
