<!DOCTYPE html>
<% 
  const isDark = (typeof locals.isDark !== 'undefined') ? locals.isDark : true;
  const currentLng = (typeof locals.currentLng !== 'undefined') ? locals.currentLng : 'fr';
  const THEMES = (typeof locals.allThemes !== 'undefined') ? locals.allThemes : {};
  
  const rawCategory = (typeof locals.currentType !== 'undefined') ? locals.currentType : (locals.detectedType || 'home');

  // Theme key derived from the registry: matches collectionType, id, /add-<id>, routePrefix or a pathAlias
  let themeKey = 'home';
  if (typeof registry !== 'undefined' && registry) {
      const themePlugin = registry.getAll().find(p =>
          rawCategory === p.collectionType ||
          rawCategory === p.id ||
          rawCategory === 'add-' + p.id ||
          rawCategory === p.routePrefix.replace('/', '') ||
          (p.pathAliases || []).includes(rawCategory)
      );
      if (themePlugin) themeKey = themePlugin.collectionType;
  }

  let activePresetKey = 'default';
  if (typeof settings !== 'undefined' && settings && settings.theme) {
        if (settings.theme[themeKey] && settings.theme[themeKey].preset) {
          activePresetKey = settings.theme[themeKey].preset;
      } 
      else if (settings.theme.home && settings.theme.home.preset) {
          activePresetKey = settings.theme.home.preset;
      }
  }

  const safeFallback = { 
      light: { bg: '#e2e8f0', card: '#ffffff', navbar: '#1e293b', navText: '#ffffff', text: '#0f172a', subtext: '#475569', highlight: '#10b981' },
      dark: { bg: '#171717', card: '#262626', navbar: '#0a0a0a', navText: '#ffffff', text: '#ffffff', subtext: '#a3a3a3', highlight: '#10b981' }
  };

  const activeTheme = (THEMES[activePresetKey]) ? THEMES[activePresetKey] : (THEMES['default'] || safeFallback);

  // Accent as separate channels. Tailwind can only honour an opacity modifier
  // (bg-primary-theme/10) when the colour is written as rgb(... / <alpha-value>);
  // handed a bare var() it drops the modifier and paints the accent at full
  // strength, turning every faint tint into a solid block.
  const rgbChannels = (hex) => {
      const raw = String(hex || '').trim().replace('#', '');
      const full = raw.length === 3 ? raw.split('').map(c => c + c).join('') : raw;
      if (!/^[0-9a-f]{6}$/i.test(full)) return '16 185 129'; // preset default
      const n = parseInt(full, 16);
      return `${(n >> 16) & 255} ${(n >> 8) & 255} ${n & 255}`;
  };
%>

<html lang="<%= currentLng %>" class="<%= isDark ? 'dark' : '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>DVinyl</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            theme: {
                bg: 'var(--bg-page)',
                card: 'var(--bg-card)',
                nav: 'var(--bg-nav)',
                text: 'var(--text-main)',
                subtext: 'var(--text-sub)',
                highlight: 'var(--highlight)'
            },
            // Same variable as theme.highlight, declared as a colour of its own so
            // Tailwind generates the whole family: border-, ring-, shadow-, accent-
            // had no rule at all, and no hover:/focus:/peer-checked: variant existed,
            // because a class written by hand in the <style> block below is invisible
            // to the variant machinery.
            'primary-theme': 'rgb(var(--highlight-rgb) / <alpha-value>)'
          }
        }
      }
    };
  </script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.6.5/flowbite.min.js"></script>
  <link rel="icon" type="image/png" href="<%= baseUrl %>/ressources/logo.png">

  <style>
    :root {
        --bg-page: <%= activeTheme.light.bg %>;
        --bg-card: <%= activeTheme.light.card %>;
        --bg-nav:  <%= activeTheme.light.navbar %>;
        --text-main: <%= activeTheme.light.text %>;
        --text-sub: <%= activeTheme.light.subtext %>;
        --highlight: <%= activeTheme.light.highlight %>;
        --highlight-rgb: <%= rgbChannels(activeTheme.light.highlight) %>;
        
        --shadow-color: 0 0 0 rgba(0,0,0,0.05);
        --border-color: rgba(0,0,0,0.1);
    }

    html.dark {
        --bg-page: <%= activeTheme.dark.bg %>;
        --bg-card: <%= activeTheme.dark.card %>;
        --bg-nav:  <%= activeTheme.dark.navbar %>;
        --text-main: <%= activeTheme.dark.text %>;
        --text-sub: <%= activeTheme.dark.subtext %>;
        --highlight: <%= activeTheme.dark.highlight %>;
        --highlight-rgb: <%= rgbChannels(activeTheme.dark.highlight) %>;
        
        --shadow-color: 0 0 20px <%= activeTheme.dark.highlight %>20;
        --border-color: rgba(255,255,255,0.1);
    }

    body {
        background-color: var(--bg-page) !important;
        color: var(--text-main) !important;
    }

    .nav-custom {
        background-color: var(--bg-nav) !important;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-main) !important;
    }

    /* Tailwind generates the colour itself now, so this only carries what it cannot
       know: a solid accent background is always paired with white text. No !important,
       so a hover: variant on the same element can still take over. Tinted backgrounds
       (bg-primary-theme/10) are a different class and keep their own text colour. */
    .bg-primary-theme { color: #fff; }

    .card-theme {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color);
        color: var(--text-main) !important;
    }
    
    #page-loader {
      background-color: var(--bg-page);
      color: var(--text-main);
    }
  </style>

  <link rel="manifest" href="<%= baseUrl %>/manifest.json">
  <meta name="theme-color" content="#0f0f0f">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DVinyl">
  <link rel="apple-touch-icon" href="<%= baseUrl %>/ressources/icone-192.png">
</head>

<body class="font-sans transition-colors duration-300 min-h-screen flex flex-col">
    
  <div id="page-loader" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center transition-opacity duration-500">
    <div class="relative">
        <i class="fa-solid fa-compact-disc fa-spin text-6xl text-primary-theme drop-shadow-md"></i>
    </div>
  </div>

  <nav class="nav-custom transition-colors duration-300">
      <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
      
      <a href="<%= baseUrl || '/' %>" class="flex items-center space-x-3 group">
        <img src="<%= baseUrl %>/ressources/logo.png" alt="Logo" class="h-8 w-8 rounded-full object-cover group-hover:rotate-12 transition-transform">
        <span class="self-center text-2xl font-semibold text-inherit"><%= locals.activeCollection && locals.activeCollection.name ? activeCollection.name : 'Vinyl' %></span>
      </a>

      <div class="flex items-center md:order-2 gap-4">
        
        <% if (locals.user) { %>
        <button type="button" class="flex text-sm bg-black/5 dark:bg-white/10 rounded-full focus:ring-4 focus:ring-gray-300 dark:focus:ring-gray-600" id="user-menu-button" data-dropdown-toggle="user-dropdown">
          <img class="w-8 h-8 rounded-full object-cover" src="<%= baseUrl + user.img %>" alt="user photo">
        </button>
  
        <div class="z-50 hidden my-4 text-base list-none card-theme rounded-lg shadow-xl min-w-[200px]" id="user-dropdown">          
          <div class="flex justify-center py-4 rounded-t-lg">
            <img src="<%= baseUrl + user.img %>" alt="user photo" class="w-20 h-20 rounded-full border-4 border-white dark:border-white/10 object-cover shadow-lg">
          </div>
       
          <div class="divide-y divide-black/5 dark:divide-white/10">
            <div class="px-4 pt-1 pb-3 text-center">
              <span class="block text-sm font-bold opacity-90 text-[var(--text-main)]"><%= user.username %></span>
              <span class="block text-xs opacity-60 truncate text-[var(--text-sub)]"><%= user.email %></span>
            </div>
            <ul class="py-2">
              <%
                // The collections block shows the switcher (only useful with 2+ memberships)
                // and/or the self-service creation entry, so it appears as soon as either applies.
                const hasSwitcher = (locals.userCollections || []).length > 1;
                const showCollectionsBlock = hasSwitcher || locals.canCreateCollection;
              %>
              <% if (showCollectionsBlock) { %>
              <li class="px-4 pt-1 pb-1">
                <span class="block text-[9px] uppercase font-bold tracking-wider opacity-50 text-[var(--text-sub)]"><%= t('nav.collections') %></span>
              </li>
              <% } %>
              <% if (hasSwitcher) { %>
              <% (locals.userCollections || []).forEach(c => { %>
              <li>
                <form action="<%= baseUrl %>/collection/switch" method="POST">
                  <input type="hidden" name="collectionId" value="<%= c._id %>">
                  <input type="hidden" name="redirectTo" value="/">
                  <button type="submit" class="w-[calc(100%-1rem)] text-left block px-4 py-2 text-sm text-[var(--text-main)] hover:bg-black/5 dark:hover:bg-white/10 mx-2 rounded transition flex items-center gap-3 <%= String(c._id) === String(locals.activeCollectionId) ? 'font-bold' : '' %>">
                    <i class="fa-solid <%= String(c._id) === String(locals.activeCollectionId) ? 'fa-circle-check text-primary-theme' : 'fa-layer-group opacity-70' %> w-5 text-center"></i>
                    <span class="truncate"><%= c.name %></span>
                  </button>
                </form>
              </li>
              <% }) %>
              <% } %>
              <% if (locals.canCreateCollection) { %>
              <li>
                <button type="button" data-new-collection-open
                  class="w-[calc(100%-1rem)] text-left block px-4 py-2 text-sm text-[var(--text-main)] hover:bg-black/5 dark:hover:bg-white/10 mx-2 rounded transition flex items-center gap-3">
                  <i class="fa-solid fa-plus w-5 text-center opacity-70"></i>
                  <span class="truncate"><%= t('nav.new_collection') %></span>
                </button>
              </li>
              <% } %>
              <% if (showCollectionsBlock) { %>
              <li class="border-t border-black/5 dark:border-white/10 my-1"></li>
              <% } %>
              <% if (locals.isCollectionAdmin || user.isAdmin) { %>
              <li class="px-4 pt-1 pb-1">
                <span class="block text-[9px] uppercase font-bold tracking-wider opacity-50 text-[var(--text-sub)]"><%= t('nav.administration') %></span>
              </li>
              <% if (user.isAdmin) { %>
              <li>
                <a href="<%= baseUrl %>/admin/instance" class="block px-4 py-2 text-sm text-[var(--text-main)] hover:bg-black/5 dark:hover:bg-white/10 mx-2 rounded transition flex items-center gap-3">
                  <i class="fa-solid fa-server w-5 text-center opacity-70"></i> <span><%= t('nav.instance') %></span>
                </a>
              </li>
              <% } %>
              <% if (locals.isCollectionAdmin) { %>
              <li>
                <a href="<%= baseUrl %>/admin" class="block px-4 py-2 text-sm text-[var(--text-main)] hover:bg-black/5 dark:hover:bg-white/10 mx-2 rounded transition flex items-center gap-3">
                  <i class="fa-solid fa-crown w-5 text-center opacity-70"></i> <span><%= t('nav.admin') %></span>
                </a>
              </li>
              <li>
                <a href="<%= baseUrl %>/admin/personnalisation" class="block px-4 py-2 text-sm text-[var(--text-main)] hover:bg-black/5 dark:hover:bg-white/10 mx-2 rounded transition flex items-center gap-3">
                  <i class="fa-solid fa-wand-magic-sparkles w-5 text-center opacity-70"></i> <span>Personnalisation</span>
                </a>
              </li>
              <% } %>
              <li class="border-t border-black/5 dark:border-white/10 my-1"></li>
              <% } %>
              <li>
                <a href="<%= baseUrl %>/settings" class="block px-4 py-2 text-sm text-[var(--text-main)] hover:bg-black/5 dark:hover:bg-white/10 mx-2 rounded transition flex items-center gap-3">
                  <i class="fa-solid fa-user-gear w-5 text-center opacity-70"></i> <span><%= t('nav.settings') %></span>
                </a>
              </li>
              <li>
                <button id="theme-toggle" class="w-[calc(100%-1rem)] text-left block px-4 py-2 text-sm text-[var(--text-main)] hover:bg-black/5 dark:hover:bg-white/10 mx-2 rounded transition flex items-center gap-3">
                    <i id="theme-icon" class="fa-solid fa-moon w-5 text-center"></i> 
                    <span id="theme-text"><%= isDark ? t('nav.theme_light') : t('nav.theme_dark') %></span>
                </button>
              </li>

              <li class="pt-2 border-t border-black/5 dark:border-white/10 mt-2">
                <a href="<%= baseUrl %>/logout" class="block px-4 py-2 text-sm font-bold text-center text-white bg-red-500 hover:bg-red-600 rounded-md mx-4 mb-2 transition-colors shadow-sm">
                  <%= t('nav.logout') %>
                </a>
              </li>
            </ul>
          </div>
        </div>
        <% } else if (locals.isShareView) { %>
          <span class="flex items-center gap-2 text-xs font-black uppercase tracking-widest text-primary-theme">
            <i class="fa-solid fa-eye"></i>
            <%= t('nav.share_view') %>
          </span>
        <% } else { %>
          <a href="<%= baseUrl %>/login" class="text-sm font-bold text-primary-theme hover:underline"><%= t('nav.login') %></a>
        <% } %>

        <button data-collapse-toggle="navbar-user" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm opacity-70 rounded-lg md:hidden hover:bg-black/5 dark:hover:bg-white/10 focus:outline-none text-[var(--text-main)]">
          <i class="fa-solid fa-bars text-xl"></i>
        </button>
      </div>

      <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1" id="navbar-user">
        <ul class="flex flex-col font-medium p-4 md:p-0 mt-4 rounded-lg md:flex-row md:space-x-8 md:mt-0 md:border-0 md:bg-transparent">
          <%
            // Global shortcuts plus shortcuts declared by each plugin (navbarShortcuts)
            const shortcutConfig = {
                'global_home': { label: t('nav.home'), url: '/' },
                'global_collection': { label: t('nav.collection'), url: '/collection' },
                'global_wishlist': { label: t('nav.wishlist'), url: '/wishlist' }
            };
            if (typeof registry !== 'undefined' && registry) {
                registry.getAll().forEach(p => {
                    (p.navbarShortcuts || []).forEach(s => {
                        shortcutConfig[s.id] = { label: t(s.label), url: s.url, module: p.collectionType, pluginId: p.id };
                    });
                });
            }

            // A scoped share link only ever browses its allowlisted types/formats -
            // drop shortcuts that would otherwise land a guest on an empty/blocked
            // page, and drop account-only shortcuts (home, wishlist) that just
            // bounce them to /login.
            const shareScopeList = locals.isShareView ? (locals.shareScope || []) : null;
            const shareScopeMap = shareScopeList && shareScopeList.length > 0
                ? new Map(shareScopeList.map(s => [s.pluginId, s.formats || []]))
                : null;

            function shortcutAllowed(id, item) {
                if (locals.isShareView && (id === 'global_home' || id === 'global_wishlist')) return false;
                if (!shareScopeMap) return true;
                if (!item.pluginId) return true;
                if (!shareScopeMap.has(item.pluginId)) return false;
                const allowedFormats = shareScopeMap.get(item.pluginId);
                if (allowedFormats.length === 0) return true;
                const qIndex = item.url.indexOf('?');
                const params = new URLSearchParams(qIndex >= 0 ? item.url.slice(qIndex + 1) : '');
                const fmt = params.get('format');
                return !fmt || allowedFormats.includes(fmt);
            }

            if (settings && settings.navbarShortcuts) {
              settings.navbarShortcuts.forEach(id => {
                const item = shortcutConfig[id];
                if (item && shortcutAllowed(id, item)) {
                  const isModuleActive = item.module ? settings.modules[item.module] : true;

                  if (isModuleActive) { %>
                    <li>
                      <a href="<%= baseUrl + item.url %>" class="block py-2 px-3 md:p-0 text-[var(--text-sub)] hover:text-primary-theme transition-colors">
                        <%= item.label %>
                      </a>
                    </li>
                  <% }
                }
              });
          } %>
        </ul>
      </div>
    </div>
  </nav>

  <% if (locals.user && locals.canCreateCollection) { %>
  <!-- Self-service collection creation, opened from the user dropdown. Self-contained
       (its own toggle script) since the header is included by every page. -->
  <div id="newCollectionModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="absolute inset-0" data-new-collection-close></div>
    <div class="relative card-theme rounded-[2rem] p-8 md:p-10 shadow-2xl w-full max-w-md">
      <button type="button" data-new-collection-close
        class="absolute top-5 right-5 w-9 h-9 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors text-[var(--text-main)]">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <h3 class="text-2xl font-black mb-8 text-[var(--text-main)]"><%= t('nav.new_collection') %></h3>
      <form action="<%= baseUrl %>/collection/create" method="POST" class="space-y-6">
        <input type="text" name="name" required maxlength="60" autocomplete="off"
          placeholder="<%= t('admin.collections.name_placeholder') %>"
          class="w-full p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-sm text-[var(--text-main)] focus:outline-none focus:border-primary-theme transition-colors">
        <button type="submit"
          class="w-full flex items-center justify-center gap-2 bg-primary-theme hover:brightness-110 text-white px-6 py-4 rounded-2xl shadow-lg shadow-primary-theme/20 transition-all active:scale-95">
          <i class="fa-solid fa-plus text-sm"></i>
          <span class="text-xs font-black"><%= t('admin.collections.create') %></span>
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <script>
    document.body.classList.add('js-ready');
    const navTranslations = {
        themeDark: <%- JSON.stringify(t('nav.theme_dark')) %>,
        themeLight: <%- JSON.stringify(t('nav.theme_light')) %>
    };
    
    document.addEventListener('DOMContentLoaded', () => {
        const themeToggleBtn = document.getElementById('theme-toggle');
        const themeIcon = document.getElementById('theme-icon');
        const themeText = document.getElementById('theme-text');
        const htmlElement = document.documentElement;
  
        function updateButtonVisuals() {
            const isDark = htmlElement.classList.contains('dark');
            if(themeIcon && themeText) {
                if (isDark) {
                    themeIcon.className = 'fa-solid fa-sun w-5 text-center text-yellow-400';
                    themeText.textContent = navTranslations.themeLight;
                } else {
                    themeIcon.className = 'fa-solid fa-moon w-5 text-center text-indigo-500';
                    themeText.textContent = navTranslations.themeDark;
                }
            }
        }
        
        updateButtonVisuals();
  
        if(themeToggleBtn){
            themeToggleBtn.addEventListener('click', async () => {
                htmlElement.classList.toggle('dark');
                updateButtonVisuals();
                const newTheme = htmlElement.classList.contains('dark') ? 'dark' : 'light';
                try {
                    await fetch('<%= baseUrl %>/settings/update-theme', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ theme: newTheme })
                    });
                } catch (e) { console.error('Erreur thème', e); }
            });
        }
    });
    
    // New-collection modal (only rendered when the user is allowed to create one)
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('newCollectionModal');
        if (!modal) return;

        const setOpen = (open) => {
            modal.classList.toggle('hidden', !open);
            modal.classList.toggle('flex', open);
            if (open) modal.querySelector('input[name="name"]')?.focus();
        };

        document.querySelectorAll('[data-new-collection-open]')
            .forEach(el => el.addEventListener('click', () => setOpen(true)));
        modal.querySelectorAll('[data-new-collection-close]')
            .forEach(el => el.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') setOpen(false);
        });
    });

    window.addEventListener('load', () => {
        const loader = document.getElementById('page-loader');
        if(loader) {
            loader.style.opacity = '0';
            setTimeout(() => { loader.remove(); }, 500);
        }
    });
  </script>

  <main class="p-6 flex-1">
