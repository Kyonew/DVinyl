<%#
    The layout choices of the Personnalisation studio (core/layout.ts), laid out for its
    narrow side panel. Fields are named layout_<key> and read back by layoutFromForm().
    Markup only: the studio's script previews every change (views/personnalisation.ejs).

    Expects `part`: 'nav' (where the navigation sits, and that position's own options)
    or 'look' (density, corners, size, width, font).
%>
<%
    const current = resolveLayout(settings);
    const opts = LAYOUT_OPTIONS;
    const pillClass = 'flex items-center justify-center gap-1.5 px-2 py-2 rounded-xl bg-black/5 dark:bg-white/5 text-xs font-semibold text-center transition-all opacity-70 hover:opacity-100 peer-checked:opacity-100 peer-checked:bg-primary-theme peer-checked:text-white peer-checked:shadow-md peer-focus-visible:ring-2 peer-focus-visible:ring-primary-theme/50';
    const fieldLabel = 'block text-[11px] font-bold uppercase tracking-widest opacity-60 mb-2';
%>

<% if (locals.part === 'nav') { %>
<div class="space-y-4">
    <div class="grid grid-cols-2 gap-2">
        <% opts.nav.forEach(pos => { %>
            <label class="cursor-pointer">
                <input type="radio" name="layout_nav" value="<%= pos %>" class="peer sr-only" <%= current.nav === pos ? 'checked' : '' %>>
                <div class="h-full p-2 rounded-xl border-2 border-transparent bg-black/5 dark:bg-white/5 transition-all hover:bg-black/10 dark:hover:bg-white/10 peer-checked:border-primary-theme peer-checked:bg-primary-theme/10 peer-focus-visible:ring-2 peer-focus-visible:ring-primary-theme/50">
                    <%# A thumbnail of the screen in the theme's own colours. %>
                    <div class="relative aspect-[16/10] rounded-md overflow-hidden border border-[var(--border-color)]" style="background-color: var(--bg-page);" aria-hidden="true">
                        <%
                            const nav = { top: 'top-0 inset-x-0 h-[17%]', left: 'left-0 inset-y-0 w-[22%]', right: 'right-0 inset-y-0 w-[22%]', bottom: 'bottom-[7%] left-1/2 -translate-x-1/2 w-[52%] h-[15%] rounded-full' }[pos];
                            const body = { top: 'top-[26%] inset-x-[8%] bottom-[8%]', left: 'top-[10%] left-[30%] right-[7%] bottom-[10%]', right: 'top-[10%] left-[7%] right-[30%] bottom-[10%]', bottom: 'top-[10%] inset-x-[8%] bottom-[30%]' }[pos];
                            const isSide = pos === 'left' || pos === 'right';
                        %>
                        <span class="absolute <%= nav %> flex <%= isSide ? 'flex-col items-center pt-[14%] gap-[9%]' : 'items-center justify-center gap-[7%]' %>" style="background-color: var(--bg-nav);">
                            <% for (let i = 0; i < 4; i++) { %>
                                <span class="block <%= isSide ? 'w-[45%] h-[5%]' : 'w-[9%] h-[30%]' %> rounded-full <%= i === 0 ? 'bg-primary-theme' : 'bg-white/30' %>"></span>
                            <% } %>
                        </span>
                        <span class="absolute <%= body %> grid grid-cols-3 gap-[6%]">
                            <% for (let i = 0; i < 6; i++) { %>
                                <span class="block rounded-sm" style="background-color: var(--bg-card);"></span>
                            <% } %>
                        </span>
                    </div>
                    <span class="block mt-1.5 text-xs font-bold text-center"><%= t('layout.nav_' + pos) %></span>
                </div>
            </label>
        <% }) %>
    </div>
    <p class="text-xs opacity-50"><i class="fa-solid fa-mobile-screen mr-1" aria-hidden="true"></i><%= t('layout.nav_hint') %></p>

    <%# Each position's own options, shown for the position picked above. %>
    <div data-layout-for="top" class="space-y-3">
        <div>
            <span class="<%= fieldLabel %>"><%= t('layout.top_style') %></span>
            <div class="grid grid-cols-2 gap-2">
                <% opts.topStyle.forEach(v => { %>
                    <label class="cursor-pointer">
                        <input type="radio" name="layout_topStyle" value="<%= v %>" class="peer sr-only" <%= current.topStyle === v ? 'checked' : '' %>>
                        <div class="<%= pillClass %>"><%= t('layout.top_' + v) %></div>
                    </label>
                <% }) %>
            </div>
        </div>
        <%- include('studio-toggle', { name: 'layout_sticky', checked: current.sticky, title: t('layout.sticky'), desc: t('layout.sticky_desc') }) %>
    </div>

    <div data-layout-for="left right">
        <span class="<%= fieldLabel %>"><%= t('layout.sidebar_style') %></span>
        <div class="grid grid-cols-2 gap-2">
            <% opts.sidebar.forEach(v => { %>
                <label class="cursor-pointer">
                    <input type="radio" name="layout_sidebar" value="<%= v %>" class="peer sr-only" <%= current.sidebar === v ? 'checked' : '' %>>
                    <div class="<%= pillClass %>">
                        <i class="fa-solid <%= v === 'rail' ? 'fa-grip-lines-vertical' : 'fa-bars-staggered' %>" aria-hidden="true"></i>
                        <%= t('layout.sidebar_' + v) %>
                    </div>
                </label>
            <% }) %>
        </div>
        <p class="mt-2 text-xs opacity-50"><%= t('layout.sidebar_desc') %></p>
    </div>

    <div data-layout-for="bottom">
        <%- include('studio-toggle', { name: 'layout_dockLabels', checked: current.dockLabels, title: t('layout.dock_labels'), desc: t('layout.dock_labels_desc') }) %>
    </div>
</div>
<% } else { %>
<div class="space-y-5">
    <div>
        <span class="<%= fieldLabel %>"><%= t('layout.density') %></span>
        <div class="grid grid-cols-3 gap-2">
            <% opts.density.forEach(v => { %>
                <label class="cursor-pointer">
                    <input type="radio" name="layout_density" value="<%= v %>" class="peer sr-only" <%= current.density === v ? 'checked' : '' %>>
                    <div class="<%= pillClass %> flex-col">
                        <span class="flex flex-col w-5" style="gap: <%= 3 * opts.densityFactor[v] %>px" aria-hidden="true">
                            <% for (let i = 0; i < 3; i++) { %><span class="block h-[2px] rounded-full bg-current opacity-70"></span><% } %>
                        </span>
                        <%= t('layout.density_' + v) %>
                    </div>
                </label>
            <% }) %>
        </div>
    </div>

    <div>
        <span class="<%= fieldLabel %>"><%= t('layout.radius') %></span>
        <div class="grid grid-cols-4 gap-2">
            <% opts.radius.forEach(v => { %>
                <label class="cursor-pointer">
                    <input type="radio" name="layout_radius" value="<%= v %>" class="peer sr-only" <%= current.radius === v ? 'checked' : '' %>>
                    <%# A fixed radius, not the scale, so each keeps showing its own corner. %>
                    <div class="<%= pillClass %> flex-col">
                        <span class="block w-5 h-5 border-2 border-current border-b-0 border-r-0 opacity-70" style="border-top-left-radius: <%= 10 * opts.radiusFactor[v] %>px" aria-hidden="true"></span>
                        <span class="text-[10px] leading-tight"><%= t('layout.radius_' + v) %></span>
                    </div>
                </label>
            <% }) %>
        </div>
    </div>

    <div>
        <span class="<%= fieldLabel %>"><%= t('layout.scale') %></span>
        <div class="grid grid-cols-3 gap-2">
            <% opts.scale.forEach((v, i) => { %>
                <label class="cursor-pointer">
                    <input type="radio" name="layout_scale" value="<%= v %>" class="peer sr-only" <%= current.scale === v ? 'checked' : '' %>>
                    <div class="<%= pillClass %>">
                        <span class="font-black leading-none" style="font-size: <%= [11, 14, 17][i] %>px" aria-hidden="true">A</span>
                        <%= t('layout.scale_' + v) %>
                    </div>
                </label>
            <% }) %>
        </div>
    </div>

    <div>
        <span class="<%= fieldLabel %>"><%= t('layout.width') %></span>
        <div class="grid grid-cols-4 gap-2">
            <% opts.width.forEach((v, i) => { %>
                <label class="cursor-pointer">
                    <input type="radio" name="layout_width" value="<%= v %>" class="peer sr-only" <%= current.width === v ? 'checked' : '' %>>
                    <div class="<%= pillClass %> flex-col">
                        <span class="flex justify-center w-7 h-3.5 rounded-sm border border-current opacity-70" aria-hidden="true">
                            <span class="block h-full bg-current opacity-60" style="width: <%= [40, 60, 80, 100][i] %>%"></span>
                        </span>
                        <span class="text-[10px] leading-tight"><%= t('layout.width_' + v) %></span>
                    </div>
                </label>
            <% }) %>
        </div>
    </div>

    <div>
        <span class="<%= fieldLabel %>"><%= t('layout.font') %></span>
        <div class="grid grid-cols-3 gap-2">
            <% opts.font.forEach(v => { %>
                <label class="cursor-pointer">
                    <input type="radio" name="layout_font" value="<%= v %>" class="peer sr-only" <%= current.font === v ? 'checked' : '' %>>
                    <div class="<%= pillClass %> flex-col" style="font-family: <%= opts.fontStacks[v] %>">
                        <span class="text-lg font-bold leading-none" aria-hidden="true">Aa</span>
                        <span class="text-[10px] leading-tight truncate max-w-full"><%= t('layout.font_' + v) %></span>
                    </div>
                </label>
            <% }) %>
        </div>
    </div>
</div>
<% } %>
