<%# What became of the last request action, read from ?request_msg= (and request_field=
    for the form field it is about). Only known keys are ever shown. %>
<% const requestMsg = String(locals.requestMsg || ''); %>
<% if (/^[a-z_.]{1,60}$/.test(requestMsg) && requestMsg) { %>
    <% const isDone = requestMsg.startsWith('msg_'); %>
    <div role="status" class="mb-6 rounded-2xl px-4 py-3 text-sm font-semibold flex items-center gap-3 <%= isDone ? 'bg-green-500/15 text-green-700 dark:text-green-300' : 'bg-red-500/15 text-red-700 dark:text-red-300' %>">
        <i class="fa-solid <%= isDone ? 'fa-circle-check' : 'fa-circle-exclamation' %>" aria-hidden="true"></i>
        <span><%= t('requests.' + requestMsg, { field: String(locals.requestField || ''), count: 20, defaultValue: t('requests.err_generic') }) %></span>
    </div>
<% } %>
