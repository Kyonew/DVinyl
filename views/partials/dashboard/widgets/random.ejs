<%
  // One item drawn at random from the shelf, and a button for another one: the widget
  // fetches itself again (GET /dashboard/widgets/:id), handled by the page's script.
  const rndPlugin = data ? (registry.getByKind(data.kind) || null) : null;
  const rndHref = data ? baseUrl + (rndPlugin ? rndPlugin.routePrefix : '/album') + '/' + data._id : '#';
  const rndCreator = data && rndPlugin ? (data[rndPlugin.creatorField] || '') : '';
  const rndAspect = (settings && settings.aspectRatioClass) || 'aspect-square';
  const rndStacked = size === 's';
%>
<div class="card-theme h-full rounded-2xl p-4 md:p-5 flex flex-col gap-3">
    <div class="flex items-center justify-between gap-2">
        <h3 class="font-bold flex items-center gap-2 min-w-0"><i class="fa-solid fa-shuffle text-primary-theme" aria-hidden="true"></i><span class="truncate"><%= t('dashboard.random_title') %></span></h3>
        <button type="button" data-widget-refresh aria-label="<%= t('dashboard.random_another') %>" title="<%= t('dashboard.random_another') %>"
            class="flex-none w-9 h-9 rounded-full bg-black/5 dark:bg-white/10 hover:bg-primary-theme hover:text-white transition-colors flex items-center justify-center">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
        </button>
    </div>
    <% if (!data) { %>
        <p class="text-sm opacity-60"><%= t('index.empty_collection') %></p>
    <% } else { %>
        <a href="<%= rndHref %>" class="flex-1 flex <%= rndStacked ? 'flex-col' : 'items-center' %> gap-4 group min-w-0">
            <span class="block <%= rndStacked ? 'w-full' : 'w-28 md:w-32 flex-none' %> rounded-xl overflow-hidden shadow-lg shadow-black/25 group-hover:scale-[1.02] transition-transform">
                <%- include('../../item-cover', { item: data, plugin: rndPlugin, gridAspect: rndAspect, settings, badgeSize: 'compact' }) %>
            </span>
            <span class="min-w-0">
                <span class="block font-bold leading-snug line-clamp-2 group-hover:text-primary-theme transition-colors"><%= data.title %></span>
                <span class="block text-sm opacity-60 truncate"><%= rndCreator %></span>
            </span>
        </a>
    <% } %>
</div>
