<%# The collection as furniture: items standing on their spine in the compartment their
    location names, plus a reserve for everything standing nowhere.

    Spines are drawn to the sizes core/spine.ts measured: heights to true scale against
    the tallest format in the piece, thicknesses compressed onto a readable range. Each
    spine is painted in one tint of a fixed palette picked from its title, and carries the
    few details that tell its kind of object apart (the `shape` its plugin declares).

    The piece follows a real room in two ways: what goes past a compartment's capacity is
    laid flat in a pile at the end of its board, and the last item of a compartment with
    room left leans on its neighbour. Both are decided in core/spine.ts.

    An editor can drag a spine from one compartment to another, which is the same
    POST /shelf/move the bulk action uses, with one item instead of thirty. Dragging is
    a mouse gesture and nothing else: a touch screen has no dragstart, so a tap on a
    spine opens a sheet instead, from which the item can be opened or filed elsewhere. %>

<style>
    <%# Everything the piece is painted with, per theme mode. The niches and the floor are
        translucent so they sit on whatever card colour the active theme gives. %>
    .shelf-piece {
        --spine-scale: 1;
        --shelf-niche: rgb(0 0 0 / 0.035);
        --shelf-niche-shadow: inset 0 1px 3px rgb(0 0 0 / 0.06);
        --shelf-floor: rgb(0 0 0 / 0.14);
        --spine-ink: #0f172a;
    }

    .dark .shelf-piece {
        --shelf-niche: rgb(0 0 0 / 0.25);
        --shelf-niche-shadow: inset 0 2px 6px rgb(0 0 0 / 0.35);
        --shelf-floor: rgb(255 255 255 / 0.12);
        --spine-ink: #f5f5f5;
    }

    <%# The palette core/spine.ts picks from (SPINE_TONES entries): soft pastels on a
        light page, muted deep tones on a dark one, both quiet enough to leave the
        theme's accent the only loud colour on screen. %>
    .shelf-spine[data-tone="0"]  { --tone: #ead9c3; }
    .shelf-spine[data-tone="1"]  { --tone: #c9dbea; }
    .shelf-spine[data-tone="2"]  { --tone: #d4e6cf; }
    .shelf-spine[data-tone="3"]  { --tone: #eccac5; }
    .shelf-spine[data-tone="4"]  { --tone: #dad3ea; }
    .shelf-spine[data-tone="5"]  { --tone: #f1e2b3; }
    .shelf-spine[data-tone="6"]  { --tone: #c8e3df; }
    .shelf-spine[data-tone="7"]  { --tone: #e6d0e2; }
    .shelf-spine[data-tone="8"]  { --tone: #d9dfe7; }
    .shelf-spine[data-tone="9"]  { --tone: #ebd6bf; }
    .shelf-spine[data-tone="10"] { --tone: #bfd9cd; }
    .shelf-spine[data-tone="11"] { --tone: #f1d4bf; }
    .dark .shelf-spine[data-tone="0"]  { --tone: #4a4035; }
    .dark .shelf-spine[data-tone="1"]  { --tone: #2f4254; }
    .dark .shelf-spine[data-tone="2"]  { --tone: #34473b; }
    .dark .shelf-spine[data-tone="3"]  { --tone: #523937; }
    .dark .shelf-spine[data-tone="4"]  { --tone: #3e3955; }
    .dark .shelf-spine[data-tone="5"]  { --tone: #504833; }
    .dark .shelf-spine[data-tone="6"]  { --tone: #2f4a47; }
    .dark .shelf-spine[data-tone="7"]  { --tone: #4b364b; }
    .dark .shelf-spine[data-tone="8"]  { --tone: #383e48; }
    .dark .shelf-spine[data-tone="9"]  { --tone: #524231; }
    .dark .shelf-spine[data-tone="10"] { --tone: #2d453b; }
    .dark .shelf-spine[data-tone="11"] { --tone: #553d31; }

    <%# The furniture's own grid. The column count is a property of the piece, so it
        arrives as a custom property rather than a Tailwind class: an inline
        grid-template-columns would win over any breakpoint class and the piece could
        never fold. %>
    .shelf-grid {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(var(--shelf-columns, 1), minmax(0, 1fr));
    }

    .shelf-niche {
        background: var(--shelf-niche);
        box-shadow: var(--shelf-niche-shadow);
    }

    <%# The board the spines stand on is the scroller's own bottom edge, so it stays put
        while a long compartment scrolls above it. The top padding is headroom for a
        spine lifted by the pointer. %>
    .shelf-scroll {
        overflow-x: auto;
        padding: 12px 12px 0;
        border-bottom: 5px solid var(--shelf-floor);
        scrollbar-width: thin;
    }

    <%# Set by script while there is more board to the right than the compartment shows. %>
    .shelf-scroll.is-clipped {
        -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 40px), transparent);
        mask-image: linear-gradient(90deg, #000 calc(100% - 40px), transparent);
    }

    .shelf-plank {
        display: flex;
        align-items: flex-end;
        gap: 2px;
        min-width: min-content;
        height: calc(var(--plank-h) * var(--spine-scale));
    }

    .shelf-spine {
        position: relative;
        flex: 0 0 auto;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        width: var(--w);
        height: calc(var(--h) * var(--spine-scale));
        border-radius: 3px 3px 0 0;
        background-color: var(--tone, #d9dfe7);
        color: var(--spine-ink);
        transform-origin: bottom left;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .shelf-spine:hover {
        transform: translateY(-6px);
        box-shadow: 0 0 0 2px rgb(var(--highlight-rgb));
    }

    .shelf-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        writing-mode: vertical-rl;
        max-height: calc(100% - 14px);
        overflow: hidden;
        pointer-events: none;
    }

    <%# Spines read from the bottom up across continental Europe, from the top down in
        the English-speaking world: the shelf follows the language the page is in. %>
    html:not([lang^="en"]) .shelf-label { transform: rotate(180deg); }

    .shelf-title,
    .shelf-sub {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-height: 100%;
        line-height: 1;
    }

    .shelf-title { font-size: 10.5px; font-weight: 700; }
    .shelf-sub { font-size: 9.5px; font-weight: 500; opacity: 0.6; }

    <%# The details that tell one kind of object from another, kept flat: a jewel case
        hinge, the rounded top of a moulded case, the bands of a bound book. %>
    .shelf-spine[data-shape="sleeve"] { background-image: linear-gradient(90deg, rgb(255 255 255 / 0.35) 0 1px, transparent 1px); }
    .shelf-spine[data-shape="jewel"] { border-radius: 2px 2px 0 0; background-image: linear-gradient(90deg, rgb(255 255 255 / 0.55) 0 2px, rgb(0 0 0 / 0.12) 2px 3px, transparent 3px); }
    .shelf-spine[data-shape="case"] { border-radius: 7px 7px 0 0; background-image: linear-gradient(180deg, rgb(0 0 0 / 0.12) 0 3px, transparent 3px); }
    .shelf-spine[data-shape="book"] { border-radius: 6px 6px 0 0; background-image: linear-gradient(180deg, transparent 0 10px, rgb(0 0 0 / 0.16) 10px 12px, transparent 12px calc(100% - 12px), rgb(0 0 0 / 0.16) calc(100% - 12px) calc(100% - 10px), transparent calc(100% - 10px)); }
    .shelf-spine[data-shape="book"] .shelf-label { max-height: calc(100% - 30px); }
    .shelf-spine[data-shape="box"] { border-radius: 4px 4px 0 0; background-image: linear-gradient(180deg, rgb(255 255 255 / 0.25) 0 2px, transparent 2px); }

    <%# The last upright item of a compartment with room left rests on its neighbour.
        Recomputed by the drag script after a drop, so it follows the shelf as it fills. %>
    .shelf-plank[data-lean] > .shelf-spine:last-of-type:not(:first-of-type) {
        transform: rotate(-5deg);
        margin-left: calc(var(--h) * var(--spine-scale) * 0.09 + 2px);
    }

    .shelf-plank[data-lean] > .shelf-spine:last-of-type:not(:first-of-type):hover {
        transform: rotate(-5deg) translateY(-6px);
    }

    <%# Laid flat: the same element as an upright spine, with its two dimensions swapped
        and its name read across. Moving it in or out of a pile is all it takes to stand
        it up or lay it down. %>
    .shelf-pile {
        display: flex;
        flex-direction: column-reverse;
        align-items: flex-start;
        flex: 0 0 auto;
        margin-left: 6px;
    }

    .shelf-pile .shelf-spine {
        width: calc(var(--h) * var(--spine-scale));
        height: var(--w);
        justify-content: flex-start;
        padding: 0 8px;
        border-radius: 0 4px 4px 0;
        border-bottom: 1px solid rgb(0 0 0 / 0.08);
        background-image: none;
    }

    .shelf-pile .shelf-spine:hover { transform: translateX(4px); }
    <%# Specific enough to beat the per-shape label rules: a book's inset for its bands
        would leave a lying book no height at all for its name. %>
    .shelf-pile .shelf-spine .shelf-label {
        writing-mode: horizontal-tb;
        transform: none;
        align-items: flex-start;
        max-height: none;
        max-width: 100%;
    }

    .shelf-pile .shelf-title { max-width: 100%; }
    .shelf-pile .shelf-sub { display: none; }

    <%# The reserve is nothing but piles, each on its own bit of floor, wrapping like
        stacks along a wall. On a phone it scrolls sideways like any compartment. %>
    .shelf-reserve .shelf-plank {
        height: auto;
        min-height: 60px;
        flex-wrap: wrap;
        gap: 18px 24px;
        padding-bottom: 12px;
    }

    .shelf-reserve .shelf-pile {
        margin-left: 0;
        padding: 0 4px;
        border-bottom: 4px solid var(--shelf-floor);
    }

    .shelf-gauge {
        width: 44px;
        height: 4px;
        border-radius: 2px;
        background: rgb(0 0 0 / 0.08);
        overflow: hidden;
        flex-shrink: 0;
    }

    .dark .shelf-gauge { background: rgb(255 255 255 / 0.14); }
    .shelf-gauge > span { display: block; height: 100%; border-radius: 2px; background: currentColor; }

    <%# Fill state, shared by the counter, the gauge and the plan: nothing to say, full,
        or over (which is when a pile has started). %>
    .shelf-fill { opacity: 0.45; }
    .shelf-fill.is-full { opacity: 1; color: rgb(var(--highlight-rgb)); }
    .shelf-fill.is-over { opacity: 1; color: #f59e0b; }

    @media (max-width: 767px) {
        <%# No screen holds four compartments side by side and still lets a spine be
            read, so the piece unfolds into one full-width band per compartment, with
            shorter spines so more bands fit on a screen. Thicknesses stay: they are
            what keeps a name readable. The plan above the bands keeps the shape. %>
        .shelf-piece { --spine-scale: 0.78; }
        .shelf-grid { grid-template-columns: 1fr; }
        .shelf-reserve .shelf-plank { flex-wrap: nowrap; }

        <%# Room the piece has and nobody has named yet. Worth drawing where the shape
            of the furniture is visible, pure noise once it is a stack of bands. %>
        .shelf-grid .shelf-slot-empty { display: none; }
    }

    .shelf-spine[draggable="true"] { cursor: grab; }
    .shelf-spine.is-dragging { opacity: 0.35; cursor: grabbing; }

    <%# The compartment being aimed at. Outlined rather than filled, so the spines
        already standing in it stay readable while something is held over them. %>
    .shelf-drop.is-target {
        outline: 2px dashed rgb(var(--highlight-rgb));
        outline-offset: -2px;
        border-radius: 0.75rem;
    }

    <%# Said by a compartment holding nothing. Inside the plank rather than instead of
        it, or an empty shelf would be the one thing nothing could be dropped onto. %>
    .shelf-empty-label {
        margin: auto;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.25;
    }

    #shelfPeek { pointer-events: none; }

    @media (prefers-reduced-motion: reduce) {
        .shelf-spine { transition: none; }
        .shelf-spine:hover { transform: none; }
    }
</style>

<% if (!locals.activeFurniture) { %>

    <div class="card-theme border rounded-2xl px-6 py-12 text-center">
        <i class="fa-solid fa-table-columns text-3xl opacity-20 mb-4"></i>
        <p class="text-sm opacity-60 mb-5"><%= t('collection.shelf_no_furniture') %></p>
        <% if (locals.canEditCollection) { %>
            <button type="button" onclick="shelfCreateFurniture()"
                class="px-5 py-2.5 bg-primary-theme text-white rounded-lg text-sm font-bold hover:brightness-110 active:scale-95 transition-all">
                <i class="fa-solid fa-plus mr-1.5"></i><%= t('collection.shelf_new_furniture') %>
            </button>
        <% } %>
    </div>

    <% if (locals.canEditCollection) { %>
        <%# The editor panel needs a piece of furniture to edit, so with none built yet
            only its "create" step is reachable, on its own. %>
        <script>
            async function shelfCreateFurniture() {
                const name = prompt(<%- JSON.stringify(t('collection.shelf_new_furniture_prompt')) %>);
                if (!name || !name.trim()) return;
                const res = await fetch('<%= baseUrl %>/shelf/furniture', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name })
                });
                const data = await res.json().catch(() => ({}));
                if (data.success) window.location.href = '<%= baseUrl %>/collection?view=shelf&furniture=' + data.id;
                else alert(<%- JSON.stringify(t('errors.generic_server_error')) %>);
            }
        </script>
    <% } %>

<% } else { %>

    <%
        // One page is one piece of furniture, so the pieces are the pager.
        const spineHref = (item) => {
            const itemPlugin = registry.getByKind(item.kind);
            return baseUrl + (itemPlugin ? itemPlugin.routePrefix : '/album') + '/' + item._id;
        };

        // The line a card shows under its title when it names the creator (artist,
        // author, director), read the same way the cards read it so a share link never
        // shows here what it hides there.
        const spineSub = (item) => {
            const itemPlugin = registry.getByKind(item.kind);
            if (!itemPlugin) return '';
            const line = getCardLines(itemPlugin, item, { lang: currentLng, isShareView: locals.isShareView === true })
                .find(l => l.name === itemPlugin.creatorField);
            if (!line) return '';
            return line.translateValue ? t(line.value, { defaultValue: line.value }) : line.value;
        };

        // Room for the tallest spine; the scale and the floor are the stylesheet's.
        const plankHeight = shelfMaxSpineHeight;

        // How full a compartment reads, for the counter, the gauge and the plan. Without
        // a capacity there is no "full": the gauge then compares compartments with the
        // busiest one of the piece.
        const busiest = Math.max(1, ...shelfRows.flat().filter(Boolean).map(cell => cell.items.length));
        const fillOf = (cell) => {
            const count = cell.items.length;
            const capacity = cell.capacity;
            return {
                percent: Math.min(100, Math.round(100 * count / (capacity > 0 ? capacity : busiest))),
                state: capacity > 0 && count > capacity ? 'is-over' : (capacity > 0 && count === capacity ? 'is-full' : '')
            };
        };

        // Compartments are numbered in reading order, which is what the plan links to.
        let cellIndex = 0;
    %>

    <%# One spine, standing or laid flat: which of the two is the stylesheet's business,
        decided by whether it sits in a pile. %>
    <% const spine = (item, where) => { %>
        <% const sub = spineSub(item); %>
        <a href="<%= spineHref(item) %>"
            class="shelf-spine"
            title="<%= item.title %><%= sub ? ' · ' + sub : '' %>"
            data-item-id="<%= item._id %>"
            data-tone="<%= item.spine.tone %>"
            data-shape="<%= item.spine.shape %>"
            data-cover="<%= itemImageUrl(item.cover_image) %>"
            data-sub="<%= sub %>"
            data-where="<%= where %>"
            <% if (locals.canEditCollection) { %>draggable="true"<% } %>
            style="--w: <%= item.spine.width %>px; --h: <%= item.spine.height %>px;">
            <span class="shelf-label">
                <span class="shelf-title"><%= item.title %></span>
                <% if (sub && item.spine.width >= 28) { %><span class="shelf-sub"><%= sub %></span><% } %>
            </span>
        </a>
    <% } %>

    <div class="flex flex-wrap items-center gap-2 mb-6">
        <% if (furnitureList.length > 1) { %>
            <% furnitureList.forEach(piece => { %>
                <a href="<%= piece.href %>"
                    class="px-4 py-2 rounded-full text-xs font-bold transition-all active:scale-95 <%= String(piece._id) === String(activeFurniture._id) ? 'bg-primary-theme text-white shadow-lg' : 'bg-black/5 dark:bg-white/10 opacity-60 hover:opacity-100' %>">
                    <%= piece.name %>
                </a>
            <% }) %>
        <% } else { %>
            <span class="px-4 py-2 rounded-full text-xs font-bold bg-black/5 dark:bg-white/10 opacity-60"><%= activeFurniture.name %></span>
        <% } %>

        <% if (locals.canEditCollection) { %>
            <%# On a phone the chips and the buttons never fit on one line, so the buttons
                take a row of their own and share it evenly instead of hanging off the right. %>
            <div class="w-full sm:w-auto sm:ml-auto flex gap-2">
                <button type="button" onclick="shelfEditor.open()"
                    class="flex-1 sm:flex-none whitespace-nowrap px-4 py-2 card-theme border rounded-lg text-xs font-bold uppercase tracking-wider sm:tracking-widest hover:text-primary-theme hover:border-primary-theme transition-all">
                    <i class="fa-solid fa-sliders mr-1.5"></i><%= t('collection.shelf_arrange') %>
                </button>
                <button type="button" onclick="shelfEditor.createFurniture()"
                    class="flex-1 sm:flex-none whitespace-nowrap px-4 py-2 card-theme border rounded-lg text-xs font-bold uppercase tracking-wider sm:tracking-widest hover:text-primary-theme hover:border-primary-theme transition-all">
                    <i class="fa-solid fa-plus mr-1.5"></i><%= t('collection.shelf_new_furniture') %>
                </button>
            </div>
        <% } %>
    </div>

    <% if (locals.canEditCollection) { %>
        <%- include('shelf-editor') %>
    <% } %>

    <%# The plan of the piece, for a phone only: once the compartments are a stack of
        bands the shape of the furniture is gone, and this is where it survives, with
        each compartment one tap away. Pointless with a single compartment. %>
    <% if (shelfRows.flat().filter(Boolean).length > 1) { %>
        <nav class="md:hidden card-theme border rounded-xl p-2.5 mb-3" aria-label="<%= t('collection.shelf_map') %>">
            <p class="text-[10px] font-bold uppercase tracking-widest opacity-50 mb-2"><%= t('collection.shelf_map') %></p>
            <div class="grid gap-1" style="grid-template-columns: repeat(<%= shelfColumns %>, minmax(0, 1fr));">
                <% let mapIndex = 0; %>
                <% shelfRows.forEach(slots => { slots.forEach(cell => { %>
                    <% if (!cell) { %>
                        <span class="rounded-md border border-dashed border-black/10 dark:border-white/10 min-h-[44px]"></span>
                    <% } else { const fill = fillOf(cell); %>
                        <a href="#shelf-cell-<%= mapIndex++ %>"
                            class="shelf-niche rounded-md min-h-[44px] px-2 py-1.5 flex flex-col justify-between gap-1.5 text-[10px] font-bold">
                            <span class="truncate"><%= cell.name %></span>
                            <span class="shelf-gauge w-full shelf-fill <%= fill.state %>"><span style="width: <%= fill.percent %>%;"></span></span>
                        </a>
                    <% } %>
                <% }) }) %>
            </div>
        </nav>
    <% } %>

    <div class="shelf-piece card-theme border rounded-2xl p-2 sm:p-3">
        <div class="shelf-grid" style="--shelf-columns: <%= shelfColumns %>;">
            <% shelfRows.forEach(slots => { slots.forEach(cell => { %>
                <% if (!cell) { %>
                    <%# A compartment the furniture has room for and nobody named yet. %>
                    <div class="shelf-slot-empty rounded-xl border border-dashed border-black/10 dark:border-white/10 min-h-[120px]"></div>
                <% } else { const fill = fillOf(cell); %>
                    <section id="shelf-cell-<%= cellIndex++ %>" class="shelf-niche rounded-xl overflow-hidden flex flex-col min-w-0 scroll-mt-24">
                        <div class="px-3 pt-2.5 flex items-center gap-2">
                            <h3 class="text-[11px] font-bold uppercase tracking-widest truncate" title="<%= cell.name %>">
                                <%= cell.name %>
                            </h3>
                            <span class="ml-auto text-[10px] font-bold tabular-nums flex-shrink-0 shelf-fill <%= fill.state %>"
                                data-shelf-count="<%= cell.name %>" data-capacity="<%= cell.capacity %>">
                                <%= cell.items.length %><% if (cell.capacity > 0) { %>/<%= cell.capacity %><% } %>
                            </span>
                            <span class="shelf-gauge shelf-fill <%= fill.state %>" data-shelf-gauge="<%= cell.name %>">
                                <span style="width: <%= fill.percent %>%;"></span>
                            </span>
                        </div>

                        <div class="shelf-scroll custom-scrollbar shelf-drop" data-shelf="<%= cell.name %>">
                            <div class="shelf-plank" style="--plank-h: <%= plankHeight %>px;" <%= cell.lean ? 'data-lean' : '' %>>
                                <span class="shelf-empty-label" <%= cell.items.length > 0 ? 'hidden' : '' %>><%= t('collection.shelf_empty_cell') %></span>
                                <% cell.standing.forEach(item => spine(item, cell.name)) %>
                                <% if (cell.pile.length > 0) { %>
                                    <span class="shelf-pile">
                                        <% cell.pile.forEach(item => spine(item, cell.name)) %>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </section>
                <% } %>
            <% }) }) %>
        </div>
    </div>

    <% if (unsortedTotal > 0) { %>
        <div class="mt-8">
            <div class="flex items-baseline justify-between gap-3 mb-3">
                <h2 class="text-xs font-bold uppercase tracking-widest opacity-50">
                    <%= t('collection.shelf_unsorted') %>
                    <span class="ml-2 opacity-60 tabular-nums" data-unsorted-count><%= unsortedTotal %></span>
                </h2>
                <% if (unsortedShown < unsortedTotal) { %>
                    <span class="text-[10px] uppercase tracking-widest opacity-40">
                        <%= unsortedTotal - unsortedShown %> <%= t('collection.shelf_more_hidden') %>
                    </span>
                <% } %>
            </div>

            <div class="shelf-piece shelf-reserve rounded-xl border-2 border-dashed border-black/10 dark:border-white/10">
                <div class="shelf-scroll custom-scrollbar shelf-drop" data-shelf="" style="border-bottom: none;">
                    <div class="shelf-plank">
                        <span class="shelf-empty-label" <%= unsorted.length > 0 ? 'hidden' : '' %>><%= t('collection.shelf_empty_cell') %></span>
                        <% unsortedPiles.forEach(pile => { %>
                            <span class="shelf-pile">
                                <% pile.forEach(item => spine(item, t('collection.shelf_unsorted'))) %>
                            </span>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <%# Shown next to a spine under the pointer: the cover and the creator the spine has
        no room for. Moved by script; one for the whole page. %>
    <div id="shelfPeek" class="hidden fixed z-50 w-64 card-theme border rounded-xl shadow-2xl p-3 gap-3" aria-hidden="true">
        <img data-peek-cover class="w-16 h-16 rounded-lg object-cover flex-shrink-0 bg-black/5 dark:bg-white/5" alt="">
        <div class="min-w-0 flex flex-col gap-0.5">
            <p data-peek-title class="text-sm font-bold truncate"></p>
            <p data-peek-sub class="text-xs opacity-60 truncate"></p>
            <p data-peek-where class="mt-1.5 text-[10px] font-bold uppercase tracking-widest text-primary-theme truncate"></p>
        </div>
    </div>

    <%# What a tap on a spine opens on a touch screen, where there is no pointer to hover
        with and no drag to file things away with. %>
    <div id="shelfSheet" class="hidden fixed inset-0 z-50" role="dialog" aria-modal="true" aria-labelledby="shelfSheetTitle">
        <div class="absolute inset-0 bg-black/60" data-sheet-close></div>
        <div class="absolute inset-x-0 bottom-0 card-theme border-t rounded-t-2xl shadow-2xl px-4 pt-2.5 pb-6 flex flex-col gap-4">
            <button type="button" data-sheet-close class="self-center w-12 h-5 flex items-center justify-center" aria-label="<%= t('collection.shelf_close') %>">
                <span class="block w-10 h-1 rounded-full bg-black/15 dark:bg-white/20"></span>
            </button>
            <div class="flex gap-3.5 items-center">
                <img data-sheet-cover class="w-20 h-20 rounded-lg object-cover flex-shrink-0 bg-black/5 dark:bg-white/5" alt="">
                <div class="min-w-0 flex flex-col gap-1">
                    <p id="shelfSheetTitle" data-sheet-title class="text-base font-bold leading-tight"></p>
                    <p data-sheet-sub class="text-sm opacity-60 truncate"></p>
                    <p data-sheet-where class="mt-1 self-start px-2.5 py-1 rounded-full bg-black/5 dark:bg-white/10 text-[10px] font-bold uppercase tracking-widest truncate max-w-full"></p>
                </div>
            </div>
            <a data-sheet-open href="#"
                class="min-h-[44px] flex items-center justify-center bg-primary-theme text-white rounded-lg text-xs font-bold uppercase tracking-widest active:scale-95 transition-all">
                <%= t('collection.shelf_open_item') %>
            </a>
            <% if (locals.canEditCollection) { %>
                <button type="button" data-sheet-move
                    class="min-h-[44px] flex items-center justify-center card-theme border rounded-lg text-xs font-bold uppercase tracking-widest active:scale-95 transition-all">
                    <i class="fa-solid fa-inbox mr-2"></i><%= t('collection.shelf_move_one') %>
                </button>
            <% } %>
        </div>
    </div>

    <script>
        <%# Peek, sheet and the board fades. Everything listens on the document, so the
            spines live search swaps in keep working, and the guard keeps a second copy of
            this script from listening twice. %>
        (function () {
            if (window.__shelfViewWired) return;
            window.__shelfViewWired = true;

            const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
            let peekTimer = null;

            function fill(root, prefix, spine) {
                root.querySelector('[data-' + prefix + '-cover]').src = spine.dataset.cover;
                root.querySelector('[data-' + prefix + '-title]').textContent = spine.querySelector('.shelf-title').textContent;
                root.querySelector('[data-' + prefix + '-sub]').textContent = spine.dataset.sub || '';
                root.querySelector('[data-' + prefix + '-where]').textContent = spine.dataset.where || '';
            }

            function hidePeek() {
                clearTimeout(peekTimer);
                document.getElementById('shelfPeek')?.classList.add('hidden');
            }

            // Above the spine where there is room, under it otherwise, and never past
            // either edge of the window.
            function showPeek(spine) {
                const peek = document.getElementById('shelfPeek');
                if (!peek) return;
                fill(peek, 'peek', spine);
                peek.classList.remove('hidden');
                peek.classList.add('flex');
                const box = spine.getBoundingClientRect();
                const width = peek.offsetWidth;
                const height = peek.offsetHeight;
                const left = Math.min(Math.max(8, box.left + box.width / 2 - 28), window.innerWidth - width - 8);
                const top = box.top - height - 12 >= 8 ? box.top - height - 12 : box.bottom + 12;
                peek.style.left = left + 'px';
                peek.style.top = top + 'px';
            }

            document.addEventListener('mouseover', event => {
                if (!canHover.matches) return;
                const spine = event.target.closest?.('.shelf-spine');
                if (!spine || spine.classList.contains('is-dragging')) return;
                if (event.relatedTarget && spine.contains(event.relatedTarget)) return;
                clearTimeout(peekTimer);
                peekTimer = setTimeout(() => showPeek(spine), 120);
            });

            document.addEventListener('mouseout', event => {
                const spine = event.target.closest?.('.shelf-spine');
                if (!spine || (event.relatedTarget && spine.contains(event.relatedTarget))) return;
                hidePeek();
            });

            document.addEventListener('dragstart', hidePeek);
            window.addEventListener('scroll', hidePeek, { passive: true });

            let sheetSpine = null;

            function closeSheet() {
                document.getElementById('shelfSheet')?.classList.add('hidden');
                sheetSpine = null;
            }

            // A tap opens the sheet rather than the item: on a phone the spine is the
            // only handle there is, and leaving the shelf on every touch would make
            // browsing it a chore. A selection in progress keeps its own meaning for taps.
            document.addEventListener('click', event => {
                const spine = event.target.closest?.('.shelf-spine');
                if (!spine || canHover.matches) return;
                if (typeof selectMode !== 'undefined' && selectMode) return;
                const sheet = document.getElementById('shelfSheet');
                if (!sheet) return;
                event.preventDefault();
                sheetSpine = spine;
                fill(sheet, 'sheet', spine);
                sheet.querySelector('[data-sheet-open]').href = spine.getAttribute('href');
                sheet.classList.remove('hidden');
            });

            document.addEventListener('click', event => {
                if (event.target.closest?.('[data-sheet-close]')) closeSheet();
                if (event.target.closest?.('[data-sheet-move]') && sheetSpine) {
                    const id = sheetSpine.dataset.itemId;
                    closeSheet();
                    if (typeof openShelfMoveModal === 'function') openShelfMoveModal([id]);
                }
            });

            document.addEventListener('keydown', event => {
                if (event.key === 'Escape' && sheetSpine) closeSheet();
            });

            // Fades the right edge of a board while part of it is out of view, so a
            // compartment that scrolls says so before anyone tries.
            function refreshClipping(scroller) {
                const more = scroller.scrollWidth - scroller.clientWidth - scroller.scrollLeft > 4;
                scroller.classList.toggle('is-clipped', more);
            }

            function refreshAllClipping() {
                document.querySelectorAll('.shelf-scroll').forEach(refreshClipping);
            }

            document.addEventListener('scroll', event => {
                if (event.target.classList?.contains('shelf-scroll')) refreshClipping(event.target);
            }, true);
            window.addEventListener('resize', refreshAllClipping);
            document.addEventListener('shelf-results:replaced', refreshAllClipping);
            document.addEventListener('shelf-view:changed', refreshAllClipping);
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', refreshAllClipping);
            else refreshAllClipping();
        })();
    </script>

<% if (locals.canEditCollection) { %>
    <script>
        (function () {
            if (window.__shelfDragWired) return;
            window.__shelfDragWired = true;

            const baseUrl = '<%= baseUrl %>';
            let dragged = null;

            // How close to the top or bottom of the window the pointer has to come before
            // the page starts moving under it, and how fast it moves once it is right on
            // the edge.
            const EDGE_BAND = 100;
            const MAX_SCROLL_STEP = 24;

            let pointerY = 0;
            let scrollFrame = null;

            // A drag holds the page still: nothing scrolls while the mouse button is
            // down, so a piece of furniture taller than the window makes its top shelves
            // unreachable from the reserve at the bottom. The page has to be moved for
            // the user, and on its own clock rather than on dragover, which stops firing
            // the moment the pointer is held still against the edge.
            function autoScroll() {
                if (!dragged) { stopAutoScroll(); return; }

                const above = pointerY - EDGE_BAND;
                const below = pointerY - (window.innerHeight - EDGE_BAND);
                let step = 0;
                if (above < 0) step = Math.max(-MAX_SCROLL_STEP, (above / EDGE_BAND) * MAX_SCROLL_STEP);
                else if (below > 0) step = Math.min(MAX_SCROLL_STEP, (below / EDGE_BAND) * MAX_SCROLL_STEP);

                if (step !== 0) window.scrollBy(0, step);
                scrollFrame = requestAnimationFrame(autoScroll);
            }

            function stopAutoScroll() {
                if (scrollFrame !== null) cancelAnimationFrame(scrollFrame);
                scrollFrame = null;
            }

            // A spine's own href takes it to the item, so a drag must not end in a
            // navigation: the browser follows the link on drop unless it is told not to.
            document.addEventListener('dragstart', event => {
                const spine = event.target.closest?.('.shelf-spine[draggable="true"]');
                if (!spine) return;
                dragged = spine;
                spine.classList.add('is-dragging');
                event.dataTransfer.effectAllowed = 'move';
                event.dataTransfer.setData('text/plain', spine.dataset.itemId);
                pointerY = event.clientY;
                if (scrollFrame === null) scrollFrame = requestAnimationFrame(autoScroll);
            });

            // Fired on the spine being carried, wherever the pointer happens to be, which
            // dragover is not: that one only reports while the pointer is over something,
            // and stops the moment it slows down or crosses a gap. Held against the top
            // of the window, this is the only event still saying where the pointer is.
            document.addEventListener('drag', event => {
                if (!dragged) return;
                // The last drag event of a gesture reports the origin rather than the
                // pointer, and acting on it would fling the page to the top.
                if (event.clientX === 0 && event.clientY === 0) return;
                pointerY = event.clientY;
            });

            document.addEventListener('dragend', () => {
                stopAutoScroll();
                dragged?.classList.remove('is-dragging');
                document.querySelectorAll('.shelf-drop.is-target').forEach(el => el.classList.remove('is-target'));
                dragged = null;
            });

            document.addEventListener('dragover', event => {
                if (!dragged) return;
                // Read wherever the pointer is, not only over a compartment: the way from
                // the reserve up to the top shelf crosses plenty that accepts no drop, and
                // that is exactly the stretch the page has to scroll through.
                pointerY = event.clientY;

                const target = event.target.closest?.('.shelf-drop');
                if (!target) return;
                event.preventDefault();
                event.dataTransfer.dropEffect = 'move';
                if (!target.classList.contains('is-target')) {
                    document.querySelectorAll('.shelf-drop.is-target').forEach(el => el.classList.remove('is-target'));
                    target.classList.add('is-target');
                }
            });

            document.addEventListener('drop', async event => {
                const target = event.target.closest?.('.shelf-drop');
                if (!dragged || !target) return;
                event.preventDefault();

                stopAutoScroll();
                const spine = dragged;
                const from = spine.closest('.shelf-drop');
                target.classList.remove('is-target');
                if (from === target) return;

                // Moved first, asked second: the shelf is the answer to a question the
                // user has already made up their mind about, and a spine that hovers in
                // place until the network replies reads as a gesture that failed.
                place(spine, target);
                refreshCounts(from);
                refreshCounts(target);
                document.dispatchEvent(new CustomEvent('shelf-view:changed'));

                try {
                    const res = await fetch(baseUrl + '/shelf/move', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids: [spine.dataset.itemId], location: target.dataset.shelf })
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok || !data.success) throw new Error(data.error || res.status);
                } catch (err) {
                    // Whatever the page is now showing is a guess that turned out wrong,
                    // and only the server knows what else the failure left behind.
                    window.location.reload();
                }
            });

            <%# Into a compartment, a spine stands with the others, ahead of any pile; into
                the reserve, it starts a pile of its own. Whether it is drawn standing or
                lying follows from where it lands. %>
            function place(spine, zone) {
                const plank = zone.querySelector('.shelf-plank');
                if (zone.dataset.shelf === '') {
                    const pile = document.createElement('span');
                    pile.className = 'shelf-pile';
                    pile.appendChild(spine);
                    plank.appendChild(pile);
                } else {
                    plank.insertBefore(spine, plank.querySelector(':scope > .shelf-pile'));
                }
                spine.dataset.where = zone.dataset.shelf === ''
                    ? <%- JSON.stringify(t('collection.shelf_unsorted')) %>
                    : zone.dataset.shelf;
            }

            <%# The counters, the gauges and the lean are what a drop invalidates: the spine
                itself keeps its own measurements wherever it stands. %>
            function refreshCounts(zone) {
                const plank = zone.querySelector('.shelf-plank');
                plank.querySelectorAll('.shelf-pile:empty').forEach(pile => pile.remove());
                const count = plank.querySelectorAll('.shelf-spine').length;

                const label = plank.querySelector('.shelf-empty-label');
                if (label) label.hidden = count > 0;

                if (zone.dataset.shelf === '') {
                    const total = document.querySelector('[data-unsorted-count]');
                    if (total) total.textContent = count;
                    return;
                }

                const badge = document.querySelector('[data-shelf-count="' + CSS.escape(zone.dataset.shelf) + '"]');
                if (!badge) return;
                const capacity = parseInt(badge.dataset.capacity, 10) || 0;
                badge.textContent = capacity > 0 ? count + '/' + capacity : String(count);

                const state = capacity > 0 && count > capacity ? 'is-over' : (capacity > 0 && count === capacity ? 'is-full' : '');
                const gauge = document.querySelector('[data-shelf-gauge="' + CSS.escape(zone.dataset.shelf) + '"]');
                [badge, gauge].forEach(el => {
                    if (!el) return;
                    el.classList.remove('is-over', 'is-full');
                    if (state) el.classList.add(state);
                });
                if (gauge && capacity > 0) gauge.firstElementChild.style.width = Math.min(100, Math.round(100 * count / capacity)) + '%';

                const standing = plank.querySelectorAll(':scope > .shelf-spine').length;
                const piled = plank.querySelector(':scope > .shelf-pile .shelf-spine');
                plank.toggleAttribute('data-lean', !piled && standing > 1 && (capacity <= 0 || count < capacity));
            }
        })();
    </script>
    <% } %>

<% } %>
