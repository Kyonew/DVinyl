</main>

<%
  // Same condition as showTabBar in header.ejs, which reserves the tab bar's height.
  const shellReady = Boolean(locals.user) && !locals.isShareView
      && typeof settings !== 'undefined' && settings && typeof registry !== 'undefined' && registry;
%>
<%# On a phone the tab bar closes the page, and the version is on the account page. %>
<footer class="mt-auto nav-custom transition-colors duration-300<%= shellReady ? ' max-md:hidden' : '' %>">
    <div class="max-w-screen-xl mx-auto py-8 px-4">
        <div class="flex flex-col items-center justify-center space-y-4">

            <div class="flex items-center gap-2 font-bold text-lg tracking-tight transition-colors">
                <img src="<%= baseUrl %>/ressources/logo.png" alt="vinyl" class="text-primary-theme align-middle"
                    style="width: 1em; height: 1em;">
                <span>Vinyl</span>
            </div>

            <div class="text-center">
                <p class="text-xs opacity-60 mt-1 transition-colors">
                    <%= t('footer.made_with') %>
                        <i class="fa-solid fa-heart text-red-500 animate-pulse mx-1"></i>
                        <%= t('footer.for_collection') %>
                </p>
                <p class="text-[10px] opacity-40 mt-2 tracking-widest">
                    DVinyl - v<%= appVersion %>
                </p>
            </div>

        </div>
    </div>
</footer>

<% if (shellReady) { %>
<%- include('shell/tab-bar') %>
<%# One add hub per page, opened by the "+" tab and by the page's own add buttons alike. %>
<%- include('add-hub') %>
<% } %>

<%- include('save-bar') %>
<%- include('shell/inbox-live') %>

<script>
    window.addEventListener('load', function () {
        const loader = document.getElementById('page-loader');
        if (loader) {
            loader.classList.add('opacity-0');
            setTimeout(() => {
                loader.style.display = 'none';
            }, 500);
        }
    });


    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('<%= baseUrl %>/sw.js')
                .then(reg => console.log('[SW] saved', reg.scope))
                .catch(err => console.warn('[SW] error:', err));
        });
    }
</script>

</body>

</html>
