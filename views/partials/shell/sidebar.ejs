<%
  /**
   * Side navigation for large screens, on the left or the right as the layout says
   * (shellNav). Wide, it lists the shortcuts with their labels; narrow (the "rail" style,
   * a viewer's own fold, or any screen under lg) it shows captioned icons. The rules in
   * partials/shell/styles switch between the two from the sidebar's width alone.
   *
   * header.ejs passes shellNav, showBackButton and shellCanAdd.
   */
  const sideRight = shellNav.nav === 'right';
  const edgeBorder = sideRight ? 'border-l' : 'border-r';
  const dropdownSide = sideRight ? 'left-end' : 'right-end';
%>
<aside id="dvSidebar" aria-label="<%= t('nav.main_navigation') %>"
  class="max-md:hidden fixed inset-y-0 <%= sideRight ? 'right-0' : 'left-0' %> z-40 flex flex-col <%= edgeBorder %> border-[var(--border-color)] text-[var(--text-main)]"
  style="background-color: var(--bg-nav);">
  <div class="flex flex-col gap-1 px-2.5 pt-4 pb-4">
    <% if (showBackButton) { %>
    <button type="button" data-standalone-back aria-label="<%= t('nav.back') %>"
      class="hidden mb-2 w-9 h-9 self-center items-center justify-center rounded-full bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition-colors">
      <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
    </button>
    <% } %>
    <%- include('brand', { brandIn: 'side' }) %>
  </div>

  <%# pt-1: room for the search field's focus ring, which the scrolling list would clip. %>
  <div class="flex-1 min-h-0 overflow-y-auto overflow-x-hidden px-2.5 pt-1 pb-3 flex flex-col gap-5 [scrollbar-width:thin]">
    <% if (locals.user) { %>
    <div class="flex flex-col gap-2.5">
      <form action="<%= baseUrl %>/search" method="GET" role="search" class="dv-side-wide">
        <label class="flex items-center gap-2.5 h-10 px-3 rounded-xl bg-black/5 dark:bg-white/10 focus-within:ring-2 focus-within:ring-primary-theme/40 transition">
          <i class="fa-solid fa-magnifying-glass text-sm opacity-60" aria-hidden="true"></i>
          <input type="search" name="q" placeholder="<%= t('nav.search') %>" aria-label="<%= t('nav.search') %>"
            class="flex-1 min-w-0 bg-transparent border-0 p-0 text-sm focus:ring-0 focus:outline-none placeholder:opacity-60">
        </label>
      </form>
      <a href="<%= baseUrl %>/search" title="<%= t('nav.search') %>" <%- locals.currentPath === '/search' ? 'aria-current="page"' : '' %>
        class="dv-side-narrow dv-side-link rounded-xl opacity-75 hover:opacity-100 hover:bg-black/5 dark:hover:bg-white/10 transition">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <span><%= t('nav.search') %></span>
      </a>
      <% if (shellCanAdd) { %>
      <button type="button" onclick="openAddModal()" title="<%= t('nav.add') %>"
        class="flex items-center justify-center gap-2 h-10 rounded-xl bg-primary-theme hover:brightness-110 shadow-lg shadow-primary-theme/20 transition active:scale-95">
        <i data-add-hub-icon class="fa-solid fa-plus" aria-hidden="true"></i>
        <span class="dv-side-wide text-sm font-bold"><%= t('nav.add') %></span>
      </button>
      <% } %>
    </div>
    <% } else if (locals.isShareView) { %>
      <span class="flex flex-col items-center gap-1 text-center text-[10px] font-black uppercase tracking-widest text-primary-theme">
        <i class="fa-solid fa-eye text-base" aria-hidden="true"></i>
        <span class="dv-side-wide"><%= t('nav.share_view') %></span>
      </span>
    <% } %>

    <nav>
      <%- include('nav-shortcuts', { shortcutsVariant: 'side' }) %>
    </nav>
  </div>

  <div class="flex flex-col gap-1 px-2.5 pt-2 pb-3 border-t border-[var(--border-color)]">
    <% if (locals.user) { %>
      <%- include('account', { accountVariant: 'side', accountPlacement: dropdownSide }) %>
    <% } else if (!locals.isShareView) { %>
      <a href="<%= baseUrl %>/login" class="dv-side-link rounded-xl text-primary-theme hover:bg-black/5 dark:hover:bg-white/10 transition">
        <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
        <span><%= t('nav.login') %></span>
      </a>
    <% } %>
    <%# Each viewer folds or unfolds it for themselves; the choice is kept in a cookie so
        the next page is drawn at the right width straight away, and only while it differs
        from the collection's style, so a style the admin changes later still reaches them.
        Only offered where the screen leaves room for the wide sidebar. %>
    <button type="button" data-sidebar-fold data-sidebar-default="<%= shellNav.sidebar %>" aria-pressed="<%= shellNav.sidebarState === 'rail' ? 'true' : 'false' %>"
      aria-label="<%= t('layout.fold_sidebar') %>" title="<%= t('layout.fold_sidebar') %>"
      class="max-lg:hidden h-8 flex items-center justify-center rounded-lg opacity-50 hover:opacity-100 hover:bg-black/5 dark:hover:bg-white/10 transition">
      <i class="fa-solid <%= sideRight ? 'fa-angles-right' : 'fa-angles-left' %> text-xs transition-transform <%= shellNav.sidebarState === 'rail' ? 'rotate-180' : '' %>" data-sidebar-fold-icon aria-hidden="true"></i>
    </button>
  </div>
</aside>
<script>
  (function () {
    const button = document.querySelector('[data-sidebar-fold]');
    if (!button) return;
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.sidebarState === 'rail' ? 'expanded' : 'rail';
      root.dataset.sidebarState = next;
      button.setAttribute('aria-pressed', next === 'rail' ? 'true' : 'false');
      button.querySelector('[data-sidebar-fold-icon]')?.classList.toggle('rotate-180', next === 'rail');
      document.cookie = next === button.dataset.sidebarDefault
        ? '<%= SIDEBAR_COOKIE %>=; path=/; max-age=0; SameSite=Lax'
        : '<%= SIDEBAR_COOKIE %>=' + next + '; path=/; max-age=31536000; SameSite=Lax';
    });
  })();
</script>
