<%- include('partials/header') %>

<%
    const when = d => new Date(d).toLocaleString(dateLocaleFor(currentLng), { dateStyle: 'medium', timeStyle: 'short' });
%>

<div class="max-w-screen-md mx-auto pb-16">
    <div class="pt-6 mb-6">
        <a href="<%= baseUrl %>/requests" class="text-sm opacity-60 hover:opacity-100 hover:text-primary-theme transition-colors">
            <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i><%= t('requests.title') %>
        </a>
    </div>

    <%- include('partials/request-message', { requestMsg, requestField }) %>

    <ul class="card-theme rounded-2xl overflow-hidden shadow-sm">
        <%- include('partials/request-row', { r, back: '/requests/' + r.id }) %>
    </ul>

    <% if (log.length) { %>
        <h2 class="mt-8 mb-3 text-xs font-bold uppercase tracking-widest opacity-50"><%= t('requests.log_title') %></h2>
        <ol class="card-theme rounded-2xl shadow-sm p-4 space-y-3">
            <% log.forEach(entry => { %>
                <li class="flex items-baseline gap-3 text-sm">
                    <span class="w-2 h-2 rounded-full bg-primary-theme flex-none translate-y-[-1px]" aria-hidden="true"></span>
                    <span class="flex-1"><%= entry.text %></span>
                    <span class="text-xs opacity-50 flex-none"><%= when(entry.at) %></span>
                </li>
            <% }) %>
        </ol>
    <% } %>
</div>

<%- include('partials/footer') %>
