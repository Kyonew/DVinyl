<%- include('partials/header') %>

<div class="max-w-screen-md mx-auto px-4 pt-24 pb-32">
    <div class="card-theme rounded-[2.5rem] p-10 md:p-16 shadow-sm text-center transition-colors">
        <div class="w-20 h-20 rounded-full bg-primary-theme/10 text-primary-theme flex items-center justify-center mx-auto mb-8">
            <i class="fa-solid fa-layer-group text-3xl"></i>
        </div>

        <% if (locals.msgKey) { %>
            <div class="bg-primary-theme/10 border border-primary-theme/30 p-3 rounded-2xl mb-8">
                <p class="text-xs font-bold text-primary-theme"><%= t('messages.' + msgKey) %></p>
            </div>
        <% } %>

        <h1 class="text-2xl md:text-3xl font-black mb-4">
            <%= t('no_collection.title') %>
        </h1>

        <% if (locals.canCreateCollection) { %>
            <%# Self-service is on: this is the landing screen of a freshly provisioned
                user (SSO or local), so offer the first step instead of a dead end. %>
            <p class="text-sm opacity-60 leading-relaxed max-w-md mx-auto mb-8">
                <%= t('no_collection.message_can_create') %>
            </p>
            <form action="<%= baseUrl %>/collection/create" method="POST"
                class="flex flex-col sm:flex-row items-stretch gap-3 max-w-md mx-auto">
                <input type="text" name="name" required maxlength="60"
                    placeholder="<%= t('admin.collections.name_placeholder') %>"
                    class="flex-1 p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 text-sm focus:outline-none focus:border-primary-theme transition-colors">
                <button type="submit"
                    class="flex items-center justify-center gap-2 bg-primary-theme hover:brightness-110 text-white px-6 py-4 rounded-2xl shadow-lg shadow-primary-theme/20 transition-all active:scale-95">
                    <i class="fa-solid fa-plus text-sm"></i>
                    <span class="text-xs font-black whitespace-nowrap"><%= t('no_collection.create_btn') %></span>
                </button>
            </form>
        <% } else { %>
            <p class="text-sm opacity-60 leading-relaxed max-w-md mx-auto">
                <%= t('no_collection.message') %>
            </p>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
