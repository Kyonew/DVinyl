<%- include('partials/header') %>

<style>
    /* header.ejs only defines bg/text primary-theme helpers; the pickers need the border variant */
    .border-primary-theme { border-color: var(--highlight) !important; }
</style>

<div class="max-w-screen-xl mx-auto px-4 max-sm:px-0 pb-20 space-y-10">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between py-6 gap-4">
        <h1 class="text-2xl md:text-3xl font-bold flex items-center gap-3 transition-colors">
            <i class="fa-solid fa-wand-magic-sparkles text-primary-theme"></i>
            <%= t('create_plugin.title') %>
        </h1>
        <a href="<%= baseUrl %>/admin"
            class="flex items-center gap-2 text-xs font-black uppercase tracking-widest bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-4 py-2 rounded-full transition-all w-fit">
            <i class="fa-solid fa-shield-halved"></i>
            <%= t('admin.title') %>
        </a>
    </div>

    <!-- Default plugins: per-collection cosmetic overrides -->
    <section class="card-theme rounded-3xl p-6 shadow-sm transition-colors">
        <h2 class="text-sm font-black uppercase tracking-widest opacity-80 mb-1 flex items-center gap-2">
            <i class="fa-solid fa-puzzle-piece text-primary-theme"></i>
            <%= t('create_plugin.section_defaults') %>
        </h2>
        <p class="text-xs opacity-50 mb-4"><%= t('create_plugin.customize_hint') %></p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <% customizablePlugins.filter(p => !p.isCustom).forEach(p => {
                const displayIcon = p.current.icon || ('fa-' + p.icon);
                const isCustomized = !!(p.current.icon || p.current.formatColors || p.current.sortFormats); %>
                <div class="flex items-center gap-4 bg-black/5 dark:bg-white/5 rounded-2xl p-4 <%= p.enabled ? '' : 'opacity-50' %>">
                    <div class="w-11 h-11 rounded-xl bg-primary-theme/10 text-primary-theme flex items-center justify-center shrink-0">
                        <i class="fa-solid <%= displayIcon %> text-lg"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="font-bold text-sm truncate flex items-center gap-2">
                            <%= p.label %>
                            <span class="w-2 h-2 rounded-full shrink-0 <%= p.enabled ? 'bg-green-500' : 'bg-gray-400' %>"></span>
                        </div>
                        <% if (isCustomized) { %>
                            <div class="text-[11px] opacity-50"><i class="fa-solid fa-palette mr-1"></i><%= t('create_plugin.customized') %></div>
                        <% } %>
                        <% const lookalikeCount = Object.keys(p.lookalikes || {}).length; %>
                        <% if (lookalikeCount > 0) { %>
                            <div class="text-[11px] font-bold text-yellow-600"><i class="fa-solid fa-triangle-exclamation mr-1"></i><%= t('create_plugin.fields_to_review', { count: lookalikeCount }) %></div>
                        <% } %>
                    </div>
                    <button type="button" onclick="openCustomize('<%= p.id %>')" title="<%= t('create_plugin.customize') %>"
                        class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-primary-theme hover:text-white transition-all shrink-0">
                        <i class="fa-solid fa-palette text-xs"></i>
                    </button>
                </div>
            <% }) %>
        </div>
    </section>

    <!-- Existing custom plugins -->
    <% if (customPlugins.length > 0) { %>
    <section class="card-theme rounded-3xl p-6 shadow-sm transition-colors">
        <h2 class="text-sm font-black uppercase tracking-widest opacity-80 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-cubes text-primary-theme"></i>
            <%= t('create_plugin.existing_title') %>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <% customPlugins.forEach(cp => { %>
                <div class="flex items-center gap-4 bg-black/5 dark:bg-white/5 rounded-2xl p-4">
                    <div class="w-11 h-11 rounded-xl bg-<%= cp.config.color %>-100 dark:bg-<%= cp.config.color %>-900/30 text-<%= cp.config.color %>-600 flex items-center justify-center shrink-0">
                        <i class="fa-solid <%= cp.config.icon %> text-lg"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="font-bold text-sm truncate"><%= cp.config.label %></div>
                        <div class="text-[11px] opacity-50 font-mono">/<%= cp.config.id %> · <%= cp.itemCount %> <%= t('common.items') %></div>
                        <% const cpLookalikes = Object.keys((customizablePlugins.find(c => c.id === cp.config.id) || {}).lookalikes || {}).length; %>
                        <% if (cpLookalikes > 0) { %>
                            <div class="text-[11px] font-bold text-yellow-600"><i class="fa-solid fa-triangle-exclamation mr-1"></i><%= t('create_plugin.fields_to_review', { count: cpLookalikes }) %></div>
                        <% } %>
                    </div>
                    <div class="flex items-center gap-1 shrink-0">
                        <button type="button" onclick="openCustomize('<%= cp.config.id %>')" title="<%= t('create_plugin.customize') %>"
                            class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-primary-theme hover:text-white transition-all">
                            <i class="fa-solid fa-palette text-xs"></i>
                        </button>
                        <a href="<%= baseUrl %>/create-plugin?edit=<%= cp.config.id %>" title="<%= t('common.edit') %>"
                            class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-primary-theme hover:text-white transition-all">
                            <i class="fa-solid fa-pen text-xs"></i>
                        </a>
                        <button type="button" title="<%= t('common.delete') %>"
                            onclick="deleteCustomPlugin('<%= cp.config.id %>', <%= cp.itemCount %>)"
                            class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-red-500 hover:text-white transition-all">
                            <i class="fa-solid fa-trash text-xs"></i>
                        </button>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>
    <% } %>

    <div class="pt-4">
        <h2 class="text-xl md:text-2xl font-bold flex items-center gap-3 transition-colors">
            <i class="fa-solid <%= editConfig ? 'fa-pen' : 'fa-plus' %> text-primary-theme"></i>
            <%= editConfig ? (t('common.edit') + ' : ' + editConfig.label) : t('create_plugin.section_builder') %>
        </h2>
        <p class="text-sm opacity-60 mt-2 max-w-3xl"><%= t('create_plugin.subtitle') %></p>
    </div>

    <% if (locals.aiConfigured && !editConfig) { %>
    <div class="card-theme rounded-3xl p-6 shadow-sm transition-colors space-y-3">
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-wand-magic-sparkles text-primary-theme"></i>
            <h3 class="font-bold text-sm"><%= t('create_plugin.ai_section_title') %></h3>
        </div>
        <p class="text-xs opacity-60"><%= t('create_plugin.ai_section_hint') %></p>
        <div class="flex flex-col md:flex-row gap-3">
            <input id="aiPluginDescription" type="text" maxlength="<%= maxAiDescriptionChars %>"
                placeholder="<%= t('create_plugin.ai_placeholder') %>"
                class="flex-1 bg-black/5 dark:bg-white/5 border border-transparent rounded-lg text-sm focus:ring-primary-theme p-3 outline-none">
            <button type="button" id="aiGenerateBtn"
                class="bg-primary-theme text-white font-bold px-6 py-3 rounded-xl hover:brightness-110 active:scale-95 transition-all flex items-center justify-center gap-2 shrink-0">
                <i id="aiGenerateBtnIcon" class="fa-solid fa-wand-magic-sparkles"></i>
                <span id="aiGenerateBtnText"><%= t('create_plugin.ai_generate_btn') %></span>
            </button>
        </div>
    </div>
    <% } %>

    <div class="grid grid-cols-1 xl:grid-cols-[1fr_420px] gap-8 items-start">

        <!-- ===================== BUILDER ===================== -->
        <div class="space-y-8">

            <div id="builderError" class="hidden bg-red-500/10 border border-red-500/40 text-red-500 rounded-2xl p-4 text-sm font-bold"></div>

            <!-- Identity -->
            <section class="card-theme rounded-3xl p-6 shadow-sm transition-colors space-y-6">
                <h2 class="text-sm font-black uppercase tracking-widest opacity-80 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-primary-theme text-white text-xs flex items-center justify-center font-black">1</span>
                    <%= t('create_plugin.section_identity') %>
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block mb-2 text-xs font-bold uppercase tracking-widest opacity-60"><%= t('create_plugin.name_label') %></label>
                        <input id="pluginLabel" type="text" maxlength="40" placeholder="<%= t('create_plugin.name_ph') %>"
                            class="bg-black/5 dark:bg-white/5 border border-transparent rounded-lg text-sm focus:ring-primary-theme block w-full p-3 outline-none">
                        <p class="text-[11px] opacity-40 mt-2 font-mono">URL : /collection?type=<span id="slugPreview">…</span></p>
                    </div>
                    <div>
                        <label class="block mb-2 text-xs font-bold uppercase tracking-widest opacity-60"><%= t('create_plugin.creator_label') %></label>
                        <input id="creatorLabel" type="text" maxlength="30" placeholder="<%= t('create_plugin.creator_ph') %>"
                            class="bg-black/5 dark:bg-white/5 border border-transparent rounded-lg text-sm focus:ring-primary-theme block w-full p-3 outline-none">
                        <p class="text-[11px] opacity-40 mt-2"><%= t('create_plugin.creator_hint') %></p>
                    </div>
                </div>

                <div>
                    <label class="block mb-2 text-xs font-bold uppercase tracking-widest opacity-60"><%= t('create_plugin.icon_label') %></label>
                    <div id="iconGrid" class="flex flex-wrap gap-2">
                        <% iconChoices.forEach(ic => { %>
                            <button type="button" data-icon="<%= ic %>"
                                class="icon-choice w-10 h-10 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-primary-theme/20 flex items-center justify-center transition-all">
                                <i class="fa-solid <%= ic %>"></i>
                            </button>
                        <% }) %>
                    </div>
                </div>

                <div>
                    <label class="block mb-2 text-xs font-bold uppercase tracking-widest opacity-60"><%= t('create_plugin.color_label') %></label>
                    <div id="colorGrid" class="flex flex-wrap gap-2">
                        <% palette.forEach(c => { %>
                            <button type="button" data-color="<%= c %>"
                                class="color-choice w-8 h-8 rounded-full bg-<%= c %>-500 transition-all hover:scale-110 border-4 border-transparent"></button>
                        <% }) %>
                    </div>
                </div>
            </section>

            <!-- Image -->
            <section class="card-theme rounded-3xl p-6 shadow-sm transition-colors space-y-6">
                <h2 class="text-sm font-black uppercase tracking-widest opacity-80 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-primary-theme text-white text-xs flex items-center justify-center font-black">2</span>
                    <%= t('create_plugin.section_image') %>
                </h2>

                <div class="grid grid-cols-3 gap-4 max-w-lg">
                    <button type="button" data-shape="poster" class="shape-choice group rounded-2xl border-2 border-black/10 dark:border-white/10 p-4 flex flex-col items-center gap-3 transition-all">
                        <div class="w-14 aspect-[2/3] rounded-lg bg-black/10 dark:bg-white/10 flex items-center justify-center">
                            <i class="fa-solid fa-image opacity-40"></i>
                        </div>
                        <span class="text-xs font-bold"><%= t('create_plugin.shape_poster') %></span>
                    </button>
                    <button type="button" data-shape="square" class="shape-choice group rounded-2xl border-2 border-black/10 dark:border-white/10 p-4 flex flex-col items-center gap-3 transition-all">
                        <div class="w-14 aspect-square rounded-lg bg-black/10 dark:bg-white/10 flex items-center justify-center self-center my-auto">
                            <i class="fa-solid fa-image opacity-40"></i>
                        </div>
                        <span class="text-xs font-bold"><%= t('create_plugin.shape_square') %></span>
                    </button>
                    <button type="button" data-shape="screen" class="shape-choice group rounded-2xl border-2 border-black/10 dark:border-white/10 p-4 flex flex-col items-center gap-3 transition-all">
                        <div class="w-14 aspect-[16/9] rounded-lg bg-black/10 dark:bg-white/10 flex items-center justify-center self-center my-auto">
                            <i class="fa-solid fa-image opacity-40"></i>
                        </div>
                        <span class="text-xs font-bold"><%= t('create_plugin.shape_screen') %></span>
                    </button>
                </div>
                <p class="text-[11px] opacity-50 -mt-3 max-w-lg"><%= t('create_plugin.shape_hint') %></p>

                <div class="pt-2 border-t border-black/5 dark:border-white/5">
                    <label class="block mb-1 text-xs font-bold uppercase tracking-widest opacity-60"><%= t('create_plugin.default_cover_label') %></label>
                    <p class="text-[11px] opacity-50 mb-4"><%= t('create_plugin.default_cover_desc') %></p>

                    <div class="flex items-start gap-4">
                        <div id="dcPreviewBox" class="w-24 shrink-0 aspect-[2/3] rounded-xl overflow-hidden bg-black/5 dark:bg-white/5 flex items-center justify-center transition-all">
                            <img id="dcPreview" src="" alt="" class="hidden w-full h-full object-cover">
                            <i id="dcPreviewIcon" class="fa-solid fa-image text-2xl opacity-20"></i>
                        </div>

                        <div class="flex-1 min-w-0 space-y-3">
                            <div class="flex gap-1 p-1 bg-black/5 dark:bg-white/5 rounded-xl">
                                <button type="button" onclick="setCoverTab('local')" id="tab-dc-local"
                                    class="flex-1 py-2 text-[10px] font-black uppercase tracking-widest rounded-lg transition-all bg-primary-theme text-white">
                                    <i class="fa-solid fa-upload mr-1"></i> <%= t('image_source.local') %>
                                </button>
                                <button type="button" onclick="setCoverTab('url')" id="tab-dc-url"
                                    class="flex-1 py-2 text-[10px] font-black uppercase tracking-widest rounded-lg transition-all opacity-50">
                                    <i class="fa-solid fa-link mr-1"></i> <%= t('image_source.url') %>
                                </button>
                            </div>

                            <div id="pane-dc-local">
                                <label class="flex flex-col items-center justify-center w-full h-24 border-2 border-dashed border-black/10 dark:border-white/10 rounded-2xl cursor-pointer hover:bg-black/5 transition-all">
                                    <i class="fa-solid fa-cloud-arrow-up text-xl opacity-20 mb-1"></i>
                                    <p class="text-[11px] font-bold opacity-50 italic"><%= t('image_source.hint') %></p>
                                    <input type="file" id="dcFile" class="hidden" accept="image/png,image/jpeg,image/webp">
                                </label>
                            </div>

                            <div id="pane-dc-url" class="hidden">
                                <input type="url" id="dcUrl" placeholder="https://site.com/image.png"
                                    class="w-full bg-black/5 dark:bg-white/5 border border-transparent rounded-lg p-3 text-sm outline-none focus:ring-1 focus:ring-primary-theme">
                                <p class="text-[10px] mt-2 opacity-50 italic"><%= t('image_source.url_hint') %></p>
                            </div>

                            <button type="button" id="dcClear"
                                class="hidden text-[11px] font-bold opacity-50 hover:opacity-100 hover:text-red-500 transition-all">
                                <i class="fa-solid fa-rotate-left mr-1"></i> <%= t('create_plugin.default_cover_reset') %>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Built-in features -->
            <section class="card-theme rounded-3xl p-6 shadow-sm transition-colors space-y-4">
                <h2 class="text-sm font-black uppercase tracking-widest opacity-80 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-primary-theme text-white text-xs flex items-center justify-center font-black">3</span>
                    <%= t('create_plugin.section_basics') %>
                </h2>
                <p class="text-xs opacity-50"><%= t('create_plugin.basics_desc') %></p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <%
                    const featureDefs = [
                        { key: 'year',      icon: 'fa-calendar',       label: t('create_plugin.feature_year') },
                        { key: 'barcode',   icon: 'fa-barcode',        label: t('create_plugin.feature_barcode') },
                        { key: 'genre',     icon: 'fa-tags',           label: t('create_plugin.feature_genre') },
                        { key: 'rating',    icon: 'fa-star',           label: t('create_plugin.feature_rating') },
                        { key: 'comments',  icon: 'fa-comment-dots',   label: t('create_plugin.feature_comments') },
                        { key: 'location',  icon: 'fa-location-dot',   label: t('create_plugin.feature_location') },
                        { key: 'tracklist', icon: 'fa-list-ol',        label: t('create_plugin.feature_tracklist') }
                    ];
                    featureDefs.forEach(f => { %>
                        <label class="flex items-center gap-3 cursor-pointer bg-black/5 dark:bg-white/5 rounded-xl px-4 py-3 hover:bg-black/10 dark:hover:bg-white/10 transition-colors">
                            <input type="checkbox" class="feature-toggle accent-current w-4 h-4" data-feature="<%= f.key %>">
                            <i class="fa-solid <%= f.icon %> opacity-40 w-4 text-center"></i>
                            <span class="text-sm font-medium"><%= f.label %></span>
                        </label>
                    <% }) %>
                </div>
            </section>

            <!-- Formats -->
            <section class="card-theme rounded-3xl p-6 shadow-sm transition-colors space-y-4">
                <h2 class="text-sm font-black uppercase tracking-widest opacity-80 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-primary-theme text-white text-xs flex items-center justify-center font-black">4</span>
                    <%= t('create_plugin.section_formats') %>
                </h2>
                <p class="text-xs opacity-50"><%= t('create_plugin.formats_desc') %></p>

                <div id="formatRows" class="space-y-2"></div>

                <button type="button" id="addFormatBtn"
                    class="w-full py-2.5 text-xs font-bold opacity-30 hover:opacity-70 border-2 border-dashed border-current rounded-xl transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-plus"></i> <%= t('create_plugin.add_format') %>
                </button>

                <div id="defaultFormatWrap" class="hidden pt-4 border-t border-black/5 dark:border-white/5">
                    <label class="block mb-1 text-xs font-bold uppercase tracking-widest opacity-60"><%= t('create_plugin.default_format_label') %></label>
                    <p class="text-[11px] opacity-50 mb-3"><%= t('create_plugin.default_format_desc') %></p>
                    <select id="defaultFormat" class="w-full sm:w-64"></select>
                </div>
            </section>

            <!-- Custom fields -->
            <section class="card-theme rounded-3xl p-6 shadow-sm transition-colors space-y-4">
                <h2 class="text-sm font-black uppercase tracking-widest opacity-80 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-primary-theme text-white text-xs flex items-center justify-center font-black">5</span>
                    <%= t('create_plugin.section_fields') %>
                </h2>
                <p class="text-xs opacity-50"><%= t('create_plugin.fields_desc') %></p>

                <div id="fieldRows" class="space-y-3"></div>

                <button type="button" id="addFieldBtn"
                    class="w-full py-2.5 text-xs font-bold opacity-30 hover:opacity-70 border-2 border-dashed border-current rounded-xl transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-plus"></i> <%= t('create_plugin.add_field') %>
                </button>
            </section>

            <button type="button" id="saveBtn"
                class="w-full text-white bg-primary-theme hover:brightness-110 font-bold rounded-2xl text-lg px-5 py-4 transition-transform hover:scale-[1.01] flex items-center justify-center gap-2 shadow-lg shadow-primary-theme/20">
                <i class="fa-solid <%= editConfig ? 'fa-floppy-disk' : 'fa-wand-magic-sparkles' %>"></i>
                <span id="saveBtnText"><%= editConfig ? t('create_plugin.update_btn') : t('create_plugin.save_btn') %></span>
            </button>
        </div>

        <!-- ===================== LIVE PREVIEW ===================== -->
        <div class="xl:sticky xl:top-24 space-y-6">
            <h2 class="text-sm font-black uppercase tracking-widest opacity-50 flex items-center gap-2">
                <i class="fa-solid fa-eye"></i> <%= t('create_plugin.preview_title') %>
            </h2>

            <!-- Card preview -->
            <div class="card-theme rounded-3xl p-6 shadow-sm transition-colors">
                <p class="text-[10px] font-black uppercase tracking-widest opacity-40 mb-4"><%= t('create_plugin.preview_card') %></p>
                <div class="max-w-[220px] mx-auto">
                    <div class="group relative rounded-2xl overflow-hidden shadow-lg">
                        <div id="pvCover" class="aspect-[2/3] bg-gradient-to-br from-black/20 to-black/50 dark:from-white/10 dark:to-black/60 flex items-center justify-center transition-all">
                            <img id="pvCoverImg" src="" alt="" class="hidden w-full h-full object-cover">
                            <i id="pvCoverIcon" class="fa-solid fa-box text-5xl opacity-30"></i>
                        </div>
                        <span id="pvBadge" class="hidden absolute top-2 left-2 text-white text-[10px] font-black uppercase px-2 py-1 rounded-md shadow"></span>
                    </div>
                    <div class="mt-3 px-1">
                        <div id="pvTitle" class="font-bold text-sm truncate"><%= t('create_plugin.preview_sample_title') %></div>
                        <div id="pvCreator" class="text-xs opacity-60 truncate"><%= t('create_plugin.preview_sample_creator') %></div>
                        <div id="pvYear" class="hidden text-[11px] opacity-40 font-mono">2024</div>
                    </div>
                </div>
            </div>

            <!-- Form preview -->
            <div class="card-theme rounded-3xl p-6 shadow-sm transition-colors">
                <p class="text-[10px] font-black uppercase tracking-widest opacity-40 mb-4"><%= t('create_plugin.preview_form') %></p>
                <div id="pvForm" class="space-y-3"></div>
            </div>
        </div>
    </div>
</div>

<!-- Per-collection cosmetic customization modal (icon + badge colors) -->
<%# The plugin workshop: one subject at a time instead of everything in one long scroll.
    Wide screens keep the menu, the open subject and a live preview side by side. On a
    phone it fills the screen and works like a settings app: the menu first (data-view
    "home"), a subject replacing it once tapped (data-view "section"). %>
<style>
    @media (max-width: 767.98px) {
        #czShell[data-view="home"] #czStage,
        #czShell[data-view="home"] #czBack,
        #czShell[data-view="section"] #czNav,
        #czShell[data-view="section"] #czHeadIcon { display: none; }
    }
    @media (min-width: 768px) {
        .cz-nav-btn[aria-current="true"] { background: color-mix(in srgb, var(--highlight) 16%, transparent); }
        .cz-nav-btn[aria-current="true"] .cz-nav-tile { background: var(--highlight); color: #fff; }
    }
    .cz-toggle:has(input:checked) { background: color-mix(in srgb, var(--highlight) 16%, transparent); }
    .cz-dot[aria-pressed="true"] { box-shadow: 0 0 0 2px rgb(var(--card-rgb)), 0 0 0 4px var(--highlight); }
</style>
<%
    const czSections = [
        { id: 'look', icon: 'fa-palette', title: 'create_plugin.cz_nav_look', desc: 'create_plugin.cz_desc_look' },
        { id: 'card', icon: 'fa-id-card', title: 'create_plugin.cz_nav_card', desc: 'create_plugin.cz_desc_card' },
        { id: 'table', icon: 'fa-table-list', title: 'create_plugin.cz_nav_table', desc: 'create_plugin.cz_desc_table' },
        { id: 'filters', icon: 'fa-filter', title: 'create_plugin.cz_nav_filters', desc: 'create_plugin.cz_desc_filters' },
        { id: 'fields', icon: 'fa-pen-ruler', title: 'create_plugin.cz_nav_fields', desc: 'create_plugin.cz_desc_fields' }
    ];
    const czLabelClass = 'block mb-2 text-xs font-bold uppercase tracking-widest opacity-60';
    const czHeadClass = 'hidden md:block font-bold text-lg';
%>
<div id="customizeModal" class="dv-overlay hidden fixed inset-0 z-[60] bg-black/60 md:items-center md:justify-center md:p-6">
    <div id="czShell" data-view="home" class="dv-pop card-theme w-full h-full md:h-[min(48rem,92vh)] md:max-w-5xl max-md:rounded-none max-md:border-0 md:rounded-3xl flex flex-col overflow-hidden">

        <header class="shrink-0 flex items-center gap-3 px-4 md:px-6 pb-3 border-b border-black/5 dark:border-white/10" style="padding-top: max(0.75rem, env(safe-area-inset-top))">
            <button type="button" id="czBack" class="md:hidden w-10 h-10 -ml-2 rounded-lg flex items-center justify-center shrink-0" aria-label="<%= t('create_plugin.cz_back') %>">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <span id="czHeadIcon" class="w-10 h-10 rounded-xl bg-primary-theme/10 text-primary-theme flex items-center justify-center shrink-0">
                <i id="czHeadIconGlyph" class="fa-solid"></i>
            </span>
            <div class="min-w-0 flex-1">
                <h3 id="czTitle" class="font-bold text-base md:text-lg truncate"></h3>
                <p id="czSubtitle" class="text-xs opacity-50 truncate"></p>
            </div>
            <button type="button" onclick="closeCustomize()" class="w-10 h-10 -mr-2 md:mr-0 rounded-lg flex items-center justify-center hover:bg-black/10 dark:hover:bg-white/10 transition-colors shrink-0" aria-label="<%= t('create_plugin.cz_close') %>">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </header>

        <div class="flex-1 min-h-0 flex flex-col md:flex-row">
            <nav id="czNav" class="md:w-56 shrink-0 max-md:flex-1 overflow-y-auto p-3 md:border-r border-black/5 dark:border-white/10">
                <div class="space-y-1 max-md:space-y-0 max-md:bg-black/5 max-md:dark:bg-white/5 max-md:rounded-2xl max-md:divide-y max-md:divide-black/5 max-md:dark:divide-white/5 max-md:overflow-hidden">
                    <% czSections.forEach(s => { %>
                        <button type="button" data-cz-nav="<%= s.id %>" data-cz-title="<%= t(s.title) %>"
                            class="cz-nav-btn w-full flex items-center gap-3 md:rounded-xl px-3 py-3 md:py-2.5 text-left hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                            <span class="cz-nav-tile w-9 h-9 md:w-8 md:h-8 rounded-lg bg-primary-theme/10 text-primary-theme flex items-center justify-center shrink-0 transition-colors">
                                <i class="fa-solid <%= s.icon %> text-sm"></i>
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block font-bold text-sm truncate"><%= t(s.title) %></span>
                                <span class="md:hidden block text-xs opacity-50 truncate"><%= t(s.desc) %></span>
                            </span>
                            <i data-cz-warn class="hidden fa-solid fa-triangle-exclamation text-yellow-600 text-xs"></i>
                            <span data-cz-count class="text-xs font-bold opacity-50 tabular-nums"></span>
                            <i class="md:hidden fa-solid fa-chevron-right text-xs opacity-30"></i>
                        </button>
                    <% }) %>
                </div>
            </nav>

            <div id="czStage" class="flex-1 min-w-0 min-h-0 flex flex-col lg:flex-row">
                <div id="czPanels" class="flex-1 min-w-0 min-h-0 overflow-y-auto custom-scrollbar p-4 md:p-6">

                    <section data-cz-panel="look" class="hidden space-y-6">
                        <div>
                            <h4 class="<%= czHeadClass %>"><%= t('create_plugin.cz_nav_look') %></h4>
                            <p class="text-xs opacity-50 md:mt-1"><%= t('create_plugin.customize_hint') %></p>
                        </div>
                        <div>
                            <label class="<%= czLabelClass %>"><%= t('create_plugin.icon_label') %></label>
                            <div id="czIconGrid" class="grid grid-cols-[repeat(auto-fill,minmax(2.75rem,1fr))] gap-2">
                                <button type="button" data-icon="" title="<%= t('create_plugin.cz_icon_own') %>" aria-label="<%= t('create_plugin.cz_icon_own') %>"
                                    class="cz-icon h-11 rounded-xl border border-dashed border-black/20 dark:border-white/20 flex items-center justify-center transition-all">
                                    <i id="czOwnIcon" class="fa-solid"></i>
                                </button>
                                <% iconChoices.forEach(ic => { %>
                                    <button type="button" data-icon="<%= ic %>"
                                        class="cz-icon h-11 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-primary-theme/20 flex items-center justify-center transition-all">
                                        <i class="fa-solid <%= ic %>"></i>
                                    </button>
                                <% }) %>
                            </div>
                        </div>
                        <div id="czFormatsWrap">
                            <label class="<%= czLabelClass %>"><%= t('create_plugin.format_colors') %></label>
                            <div id="czFormats" class="space-y-4"></div>
                            <label class="flex items-center gap-3 mt-4 text-sm min-h-11 cursor-pointer">
                                <input type="checkbox" id="czSortFormats" class="accent-primary-theme w-4 h-4 shrink-0">
                                <%= t('create_plugin.sort_formats') %>
                            </label>
                        </div>
                    </section>

                    <section data-cz-panel="card" class="hidden space-y-6">
                        <div>
                            <h4 class="<%= czHeadClass %>"><%= t('create_plugin.cz_nav_card') %></h4>
                            <p class="text-xs opacity-50 md:mt-1"><%= t('create_plugin.cz_desc_card') %></p>
                        </div>
                        <div id="czCardFieldsWrap">
                            <div class="flex items-baseline justify-between gap-3 mb-1">
                                <label class="text-xs font-bold uppercase tracking-widest opacity-60"><%= t('create_plugin.card_fields') %></label>
                                <span id="czCardCount" class="text-xs font-bold opacity-60 tabular-nums"></span>
                            </div>
                            <p class="text-xs opacity-50 mb-3"><%= t('create_plugin.card_fields_hint', { count: maxCardLines }) %></p>
                            <div id="czCardFields" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
                        </div>
                        <div id="czCornerFieldWrap">
                            <label class="block mb-1 text-xs font-bold uppercase tracking-widest opacity-60"><%= t('create_plugin.corner_field') %></label>
                            <p class="text-xs opacity-50 mb-3"><%= t('create_plugin.corner_field_hint') %></p>
                            <select id="czCornerField"
                                class="w-full bg-black/5 dark:bg-white/5 border border-transparent rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-primary-theme outline-none transition-all cursor-pointer"></select>

                            <%# Which corner, shown rather than named: a square standing for the cover, its
                                four quadrants clickable except the top-right one, where the format badge
                                already sits. Hidden until a field is chosen, since it decides nothing on
                                its own. %>
                            <div id="czCornerPosWrap" class="hidden mt-4">
                                <label class="<%= czLabelClass %>"><%= t('create_plugin.corner_position') %></label>
                                <div class="w-32 h-32 rounded-xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 grid grid-cols-2 grid-rows-2 gap-1 p-1">
                                    <% [
                                        { pos: 'top-left', label: 'create_plugin.corner_top_left' },
                                        { pos: '', label: '' },
                                        { pos: 'bottom-left', label: 'create_plugin.corner_bottom_left' },
                                        { pos: 'bottom-right', label: 'create_plugin.corner_bottom_right' }
                                    ].forEach(cell => { %>
                                        <% if (cell.pos) { %>
                                            <button type="button" class="cz-corner-pos rounded-lg border-2 border-transparent hover:border-primary-theme/50 flex items-center justify-center transition-all"
                                                data-pos="<%= cell.pos %>" title="<%= t(cell.label) %>">
                                                <span class="w-6 h-2.5 rounded-sm bg-black/25 dark:bg-white/25"></span>
                                            </button>
                                        <% } else { %>
                                            <div class="rounded-lg flex items-center justify-center opacity-60 cursor-not-allowed" title="<%= t('create_plugin.corner_taken') %>">
                                                <span class="w-6 h-2.5 rounded-sm bg-primary-theme"></span>
                                            </div>
                                        <% } %>
                                    <% }) %>
                                </div>
                                <p class="text-xs opacity-50 mt-2"><%= t('create_plugin.corner_taken') %></p>
                            </div>
                        </div>
                    </section>

                    <section data-cz-panel="table" class="hidden space-y-5">
                        <div>
                            <h4 class="<%= czHeadClass %>"><%= t('create_plugin.cz_nav_table') %></h4>
                            <p class="text-xs opacity-50 md:mt-1"><%= t('create_plugin.table_columns_hint') %></p>
                        </div>
                        <div id="czTablePreview" class="flex gap-px overflow-x-auto rounded-xl bg-black/10 dark:bg-white/10 p-px text-xs font-bold"></div>
                        <div id="czTableColumnsWrap">
                            <div id="czTableColumns" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2"></div>
                        </div>
                    </section>

                    <section data-cz-panel="filters" class="hidden space-y-5">
                        <div>
                            <h4 class="<%= czHeadClass %>"><%= t('create_plugin.cz_nav_filters') %></h4>
                            <p class="text-xs opacity-50 md:mt-1"><%= t('create_plugin.filters_hint') %></p>
                        </div>
                        <div id="czFiltersWrap">
                            <div id="czFilters" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2"></div>
                        </div>
                    </section>

                    <section data-cz-panel="fields" class="hidden space-y-5">
                        <div>
                            <h4 class="<%= czHeadClass %>"><%= t('create_plugin.cz_nav_fields') %></h4>
                            <p class="text-xs opacity-50 md:mt-1"><%= t('create_plugin.extra_fields_hint') %></p>
                        </div>
                        <div id="czFields" class="space-y-2"></div>
                        <button type="button" id="czAddFieldBtn"
                            class="w-full border-2 border-dashed border-black/10 dark:border-white/10 rounded-xl py-3 text-sm font-bold opacity-70 hover:opacity-100 hover:border-primary-theme transition-all">
                            <i class="fa-solid fa-plus"></i> <%= t('create_plugin.add_field') %>
                        </button>
                    </section>
                </div>

                <%# Comes first on narrow screens, above the scrolling subject, so what is being
                    changed and its effect stay on screen together. %>
                <aside id="czPreviewCol" class="order-first lg:order-last shrink-0 lg:w-72 p-3 lg:p-6 border-b lg:border-b-0 lg:border-l border-black/5 dark:border-white/10">
                    <p class="hidden lg:block mb-3 text-xs font-bold uppercase tracking-widest opacity-60"><%= t('create_plugin.preview_card') %></p>
                    <div class="flex lg:block items-center gap-3">
                        <div class="relative w-20 lg:w-full aspect-square rounded-xl bg-black/10 dark:bg-white/10 flex items-center justify-center overflow-hidden shrink-0">
                            <i id="czPvIcon" class="fa-solid text-2xl lg:text-6xl opacity-30"></i>
                            <span id="czPvBadge" class="hidden absolute top-1 right-1 lg:top-2 lg:right-2 text-[9px] lg:text-[11px] font-bold text-white px-1.5 py-0.5 rounded max-w-[90%] truncate"></span>
                            <span id="czPvCorner" class="hidden absolute text-[9px] lg:text-[11px] font-bold text-white bg-black/60 px-1.5 py-0.5 rounded max-w-[60%] truncate"></span>
                        </div>
                        <div class="min-w-0 flex-1 lg:mt-3">
                            <p class="font-bold text-sm truncate"><%= t('create_plugin.preview_sample_title') %></p>
                            <div id="czPvLines" class="text-xs opacity-60 space-y-0.5 mt-0.5"></div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>

        <footer class="shrink-0 border-t border-black/5 dark:border-white/10 px-4 md:px-6 pt-3 flex flex-wrap items-center gap-3" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))">
            <div id="czError" class="hidden w-full text-red-500 text-sm font-bold"></div>
            <button type="button" onclick="saveCustomize(true)"
                class="px-3 py-3 rounded-xl font-bold text-sm opacity-60 hover:opacity-100 hover:text-red-500 transition-all">
                <%= t('create_plugin.reset') %>
            </button>
            <span id="czDirty" class="hidden md:inline-flex invisible ml-auto items-center gap-2 text-xs font-bold opacity-70">
                <i class="fa-solid fa-circle-exclamation text-primary-theme"></i><%= t('common.unsaved_changes') %>
            </span>
            <button type="button" onclick="saveCustomize(false)"
                class="max-md:flex-1 md:min-w-44 text-white bg-primary-theme hover:brightness-110 font-bold rounded-xl px-6 py-3 transition-all">
                <%= t('common.save') %>
            </button>
        </footer>
    </div>
</div>

<%- include('partials/footer') %>

<script>
(function () {
    const baseUrl = '<%= baseUrl %>';
    // Values are injected through JSON.stringify with '<' escaped: user-provided
    // labels cannot break out of the script block, and translated strings keep
    // their quotes instead of being HTML-entity encoded.
    const editConfig = <%- editConfig ? JSON.stringify(editConfig).replace(/</g, '\\u003c') : 'null' %>;
    const editPlaceholder = <%- JSON.stringify(locals.editPlaceholder || '') %>;
    const palette = <%- JSON.stringify(palette) %>;

    <%
    const builderI18n = {
        fieldTypes: {
            text: t('create_plugin.type_text'),
            number: t('create_plugin.type_number'),
            textarea: t('create_plugin.type_textarea'),
            select: t('create_plugin.type_select'),
            boolean: t('create_plugin.type_boolean'),
            tags: t('create_plugin.type_tags'),
            date: t('create_plugin.type_date'),
            rows: t('create_plugin.type_rows')
        },
        groupMain: t('create_plugin.field_group_main'),
        groupMeta: t('create_plugin.field_group_meta'),
        required: t('create_plugin.field_required'),
        fieldLabelPh: t('create_plugin.field_label_ph'),
        formatPh: t('create_plugin.format_name_ph'),
        optionsPh: t('create_plugin.field_options_ph'),
        columnsPh: t('create_plugin.field_columns_ph'),
        defaultPh: t('create_plugin.field_default_ph'),
        defaultNone: t('create_plugin.field_default_none'),
        defaultChecked: t('create_plugin.field_default_checked'),
        czSubtitle: t('create_plugin.customize'),
        czNewField: t('create_plugin.cz_new_field'),
        czRequired: t('create_plugin.field_required'),
        czDeleteField: t('create_plugin.cz_delete_field'),
        czDiscard: t('create_plugin.cz_discard_confirm'),
        czReset: t('create_plugin.cz_reset_confirm'),
        czTableTitle: t('create_plugin.cz_table_title'),
        deleteConfirm: t('create_plugin.delete_confirm'),
        saving: t('create_plugin.saving'),
        aiGenerating: t('create_plugin.ai_generating'),
        pvTitle: t('create_plugin.preview_sample_title'),
        pvCreator: t('create_plugin.preview_sample_creator'),
        pvComments: t('create_plugin.feature_comments'),
        pvLocation: t('create_plugin.feature_location'),
        pvYear: t('create_plugin.feature_year'),
        pvBarcode: t('create_plugin.feature_barcode'),
        pvGenre: t('create_plugin.feature_genre'),
        pvRating: t('create_plugin.feature_rating'),
        pvTracklist: t('create_plugin.feature_tracklist'),
        pvFormat: t('confirm_vinyl.field_format'),
        pvQuantity: t('confirm_vinyl.field_quantity'),
        pvTitleField: t('confirm_vinyl.field_title'),
        coverTooBig: t('create_plugin.default_cover_too_big'),
        lookalike: t('create_plugin.field_lookalike', { native: '__NATIVE__' }),
        lookalikeUse: t('create_plugin.lookalike_use'),
        lookalikeKeep: t('create_plugin.lookalike_keep'),
        lookalikePlan: t('create_plugin.lookalike_plan', { withValue: '__ALL__', move: '__MOVE__', same: '__SAME__', left: '__LEFT__', native: '__NATIVE__' }),
        lookalikeDone: t('create_plugin.lookalike_done', { moved: '__MOVED__' }),
        lookalikeDoneLeft: t('create_plugin.lookalike_done_left', { moved: '__MOVED__', left: '__LEFT__' }),
        fieldDeleteConfirm: t('create_plugin.field_delete_confirm', { count: '__COUNT__' }),
        noFormat: t('common.no_format')
    };
    %>
    const i18n = <%- JSON.stringify(builderI18n).replace(/</g, '\\u003c') %>;

    // ---- State ---------------------------------------------------------------
    const state = {
        icon: 'fa-box',
        color: 'teal',
        shape: 'poster',
        // null: untouched, the stored image is kept. '' resets to the generic logo.
        // Anything else is the new image, as a data URI or a remote URL.
        defaultCover: null,
        // Format preselected on a new item; '' leaves the picker blank
        defaultFormat: ''
    };

    // The picker works with shape names, the config stores the Tailwind class.
    // Configs written before that carry imageShape instead.
    const SHAPE_ASPECTS = { poster: 'aspect-[2/3]', square: 'aspect-square', screen: 'aspect-[16/9]' };

    function aspectClassForShape(shape) {
        return SHAPE_ASPECTS[shape] || SHAPE_ASPECTS.poster;
    }

    function shapeFromConfig(cfg) {
        const stored = cfg.aspectRatioClass || (cfg.imageShape === 'square' ? 'aspect-square' : '');
        return Object.keys(SHAPE_ASPECTS).find(name => SHAPE_ASPECTS[name] === stored) || 'poster';
    }

    function slugify(s) {
        return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
            .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 30);
    }

    const $ = id => document.getElementById(id);

    // Same select/option styling as the rest of the app (admin.ejs, fields/select.ejs):
    // without the explicit text color + option background, the native dropdown renders
    // white-on-white in dark mode.
    const SELECT_CLASSES = 'bg-black/5 dark:bg-white/5 border border-transparent text-gray-900 dark:text-white rounded-lg text-sm p-2.5 outline-none cursor-pointer';
    const OPTION_CLASSES = 'bg-white dark:bg-[#1a1a1a]';

    // Native <option> backgrounds are not stylable across browsers, so the picked color
    // is shown on a swatch next to the dropdown rather than on the list itself.
    const SWATCH_CLASSES = 'w-9 h-9 rounded-lg shrink-0 border border-black/10 dark:border-white/10 transition-colors';

    function paintSwatch(el, color) {
        el.className = SWATCH_CLASSES + (color ? ' bg-' + color + '-500' : ' bg-black/10 dark:bg-white/10');
    }

    // ---- Icon / color / shape pickers -----------------------------------------
    document.querySelectorAll('.icon-choice').forEach(btn => {
        btn.addEventListener('click', () => { state.icon = btn.dataset.icon; syncPickers(); renderPreview(); });
    });
    document.querySelectorAll('.color-choice').forEach(btn => {
        btn.addEventListener('click', () => { state.color = btn.dataset.color; syncPickers(); renderPreview(); });
    });
    document.querySelectorAll('.shape-choice').forEach(btn => {
        btn.addEventListener('click', () => { state.shape = btn.dataset.shape; syncPickers(); renderPreview(); });
    });

    function syncPickers() {
        document.querySelectorAll('.icon-choice').forEach(b => {
            const on = b.dataset.icon === state.icon;
            b.classList.toggle('bg-primary-theme', on);
            b.classList.toggle('text-white', on);
        });
        document.querySelectorAll('.color-choice').forEach(b => {
            b.classList.toggle('border-primary-theme', b.dataset.color === state.color);
            b.classList.toggle('scale-110', b.dataset.color === state.color);
        });
        document.querySelectorAll('.shape-choice').forEach(b => {
            b.classList.toggle('border-primary-theme', b.dataset.shape === state.shape);
        });
    }

    // ---- Default cover ----------------------------------------------------------
    // Downscaled before upload: the image is stored in the plugin config, so it travels
    // in the database and in every instance backup. 512 px is plenty for a placeholder.
    const COVER_MAX_SIDE = 512;
    const COVER_MAX_BYTES = 512 * 1024;

    // Src currently shown in both previews, whatever its origin (stored image, upload, URL)
    let coverPreviewSrc = '';

    window.setCoverTab = function (type) {
        ['local', 'url'].forEach(t => {
            const btn = $('tab-dc-' + t);
            const pane = $('pane-dc-' + t);
            btn.className = 'flex-1 py-2 text-[10px] font-black uppercase tracking-widest rounded-lg transition-all ' +
                (t === type ? 'bg-primary-theme text-white' : 'opacity-50');
            pane.classList.toggle('hidden', t !== type);
        });
    };

    function setCoverPreview(src) {
        coverPreviewSrc = src || '';
        const img = $('dcPreview');
        if (coverPreviewSrc) img.src = coverPreviewSrc;
        img.classList.toggle('hidden', !coverPreviewSrc);
        $('dcPreviewIcon').classList.toggle('hidden', !!coverPreviewSrc);
        $('dcClear').classList.toggle('hidden', !coverPreviewSrc);
        renderPreview();
    }

    function compressCover(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onerror = () => reject(new Error(i18n.coverTooBig));
            reader.onload = e => {
                const img = new Image();
                img.onerror = () => reject(new Error(i18n.coverTooBig));
                img.onload = () => {
                    const scale = Math.min(1, COVER_MAX_SIDE / Math.max(img.width, img.height));
                    const canvas = document.createElement('canvas');
                    canvas.width = Math.round(img.width * scale);
                    canvas.height = Math.round(img.height * scale);
                    canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
                    // PNG sources keep their transparency, which a logo usually relies on
                    resolve(file.type === 'image/png'
                        ? canvas.toDataURL('image/png')
                        : canvas.toDataURL('image/jpeg', 0.82));
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        });
    }

    $('dcFile').addEventListener('change', async e => {
        const file = e.target.files[0];
        e.target.value = '';
        if (!file) return;
        try {
            const dataUri = await compressCover(file);
            // Base64 inflates by 4/3, and the server caps the decoded size
            if ((dataUri.length * 3) / 4 > COVER_MAX_BYTES) throw new Error(i18n.coverTooBig);
            state.defaultCover = dataUri;
            $('dcUrl').value = '';
            setCoverPreview(dataUri);
        } catch (err) {
            alert(err.message);
        }
    });

    $('dcUrl').addEventListener('input', e => {
        const val = e.target.value.trim();
        // A half-typed URL is left alone; emptying the field is a reset
        if (/^https?:\/\/\S+$/i.test(val)) {
            state.defaultCover = val;
            setCoverPreview(val);
        } else if (!val) {
            state.defaultCover = '';
            setCoverPreview('');
        }
    });

    $('dcClear').addEventListener('click', () => {
        state.defaultCover = '';
        $('dcUrl').value = '';
        setCoverPreview('');
    });

    // ---- Preselected format ------------------------------------------------------
    // Mirrors the server-side slug rule so a row typed just now already has the value
    // it will be saved under.
    function formatValueOf(f) {
        return f.value || slugify(f.label).replace(/-/g, '_');
    }

    let defaultFormatSig = '';

    function syncDefaultFormat(formats) {
        const sel = $('defaultFormat');
        $('defaultFormatWrap').classList.toggle('hidden', formats.length === 0);

        const values = formats.map(formatValueOf);
        // A format that was renamed or removed cannot stay preselected
        if (state.defaultFormat && !values.includes(state.defaultFormat)) state.defaultFormat = '';

        // Rebuilt only when the formats themselves changed, so typing elsewhere never
        // reshuffles the dropdown under the pointer
        const sig = JSON.stringify(formats.map((f, i) => [values[i], f.label]));
        if (sig !== defaultFormatSig) {
            defaultFormatSig = sig;
            sel.className = SELECT_CLASSES + ' w-full sm:w-64';
            sel.innerHTML = '';
            const none = document.createElement('option');
            none.value = ''; none.textContent = i18n.noFormat; none.className = OPTION_CLASSES;
            sel.appendChild(none);
            formats.forEach((f, i) => {
                const o = document.createElement('option');
                o.value = values[i]; o.textContent = f.label; o.className = OPTION_CLASSES;
                sel.appendChild(o);
            });
        }
        sel.value = state.defaultFormat;
    }

    $('defaultFormat').addEventListener('change', e => {
        state.defaultFormat = e.target.value;
        renderPreview();
    });

    // ---- Dynamic rows: formats -------------------------------------------------
    function addFormatRow(data) {
        data = data || {};
        const row = document.createElement('div');
        row.className = 'fmt-row flex items-center gap-2';
        row.dataset.value = data.value || '';

        const input = document.createElement('input');
        input.type = 'text'; input.maxLength = 30;
        input.placeholder = i18n.formatPh;
        input.value = data.label || '';
        input.className = 'fmt-label flex-1 bg-black/5 dark:bg-white/5 rounded-lg text-sm p-2.5 outline-none focus:ring-1 focus:ring-primary-theme';
        input.addEventListener('input', renderPreview);

        const swatch = document.createElement('span');

        const colorSel = document.createElement('select');
        colorSel.className = 'fmt-color ' + SELECT_CLASSES;
        palette.forEach(c => {
            const o = document.createElement('option');
            o.value = c; o.textContent = c;
            o.className = OPTION_CLASSES;
            if ((data.color || state.color) === c) o.selected = true;
            colorSel.appendChild(o);
        });
        paintSwatch(swatch, colorSel.value);
        colorSel.addEventListener('change', () => { paintSwatch(swatch, colorSel.value); renderPreview(); });

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'w-9 h-9 rounded-lg flex items-center justify-center opacity-40 hover:opacity-100 hover:text-red-500 transition-all shrink-0';
        del.innerHTML = '<i class="fa-solid fa-xmark"></i>';
        del.addEventListener('click', () => { row.remove(); renderPreview(); });

        row.append(input, swatch, colorSel, del);
        $('formatRows').appendChild(row);
    }

    // ---- Default value of a field, shared by both field editors -------------------
    // One control per kind of field: a box for what is typed, a choice among the field's
    // own options for a list, a tick for a checkbox, nothing for repeating rows. Follows
    // the type and the options as the admin changes them. read() gives what to send.
    function buildDefaultControl(data, type, options) {
        const wrap = document.createElement('div');
        wrap.className = 'flex items-center gap-2 w-full';
        const inputClass = 'flex-1 min-w-[180px] bg-black/5 dark:bg-white/5 rounded-lg text-xs p-2 outline-none focus:ring-1 focus:ring-primary-theme';

        const text = document.createElement('input');
        text.className = inputClass;
        text.placeholder = i18n.defaultPh;
        const choice = document.createElement('select');
        choice.className = SELECT_CLASSES.replace('text-sm p-2.5', 'text-xs p-2') + ' flex-1';
        const tickLabel = document.createElement('label');
        tickLabel.className = 'flex items-center gap-2 text-xs cursor-pointer opacity-70';
        const tick = document.createElement('input');
        tick.type = 'checkbox';
        tick.className = 'w-3.5 h-3.5';
        tickLabel.append(tick, document.createTextNode(i18n.defaultChecked));
        wrap.append(text, choice, tickLabel);

        // A list's default is stored as its option key, shown here by its label.
        const initial = data.default;
        if (data.type === 'boolean') tick.checked = initial === true;
        else if (data.type === 'select') {
            const opt = (data.options || []).find(o => o.value === initial);
            choice.dataset.wanted = opt ? opt.label : '';
        } else if (Array.isArray(initial)) text.value = initial.join(', ');
        else if (initial !== undefined && initial !== null) text.value = String(initial);

        function optionLabels() {
            return options.value.split(',').map(s => s.trim()).filter(Boolean);
        }
        function fillChoice() {
            const wanted = choice.value || choice.dataset.wanted || '';
            choice.innerHTML = '';
            [''].concat(optionLabels()).forEach(label => {
                const o = document.createElement('option');
                o.value = label;
                o.textContent = label || i18n.defaultNone;
                o.className = OPTION_CLASSES;
                if (label === wanted) o.selected = true;
                choice.appendChild(o);
            });
            choice.dataset.wanted = '';
        }
        function sync() {
            const tp = type.value;
            text.classList.toggle('hidden', tp === 'select' || tp === 'boolean' || tp === 'rows');
            choice.classList.toggle('hidden', tp !== 'select');
            tickLabel.classList.toggle('hidden', tp !== 'boolean');
            wrap.classList.toggle('hidden', tp === 'rows');
            text.type = tp === 'number' ? 'number' : tp === 'date' ? 'date' : 'text';
            if (tp === 'number') text.step = 'any';
            if (tp === 'select') fillChoice();
        }
        type.addEventListener('change', sync);
        options.addEventListener('input', () => { if (type.value === 'select') fillChoice(); });
        sync();

        return {
            el: wrap,
            read() {
                const tp = type.value;
                if (tp === 'boolean') return tick.checked;
                if (tp === 'select') return choice.value;
                if (tp === 'rows') return '';
                return text.value.trim();
            }
        };
    }

    // ---- Dynamic rows: custom fields --------------------------------------------
    function addFieldRow(data) {
        data = data || {};
        const row = document.createElement('div');
        row.className = 'field-row bg-black/5 dark:bg-white/5 rounded-xl p-3 space-y-2';
        row.dataset.name = data.name || '';

        const top = document.createElement('div');
        top.className = 'flex items-center gap-2';

        const label = document.createElement('input');
        label.type = 'text'; label.maxLength = 40;
        label.placeholder = i18n.fieldLabelPh;
        label.value = data.label || '';
        label.className = 'fld-label flex-1 bg-black/5 dark:bg-white/5 rounded-lg text-sm p-2.5 outline-none focus:ring-1 focus:ring-primary-theme';
        label.addEventListener('input', renderPreview);

        const type = document.createElement('select');
        type.className = 'fld-type ' + SELECT_CLASSES;
        Object.keys(i18n.fieldTypes).forEach(tp => {
            const o = document.createElement('option');
            o.value = tp; o.textContent = i18n.fieldTypes[tp];
            o.className = OPTION_CLASSES;
            if ((data.type || 'text') === tp) o.selected = true;
            type.appendChild(o);
        });

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'w-9 h-9 rounded-lg flex items-center justify-center opacity-40 hover:opacity-100 hover:text-red-500 transition-all shrink-0';
        del.innerHTML = '<i class="fa-solid fa-xmark"></i>';
        del.addEventListener('click', () => { row.remove(); renderPreview(); });

        top.append(label, type, del);

        const bottom = document.createElement('div');
        bottom.className = 'flex flex-wrap items-center gap-x-4 gap-y-2';

        const group = document.createElement('select');
        group.className = 'fld-group ' + SELECT_CLASSES.replace('text-sm p-2.5', 'text-xs p-2');
        [['main', i18n.groupMain], ['metadata', i18n.groupMeta]].forEach(([v, l]) => {
            const o = document.createElement('option');
            o.value = v; o.textContent = l;
            o.className = OPTION_CLASSES;
            if ((data.group || 'metadata') === v) o.selected = true;
            group.appendChild(o);
        });
        group.addEventListener('change', renderPreview);

        const reqLabel = document.createElement('label');
        reqLabel.className = 'flex items-center gap-2 text-xs cursor-pointer opacity-70';
        const req = document.createElement('input');
        req.type = 'checkbox';
        req.className = 'fld-required w-3.5 h-3.5';
        req.checked = data.required === true;
        req.addEventListener('change', renderPreview);
        reqLabel.append(req, document.createTextNode(i18n.required));

        const options = document.createElement('input');
        options.type = 'text';
        options.placeholder = i18n.optionsPh;
        options.value = Array.isArray(data.options) ? data.options.map(o => o.label).join(', ') : '';
        options.className = 'fld-options flex-1 min-w-[180px] bg-black/5 dark:bg-white/5 rounded-lg text-xs p-2 outline-none focus:ring-1 focus:ring-primary-theme';
        options.addEventListener('input', renderPreview);

        const fieldDefault = buildDefaultControl(data, type, options);
        row._readDefault = fieldDefault.read;

        bottom.append(group, reqLabel, options, fieldDefault.el);
        row.append(top, bottom);

        function syncOptionsVisibility() {
            // A list takes its options, a repeating field its columns, in the same box.
            options.classList.toggle('hidden', type.value !== 'select' && type.value !== 'rows');
            options.placeholder = type.value === 'rows' ? i18n.columnsPh : i18n.optionsPh;
        }
        type.addEventListener('change', () => { syncOptionsVisibility(); renderPreview(); });
        syncOptionsVisibility();

        $('fieldRows').appendChild(row);
    }

    $('addFormatBtn').addEventListener('click', () => addFormatRow());
    $('addFieldBtn').addEventListener('click', () => addFieldRow());

    // ---- Collect current state ---------------------------------------------------
    function collect() {
        const features = {};
        document.querySelectorAll('.feature-toggle').forEach(cb => { features[cb.dataset.feature] = cb.checked; });

        const formats = Array.from(document.querySelectorAll('.fmt-row')).map(r => ({
            value: r.dataset.value || undefined,
            label: r.querySelector('.fmt-label').value.trim(),
            color: r.querySelector('.fmt-color').value
        })).filter(f => f.label);

        const fields = Array.from(document.querySelectorAll('.field-row')).map(r => ({
            name: r.dataset.name || undefined,
            label: r.querySelector('.fld-label').value.trim(),
            type: r.querySelector('.fld-type').value,
            group: r.querySelector('.fld-group').value,
            required: r.querySelector('.fld-required').checked,
            options: r.querySelector('.fld-options').value.split(',').map(s => s.trim()).filter(Boolean),
            default: r._readDefault ? r._readDefault() : undefined,
        })).filter(f => f.label);

        const payload = {
            editId: editConfig ? editConfig.id : '',
            label: $('pluginLabel').value.trim(),
            id: editConfig ? editConfig.id : slugify($('pluginLabel').value),
            icon: state.icon,
            color: state.color,
            aspectRatioClass: aspectClassForShape(state.shape),
            creatorLabel: $('creatorLabel').value.trim(),
            defaultFormat: state.defaultFormat,
            features, formats, fields
        };
        // Sent only when the admin actually picked or removed an image, so editing a
        // plugin never re-uploads the stored one (see buildConfigFromSubmission)
        if (state.defaultCover !== null) payload.defaultCover = state.defaultCover;
        return payload;
    }

    // ---- Live preview -----------------------------------------------------------
    function mockInput(labelText, kind) {
        const wrap = document.createElement('div');
        const lab = document.createElement('div');
        lab.className = 'text-[10px] font-bold uppercase tracking-widest opacity-50 mb-1';
        lab.textContent = labelText;
        wrap.appendChild(lab);
        const box = document.createElement('div');
        box.className = 'bg-black/5 dark:bg-white/5 rounded-lg ' + (kind === 'textarea' ? 'h-14' : 'h-8');
        if (kind === 'boolean') {
            box.className = 'w-10 h-5 rounded-full bg-black/10 dark:bg-white/10 relative';
            box.innerHTML = '<span class="absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-white shadow"></span>';
        }
        if (kind === 'select') box.innerHTML = '<div class="h-full flex items-center justify-end pr-2 opacity-30"><i class="fa-solid fa-chevron-down text-[10px]"></i></div>';
        if (kind === 'date') box.innerHTML = '<div class="h-full flex items-center justify-end pr-2 opacity-30"><i class="fa-solid fa-calendar-days text-[10px]"></i></div>';
        wrap.appendChild(box);
        return wrap;
    }

    function renderPreview() {
        const cfg = collect();

        $('slugPreview').textContent = cfg.id || '…';

        // Card
        const aspect = cfg.aspectRatioClass;

        $('pvCover').className = aspect +
            ' bg-gradient-to-br from-black/20 to-black/50 dark:from-white/10 dark:to-black/60 flex items-center justify-center transition-all';
        $('pvCoverIcon').className = 'fa-solid ' + cfg.icon + ' text-5xl opacity-30';

        $('dcPreviewBox').className = 'w-24 shrink-0 ' + aspect +
            ' rounded-xl overflow-hidden bg-black/5 dark:bg-white/5 flex items-center justify-center transition-all';

        // The card shows the default cover when there is one, exactly like a coverless item
        const pvImg = $('pvCoverImg');
        if (coverPreviewSrc) pvImg.src = coverPreviewSrc;
        pvImg.classList.toggle('hidden', !coverPreviewSrc);
        $('pvCoverIcon').classList.toggle('hidden', !!coverPreviewSrc);

        $('pvTitle').textContent = i18n.pvTitle;
        $('pvCreator').textContent = cfg.creatorLabel ? (cfg.creatorLabel + ' : ' + i18n.pvCreator) : i18n.pvCreator;
        $('pvYear').classList.toggle('hidden', !cfg.features.year);

        syncDefaultFormat(cfg.formats);

        // The badge illustrates the preselected format when there is one, the first
        // declared format otherwise
        const badge = $('pvBadge');
        const badgeFmt = cfg.formats.find(f => formatValueOf(f) === state.defaultFormat) || cfg.formats[0];
        if (badgeFmt) {
            badge.textContent = badgeFmt.label;
            badge.className = 'absolute top-2 left-2 text-white text-[10px] font-black uppercase px-2 py-1 rounded-md shadow bg-' + (badgeFmt.color || cfg.color) + '-600/90';
        } else {
            badge.className = 'hidden';
        }

        // Form
        const form = $('pvForm');
        form.innerHTML = '';
        form.appendChild(mockInput(i18n.pvTitleField + ' *', 'text'));
        form.appendChild(mockInput((cfg.creatorLabel || '…') + ' *', 'text'));
        if (cfg.formats.length > 0) form.appendChild(mockInput(i18n.pvFormat, 'select'));
        form.appendChild(mockInput(i18n.pvQuantity, 'number'));
        cfg.fields.filter(f => f.group === 'main').forEach(f =>
            form.appendChild(mockInput(f.label + (f.required ? ' *' : ''), f.type)));
        if (cfg.features.tracklist) form.appendChild(mockInput(i18n.pvTracklist, 'textarea'));

        const divider = document.createElement('hr');
        divider.className = 'border-black/10 dark:border-white/10 !my-4';
        form.appendChild(divider);

        if (cfg.features.year) form.appendChild(mockInput(i18n.pvYear, 'text'));
        if (cfg.features.barcode) form.appendChild(mockInput(i18n.pvBarcode, 'text'));
        if (cfg.features.genre) form.appendChild(mockInput(i18n.pvGenre, 'text'));
        cfg.fields.filter(f => f.group === 'metadata').forEach(f =>
            form.appendChild(mockInput(f.label + (f.required ? ' *' : ''), f.type)));
        if (cfg.features.rating) form.appendChild(mockInput(i18n.pvRating, 'number'));
        if (cfg.features.comments) form.appendChild(mockInput(i18n.pvComments, 'textarea'));
        if (cfg.features.location) form.appendChild(mockInput(i18n.pvLocation, 'text'));
    }

    ['pluginLabel', 'creatorLabel'].forEach(id => $(id).addEventListener('input', renderPreview));
    document.querySelectorAll('.feature-toggle').forEach(cb => cb.addEventListener('change', renderPreview));

    // ---- Save ----------------------------------------------------------------------
    $('saveBtn').addEventListener('click', async () => {
        const btn = $('saveBtn');
        const txt = $('saveBtnText');
        const errBox = $('builderError');
        errBox.classList.add('hidden');
        btn.disabled = true;
        const prev = txt.textContent;
        txt.textContent = i18n.saving;

        try {
            const res = await fetch(baseUrl + '/create-plugin/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(collect())
            });
            const data = await res.json();
            if (!res.ok || !data.success) {
                throw new Error((data.errors || []).join(' · ') || 'Error');
            }
            window.location.href = baseUrl + '/collection?type=' + data.id;
        } catch (err) {
            errBox.textContent = err.message;
            errBox.classList.remove('hidden');
            btn.disabled = false;
            txt.textContent = prev;
        }
    });

    // ---- AI plugin generation --------------------------------------------------------
    if ($('aiGenerateBtn')) {
        $('aiGenerateBtn').addEventListener('click', async () => {
            const btn = $('aiGenerateBtn');
            const icon = $('aiGenerateBtnIcon');
            const txt = $('aiGenerateBtnText');
            const errBox = $('builderError');
            const description = $('aiPluginDescription').value.trim();
            errBox.classList.add('hidden');

            btn.disabled = true;
            const prevText = txt.textContent;
            const prevIconClass = icon.className;
            txt.textContent = i18n.aiGenerating;
            icon.className = 'fa-solid fa-spinner fa-spin';

            try {
                const res = await fetch(baseUrl + '/create-plugin/ai-generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ description })
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error((data.errors || []).join(' · ') || 'Error');
                }
                applyConfigToForm(data.draft);
            } catch (err) {
                errBox.textContent = err.message;
                errBox.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                txt.textContent = prevText;
                icon.className = prevIconClass;
            }
        });
    }

    // ---- Per-collection cosmetic customization modal -----------------------------------
    const customizable = <%- JSON.stringify(customizablePlugins).replace(/</g, '\\u003c') %>;
    const czDefaultColor = <%- JSON.stringify(t('create_plugin.default_color')) %>;
    let czPluginId = null;
    let czIcon = '';

    function czSyncIcons() {
        document.querySelectorAll('.cz-icon').forEach(b => {
            const on = b.dataset.icon === czIcon;
            b.classList.toggle('bg-primary-theme', on);
            b.classList.toggle('text-white', on);
        });
        czRefresh();
    }

    document.querySelectorAll('.cz-icon').forEach(btn => {
        // The first tile is the plugin's own icon, and clicking the selected one again
        // comes back to it as well.
        btn.addEventListener('click', () => {
            czIcon = (czIcon === btn.dataset.icon) ? '' : btn.dataset.icon;
            czSyncIcons();
        });
    });

    const CZ_TYPE_ICONS = {
        text: 'fa-font', number: 'fa-hashtag', textarea: 'fa-align-left', select: 'fa-list',
        boolean: 'fa-square-check', tags: 'fa-tags', date: 'fa-calendar', rows: 'fa-table-list'
    };

    // Row builder for the modal's user-defined fields. Deliberately uses its own class
    // names: the plugin builder's collect() harvests '.field-row' document-wide and
    // would otherwise swallow these rows into the plugin being created.
    function czAddFieldRow(data) {
        data = data || {};
        const row = document.createElement('div');
        row.className = 'cz-field-row bg-black/5 dark:bg-white/5 rounded-xl';
        // Existing fields keep their stored name so renaming a label never orphans
        // the values already saved under the old key.
        row.dataset.name = data.name || '';
        // Kept beside the plugin's own lookalike on purpose: travels back with the save.
        row.dataset.keepBeside = data.keepBeside || '';

        const top = document.createElement('div');
        top.className = 'flex flex-wrap items-center gap-2';

        const label = document.createElement('input');
        label.type = 'text'; label.maxLength = 40;
        label.placeholder = i18n.fieldLabelPh;
        label.value = data.label || '';
        label.className = 'czf-label w-full sm:w-auto sm:flex-1 bg-black/5 dark:bg-white/5 rounded-lg text-sm p-2.5 outline-none focus:ring-1 focus:ring-primary-theme';

        const type = document.createElement('select');
        type.className = 'czf-type max-sm:flex-1 ' + SELECT_CLASSES;
        Object.keys(i18n.fieldTypes).forEach(tp => {
            const o = document.createElement('option');
            o.value = tp; o.textContent = i18n.fieldTypes[tp];
            o.className = OPTION_CLASSES;
            if ((data.type || 'text') === tp) o.selected = true;
            type.appendChild(o);
        });

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'w-11 h-11 sm:w-9 sm:h-9 rounded-lg flex items-center justify-center opacity-50 hover:opacity-100 hover:text-red-500 transition-all shrink-0';
        del.innerHTML = '<i class="fa-solid fa-trash text-sm"></i>';
        del.title = i18n.czDeleteField;
        del.setAttribute('aria-label', i18n.czDeleteField);
        // A field already saved may hold values: say how many before it goes. The values
        // themselves stay in the items until a later save confirms the removal.
        del.addEventListener('click', async () => {
            if (row.dataset.name && czPluginId) {
                try {
                    const res = await fetch(baseUrl + '/create-plugin/customize/' + czPluginId + '/fields/' + encodeURIComponent(row.dataset.name), { headers: { 'Accept': 'application/json' } });
                    const usage = await res.json();
                    if (usage.withValue > 0 && !confirm(i18n.fieldDeleteConfirm.replace('__COUNT__', usage.withValue))) return;
                } catch (e) { /* no count to show: removed as before */ }
            }
            row.remove();
        });

        top.append(label, type, del);

        const bottom = document.createElement('div');
        bottom.className = 'flex flex-wrap items-center gap-x-4 gap-y-2';

        const group = document.createElement('select');
        group.className = 'czf-group ' + SELECT_CLASSES.replace('text-sm p-2.5', 'text-xs p-2');
        [['main', i18n.groupMain], ['metadata', i18n.groupMeta]].forEach(([v, l]) => {
            const o = document.createElement('option');
            o.value = v; o.textContent = l;
            o.className = OPTION_CLASSES;
            if ((data.group || 'metadata') === v) o.selected = true;
            group.appendChild(o);
        });

        const reqLabel = document.createElement('label');
        reqLabel.className = 'flex items-center gap-2 text-xs cursor-pointer opacity-70';
        const req = document.createElement('input');
        req.type = 'checkbox';
        req.className = 'czf-required w-3.5 h-3.5';
        req.checked = data.required === true;
        reqLabel.append(req, document.createTextNode(i18n.required));

        const options = document.createElement('input');
        options.type = 'text';
        options.placeholder = i18n.optionsPh;
        options.value = Array.isArray(data.options) ? data.options.map(o => o.label).join(', ') : '';
        options.className = 'czf-options flex-1 min-w-[180px] bg-black/5 dark:bg-white/5 rounded-lg text-xs p-2 outline-none focus:ring-1 focus:ring-primary-theme';

        const fieldDefault = buildDefaultControl(data, type, options);
        row._readDefault = fieldDefault.read;

        bottom.append(group, reqLabel, options, fieldDefault.el);

        // Folded to one line, so a long list of fields reads at a glance. A new field and
        // one that needs a decision open on their own.
        const head = document.createElement('button');
        head.type = 'button';
        head.className = 'w-full flex items-center gap-3 p-3 min-h-14 text-left';
        const glyph = document.createElement('i');
        glyph.className = 'w-5 text-center text-primary-theme shrink-0';
        const names = document.createElement('span');
        names.className = 'min-w-0 flex-1';
        const headTitle = document.createElement('span');
        headTitle.className = 'block font-bold text-sm truncate';
        const headSub = document.createElement('span');
        headSub.className = 'block text-xs opacity-50 truncate';
        names.append(headTitle, headSub);
        const chevron = document.createElement('i');
        chevron.className = 'fa-solid fa-chevron-down text-xs opacity-40 transition-transform';
        head.appendChild(glyph);
        head.appendChild(names);
        if (data.lookalike) {
            const warn = document.createElement('i');
            warn.className = 'fa-solid fa-triangle-exclamation text-yellow-600 text-xs';
            head.appendChild(warn);
        }
        head.appendChild(chevron);

        const body = document.createElement('div');
        body.className = 'px-3 pb-3 space-y-2';
        body.append(top, bottom);
        row.append(head, body);

        function setOpen(open) {
            body.classList.toggle('hidden', !open);
            chevron.classList.toggle('rotate-180', open);
            head.setAttribute('aria-expanded', String(open));
        }
        head.addEventListener('click', () => setOpen(body.classList.contains('hidden')));
        function syncHead() {
            glyph.className = 'fa-solid ' + (CZ_TYPE_ICONS[type.value] || 'fa-font') + ' w-5 text-center text-primary-theme shrink-0';
            headTitle.textContent = label.value.trim() || i18n.czNewField;
            const fallback = fieldDefault.read();
            const parts = [i18n.fieldTypes[type.value]];
            if (req.checked) parts.push(i18n.czRequired);
            if (fallback && fallback !== true) parts.push(fallback);
            headSub.textContent = parts.join(' · ');
        }
        row.addEventListener('input', syncHead);
        row.addEventListener('change', syncHead);
        syncHead();
        setOpen(!data.name || !!data.lookalike);

        function syncOptionsVisibility() {
            // A list takes its options, a repeating field its columns, in the same box.
            options.classList.toggle('hidden', type.value !== 'select' && type.value !== 'rows');
            options.placeholder = type.value === 'rows' ? i18n.columnsPh : i18n.optionsPh;
        }
        type.addEventListener('change', syncOptionsVisibility);
        syncOptionsVisibility();

        // Names the plugin's own field this one looks like, so the admin can decide
        // whether both are wanted.
        if (data.lookalike) {
            const note = document.createElement('p');
            note.className = 'text-xs font-bold text-yellow-600';
            const icon = document.createElement('i');
            icon.className = 'fa-solid fa-triangle-exclamation mr-1';
            note.append(icon, document.createTextNode(i18n.lookalike.replace('__NATIVE__', data.lookalike)));
            body.appendChild(note);

            // The two ways out (#151): move the values into the plugin's field, never over
            // a different one, or keep both on purpose so the field stops being reported.
            const actions = document.createElement('div');
            actions.className = 'flex flex-wrap gap-2';
            const actionClass = 'text-xs font-bold px-3 py-1.5 rounded-lg transition-all hover:brightness-110';
            const use = document.createElement('button');
            use.type = 'button';
            use.className = actionClass + ' bg-yellow-600 text-white';
            use.textContent = i18n.lookalikeUse;
            const keep = document.createElement('button');
            keep.type = 'button';
            keep.className = actionClass + ' bg-black/5 dark:bg-white/10';
            keep.textContent = i18n.lookalikeKeep;
            actions.append(use, keep);
            body.appendChild(actions);

            const fieldUrl = () => baseUrl + '/create-plugin/customize/' + czPluginId + '/fields/' + encodeURIComponent(row.dataset.name);
            const postJson = async (url) => {
                const res = await fetch(url, { method: 'POST', headers: { 'Accept': 'application/json' } });
                const out = await res.json().catch(() => ({}));
                if (!res.ok || !out.success) throw new Error(out.error || 'error');
                return out;
            };

            use.addEventListener('click', async () => {
                try {
                    const plan = await (await fetch(fieldUrl(), { headers: { 'Accept': 'application/json' } })).json();
                    if (!plan.success || !plan.native) return;
                    const left = (plan.conflict || 0) + (plan.incompatible || 0);
                    const text = i18n.lookalikePlan
                        .replace('__ALL__', plan.withValue).replace('__MOVE__', plan.move)
                        .replace('__SAME__', plan.same).replace('__LEFT__', left)
                        .replace('__NATIVE__', plan.native.label);
                    if (!confirm(text)) return;
                    const done = await postJson(fieldUrl() + '/transfer');
                    alert(done.removed
                        ? i18n.lookalikeDone.replace('__MOVED__', done.moved)
                        : i18n.lookalikeDoneLeft.replace('__MOVED__', done.moved).replace('__LEFT__', done.left));
                    window.location.reload();
                } catch (e) { alert(e.message); }
            });

            keep.addEventListener('click', async () => {
                try {
                    await postJson(fieldUrl() + '/keep');
                    row.dataset.keepBeside = data.lookalikeName || '';
                    note.remove();
                    actions.remove();
                } catch (e) { alert(e.message); }
            });
        }

        $('czFields').appendChild(row);
        return row;
    }

    $('czAddFieldBtn').addEventListener('click', () => {
        const row = czAddFieldRow();
        row.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        row.querySelector('.czf-label').focus();
    });

    const CZ_TOGGLE_CLASSES = 'cz-toggle flex items-center gap-3 text-sm px-3 min-h-11 rounded-xl bg-black/5 dark:bg-white/5 cursor-pointer transition-colors';

    // ---- Card fields (selection only: the order is the plugin's own) -------------------
    const MAX_CARD_LINES = <%= maxCardLines %>;

    function czSyncCardFieldLimit() {
        const boxes = Array.from(document.querySelectorAll('.cz-card-field'));
        const reached = boxes.filter(b => b.checked).length >= MAX_CARD_LINES;
        boxes.forEach(b => {
            b.disabled = reached && !b.checked;
            b.closest('label').classList.toggle('opacity-40', b.disabled);
        });
    }

    // Same candidates as the card fields, plus an empty choice: a clean corner is the
    // default and has to remain reachable once something has been put there.
    function czRenderCornerField(data) {
        const select = $('czCornerField');
        const choices = data.cardFieldChoices || [];
        $('czCornerFieldWrap').classList.toggle('hidden', choices.length === 0);

        select.innerHTML = '';
        const none = document.createElement('option');
        none.value = '';
        none.className = 'bg-white dark:bg-[#1a1a1a]';
        none.textContent = <%- JSON.stringify(t('create_plugin.corner_field_none')) %>;
        select.append(none);

        choices.forEach(choice => {
            const option = document.createElement('option');
            option.value = choice.name;
            option.className = 'bg-white dark:bg-[#1a1a1a]';
            option.textContent = choice.label;
            select.append(option);
        });

        select.value = (data.current && data.current.cornerField) || '';

        czCornerPos = (data.current && data.current.cornerPosition) || <%- JSON.stringify(DEFAULT_CORNER_POSITION) %>;
        czPaintCornerPos();
        select.onchange = czPaintCornerPos;
    }

    let czCornerPos = <%- JSON.stringify(DEFAULT_CORNER_POSITION) %>;

    function czPaintCornerPos() {
        // The picker only means something once there is something to place.
        $('czCornerPosWrap').classList.toggle('hidden', !$('czCornerField').value);
        document.querySelectorAll('.cz-corner-pos').forEach(cell => {
            const active = cell.dataset.pos === czCornerPos;
            cell.classList.toggle('border-primary-theme', active);
            cell.classList.toggle('bg-primary-theme/10', active);
            cell.querySelector('span').classList.toggle('bg-primary-theme', active);
        });
    }

    document.addEventListener('click', function (event) {
        const cell = event.target.closest('.cz-corner-pos');
        if (!cell) return;
        czCornerPos = cell.dataset.pos;
        czPaintCornerPos();
        czRefresh();
    });

    function czRenderCardFields(data) {
        const wrap = $('czCardFields');
        wrap.innerHTML = '';
        const choices = data.cardFieldChoices || [];
        $('czCardFieldsWrap').classList.toggle('hidden', choices.length === 0);

        const selected = new Set(data.current.cardFields || data.cardFields || []);
        choices.forEach(choice => {
            const label = document.createElement('label');
            label.className = CZ_TOGGLE_CLASSES;

            const box = document.createElement('input');
            box.type = 'checkbox';
            box.className = 'cz-card-field accent-primary-theme w-4 h-4 shrink-0';
            box.value = choice.name;
            box.checked = selected.has(choice.name);
            box.addEventListener('change', czSyncCardFieldLimit);

            const text = document.createElement('span');
            text.className = 'truncate';
            text.textContent = choice.label;

            label.append(box, text);
            wrap.appendChild(label);
        });
        czSyncCardFieldLimit();
    }

    function czRenderTableColumns(data) {
        const wrap = $('czTableColumns');
        wrap.innerHTML = '';
        const choices = data.cardFieldChoices || [];
        $('czTableColumnsWrap').classList.toggle('hidden', choices.length === 0);

        const selected = new Set(data.tableColumns || []);
        choices.forEach(choice => {
            const label = document.createElement('label');
            label.className = CZ_TOGGLE_CLASSES;

            const box = document.createElement('input');
            box.type = 'checkbox';
            box.className = 'cz-table-column accent-primary-theme w-4 h-4 shrink-0';
            box.value = choice.name;
            box.checked = selected.has(choice.name);

            const text = document.createElement('span');
            text.className = 'truncate';
            text.textContent = choice.label;

            label.append(box, text);
            wrap.appendChild(label);
        });
    }

    // ---- Filters (on/off per filter, in the order the collection page lays them out) --
    function czRenderFilters(data) {
        const wrap = $('czFilters');
        wrap.innerHTML = '';
        const choices = data.filterChoices || [];
        $('czFiltersWrap').classList.toggle('hidden', choices.length === 0);

        choices.forEach(choice => {
            const label = document.createElement('label');
            label.className = CZ_TOGGLE_CLASSES;

            const box = document.createElement('input');
            box.type = 'checkbox';
            box.className = 'cz-filter accent-primary-theme w-4 h-4 shrink-0';
            box.value = choice.id;
            box.checked = !!choice.on;

            const text = document.createElement('span');
            text.className = 'truncate';
            text.textContent = choice.label;

            label.append(box, text);
            wrap.appendChild(label);
        });
    }

    window.openCustomize = function (id) {
        const data = customizable.find(p => p.id === id);
        if (!data) return;
        czPluginId = id;
        czIcon = data.current.icon || '';
        $('czTitle').textContent = data.label;
        $('czError').classList.add('hidden');
        czSyncIcons();

        $('czFields').innerHTML = '';
        (data.extraFields || []).forEach(f => czAddFieldRow({
            ...f,
            lookalike: (data.lookalikes || {})[f.name],
            lookalikeName: (data.lookalikeNames || {})[f.name]
        }));

        czRenderCardFields(data);
        czRenderCornerField(data);
        czRenderTableColumns(data);
        czRenderFilters(data);

        const wrap = $('czFormats');
        wrap.innerHTML = '';
        $('czFormatsWrap').classList.toggle('hidden', data.formats.length === 0);
        $('czSortFormats').checked = !!(data.current && data.current.sortFormats);
        czPreviewFormat = data.formats[0] ? data.formats[0].value : '';
        data.formats.forEach(f => wrap.appendChild(czColorRow(f, (data.current.formatColors || {})[f.value] || '')));

        // A subject with nothing to set for this plugin is not offered.
        const offered = {
            look: true,
            card: (data.cardFieldChoices || []).length > 0,
            table: (data.cardFieldChoices || []).length > 0,
            filters: (data.filterChoices || []).length > 0,
            fields: true
        };
        document.querySelectorAll('[data-cz-nav]').forEach(btn => {
            btn.classList.toggle('hidden', !offered[btn.dataset.czNav]);
        });

        czSnapshot = JSON.stringify(czCollect());
        czRefresh();

        const modal = $('customizeModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.documentElement.classList.add('overflow-hidden');
        history.pushState({ cz: 'home' }, '');
        czDepth = 1;
        czShow(czIsPhone() ? null : 'look');
    };

    // One format: its name and the palette as dots, the first standing for the plugin's
    // own color. The chosen color travels in a hidden input read at save time.
    function czColorRow(format, current) {
        const row = document.createElement('div');
        const name = document.createElement('p');
        name.className = 'text-sm font-medium truncate mb-2';
        name.textContent = format.label;
        const dots = document.createElement('div');
        dots.className = 'flex flex-wrap gap-2.5';
        const input = document.createElement('input');
        input.type = 'hidden';
        input.className = 'cz-color';
        input.dataset.format = format.value;
        input.value = current;

        ['', ...palette].forEach(color => {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'cz-dot w-8 h-8 rounded-full transition-shadow flex items-center justify-center '
                + (color ? 'bg-' + color + '-500' : 'border border-dashed border-black/30 dark:border-white/30');
            dot.title = color || czDefaultColor;
            dot.setAttribute('aria-label', color || czDefaultColor);
            dot.dataset.color = color;
            if (!color) dot.innerHTML = '<i class="fa-solid fa-rotate-left text-[10px] opacity-60"></i>';
            dot.setAttribute('aria-pressed', String(color === current));
            dot.addEventListener('click', () => {
                input.value = color;
                dots.querySelectorAll('.cz-dot').forEach(d => d.setAttribute('aria-pressed', String(d === dot)));
                czPreviewFormat = format.value;
                czRefresh();
            });
            dots.appendChild(dot);
        });
        row.append(name, dots, input);
        return row;
    }

    // ---- Moving around: the subject shown, and the phone's own back gesture ------------
    const czPhoneQuery = window.matchMedia('(max-width: 767.98px)');
    const czIsPhone = () => czPhoneQuery.matches;
    let czSnapshot = '';
    let czDepth = 0;
    let czPreviewFormat = '';

    // `section` empty is the phone's menu; a wide screen always has a subject open.
    function czShow(section) {
        const data = customizable.find(p => p.id === czPluginId);
        if (!data) return;
        $('czShell').dataset.view = section ? 'section' : 'home';
        const open = section || 'look';
        document.querySelectorAll('[data-cz-panel]').forEach(panel => {
            panel.classList.toggle('hidden', panel.dataset.czPanel !== open);
        });
        let title = data.label;
        document.querySelectorAll('[data-cz-nav]').forEach(btn => {
            const active = btn.dataset.czNav === open;
            btn.setAttribute('aria-current', String(active));
            if (active && section && czIsPhone()) title = btn.dataset.czTitle;
        });
        $('czTitle').textContent = title;
        $('czSubtitle').textContent = title === data.label ? i18n.czSubtitle : data.label;
        // The card preview only answers the subjects that change the card.
        $('czPreviewCol').classList.toggle('hidden', open !== 'look' && open !== 'card');
        $('czPanels').scrollTop = 0;
    }

    document.querySelectorAll('[data-cz-nav]').forEach(btn => {
        btn.addEventListener('click', () => {
            // On a phone a subject is a screen, so Back has to come out of it.
            if (czIsPhone()) {
                history.pushState({ cz: btn.dataset.czNav }, '');
                czDepth = 2;
            }
            czShow(btn.dataset.czNav);
        });
    });
    $('czBack').addEventListener('click', () => history.back());

    function czDirty() {
        return !!czPluginId && JSON.stringify(czCollect()) !== czSnapshot;
    }

    function czHide() {
        const modal = $('customizeModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.documentElement.classList.remove('overflow-hidden');
        czPluginId = null;
    }

    window.closeCustomize = function () {
        if (!czPluginId) return;
        if (czDirty() && !confirm(i18n.czDiscard)) return;
        czHide();
        if (czDepth > 0) history.go(-czDepth);
        czDepth = 0;
    };

    window.addEventListener('popstate', event => {
        if (!czPluginId) return;
        const where = event.state && event.state.cz;
        if (!where) {
            // Back from the menu leaves the workshop, unless that would lose changes.
            if (czDirty() && !confirm(i18n.czDiscard)) {
                history.pushState({ cz: 'home' }, '');
                czDepth = 1;
                return;
            }
            czDepth = 0;
            czHide();
            return;
        }
        czDepth = where === 'home' ? 1 : 2;
        czShow(where === 'home' ? (czIsPhone() ? null : 'look') : where);
    });

    // A reload after saving lands on the entries the workshop added: step back off them.
    if (history.state && history.state.cz) history.go(history.state.cz === 'home' ? -1 : -2);

    document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && czPluginId) closeCustomize();
    });

    // Everything that follows from the current choices: menu counts, preview, unsaved note.
    function czRefresh() {
        const data = customizable.find(p => p.id === czPluginId);
        if (!data) return;
        const checked = selector => Array.from(document.querySelectorAll(selector)).filter(b => b.checked);
        const cardBoxes = checked('.cz-card-field');
        const columns = checked('.cz-table-column');
        const rows = Array.from(document.querySelectorAll('.cz-field-row'));
        const counts = {
            card: cardBoxes.length + '/' + MAX_CARD_LINES,
            table: String(columns.length),
            filters: String(checked('.cz-filter').length),
            fields: String(rows.length)
        };
        document.querySelectorAll('[data-cz-nav]').forEach(btn => {
            btn.querySelector('[data-cz-count]').textContent = counts[btn.dataset.czNav] || '';
        });
        const warn = document.querySelector('[data-cz-nav="fields"] [data-cz-warn]');
        warn.classList.toggle('hidden', Object.keys(data.lookalikes || {}).length === 0);
        $('czCardCount').textContent = counts.card;

        const labelOf = name => ((data.cardFieldChoices || []).find(c => c.name === name) || {}).label || name;
        const icon = czIcon || ('fa-' + data.icon);
        $('czHeadIconGlyph').className = 'fa-solid ' + icon;
        $('czPvIcon').className = 'fa-solid ' + icon + ' text-2xl lg:text-6xl opacity-30';
        $('czOwnIcon').className = 'fa-solid fa-' + data.icon;

        const format = data.formats.find(f => f.value === czPreviewFormat);
        const badge = $('czPvBadge');
        badge.classList.toggle('hidden', !format);
        if (format) {
            const input = document.querySelector('.cz-color[data-format="' + CSS.escape(format.value) + '"]');
            const color = input ? input.value : '';
            badge.textContent = format.label;
            badge.className = badge.className.replace(/\bbg-\S+/g, '').trim() + ' ' + (color ? 'bg-' + color + '-600' : 'bg-primary-theme');
        }

        const corner = $('czPvCorner');
        const cornerField = $('czCornerField').value;
        corner.classList.toggle('hidden', !cornerField);
        corner.textContent = cornerField ? labelOf(cornerField) : '';
        corner.style.top = czCornerPos === 'top-left' ? '0.25rem' : '';
        corner.style.bottom = czCornerPos === 'top-left' ? '' : '0.25rem';
        corner.style.left = czCornerPos === 'bottom-right' ? '' : '0.25rem';
        corner.style.right = czCornerPos === 'bottom-right' ? '0.25rem' : '';

        const lines = $('czPvLines');
        lines.innerHTML = '';
        cardBoxes.forEach(box => {
            const line = document.createElement('p');
            line.className = 'truncate';
            line.textContent = labelOf(box.value);
            lines.appendChild(line);
        });

        const table = $('czTablePreview');
        table.innerHTML = '';
        [i18n.czTableTitle, ...columns.map(box => labelOf(box.value))].forEach(text => {
            const cell = document.createElement('span');
            cell.className = 'card-theme px-3 py-2 whitespace-nowrap first:rounded-l-xl last:rounded-r-xl flex-1';
            cell.textContent = text;
            table.appendChild(cell);
        });

        $('czDirty').classList.toggle('invisible', !czDirty());
    }

    $('customizeModal').addEventListener('input', czRefresh);
    $('customizeModal').addEventListener('change', czRefresh);
    new MutationObserver(czRefresh).observe($('czFields'), { childList: true });

    // What the workshop currently says, as the save route takes it.
    function czCollect() {
        const body = { icon: czIcon, formatColors: {}, sortFormats: $('czSortFormats').checked, cornerField: $('czCornerField').value, cornerPosition: czCornerPos };
        document.querySelectorAll('.cz-color').forEach(input => {
            if (input.value) body.formatColors[input.dataset.format] = input.value;
        });
        // Always sent, so unchecking everything is honoured as "title only" instead
        // of falling back to the plugin's own fields
        body.cardFields = Array.from(document.querySelectorAll('.cz-card-field'))
            .filter(b => b.checked).map(b => b.value);
        body.tableColumns = Array.from(document.querySelectorAll('.cz-table-column'))
            .filter(b => b.checked).map(b => b.value);
        body.filters = Array.from(document.querySelectorAll('.cz-filter'))
            .filter(b => b.checked).map(b => b.value);
        body.extraFields = Array.from(document.querySelectorAll('.cz-field-row')).map(r => ({
            name: r.dataset.name || undefined,
            keepBeside: r.dataset.keepBeside || undefined,
            label: r.querySelector('.czf-label').value.trim(),
            type: r.querySelector('.czf-type').value,
            group: r.querySelector('.czf-group').value,
            required: r.querySelector('.czf-required').checked,
            options: r.querySelector('.czf-options').value.split(',').map(s => s.trim()).filter(Boolean),
            default: r._readDefault ? r._readDefault() : undefined
        })).filter(f => f.label);
        return body;
    }

    window.saveCustomize = async function (reset) {
        if (!czPluginId) return;
        if (reset && !confirm(i18n.czReset)) return;
        const body = reset
            ? { icon: '', formatColors: {}, sortFormats: false, cornerField: '', cornerPosition: '' }
            : czCollect();
        // "Reset" only clears the cosmetics: omitting extraFields leaves the declared
        // fields alone, so a misclick cannot make saved values unreachable.
        try {
            const res = await fetch(baseUrl + '/create-plugin/customize/' + czPluginId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();
            if (!res.ok || !data.success) throw new Error(data.error || 'Error');
            window.location.reload();
        } catch (err) {
            const errBox = $('czError');
            errBox.textContent = err.message;
            errBox.classList.remove('hidden');
        }
    };

    $('customizeModal').addEventListener('click', e => {
        if (e.target === $('customizeModal')) closeCustomize();
    });

    // ---- Delete (existing plugins list) ----------------------------------------------
    window.deleteCustomPlugin = async function (id, itemCount) {
        if (!confirm(i18n.deleteConfirm.replace('%COUNT%', itemCount))) return;
        try {
            const res = await fetch(baseUrl + '/create-plugin/delete/' + id, {
                method: 'POST',
                headers: { 'Accept': 'application/json' }
            });
            const data = await res.json();
            if (!res.ok || !data.success) throw new Error(data.error || 'Error');
            window.location.reload();
        } catch (err) {
            alert(err.message);
        }
    };

    // ---- Init ---------------------------------------------------------------------------
    // Fills every builder field from a config object, used both to prefill an
    // existing plugin for editing (below) and, via the "Describe it" box, to drop
    // in an AI-generated first draft. Re-callable: clears the dynamic field/format
    // rows first, so a second AI draft replaces the first rather than appending to it.
    function applyConfigToForm(config) {
        $('pluginLabel').value = config.label || '';
        $('creatorLabel').value = config.creatorLabel || '';
        state.icon = config.icon || 'fa-box';
        state.color = config.color || 'teal';
        state.shape = shapeFromConfig(config);
        const features = config.features || {};
        document.querySelectorAll('.feature-toggle').forEach(cb => { cb.checked = features[cb.dataset.feature] === true; });
        $('formatRows').innerHTML = '';
        $('fieldRows').innerHTML = '';
        (config.formats || []).forEach(addFormatRow);
        (config.fields || []).forEach(addFieldRow);
        state.defaultFormat = config.defaultFormat || '';
        syncPickers();
        renderPreview();
    }

    if (editConfig) {
        applyConfigToForm(editConfig);
        if (editPlaceholder) {
            // state.defaultCover stays null: previewing the stored image is not editing it
            if (/^https?:\/\//i.test(editPlaceholder)) {
                $('dcUrl').value = editPlaceholder;
                setCoverTab('url');
            }
            setCoverPreview(editPlaceholder);
        }
    } else {
        syncPickers();
        renderPreview();
    }
})();
</script>
