<%- include('partials/header') %>

    <!-- Loaded up here, not at the bottom of the page: the partials included below open
         their own socket as they are parsed, so `io` has to exist before they run. -->
    <script src="<%= baseUrl %>/socket.io/socket.io.js"></script>

    <div class="max-w-screen-xl mx-auto px-4 pb-20 space-y-10">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between py-6 gap-4">
            <h1 class="text-2xl md:text-3xl font-bold flex items-center gap-3 transition-colors">
                <i class="fa-solid fa-shield-halved text-primary-theme"></i>
                <%= t('admin.title') %>
                <span class="text-base font-bold opacity-50">- <%= locals.collectionDoc ? collectionDoc.name : '' %></span>
            </h1>
            <div class="flex items-center gap-3">
                <% if (user.isAdmin) { %>
                    <a href="<%= baseUrl %>/admin/instance"
                        class="flex items-center gap-2 text-xs font-black uppercase tracking-widest bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-4 py-2 rounded-full transition-all">
                        <i class="fa-solid fa-server"></i>
                        <%= t('admin.instance.title') %>
                    </a>
                <% } %>
                <div
                    class="w-fit text-[10px] font-black tracking-widest opacity-40 border border-black/10 dark:border-white/10 px-3 py-1 rounded-full">
                    v<%= appVersion %>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <h1 class="text-2xl md:text-3xl font-bold flex items-center gap-3 transition-colors">
                <i class="fa-solid fa-puzzle-piece text-primary-theme"></i>
                <%= t('admin.modules') %>
            </h1>
            <a href="<%= baseUrl %>/create-plugin"
                class="flex items-center gap-2 text-xs font-black uppercase tracking-widest bg-primary-theme text-white hover:brightness-110 hover:scale-105 px-5 py-2.5 rounded-full transition-all w-fit shadow-lg shadow-primary-theme/20">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                <%= t('create_plugin.title') %>
            </a>
        </div>

        <section class="card-theme rounded-3xl p-6 shadow-sm mb-10 transition-colors">
            <div class="flex flex-col gap-8">
                <div class="flex items-center gap-4">
                    <div
                        class="w-12 h-12 rounded-2xl bg-primary-theme/10 text-primary-theme flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-cubes-stacked text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-sm font-black uppercase tracking-widest opacity-80">
                            <%= t('perso.modules.title') %>
                        </h2>
                        <p class="text-xs opacity-50">
                            <%= t('admin.modules_description') %>
                        </p>
                    </div>
                </div>

                <form action="<%= baseUrl %>/admin/modules/save" method="POST" class="space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <%
                        const mods = registry.getAll().map(p => ({
                            key: p.collectionType,
                            pluginId: p.id,
                            label: t(p.label),
                            icon: 'fa-' + p.icon,
                            needsKey: (p.requiredEnvKeys || []).length > 0,
                            settings: p.settings || []
                        }));
                        %>
                            <% mods.forEach((mod)=> { %>
                                <div class="flex flex-col gap-2">
                                    <label
                                        class="group flex items-center justify-between p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-transparent hover:border-primary-theme/30 has-[:checked]:bg-green-500/10 has-[:checked]:border-green-500/30 transition-all cursor-pointer">
                                        <div class="flex items-center gap-3">
                                            <div
                                                class="w-10 h-10 rounded-xl flex items-center justify-center bg-white dark:bg-black/20 shadow-sm group-hover:text-primary-theme group-has-[:checked]:bg-green-500 group-has-[:checked]:text-white transition-colors">
                                                <i class="fa-solid <%= mod.icon %> text-sm"></i>
                                            </div>
                                            <span
                                                class="text-sm font-bold opacity-70 group-hover:opacity-100 group-has-[:checked]:opacity-100 transition-opacity">
                                                <%= mod.label %>
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <% if (mod.settings.length > 0) { %>
                                                <span role="button" tabindex="0"
                                                    onclick="event.preventDefault(); document.getElementById('opts-<%= mod.pluginId %>').classList.toggle('hidden');"
                                                    onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault(); document.getElementById('opts-<%= mod.pluginId %>').classList.toggle('hidden');}"
                                                    class="w-8 h-8 rounded-lg flex items-center justify-center bg-white dark:bg-black/20 shadow-sm opacity-60 hover:opacity-100 hover:text-primary-theme transition-all cursor-pointer"
                                                    title="<%= t('admin.module_settings') %>">
                                                    <i class="fa-solid fa-gear text-xs"></i>
                                                </span>
                                            <% } %>
                                            <div class="relative inline-flex items-center cursor-pointer">
                                                <input type="checkbox" name="<%= mod.key %>Active" <%=settings.modules &&
                                                    settings.modules[mod.key] ? 'checked' : '' %> class="sr-only peer">
                                                <div
                                                    class="w-11 h-6 bg-black/10 dark:bg-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500">
                                                </div>
                                            </div>
                                        </div>
                                    </label>

                                    <% if (mod.settings.length > 0) { %>
                                        <div id="opts-<%= mod.pluginId %>" class="hidden p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 space-y-3">
                                            <% mod.settings.forEach(opt => {
                                                const current = registry.getPluginSetting(settings, mod.pluginId, opt.key);
                                            %>
                                                <label class="flex items-start justify-between gap-3 cursor-pointer">
                                                    <div>
                                                        <span class="text-xs font-bold opacity-80"><%= t(opt.label, { defaultValue: opt.label }) %></span>
                                                        <% if (opt.description) { %>
                                                            <p class="text-[10px] opacity-50 mt-0.5"><%= t(opt.description, { defaultValue: opt.description }) %></p>
                                                        <% } %>
                                                    </div>
                                                    <div class="relative inline-flex items-center shrink-0 mt-0.5">
                                                        <input type="checkbox" name="pluginSetting_<%= mod.pluginId %>_<%= opt.key %>" <%= current ? 'checked' : '' %> class="sr-only peer">
                                                        <div class="w-9 h-5 bg-black/10 dark:bg-white/10 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-green-500"></div>
                                                    </div>
                                                </label>
                                            <% }) %>
                                        </div>
                                    <% } %>
                                    <% if (mod.needsKey) { %>
                                        <div id="error-<%= mod.key %>"
                                            class="hidden p-3 bg-red-500/10 border border-red-500/20 rounded-xl animate-in fade-in slide-in-from-top-1 duration-300">
                                            <p class="text-[10px] text-red-500 font-bold flex items-center gap-2">
                                                <i class="fa-solid fa-circle-exclamation"></i>
                                                <%= t('admin.errors.missing_api_key') %>
                                            </p>
                                            <a href="https://github.com/Kyonew/DVinyl/blob/main/docs/api-keys.md"
                                                target="_blank"
                                                class="text-[9px] text-primary-theme underline mt-1 block font-bold uppercase tracking-tighter">
                                                <%= t('admin.errors.help_link') %>
                                            </a>
                                        </div>
                                        <% } %>
                                </div>
                                <% }) %>
                    </div>
                    <label
                        class="flex items-start justify-between gap-4 p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 cursor-pointer">
                        <div class="flex items-start gap-3">
                            <div
                                class="w-10 h-10 rounded-xl flex items-center justify-center bg-white dark:bg-black/20 shadow-sm shrink-0">
                                <i class="fa-solid fa-layer-group text-sm"></i>
                            </div>
                            <div>
                                <span class="text-sm font-bold opacity-80">
                                    <%= t('admin.merge_duplicates') %>
                                </span>
                                <p class="text-xs opacity-50 mt-0.5">
                                    <%= t('admin.merge_duplicates_desc') %>
                                </p>
                            </div>
                        </div>
                        <div class="relative inline-flex items-center shrink-0 mt-2">
                            <input type="checkbox" name="mergeDuplicates" <%= settings.mergeDuplicates !== false ?
                                'checked' : '' %> class="sr-only peer">
                            <div
                                class="w-11 h-6 bg-black/10 dark:bg-white/10 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500">
                            </div>
                        </div>
                    </label>

                    <div class="flex justify-end pt-2">
                        <button type="submit"
                            class="w-full sm:w-auto bg-primary-theme text-white text-xs font-black uppercase tracking-widest px-10 py-4 rounded-2xl hover:brightness-110 active:scale-95 transition-all shadow-lg shadow-primary-theme/20 flex items-center justify-center gap-3">
                            <i class="fa-solid fa-save"></i>
                            <%= t('perso.save') %>
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <% if (locals.successMessage && !locals.newPassword) { %>
            <div class="bg-primary-theme/10 border border-primary-theme/30 p-4 rounded-2xl text-center mb-6 transition-colors">
                <p class="text-sm font-bold text-primary-theme flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check-circle"></i>
                    <%= successMessage %>
                </p>
            </div>
        <% } %>

        <% if (locals.newPassword) { %>
            <div
                class="bg-primary-theme/10 border border-primary-theme/30 p-6 rounded-2xl text-center animate-pulse transition-colors">
                <h2 class="text-lg font-bold text-primary-theme mb-2">
                    <i class="fa-solid fa-check-circle"></i>
                    <%= successMessage %>
                </h2>
                <p class="text-sm opacity-70 mb-4">
                    <%= t('admin.temp_password_hint') %>
                </p>
                <div
                    class="bg-white dark:bg-black/50 p-4 rounded-xl inline-flex items-center gap-3 border border-primary-theme/30 shadow-sm overflow-hidden max-w-full">
                    <code class="text-xl md:text-2xl font-mono select-all break-all"><%= newPassword %></code>
                </div>
            </div>
            <% } %>
            
                <%- include('partials/admin-visibility') %>

                <section>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between py-6 gap-4 mb-4">
                        <h1 class="text-2xl md:text-3xl font-bold flex items-center gap-3 transition-colors">
                            <i class="fa-solid fa-users text-neutral-400 dark:text-neutral-500"></i>
                            <%= t('admin.members.title', { count: (locals.members || []).length }) %>
                        </h1>
                        <button onclick="toggleModal('addMemberModal')"
                            class="group relative flex items-center gap-3 bg-primary-theme hover:brightness-110 text-white px-5 py-3 rounded-2xl shadow-lg shadow-primary-theme/20 transition-all active:scale-95 overflow-hidden">
                            <div
                                class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform">
                            </div>
                            <i class="fa-solid fa-user-plus text-sm relative"></i>
                            <span class="text-xs font-black relative">
                                <%= t('admin.members.create_btn') %>
                            </span>
                        </button>
                    </div>

                    <!-- Invite an existing instance user -->
                    <form action="<%= baseUrl %>/admin/members/invite" method="POST"
                        class="flex flex-col sm:flex-row items-stretch gap-2 mb-6">
                        <input type="text" name="identifier" required
                            placeholder="<%= t('admin.members.invite_placeholder') %>"
                            class="flex-1 bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-2xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-primary-theme/40 transition-colors">
                        <select name="role"
                            class="bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-2xl px-4 py-3 text-sm outline-none cursor-pointer">
                            <option class="bg-white dark:bg-[#1a1a1a]" value="viewer"><%= t('admin.members.role_viewer') %></option>
                            <option class="bg-white dark:bg-[#1a1a1a]" value="editor"><%= t('admin.members.role_editor') %></option>
                            <option class="bg-white dark:bg-[#1a1a1a]" value="admin"><%= t('admin.members.role_admin') %></option>
                        </select>
                        <button type="submit"
                            class="flex items-center justify-center gap-2 bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-5 py-3 rounded-2xl text-xs font-black transition-all">
                            <i class="fa-solid fa-envelope"></i>
                            <%= t('admin.members.invite_btn') %>
                        </button>
                    </form>

                    <div class="card-theme rounded-2xl overflow-hidden shadow-lg transition-colors">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm opacity-80 min-w-[600px]">
                                <thead class="bg-black/5 dark:bg-white/5 text-xs uppercase opacity-70 transition-colors">
                                    <tr>
                                        <th class="px-6 py-4">
                                            <%= t('admin.table.user') %>
                                        </th>
                                        <th class="px-6 py-4">
                                            <%= t('admin.members.col_role') %>
                                        </th>
                                        <th class="px-6 py-4 text-right">
                                            <%= t('admin.table.actions') %>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-black/5 dark:divide-white/5 transition-colors">
                                    <% (locals.members || []).forEach(m=> { const mu = m.user; %>
                                        <tr class="hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                                            <td class="px-6 py-4 font-medium">
                                                <div class="flex items-center gap-3">
                                                    <img src="<%= baseUrl + (mu.img || '/ressources/no-pp.jpg') %>"
                                                        class="w-8 h-8 rounded-full border border-black/10 dark:border-white/10 object-cover">
                                                    <div class="overflow-hidden">
                                                        <p class="truncate"><%= mu.username %>
                                                            <% if (mu.isAdmin) { %>
                                                                <span class="text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-primary-theme/10 text-primary-theme">
                                                                    <%= t('admin.instance.admin_badge') %>
                                                                </span>
                                                            <% } %>
                                                        </p>
                                                        <p class="text-[10px] opacity-60 truncate"><%= mu.email %></p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4">
                                                <% if (String(mu._id) === String(user._id)) { %>
                                                    <!-- Own role: read-only (another admin must change it) -->
                                                    <span class="inline-block bg-black/5 dark:bg-white/5 rounded-lg px-3 py-2 text-xs font-bold opacity-70">
                                                        <%= t('admin.members.role_' + m.role) %>
                                                    </span>
                                                <% } else { %>
                                                    <form action="<%= baseUrl %>/admin/members/role" method="POST" class="flex items-center gap-2">
                                                        <input type="hidden" name="userId" value="<%= mu._id %>">
                                                        <select name="role" onchange="this.form.submit()"
                                                            class="bg-black/5 dark:bg-white/5 border border-transparent rounded-lg px-3 py-2 text-xs font-bold outline-none cursor-pointer">
                                                            <option class="bg-white dark:bg-[#1a1a1a]" value="viewer" <%= m.role === 'viewer' ? 'selected' : '' %>><%= t('admin.members.role_viewer') %></option>
                                                            <option class="bg-white dark:bg-[#1a1a1a]" value="editor" <%= m.role === 'editor' ? 'selected' : '' %>><%= t('admin.members.role_editor') %></option>
                                                            <option class="bg-white dark:bg-[#1a1a1a]" value="admin" <%= m.role === 'admin' ? 'selected' : '' %>><%= t('admin.members.role_admin') %></option>
                                                        </select>
                                                    </form>
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 text-right">
                                                <div class="flex justify-end gap-2">
                                                    <% if (!mu.isAdmin) { %>
                                                        <form action="<%= baseUrl %>/admin/members/reset-password" method="POST"
                                                            onsubmit="return confirm(<%= JSON.stringify(t('admin.confirm_reset', { name: mu.username })) %>)">
                                                            <input type="hidden" name="userId" value="<%= mu._id %>">
                                                            <button type="submit"
                                                                class="text-yellow-600 bg-yellow-100 dark:bg-yellow-500/10 p-2 rounded-lg transition-colors hover:brightness-110"
                                                                title="<%= t('admin.tooltips.reset_password') %>">
                                                                <i class="fa-solid fa-key"></i>
                                                            </button>
                                                        </form>
                                                    <% } %>
                                                    <form action="<%= baseUrl %>/admin/members/remove" method="POST"
                                                        onsubmit="return confirm(<%= JSON.stringify(t('admin.members.confirm_remove', { name: mu.username })) %>)">
                                                        <input type="hidden" name="userId" value="<%= mu._id %>">
                                                        <button type="submit"
                                                            class="text-red-600 bg-red-100 dark:bg-red-500/10 p-2 rounded-lg transition-colors hover:brightness-110"
                                                            title="<%= t('admin.members.remove_btn') %>">
                                                            <i class="fa-solid fa-user-minus"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section>
                    <div class="flex items-center gap-4 mb-6">
                        <h2 class="text-xl font-bold flex items-center gap-2 transition-colors whitespace-nowrap">
                            <i class="fa-solid fa-layer-group text-primary-theme"></i>
                            <%= t('admin.my_collection.title') %>
                        </h2>
                        <div class="flex-grow border-t border-black/10 dark:border-white/10 transition-colors"></div>
                    </div>

                    <div class="card-theme rounded-3xl p-6 md:p-8 shadow-sm transition-colors space-y-6">
                        <% if (locals.collectionDoc) { %>
                            <form action="<%= baseUrl %>/admin/collections/<%= collectionDoc._id %>/rename" method="POST"
                                class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                                <div class="flex-1 space-y-2">
                                    <label class="block text-[10px] font-black uppercase tracking-widest opacity-50 ml-1">
                                        <%= t('admin.my_collection.name_label') %>
                                    </label>
                                    <input type="text" name="name" value="<%= collectionDoc.name %>" required
                                        class="w-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-2xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-primary-theme/40 transition-colors">
                                </div>
                                <button type="submit"
                                    class="sm:self-end flex items-center justify-center gap-2 bg-primary-theme hover:brightness-110 text-white px-6 py-3 rounded-2xl text-xs font-black transition-all active:scale-95">
                                    <i class="fa-solid fa-pen"></i>
                                    <%= t('admin.collections.rename') %>
                                </button>
                            </form>
                        <% } %>

                        <div class="border-t border-black/5 dark:border-white/5 pt-6 flex flex-col md:flex-row md:items-center justify-between gap-6">
                            <div>
                                <h3 class="text-lg font-bold flex items-center gap-2 mb-1">
                                    <i class="fa-solid fa-database text-primary-theme"></i>
                                    <%= t('admin.collection_backup.title') %>
                                </h3>
                                <p class="text-xs opacity-60">
                                    <%= t('admin.collection_backup.subtitle') %>
                                </p>
                            </div>
                            <div class="flex flex-wrap gap-3">
                                <a href="<%= baseUrl %>/backup/collection/export"
                                    class="flex-1 sm:flex-none bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-6 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-file-export"></i>
                                    <%= t('admin.backup.export_btn') %>
                                </a>
                                <a href="<%= baseUrl %>/backup/collection/export-csv"
                                    class="flex-1 sm:flex-none bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-6 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-file-csv"></i>
                                    <%= t('admin.backup.export_csv_btn') %>
                                </a>
                                <label
                                    class="flex-1 sm:flex-none bg-black/5 dark:bg-white/5 hover:bg-yellow-500 hover:text-white px-6 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2 cursor-pointer">
                                    <i class="fa-solid fa-file-import"></i>
                                    <%= t('admin.backup.import_btn') %>
                                        <input type="file" id="collectionBackupInput" class="hidden" accept=".json">
                                </label>
                            </div>
                        </div>

                        <div id="shareLinks" class="border-t border-black/5 dark:border-white/5 pt-6 scroll-mt-6">
                            <h3 class="text-lg font-bold flex items-center gap-2 mb-1">
                                <i class="fa-solid fa-qrcode text-primary-theme"></i>
                                <%= t('admin.sharing.title') %>
                            </h3>
                            <p class="text-xs opacity-60 max-w-md mb-4">
                                <%= t('admin.sharing.subtitle') %>
                            </p>

                            <%
                                const shareLinks = (locals.collectionDoc && collectionDoc.shareLinks) || [];
                                const sharePlugins = registry.getAll().filter(p => settings.modules && settings.modules[p.collectionType] === true);
                            %>

                            <div class="space-y-4">
                                <% shareLinks.forEach((link, idx) => { %>
                                    <%
                                        const scopeByType = {};
                                        (link.scope || []).forEach((s) => { scopeByType[s.pluginId] = s.formats || []; });
                                        const idPrefix = 'link' + idx;
                                    %>
                                    <div class="rounded-2xl bg-black/5 dark:bg-white/5 p-4 space-y-4">
                                        <div class="flex flex-wrap items-center justify-between gap-3">
                                            <div class="flex items-center gap-2 min-w-0">
                                                <span class="w-2 h-2 rounded-full <%= link.enabled ? 'bg-green-500' : 'bg-gray-400' %> shrink-0"></span>
                                                <span class="text-sm font-bold truncate"><%= link.label || t('admin.sharing.untitled_link') %></span>
                                            </div>
                                            <div class="flex flex-wrap gap-2">
                                                <form action="<%= baseUrl %>/admin/share/<%= link.token %>/toggle" method="POST">
                                                    <button type="submit"
                                                        class="bg-black/5 dark:bg-white/10 hover:bg-<%= link.enabled ? 'red' : 'green' %>-500 hover:text-white px-3 py-1.5 rounded-lg text-xs font-bold transition-all">
                                                        <%= link.enabled ? t('admin.sharing.disable_btn') : t('admin.sharing.enable_btn') %>
                                                    </button>
                                                </form>
                                                <form action="<%= baseUrl %>/admin/share/<%= link.token %>/regenerate" method="POST"
                                                    onsubmit="return confirm(<%= JSON.stringify(t('admin.sharing.confirm_regenerate')) %>)">
                                                    <button type="submit" title="<%= t('admin.sharing.regenerate_btn') %>"
                                                        class="bg-black/5 dark:bg-white/10 hover:bg-amber-500 hover:text-white w-8 h-8 rounded-lg text-xs transition-all">
                                                        <i class="fa-solid fa-rotate"></i>
                                                    </button>
                                                </form>
                                                <form action="<%= baseUrl %>/admin/share/<%= link.token %>/delete" method="POST"
                                                    onsubmit="return confirm(<%= JSON.stringify(t('admin.sharing.confirm_delete')) %>)">
                                                    <button type="submit" title="<%= t('admin.sharing.delete_btn') %>"
                                                        class="bg-black/5 dark:bg-white/10 hover:bg-red-600 hover:text-white w-8 h-8 rounded-lg text-xs transition-all">
