                                    <button id="btnRefresh<%= K %>" onclick="startMetadataRefresh('<%= K %>', '<%= p.id %>')" class="w-full sm:w-auto bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white px-8 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2 border border-black/10 dark:border-white/10 shadow-sm">
                                        <i class="fa-solid fa-play" id="iconRefresh<%= K %>"></i>
