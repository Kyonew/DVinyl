<%- include('partials/header') %>
<%- include('partials/markdown-styles') %>

<%#
    The home page: the collection's widgets (core/dashboard.ts), in the order and sizes its
    admin arranged them, each drawn by partials/dashboard/frame. Two columns on a phone,
    four from md up; a widget spans one to four of them.
%>
<div class="max-w-screen-xl mx-auto pb-12" data-dashboard>
    <% if (locals.isCollectionAdmin) { %>
        <%- include('partials/dashboard/editor-bar', { part: 'bar' }) %>
    <% } %>

    <div data-dashboard-grid class="grid grid-cols-2 md:grid-cols-4 gap-x-2.5 gap-y-6 md:gap-x-6 md:gap-y-10">
        <% entries.forEach(entry => { %>
            <%- include('partials/dashboard/frame', { entry, dashboardWidgets }) %>
        <% }) %>
    </div>

    <% if (locals.isCollectionAdmin) { %>
        <%- include('partials/dashboard/editor-bar', { part: 'rest' }) %>
    <% } %>
</div>

<% if (locals.canEditCollection && entries.some(e => e.widget.type === 'wishlist')) { %>
    <%- include('partials/wishlist-move-script') %>
<% } %>

<script>
    // A widget that offers another take of itself (the random pick) fetches its own
    // frame again and takes its place.
    document.querySelector('[data-dashboard-grid]').addEventListener('click', async (event) => {
        const button = event.target.closest('[data-widget-refresh]');
        if (!button) return;
        const frame = button.closest('[data-widget]');
        button.disabled = true;
        button.querySelector('i')?.classList.add('fa-spin');
        try {
            const res = await fetch('<%= baseUrl %>/dashboard/widgets/' + encodeURIComponent(frame.dataset.widgetId));
            if (!res.ok) throw new Error(String(res.status));
            const template = document.createElement('template');
            template.innerHTML = (await res.text()).trim();
            if (template.content.firstElementChild) frame.replaceWith(template.content.firstElementChild);
        } catch (e) {
            button.disabled = false;
            button.querySelector('i')?.classList.remove('fa-spin');
        }
    });
</script>

<% if (locals.isCollectionAdmin) { %>
    <%- include('partials/dashboard/editor') %>
<% } %>

<%- include('partials/footer') %>
