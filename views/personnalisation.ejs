<%- include('partials/header') %>

    <div class="max-w-5xl mx-auto px-4 max-sm:px-0 pt-2 pb-12 md:py-10">

        <%# On phones the shell's back button stands in for the link home, and the cards
            tighten up: same settings, less chrome around them. %>
        <div data-settings-head class="flex flex-col md:flex-row md:items-center justify-between mb-6 md:mb-8 gap-4">
            <div>
                <h1 class="text-[2rem] leading-tight font-extrabold tracking-tight md:text-3xl md:font-black md:tracking-normal transition-colors">
                    <%= t('perso.title') %>
                </h1>
                <p class="text-sm md:text-base opacity-60 mt-1 transition-colors">
                    <%= t('perso.subtitle', { siteName: settings.siteName }) %>
                </p>
            </div>
            <a href="<%= baseUrl || '/' %>"
                class="max-md:hidden w-fit px-4 py-2 bg-black/5 dark:bg-white/10 rounded-lg text-sm font-bold hover:bg-black/10 dark:hover:bg-white/20 transition-all flex items-center">
                <i class="fa-solid fa-arrow-left mr-2"></i>
                <%= t('perso.backHome') %>
            </a>
        </div>

        <form action="<%= baseUrl %>/admin/personnalisation/save" method="POST" data-save-bar class="space-y-5 md:space-y-8">

            <%- include('partials/settings-tabs', { phoneOnly: true, tabs: [
                { id: 'themes', icon: 'palette', label: t('perso.themes.title') },
                { id: 'layout', icon: 'table-columns', label: t('layout.title') },
                { id: 'cards', icon: 'percent', label: t('perso.card_aspect_ratio') },
                { id: 'navigation', icon: 'list-check', label: t('perso.nav_title') },
                { id: 'quick-add', icon: 'bolt', label: t('perso.fastAdd_title') },
                { id: 'widgets', icon: 'chart-simple', label: t('perso.widgets_title') },
                { id: 'packs', icon: 'box-archive', label: t('perso.pack_title') }
            ] }) %>

            <div data-tab-panel="themes" class="md:!mt-0 card-theme rounded-2xl md:rounded-3xl p-4 md:p-6 shadow-sm md:shadow-xl transition-colors">
                <h2 class="text-lg md:text-xl font-bold mb-4 md:mb-6 flex items-center gap-3">
                    <div
                        class="w-8 h-8 md:w-10 md:h-10 shrink-0 rounded-full bg-primary-theme/10 text-primary-theme flex items-center justify-center text-sm md:text-base">
                        <i class="fa-solid fa-palette"></i>
                    </div>
                    <%= t('perso.themes.title') %>
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8">

                    <div class="space-y-2">
                        <label class="block text-xs font-bold uppercase tracking-widest opacity-60">
                            <i class="fa-solid fa-house mr-1"></i>
                            <%= t('perso.themes.home') %>
                        </label>
                        <select name="homePreset"
                            class="w-full bg-black/5 dark:bg-black/20 border border-transparent focus:border-primary-theme rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary-theme/20 outline-none transition-all">
                            <% for (const [key, val] of Object.entries(presets)) { %>
                                <option value="<%= key %>" <%=(settings.theme.home.preset===key) ? 'selected' : '' %>
                                    class="dark:bg-neutral-900">
                                    <%= val.label %>
                                </option>
                                <% } %>
                        </select>
                    </div>

                    <% const themeCats = registry.getEnabled(settings).map(p => ({ key: p.collectionType, label: t(p.label), icon: 'fa-' + p.icon })); %>

                        <% themeCats.forEach((tTheme)=> { %>
                            <div class="space-y-2">
                                <label class="block text-xs font-bold uppercase tracking-widest opacity-60">
                                    <i class="fa-solid <%= tTheme.icon %> mr-1"></i>
                                    <%= tTheme.label %>
                                </label>
                                <select name="<%= tTheme.key %>Preset"
                                    class="w-full bg-black/5 dark:bg-black/20 border border-transparent focus:border-primary-theme rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary-theme/20 outline-none transition-all">
                                    <% for (const [key, val] of Object.entries(presets)) { %>
                                        <option value="<%= key %>" <%=(settings.theme[tTheme.key] &&
                                            settings.theme[tTheme.key].preset===key) ? 'selected' : '' %>
                                            class="dark:bg-neutral-900">
                                            <%= val.label %>
                                        </option>
                                        <% } %>
                                </select>
                            </div>
                            <% }) %>

                </div>
            </div>

            <div data-tab-panel="layout" class="card-theme rounded-2xl md:rounded-3xl p-4 md:p-6 shadow-sm md:shadow-xl transition-colors md:mt-8">
                <h2 class="text-lg md:text-xl font-bold mb-2 flex items-center gap-3">
                    <div
                        class="w-8 h-8 md:w-10 md:h-10 shrink-0 rounded-full bg-primary-theme/10 text-primary-theme flex items-center justify-center text-sm md:text-base">
                        <i class="fa-solid fa-table-columns"></i>
                    </div>
                    <%= t('layout.title') %>
                </h2>
                <p class="text-sm opacity-60 mb-4 md:mb-6"><%= t('layout.desc') %></p>
                <%- include('partials/layout-settings') %>
            </div>

            <div data-tab-panel="cards" class="card-theme rounded-2xl md:rounded-3xl p-4 md:p-6 shadow-sm md:shadow-xl transition-colors md:mt-8">
                <h2 class="text-lg md:text-xl font-bold mb-2 flex items-center gap-3">
                    <div
                        class="w-8 h-8 md:w-10 md:h-10 shrink-0 rounded-full bg-primary-theme/10 text-primary-theme flex items-center justify-center text-sm md:text-base">
                        <i class="fa-solid fa-percent"></i>
                    </div>
                    <%= t('perso.card_aspect_ratio') %>
                </h2>
                <p class="text-sm opacity-60 mb-4"><%= t('perso.card_aspect_ratio_desc') %></p>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                    <%
                    // Values must stay in sync with CARD_ASPECT_RATIOS (core/customPlugin.ts),
                    // which is what the save route accepts.
                    const aspectRatioOptions = [
                        { value: 'aspect-[2/3]', label: t('create_plugin.shape_poster'), icon: 'fa-file' },
                        { value: 'aspect-square', label: t('create_plugin.shape_square'), icon: 'fa-square' },
                        { value: 'aspect-[16/9]', label: t('create_plugin.shape_screen'), icon: 'fa-desktop' }
                    ];
                    const currentAspect = settings.aspectRatioClass || 'aspect-square';
                    %>
                    <% aspectRatioOptions.forEach(opt=> { %>
                        <label class="cursor-pointer relative group">
                            <input type="radio" name="aspectRatioClass" value="<%= opt.value %>" class="peer sr-only"
                                <%= currentAspect === opt.value ? 'checked' : '' %>>
                            <div
                                class="flex items-center gap-3 p-3 rounded-xl border border-black/5 dark:border-white/5 bg-black/5 dark:bg-white/5 transition-all peer-checked:text-white opacity-60 peer-checked:opacity-100 peer-checked:shadow-md peer-checked:bg-primary-theme">
                                <i class="fa-solid <%= opt.icon %> text-base w-4 text-center"></i>
                                <span class="text-sm font-medium">
                                    <%= opt.label %>
                                </span>
                            </div>
                        </label>
                        <% }) %>
                </div>
            </div>

            <div data-tab-panel="navigation" class="card-theme rounded-2xl md:rounded-3xl p-4 md:p-6 shadow-sm md:shadow-xl transition-colors md:mt-8">
                <h2 class="text-lg md:text-xl font-bold mb-2 flex items-center gap-3">
                    <div
                        class="w-8 h-8 md:w-10 md:h-10 shrink-0 rounded-full bg-primary-theme/10 text-primary-theme flex items-center justify-center text-sm md:text-base">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <%= t('perso.nav_title') %>
                </h2>
                <p class="text-sm opacity-60 mb-4 md:mb-6">
                    <%= t('perso.nav_desc') %>
                </p>

                <div class="md:space-y-6">
                    <%
                    // Global group plus one group per plugin (navbarShortcuts declared by the plugin)
                    const shortcutGroups = [
                        { label: t('perso.modules.global'), active: true, options: [
                            { id: 'global_home', label: t('nav.home') },
                            { id: 'global_collection', label: t('nav.collection') },
                            { id: 'global_wishlist', label: t('nav.wishlist') },
                            { id: 'global_info', label: t('collection_info.title') },
                            { id: 'global_lists', label: t('lists.title') }
                        ] }
                    ];
                    registry.getAll().forEach(p => {
                        shortcutGroups.push({
                            label: t(p.label),
                            active: !!(settings.modules && settings.modules[p.collectionType]),
                            options: (p.navbarShortcuts || []).map(sc => ({ id: sc.id, label: t(sc.label) }))
                        });
                    });
                    %>

                        <div class="max-md:hidden flex gap-2 overflow-x-auto pb-2 scrollbar-hide flex-nowrap">
                            <% shortcutGroups.forEach((group, idx)=> { %>
                                <% if (group.active) { %>
                                    <button type="button" onclick="switchTab('shortcuts', <%= idx %>)"
                                        id="tab-shortcuts-<%= idx %>"
                                        class="tab-btn-shortcuts shrink-0 px-5 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all border-2 border-transparent text-black/50 dark:text-white/50 bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10">
                                        <%= group.label %>
                                    </button>
                                    <% } %>
                                        <% }) %>
                        </div>

                        <div class="md:mt-4 max-md:space-y-3">
                            <% shortcutGroups.forEach((group, idx)=> { %>
                                <% if (group.active) { %>
                                    <div id="content-shortcuts-<%= idx %>"
                                        class="tab-content-shortcuts hidden max-md:!block bg-black/5 dark:bg-white/5 rounded-2xl p-3 md:p-5">
                                        <p class="md:hidden mb-2 text-xs font-bold uppercase tracking-widest opacity-60"><%= group.label %></p>
                                        <div class="flex flex-wrap gap-2 md:gap-3">
                                            <% group.options.forEach(opt=> { %>
                                                <label class="shortcut-option cursor-pointer group relative">
                                                    <input type="checkbox" name="navbarShortcuts" value="<%= opt.id %>"
                                                        <%=(settings.navbarShortcuts &&
                                                        settings.navbarShortcuts.includes(opt.id)) ? 'checked' : '' %>
                                                    class="sr-only">
                                                    <div
                                                        class="flex items-center gap-2 px-3 py-2 md:px-4 md:py-2.5 rounded-xl border-2 border-transparent bg-black/5 dark:bg-white/5 text-black/50 dark:text-white/50 opacity-80 transition-all duration-300 font-bold group-hover:bg-black/10 dark:group-hover:bg-white/10 group-has-[:checked]:bg-primary-theme group-has-[:checked]:border-primary-theme group-has-[:checked]:text-white group-has-[:checked]:opacity-100 group-has-[:checked]:shadow-lg group-has-[:checked]:-translate-y-0.5">
                                                        <i
                                                            class="fa-solid fa-plus text-[10px] opacity-40 block group-has-[:checked]:hidden transition-transform"></i>
                                                        <i
                                                            class="fa-solid fa-check text-[10px] hidden group-has-[:checked]:block transition-transform"></i>
                                                        <span class="text-sm">
                                                            <%= opt.label %>
                                                        </span>
                                                    </div>
                                                </label>
                                                <% }) %>
                                        </div>
                                    </div>
                                    <% } %>
                                        <% }) %>
                        </div>
                </div>
            </div>


            <div data-tab-panel="quick-add" class="card-theme rounded-2xl md:rounded-3xl p-4 md:p-6 shadow-sm md:shadow-xl transition-colors md:mt-8">
                <h2 class="text-lg md:text-xl font-bold mb-2 flex items-center gap-3">
                    <div
                        class="w-8 h-8 md:w-10 md:h-10 shrink-0 rounded-full bg-primary-theme/10 text-primary-theme flex items-center justify-center text-sm md:text-base">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <%= t('perso.fastAdd_title') %>
                </h2>
                <p class="text-sm opacity-60 mb-4 md:mb-6">
                    <%= t('perso.fastAdd_desc') %>
                </p>

                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                    <%
                    const fastAddOptions = [
                        { value: '', label: t('perso.fastAdd_disabled'), icon: 'fa-xmark', color: 'peer-checked:bg-gray-500' }
                    ];
                    registry.getAll().forEach(p => {
                        if (settings.modules && settings.modules[p.collectionType]) {
                            (p.fastAddOptions || []).forEach(o => {
                                fastAddOptions.push({ value: o.value, label: t(o.label), icon: o.icon, color: o.color });
                            });
                        }
                    });
                    %>
                        <% fastAddOptions.forEach(opt=> { %>
                            <label class="cursor-pointer relative group">
                                <input type="radio" name="fastAdd" value="<%= opt.value %>" class="peer sr-only"
                                    <%=(settings.fastAdd===opt.value || (!settings.fastAdd && opt.value==='' ))
                                    ? 'checked' : '' %>>
                                <div
                                    class="flex items-center gap-3 p-3 rounded-xl border border-black/5 dark:border-white/5 bg-black/5 dark:bg-white/5 transition-all peer-checked:text-white opacity-60 peer-checked:opacity-100 peer-checked:shadow-md <%= opt.color %>">
                                    <i class="fa-solid <%= opt.icon %> text-base w-4 text-center"></i>
                                    <span class="text-sm font-medium">
                                        <%= opt.label %>
                                    </span>
                                </div>
                            </label>
                            <% }) %>
                </div>

                <%# Offered only where something can actually be scanned into one exact
                    item: with no such module active the toggle would promise a behaviour
                    no search on this instance can trigger. %>
                <% if (locals.scanModeAvailable) { %>
                    <label
                        class="flex items-start justify-between gap-4 p-4 mt-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 cursor-pointer">
                        <div class="flex items-start gap-3">
                            <div
                                class="w-10 h-10 rounded-xl flex items-center justify-center bg-white dark:bg-black/20 shadow-sm shrink-0">
                                <i class="fa-solid fa-barcode text-sm"></i>
                            </div>
                            <div>
                                <span class="text-sm font-bold opacity-80">
                                    <%= t('perso.instantAdd_title') %>
                                </span>
                                <p class="text-xs opacity-50 mt-0.5">
                                    <%= t('perso.instantAdd_desc') %>
                                </p>
                            </div>
                        </div>
                        <div class="relative inline-flex items-center shrink-0 mt-2">
                            <input type="checkbox" name="instantAdd" <%= settings.instantAdd === true ? 'checked' : ''
                                %> class="sr-only peer">
                            <div
                                class="w-11 h-6 bg-black/10 dark:bg-white/10 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500">
                            </div>
                        </div>
                    </label>
                <% } %>
            </div>

            <div data-tab-panel="widgets" class="card-theme rounded-2xl md:rounded-3xl p-4 md:p-6 shadow-sm md:shadow-xl transition-colors md:mt-8">
                <h2 class="text-lg md:text-xl font-bold mb-2 flex items-center gap-3">
                    <div
                        class="w-8 h-8 md:w-10 md:h-10 shrink-0 rounded-full bg-primary-theme/10 text-primary-theme flex items-center justify-center text-sm md:text-base">
                        <i class="fa-solid fa-chart-simple"></i>
                    </div>
                    <%= t('perso.widgets_title') %>
                </h2>
                <%# The home page is arranged in place now (views/partials/dashboard/editor). The
                    stats picked here before still seed the default home page, so they are
                    carried through untouched rather than wiped by the next save. %>
                <% (settings.statsWidgets || []).forEach(id => { %>
                    <input type="hidden" name="statsWidgets" value="<%= id %>">
                <% }) %>
                <p class="text-sm opacity-70 mb-4"><%= t('perso.widgets_moved') %></p>
                <a href="<%= baseUrl %>/dashboard#arrange"
                    class="inline-flex items-center gap-2 h-11 px-5 rounded-xl bg-primary-theme hover:brightness-110 text-sm font-bold shadow-lg shadow-primary-theme/20 transition active:scale-95">
                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><%= t('dashboard.arrange') %>
                </a>
            </div>


            <div data-tab-panel="packs" class="card-theme rounded-2xl md:rounded-3xl p-4 md:p-6 shadow-sm md:shadow-xl transition-colors md:mt-8">
                <h2 class="text-lg md:text-xl font-bold mb-2 flex items-center gap-3">
                    <div
                        class="w-8 h-8 md:w-10 md:h-10 shrink-0 rounded-full bg-primary-theme/10 text-primary-theme flex items-center justify-center text-sm md:text-base">
                        <i class="fa-solid fa-box-archive"></i>
                    </div>
                    <%= t('perso.pack_title') %>
                </h2>
                <p class="text-sm opacity-60 mb-4 md:mb-6"><%= t('perso.pack_desc') %></p>
                <%- include('partials/look-packs') %>
            </div>

            <div data-settings-panel-only class="flex justify-end pt-4">
                <button type="submit"
                    class="w-full md:w-auto px-10 py-4 bg-primary-theme text-white font-black rounded-2xl hover:brightness-110 active:scale-95 transition-all shadow-lg shadow-primary-theme/20 flex items-center justify-center gap-3">
                    <i class="fa-solid fa-save"></i>
                    <%= t('perso.save') %>
                </button>
            </div>
        </form>
    </div>

    <script>
        function switchTab(groupName, index) {
            const allContents = document.querySelectorAll('.tab-content-' + groupName);
            allContents.forEach(el => el.classList.add('hidden'));

            const allBtns = document.querySelectorAll('.tab-btn-' + groupName);
            allBtns.forEach(btn => {
                btn.classList.remove('bg-primary-theme', 'text-white', 'border-primary-theme', 'opacity-100', 'shadow-md');
                btn.classList.add('bg-black/5', 'dark:bg-white/5', 'text-black/50', 'dark:text-white/50');
            });

            const targetContent = document.getElementById('content-' + groupName + '-' + index);
            if (targetContent) targetContent.classList.remove('hidden');

            const targetBtn = document.getElementById('tab-' + groupName + '-' + index);
            if (targetBtn) {
                targetBtn.classList.remove('bg-black/5', 'dark:bg-white/5', 'text-black/50', 'dark:text-white/50');
                targetBtn.classList.add('bg-primary-theme', 'text-white', 'border-primary-theme', 'opacity-100', 'shadow-md');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const firstShortcutTab = document.querySelector('.tab-btn-shortcuts');
            if (firstShortcutTab) {
                const idx = firstShortcutTab.id.split('-').pop();
                switchTab('shortcuts', idx);
            }
        });

        const checkboxes = document.querySelectorAll('input[name="navbarShortcuts"]');
        const maxAllowed = 6;

        checkboxes.forEach(cb => {
            cb.addEventListener('change', () => {
                const checkedCount = document.querySelectorAll('input[name="navbarShortcuts"]:checked').length;
                if (checkedCount > maxAllowed) {
                    cb.checked = false;
                    alert(<%- JSON.stringify(t('perso.nav_max')) %>);
                }
            });
        });
    </script>

    <%- include('partials/footer') %>
