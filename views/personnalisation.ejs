<%- include('partials/header', { shellBack: false }) %>
<link rel="stylesheet" href="<%= baseUrl %>/vendor/fonts/plus-jakarta-sans.css">
<link rel="stylesheet" href="<%= baseUrl %>/vendor/fonts/poppins.css">

<%#
    The Personnalisation studio: everything about the collection's look in one place,
    the real app on the left as a live preview, the choices on the right in five tabs
    (partials/studio/tab-*): Style first, the rest to fine-tune.

    Changes are a draft (core/lookDraft.ts) until they are saved: the preview frame loads
    pages with ?studio=1, which shows the draft over the saved settings, so members see
    nothing change before "Save". What only restyles (density, corners, size, width,
    font) is applied in the frame at once; what changes the shell's markup (navigation,
    colours, cards, shortcuts) reloads it, keeping its scroll. The page counts what
    differs from the saved look, and marks the tabs holding those changes.

    The home page's widgets are arranged in the preview itself, with the page's own
    editor (partials/dashboard/editor), which saves as it goes.
%>
<%
    // The saved look, field by field as the form posts it, to tell what the draft changes.
    const savedLayout = resolveLayout(savedSettings);
    const savedTheme = savedSettings.theme || {};
    const savedValues = {
        layout_nav: savedLayout.nav,
        layout_topStyle: savedLayout.topStyle === 'floating' ? 'floating' : '',
        layout_sticky: savedLayout.sticky ? 'on' : '',
        layout_sidebar: savedLayout.sidebar,
        layout_dockLabels: savedLayout.dockLabels ? 'on' : '',
        layout_density: savedLayout.density,
        layout_radius: savedLayout.radius,
        layout_scale: savedLayout.scale,
        layout_width: savedLayout.width,
        layout_font: savedLayout.font,
        homePreset: (savedTheme.home && savedTheme.home.preset) || 'default',
        aspectRatioClass: savedSettings.aspectRatioClass || 'aspect-square',
        navbarShortcuts: (savedSettings.navbarShortcuts || []).map(String),
        fastAdd: savedSettings.fastAdd || '',
        instantAdd: savedSettings.instantAdd === true ? 'on' : ''
    };
    registry.getEnabled(savedSettings).forEach(p => {
        savedValues[p.collectionType + 'Preset'] = (savedTheme[p.collectionType] && savedTheme[p.collectionType].preset) || 'default';
    });
    const studioTabs = [
        { id: 'style', icon: 'palette', label: t('studio.tab_style') },
        { id: 'nav', icon: 'table-columns', label: t('studio.tab_nav') },
        { id: 'details', icon: 'sliders', label: t('studio.tab_details') },
        { id: 'home', icon: 'table-cells-large', label: t('studio.tab_home') },
        { id: 'more', icon: 'ellipsis', label: t('studio.tab_more') }
    ];
    const toolButton = 'h-9 min-w-[2.25rem] px-2 flex items-center justify-center gap-1.5 rounded-lg text-sm hover:bg-black/5 dark:hover:bg-white/10 transition-colors';
%>

<style>
    .dv-stop { display: block; width: 10px; height: 10px; border-radius: 9999px; background: rgb(127 127 127 / 0.45); transition: all 0.15s ease; }
    .dv-stop-passed { background: var(--highlight); }
    input:checked + .dv-stop { width: 20px; height: 20px; background: var(--highlight); box-shadow: 0 0 0 4px rgb(var(--highlight-rgb) / 0.25); cursor: grab; }
    [data-stepper-track].is-dragging, [data-stepper-track].is-dragging * { cursor: grabbing; }
    [data-stepper-track].is-dragging input:checked + .dv-stop { transform: scale(1.15); }
    input:focus-visible + .dv-stop { outline: 2px solid var(--highlight); outline-offset: 3px; }
    [data-studio-pane]:not(.is-active) { display: none; }
    /* A dropdown's list is drawn by the browser, white unless told otherwise, while its
       options inherit the theme's text colour: in a dark theme, white on white. */
    html.dark #studio { color-scheme: dark; }
    #studio select option, #studio select optgroup { background-color: var(--bg-card); color: var(--text-main); }
    /* The tick on the picked thumbnail: a preset button (aria-pressed) or a radio card. */
    .dv-picked { display: none; }
    [aria-pressed="true"] > .dv-picked, label:has(input:checked) > .dv-picked { display: flex; }
    @media (prefers-reduced-motion: reduce) { .dv-stop { transition: none; } }
</style>

<div id="studio" class="fixed inset-0 z-[55] flex flex-col bg-[var(--bg-page)] text-[var(--text-main)]">
    <header class="flex-none flex items-center gap-2 md:gap-3 px-2 md:px-4 h-[60px] border-b border-[var(--border-color)]" style="background-color: var(--bg-nav); padding-top: env(safe-area-inset-top);">
        <a href="<%= baseUrl %>/dashboard" aria-label="<%= t('nav.back') %>" title="<%= t('nav.back') %>" class="<%= toolButton %> !w-10 !h-10">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </a>
        <div class="min-w-0 flex flex-col">
            <h1 class="font-extrabold text-base leading-tight truncate"><%= t('perso.title') %></h1>
            <span data-studio-state-small class="md:hidden text-[11px] truncate opacity-70"></span>
            <span class="max-md:hidden text-xs opacity-60 truncate"><%= t('studio.subtitle', { name: (locals.activeCollection && activeCollection.name) || settings.siteName }) %></span>
        </div>
        <span class="flex-1"></span>
        <span data-studio-state role="status" aria-live="polite" class="max-md:hidden flex items-center gap-2 h-8 px-3 rounded-full text-xs font-bold bg-black/5 dark:bg-white/10">
            <span data-studio-state-dot class="w-[7px] h-[7px] rounded-full bg-current opacity-50"></span>
            <span data-studio-state-text><%= t('studio.up_to_date') %></span>
        </span>
        <button type="button" data-studio-discard disabled
            class="h-10 px-3 md:px-3.5 rounded-xl text-sm font-bold bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition disabled:opacity-40 disabled:pointer-events-none">
            <i class="fa-solid fa-rotate-left md:hidden" aria-hidden="true"></i><span class="max-md:sr-only"><%= t('studio.discard') %></span>
        </button>
        <button type="submit" form="studioForm"
            class="h-10 px-4 md:px-5 rounded-xl text-sm font-extrabold bg-primary-theme hover:brightness-110 shadow-lg shadow-primary-theme/20 transition active:scale-95 flex items-center gap-2">
            <i class="fa-solid fa-check" aria-hidden="true"></i><%= t('studio.publish') %>
        </button>
    </header>

    <div class="flex-1 min-h-0 flex max-lg:flex-col">
        <%# The preview: the real app in a frame, the page, device and mode it is shown in
            in a small bar floating under it. %>
        <section data-studio-preview aria-label="<%= t('studio.preview') %>"
            class="min-w-0 flex flex-col items-center gap-3 px-3 pt-3 pb-3 lg:flex-1 lg:px-6 lg:pt-5 lg:pb-4 max-lg:h-[46vh] max-lg:flex-none bg-black/[0.04] dark:bg-black/30">
            <div data-studio-stage class="flex-1 min-h-0 w-full flex justify-center">
                <iframe data-studio-frame title="<%= t('studio.preview') %>"
                    class="h-full w-full flex-none rounded-2xl border border-[var(--border-color)] shadow-2xl bg-[var(--bg-page)] transition-[width] duration-300"></iframe>
            </div>
            <div class="flex-none flex items-center gap-1 p-1.5 rounded-2xl card-theme shadow-xl max-w-full">
                <label class="flex items-center gap-2 pl-2 text-sm opacity-90">
                    <span class="max-sm:hidden opacity-70"><%= t('studio.page') %></span>
                    <select data-studio-page aria-label="<%= t('studio.page') %>" class="h-9 max-w-[10rem] rounded-lg border-0 bg-black/5 dark:bg-white/10 px-2 text-sm focus:ring-2 focus:ring-primary-theme/40">
                        <% [
                            ['/dashboard', t('nav.home')],
                            ['/collection', t('nav.collection')],
                            ['/wishlist', t('nav.wishlist')],
                            ['/lists', t('lists.title')],
                            ['/search', t('nav.search')],
                            ['/account', t('nav.account')]
                        ].forEach(([path, label]) => { %>
                            <option value="<%= path %>"><%= label %></option>
                        <% }) %>
                    </select>
                </label>
                <span class="max-lg:hidden w-px h-6 mx-1 bg-[var(--border-color)]" aria-hidden="true"></span>
                <div class="max-lg:hidden flex items-center gap-0.5" role="group" aria-label="<%= t('studio.device') %>">
                    <% [['desktop', 'fa-desktop'], ['tablet', 'fa-tablet-screen-button'], ['phone', 'fa-mobile-screen']].forEach(([id, icon]) => { %>
                        <button type="button" data-studio-device="<%= id %>" aria-pressed="<%= id === 'desktop' %>" title="<%= t('studio.device_' + id) %>" aria-label="<%= t('studio.device_' + id) %>"
                            class="w-9 h-9 rounded-lg flex items-center justify-center opacity-60 hover:opacity-100 aria-pressed:opacity-100 aria-pressed:bg-primary-theme/15 aria-pressed:text-primary-theme transition">
                            <i class="fa-solid <%= icon %> text-sm" aria-hidden="true"></i>
                        </button>
                    <% }) %>
                </div>
                <span class="w-px h-6 mx-1 bg-[var(--border-color)]" aria-hidden="true"></span>
                <button type="button" data-studio-dark title="<%= t('studio.toggle_dark') %>" class="<%= toolButton %> px-2.5">
                    <i class="fa-solid fa-circle-half-stroke" aria-hidden="true"></i><span data-studio-dark-label class="max-sm:hidden"></span>
                </button>
                <button type="button" data-studio-reload title="<%= t('studio.reload') %>" aria-label="<%= t('studio.reload') %>" class="<%= toolButton %>">
                    <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                </button>
            </div>
        </section>

        <aside data-studio-panel aria-label="<%= t('perso.title') %>"
            class="flex-none flex lg:w-[420px] lg:border-l border-[var(--border-color)] max-lg:flex-col max-lg:flex-1 max-lg:min-h-0 max-lg:rounded-t-3xl max-lg:-mt-3 max-lg:relative max-lg:shadow-[0_-12px_30px_rgba(0,0,0,0.35)]"
            style="background-color: var(--bg-card);">
            <nav aria-label="<%= t('studio.sections') %>" role="tablist"
                class="flex-none flex gap-1 p-2 overflow-x-auto [scrollbar-width:none] lg:w-[76px] lg:flex-col lg:py-3.5 lg:overflow-visible border-[var(--border-color)] max-lg:border-b lg:border-r"
                style="background-color: rgb(0 0 0 / 0.08);">
                <% studioTabs.forEach((tab, i) => { %>
                    <button type="button" role="tab" data-studio-tab="<%= tab.id %>" aria-selected="<%= i === 0 %>" aria-controls="studio-pane-<%= tab.id %>"
                        class="relative flex-none flex items-center gap-2 lg:flex-col lg:gap-1.5 px-3.5 h-10 lg:h-auto lg:px-1 lg:py-2.5 rounded-full lg:rounded-xl text-sm lg:text-[11px] font-bold opacity-70 hover:opacity-100 aria-selected:opacity-100 aria-selected:bg-primary-theme/15 aria-selected:text-primary-theme transition">
                        <span class="relative flex">
                            <i class="fa-solid fa-<%= tab.icon %> lg:text-lg" aria-hidden="true"></i>
                            <span data-tab-dot class="hidden absolute -top-1 -right-1.5 w-2 h-2 rounded-full bg-primary-theme ring-2 ring-[var(--bg-card)]"></span>
                        </span>
                        <span class="whitespace-nowrap"><%= tab.label %></span>
                    </button>
                <% }) %>
            </nav>

            <form id="studioForm" action="<%= baseUrl %>/admin/personnalisation/save" method="POST" class="flex-1 min-w-0 min-h-0 overflow-y-auto overscroll-contain">
                <% studioTabs.forEach((tab, i) => { %>
                    <div id="studio-pane-<%= tab.id %>" data-studio-pane="<%= tab.id %>" role="tabpanel" class="<%= i === 0 ? 'is-active' : '' %> px-5 pt-5 pb-8 flex flex-col gap-6">
                        <%- include('partials/studio/tab-' + tab.id) %>
                    </div>
                <% }) %>
            </form>
        </aside>
    </div>
</div>

<script>
(() => {
    const base = '<%= baseUrl %>';
    const studio = document.getElementById('studio');
    const form = document.getElementById('studioForm');
    const frame = studio.querySelector('[data-studio-frame]');
    const pageSelect = studio.querySelector('[data-studio-page]');
    const layoutOptions = <%- JSON.stringify({
        densityFactor: LAYOUT_OPTIONS.densityFactor,
        radiusFactor: LAYOUT_OPTIONS.radiusFactor,
        scalePercent: LAYOUT_OPTIONS.scalePercent,
        contentMax: LAYOUT_OPTIONS.contentMax,
        fontStacks: LAYOUT_OPTIONS.fontStacks
    }) %>;
    const fontSheets = { jakarta: 'plus-jakarta-sans.css', poppins: 'poppins.css' };
    const savedValues = <%- JSON.stringify(savedValues).replace(/</g, '\\u003c') %>;
    const widgetTypes = <%- JSON.stringify(widgetTypes).replace(/</g, '\\u003c') %>;
    const sizeShort = <%- JSON.stringify({ s: t('dashboard.size_s_short'), m: t('dashboard.size_m_short'), l: t('dashboard.size_l_short'), full: t('dashboard.size_full_short') }) %>;
    const i18n = <%- JSON.stringify({
        upToDate: t('studio.up_to_date'),
        saved: t('studio.published'),
        changesOne: t('studio.changes_one', { count: '{{count}}' }),
        changesOther: t('studio.changes_other', { count: '{{count}}' }),
        discardConfirm: t('studio.discard_confirm'),
        maxShortcuts: t('perso.nav_max'),
        presetCurrent: t('studio.preset_current', { name: '{{name}}' }),
        presetCustom: t('studio.preset_custom'),
        dark: t('studio.mode_dark'),
        light: t('studio.mode_light')
    }).replace(/</g, '\\u003c') %>;
    const deviceWidths = { desktop: '100%', tablet: '834px', phone: '390px' };
    const TAB_OF = (name) => {
        if (/^layout_(nav|topStyle|sticky|sidebar|dockLabels)$/.test(name) || name === 'navbarShortcuts') return 'nav';
        if (/^layout_/.test(name) || name === 'aspectRatioClass') return 'details';
        if (/Preset$/.test(name)) return 'style';
        return 'more';
    };

    document.body.style.overflow = 'hidden';
    const value = (name) => form.querySelector(`[name="${name}"]:checked`)?.value;

    // ---- Tabs ---------------------------------------------------------------------
    const tabs = [...studio.querySelectorAll('[data-studio-tab]')];
    function showTab(id) {
        tabs.forEach(tab => tab.setAttribute('aria-selected', String(tab.dataset.studioTab === id)));
        form.querySelectorAll('[data-studio-pane]').forEach(pane => pane.classList.toggle('is-active', pane.dataset.studioPane === id));
        form.scrollTop = 0;
        try { sessionStorage.setItem('studioTab', id); } catch (e) { /* private mode */ }
    }
    tabs.forEach(tab => tab.addEventListener('click', () => showTab(tab.dataset.studioTab)));

    // ---- The frame ----------------------------------------------------------------
    const inStudio = (path) => {
        const url = new URL(base + path, window.location.origin);
        url.searchParams.set('studio', '1');
        return url;
    };
    let keepScroll = null;
    let darkOverride = null;

    function frameWindow() {
        try { return frame.contentWindow && frame.contentWindow.document ? frame.contentWindow : null; } catch (e) { return null; }
    }
    function reloadFrame() {
        const win = frameWindow();
        keepScroll = win ? win.scrollY : null;
        if (win) win.location.reload();
    }

    // What only restyles is applied in the frame straight away, through the variables
    // the shell itself reads.
    function applyLook() {
        const win = frameWindow();
        if (!win) return;
        const doc = win.document;
        const style = doc.documentElement.style;
        const density = value('layout_density'), radius = value('layout_radius'), scale = value('layout_scale');
        const width = value('layout_width'), font = value('layout_font');
        if (density) style.setProperty('--dv-space', String(layoutOptions.densityFactor[density]));
        if (radius) style.setProperty('--dv-radius', String(layoutOptions.radiusFactor[radius]));
        if (width) style.setProperty('--dv-content-max', layoutOptions.contentMax[width]);
        if (scale) style.fontSize = layoutOptions.scalePercent[scale];
        if (font) {
            style.setProperty('--dv-font', layoutOptions.fontStacks[font]);
            const sheet = fontSheets[font];
            if (sheet && !doc.querySelector(`link[data-studio-font="${font}"]`)) {
                const link = doc.createElement('link');
                Object.assign(link, { rel: 'stylesheet', href: base + '/vendor/fonts/' + sheet });
                link.dataset.studioFont = font;
                doc.head.appendChild(link);
            }
        }
    }

    function isDarkFrame() {
        const win = frameWindow();
        return win ? win.document.documentElement.classList.contains('dark') : document.documentElement.classList.contains('dark');
    }
    function syncDarkLabel() {
        studio.querySelector('[data-studio-dark-label]').textContent = isDarkFrame() ? i18n.dark : i18n.light;
    }
    function applyDark() {
        const win = frameWindow();
        if (win && darkOverride !== null) win.document.documentElement.classList.toggle('dark', darkOverride);
        syncDarkLabel();
    }

    // The home tab lists the widgets as the preview shows them.
    function syncHomeList() {
        const win = frameWindow();
        if (!win) return;
        const frames = [...win.document.querySelectorAll('[data-dashboard-grid] > [data-widget]')];
        if (frames.length === 0) return;
        const list = form.querySelector('[data-home-widgets]');
        const template = list.firstElementChild;
        if (!template) return;
        list.replaceChildren(...frames.map((el, i) => {
            const type = widgetTypes[el.dataset.widgetType] || { label: el.dataset.widgetType, icon: 'fa-puzzle-piece' };
            const row = template.cloneNode(true);
            const [number, icon, label, size] = row.children;
            number.textContent = String(i + 1);
            icon.className = 'fa-solid ' + type.icon + ' w-4 text-center opacity-60';
            label.textContent = type.label;
            size.textContent = sizeShort[el.dataset.widgetSize] || '';
            return row;
        }));
    }

    frame.addEventListener('load', () => {
        const win = frameWindow();
        if (!win) return;
        const url = new URL(win.location.href);
        // A page reached by a script rather than a link lost the preview flag.
        if (url.searchParams.get('studio') !== '1') {
            url.searchParams.set('studio', '1');
            win.location.replace(url.toString());
            return;
        }
        const path = url.pathname.slice(base.length) || '/';
        if ([...pageSelect.options].some(o => o.value === path)) pageSelect.value = path;
        else {
            let custom = pageSelect.querySelector('[data-custom]');
            if (!custom) {
                custom = document.createElement('option');
                custom.dataset.custom = '1';
                pageSelect.appendChild(custom);
            }
            custom.value = path;
            custom.textContent = path;
            pageSelect.value = path;
        }
        applyLook();
        applyDark();
        syncHomeList();
        if (keepScroll !== null) { win.scrollTo(0, keepScroll); keepScroll = null; }
        // Arranging the home page saves widget by widget: the list follows.
        win.addEventListener('click', () => setTimeout(syncHomeList, 600));
    });

    pageSelect.addEventListener('change', () => { frame.src = inStudio(pageSelect.value).toString(); });
    studio.querySelector('[data-studio-reload]').addEventListener('click', reloadFrame);
    studio.querySelectorAll('[data-studio-device]').forEach(button => button.addEventListener('click', () => {
        studio.querySelectorAll('[data-studio-device]').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
        const device = button.dataset.studioDevice;
        frame.style.width = deviceWidths[device];
        // A phone gets a bezel, so it reads as one.
        frame.classList.toggle('!rounded-[2.5rem]', device === 'phone');
        frame.classList.toggle('!border-[10px]', device === 'phone');
        frame.classList.toggle('!border-black', device === 'phone');
    }));
    studio.querySelector('[data-studio-dark]').addEventListener('click', () => {
        darkOverride = !isDarkFrame();
        applyDark();
    });

    // ---- What changed since the saved look ------------------------------------------
    const stateEl = studio.querySelector('[data-studio-state]');
    const stateText = studio.querySelector('[data-studio-state-text]');
    const stateSmall = studio.querySelector('[data-studio-state-small]');
    const discardButtons = [...studio.querySelectorAll('[data-studio-discard]')];
    let justSaved = false;

    function currentValues() {
        const data = new FormData(form);
        const values = {};
        Object.keys(savedValues).forEach(name => {
            if (name === 'navbarShortcuts') values[name] = data.getAll(name).map(String);
            else values[name] = data.has(name) ? String(data.get(name)) : '';
        });
        return values;
    }
    function changedFields() {
        const now = currentValues();
        const offered = new Set([...form.querySelectorAll('[name="navbarShortcuts"]')].map(input => input.value));
        return Object.keys(savedValues).filter(name => {
            if (name === 'navbarShortcuts') {
                const saved = savedValues[name].filter(id => offered.has(id)).sort().join();
                return saved !== now[name].slice().sort().join();
            }
            // A field the form does not show (a module switched off) is not a change.
            if (!form.querySelector(`[name="${name}"]`)) return false;
            return now[name] !== savedValues[name];
        });
    }
    function markChanges() {
        const changed = changedFields();
        const count = changed.length;
        const text = count === 0
            ? (justSaved ? i18n.saved : i18n.upToDate)
            : (count === 1 ? i18n.changesOne : i18n.changesOther).replace('{{count}}', count);
        stateText.textContent = text;
        stateSmall.textContent = text;
        stateEl.classList.toggle('text-primary-theme', count > 0);
        stateEl.classList.toggle('bg-primary-theme/15', count > 0);
        stateEl.classList.toggle('bg-black/5', count === 0);
        discardButtons.forEach(button => { button.disabled = count === 0; });
        const dirtyTabs = new Set(changed.map(TAB_OF));
        tabs.forEach(tab => tab.querySelector('[data-tab-dot]').classList.toggle('hidden', !dirtyTabs.has(tab.dataset.studioTab)));
    }

    // ---- The draft ------------------------------------------------------------------
    let draftTimer = null;
    let reloadAfterDraft = false;
    function pushDraft(reload) {
        reloadAfterDraft = reloadAfterDraft || reload;
        clearTimeout(draftTimer);
        draftTimer = setTimeout(async () => {
            const reloadNow = reloadAfterDraft;
            reloadAfterDraft = false;
            try {
                await fetch(base + '/admin/personnalisation/draft', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(new FormData(form))
                });
                if (reloadNow) reloadFrame();
            } catch (e) { /* the next change sends the whole form again */ }
        }, reload ? 120 : 400);
    }

    // ---- The controls -----------------------------------------------------------------
    // Only the options of the navigation picked are shown.
    function syncNavOptions() {
        const nav = value('layout_nav');
        form.querySelectorAll('[data-layout-for]').forEach(el => {
            el.classList.toggle('hidden', !el.dataset.layoutFor.split(' ').includes(nav));
        });
    }

    // Stepped sliders: the fill reaches the chosen stop, the stops before it are lit.
    function syncSteppers() {
        form.querySelectorAll('[data-stepper]').forEach(stepper => {
            const inputs = [...stepper.querySelectorAll('input')];
            const index = Math.max(0, inputs.findIndex(input => input.checked));
            inputs.forEach((input, i) => input.nextElementSibling.classList.toggle('dv-stop-passed', i < index));
            stepper.querySelector('[data-stepper-fill]').style.width = `calc((100% - 1.5rem) * ${inputs.length > 1 ? index / (inputs.length - 1) : 0})`;
            stepper.querySelector('[data-stepper-value]').textContent = inputs[index].dataset.label;
        });
    }

    // ...and they slide: pressing anywhere on the track, then dragging, picks the stop
    // nearest the pointer as it moves (the stops sit on the track, 0.75rem in from each
    // side, see partials/studio/stepper).
    form.querySelectorAll('[data-stepper-track]').forEach(track => {
        const inputs = [...track.querySelectorAll('input')];
        const inset = parseFloat(getComputedStyle(document.documentElement).fontSize) * 0.75;
        const pickAt = (clientX) => {
            const box = track.getBoundingClientRect();
            const ratio = Math.min(1, Math.max(0, (clientX - box.left - inset) / (box.width - 2 * inset)));
            const input = inputs[Math.round(ratio * (inputs.length - 1))];
            if (input.checked) return;
            input.checked = true;
            input.dispatchEvent(new Event('change', { bubbles: true }));
        };
        track.addEventListener('pointerdown', (event) => {
            if (event.button > 0) return;
            event.preventDefault();
            track.classList.add('is-dragging');
            pickAt(event.clientX);
            track.querySelector('input:checked')?.focus({ preventScroll: true });
            const move = (ev) => pickAt(ev.clientX);
            const end = () => {
                track.classList.remove('is-dragging');
                window.removeEventListener('pointermove', move);
                window.removeEventListener('pointerup', end);
                window.removeEventListener('pointercancel', end);
            };
            window.addEventListener('pointermove', move);
            window.addEventListener('pointerup', end);
            window.addEventListener('pointercancel', end);
        });
        // The press is handled above; the label's own click would pick its stop a second time.
        track.addEventListener('click', (event) => event.preventDefault());
    });

    // The ready-made layout every layout choice matches, if any.
    const presetButtons = [...form.querySelectorAll('[data-studio-preset]')];
    function markPreset() {
        let current = null;
        presetButtons.forEach(button => {
            const matches = Object.entries(JSON.parse(button.dataset.studioPreset)).every(([key, val]) => {
                if (key === 'topStyle') return (value('layout_topStyle') || 'bar') === val;
                const input = form.querySelector(`[name="layout_${key}"]`);
                if (input && input.type === 'checkbox') return input.checked === (val === true);
                return value('layout_' + key) === String(val);
            });
            button.setAttribute('aria-pressed', String(matches));
            if (matches) current = button.dataset.presetName;
        });
        const hint = form.querySelector('[data-preset-hint]');
        hint.textContent = current ? i18n.presetCurrent.replace('{{name}}', current) : i18n.presetCustom;
        hint.classList.toggle('text-primary-theme', !current);
        hint.classList.toggle('opacity-80', Boolean(current));
    }
    function setLayout(values) {
        Object.entries(values).forEach(([key, val]) => {
            form.querySelectorAll(`[name="layout_${key}"]`).forEach(input => {
                if (key === 'topStyle') input.checked = val === 'floating';
                else if (input.type === 'checkbox') input.checked = val === true;
                else input.checked = input.value === String(val);
            });
        });
    }
    presetButtons.forEach(button => button.addEventListener('click', () => {
        setLayout(JSON.parse(button.dataset.studioPreset));
        syncAll();
        applyLook();
        pushDraft(true);
    }));

    // The colours picked paint the thumbnails, and their name shows above them.
    function syncColors() {
        const picked = form.querySelector('[name="homePreset"]:checked');
        if (!picked) return;
        const panel = studio.querySelector('[data-studio-panel]');
        panel.style.setProperty('--thumb-bg', picked.dataset.bg);
        panel.style.setProperty('--thumb-card', picked.dataset.card);
        panel.style.setProperty('--thumb-nav', picked.dataset.nav);
        panel.style.setProperty('--thumb-accent', picked.dataset.accent);
        form.querySelector('[data-theme-name]').textContent = picked.dataset.label;
    }

    function syncShortcuts() {
        form.querySelector('[data-shortcut-count]').textContent = form.querySelectorAll('[name="navbarShortcuts"]:checked').length;
    }

    function syncAll() {
        syncNavOptions();
        syncSteppers();
        markPreset();
        syncColors();
        syncShortcuts();
        markChanges();
    }

    const RESTYLE_ONLY = /^layout_(density|radius|scale|width|font)$/;
    form.addEventListener('change', (event) => {
        const name = event.target.name;
        if (!name) return; // the packs section's own fields
        if (name === 'navbarShortcuts' && event.target.checked
            && form.querySelectorAll('[name="navbarShortcuts"]:checked').length > 6) {
            event.target.checked = false;
            return alert(i18n.maxShortcuts);
        }
        justSaved = false;
        syncAll();
        if (RESTYLE_ONLY.test(name)) {
            applyLook();
            pushDraft(false);
        } else {
            pushDraft(true);
        }
    });

    discardButtons.forEach(button => button.addEventListener('click', async () => {
        if (!confirm(i18n.discardConfirm)) return;
        await fetch(base + '/admin/personnalisation/draft/discard', { method: 'POST' });
        window.location.href = window.location.pathname;
    }));

    // ---- The home page ------------------------------------------------------------------
    form.querySelector('[data-studio-arrange]').addEventListener('click', () => {
        const url = inStudio('/dashboard');
        url.hash = 'arrange';
        frame.src = url.toString();
    });

    // ---- Start --------------------------------------------------------------------------
    const params = new URLSearchParams(window.location.search);
    if (params.get('msg') === 'saved') {
        justSaved = true;
        history.replaceState(null, '', window.location.pathname);
    }
    let startTab = <%- JSON.stringify(startArrange ? 'home' : null) %>;
    if (!startTab) { try { startTab = sessionStorage.getItem('studioTab'); } catch (e) { /* private mode */ } }
    if (startTab && tabs.some(tab => tab.dataset.studioTab === startTab)) showTab(startTab);
    syncAll();
    syncDarkLabel();
    const start = inStudio(<%- JSON.stringify(startPage).replace(/</g, '\\u003c') %>);
    if (<%- JSON.stringify(Boolean(startArrange)) %>) start.hash = 'arrange';
    frame.src = start.toString();
})();
</script>

<%- include('partials/footer') %>
