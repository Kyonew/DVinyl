<%- include('partials/header') %>

    <%
        // Importer-sync actions (e.g. Discogs wantlist sync) declared by any plugin, rendered generically.
        const wishlistActions = locals.canEditCollection
            ? registry.getAll().flatMap(p => {
                const bucket = (user.pluginData && user.pluginData[p.id]) || {};
                return (p.collectionActions || [])
                    .filter(a => a.behavior === 'importer-sync' && (!a.requiresUserData || bucket[a.requiresUserData]));
              })
            : [];

        // The wishlist mixes every type, so there is no current module to add to: the add
        // hub asks. It also carries the fast-add shortcut, so the entry points here behave
        // exactly like the dashboard one.
        const canAdd = locals.canEditCollection && registry.getEnabled(settings).length > 0;
        const scanPlugins = registry.getEnabled(settings).filter(p => hasBarcodeScan(p));
        const canScan = locals.canEditCollection && scanPlugins.length > 0;
        const scanHref = scanPlugins.length === 1 ? (baseUrl + '/add-' + scanPlugins[0].id + '?scan=1') : null;

        // Phone header, as on the collection page: the title and its counters alone. Add
        // and scan are the tab bar's "+", and the plugin's sync actions go in a menu.
        const phoneBadge = 'max-md:p-0 max-md:bg-transparent max-md:dark:bg-transparent max-md:rounded-none';
    %>

    <div class="max-w-screen-xl mx-auto pb-12">

        <div class="flex items-start md:items-center justify-between gap-3 mb-5 md:mb-8 pt-2 sm:pt-6">

            <h1 class="text-[2rem] leading-tight md:text-3xl font-extrabold md:font-bold tracking-tight md:tracking-normal flex flex-col md:flex-row md:items-center gap-1 md:gap-3 transition-colors min-w-0 md:mr-4">
                <span class="flex items-center gap-2 md:gap-3 md:text-primary-theme min-w-0">
                    <i class="max-md:hidden fa-solid fa-gift flex-shrink-0"></i>
                    <span class="truncate">
                        <%= t('wishlist.title') %>
                    </span>
                </span>
                <span class="flex flex-wrap items-center gap-2 md:mt-1.5 w-fit tracking-normal">
                    <span id="totalItemsBadge"
                        class="px-3 py-1 bg-black/5 dark:bg-white/10 rounded-full text-sm font-medium opacity-70 <%= phoneBadge %>">
                        <%= totalItems %>
                            <%= t('common.items') %>
                    </span>
                    <%# Distinct works behind the item count, shown here too so the wishlist
                        matches the collection page. Hidden when it equals the item count.
                        The label pluralizes on the count (unique_titles_one for 1). %>
                    <span id="uniqueTitlesBadge"
                        class="px-3 py-1 bg-black/5 dark:bg-white/10 rounded-full text-sm font-medium opacity-70 <%= phoneBadge %> max-md:before:content-['·'] max-md:before:mr-2 <%= (uniqueTitles === totalItems) ? 'hidden' : '' %>"
                        title="<%= t('collection.unique_titles_hint') %>">
                        <%= t('collection.unique_titles', { count: uniqueTitles }) %>
                    </span>
                </span>
            </h1>

            <div class="flex gap-2">

                <% if (wishlistActions.length) { %>
                    <button type="button" onclick="toggleWishlistMenu(true)" aria-haspopup="dialog" aria-label="<%= t('detail.more_actions') %>"
                        class="md:hidden flex-none mt-1 w-11 h-11 rounded-full card-theme flex items-center justify-center">
                        <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                    </button>
                <% } %>
                <% if (canAdd) { %>
                    <button type="button" onclick="openAddModal()"
                        class="max-md:hidden flex-shrink-0 w-10 h-10 md:w-auto md:px-4 card-theme hover:text-primary-theme hover:border-primary-theme rounded-lg transition-all shadow-sm flex items-center justify-center gap-2 group"
                        title="<%= t('collection.add') %>">
                        <i class="fa-solid fa-plus group-hover:scale-110 transition-transform"></i>
                        <span class="hidden md:inline text-xs font-bold uppercase tracking-widest">
                            <%= t('collection.add') %>
                        </span>
                    </button>
                    <% } %>
                    <% if (canScan) { %>
                    <a href="<%= scanHref || '#' %>" <%- scanHref ? '' : 'onclick="openScanPicker(); return false;"' %>
                        class="max-md:hidden flex-shrink-0 w-10 h-10 md:w-auto md:px-4 card-theme hover:text-primary-theme hover:border-primary-theme rounded-lg transition-all shadow-sm flex items-center justify-center gap-2 group"
                        title="<%= t('collection.scan') %>">
                        <i class="fa-solid fa-barcode group-hover:scale-110 transition-transform"></i>
                        <span class="hidden md:inline text-xs font-bold uppercase tracking-widest">
                            <%= t('collection.scan') %>
                        </span>
                    </a>
                    <% } %>

                        <% wishlistActions.forEach(action => { %>
                            <button type="button" data-action-id="<%= action.id %>"
                                onclick="runImporterSync('<%= action.importerId %>', '<%= action.id %>')"
                                class="max-md:hidden flex-shrink-0 w-10 h-10 md:w-auto md:h-auto md:p-2.5 card-theme hover:text-primary-theme hover:border-primary-theme rounded-lg transition-all shadow-sm flex items-center justify-center active:scale-95 group"
                                title="<%= t(action.tooltip || action.label) %>">
                                <i class="fa-solid <%= action.icon %> group-hover:rotate-180 transition-transform duration-500"></i>
                            </button>
                            <% }) %>

            </div>

        </div>

        <% if (wishlistActions.length) { %>
        <%# Phone: the sync actions the desktop header shows as buttons, same handlers. %>
        <div id="wishlistMenu" class="md:hidden fixed inset-0 z-[60] hidden">
            <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="toggleWishlistMenu(false)"></div>
            <div role="dialog" aria-modal="true" aria-label="<%= t('detail.more_actions') %>"
                class="absolute inset-x-0 bottom-0 card-theme rounded-t-[2rem] px-4 pt-3 shadow-2xl"
                style="padding-bottom: calc(1rem + env(safe-area-inset-bottom));">
                <div class="w-12 h-1.5 bg-black/10 dark:bg-white/10 rounded-full mx-auto mb-4" aria-hidden="true"></div>
                <div class="rounded-2xl bg-black/5 dark:bg-white/5 divide-y divide-black/5 dark:divide-white/10 overflow-hidden">
                    <% wishlistActions.forEach(action => { %>
                        <button type="button" onclick="toggleWishlistMenu(false); runImporterSync('<%= action.importerId %>', '<%= action.id %>')"
                            class="flex items-center gap-4 w-full text-left px-4 min-h-[52px] font-semibold">
                            <i class="fa-solid <%= action.icon %> w-5 text-center text-primary-theme" aria-hidden="true"></i><%= t(action.label) %>
                        </button>
                    <% }) %>
                </div>
            </div>
        </div>
        <script>
            function toggleWishlistMenu(open) {
                document.getElementById('wishlistMenu').classList.toggle('hidden', !open);
                document.body.classList.toggle('overflow-hidden', open);
            }
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') toggleWishlistMenu(false);
            });
        </script>
        <% } %>

        <%# The invitation below is for a wishlist that holds nothing at all. A filter
            that matches nothing keeps the normal page instead, or the controls needed
            to widen it back would go with the grid. %>
        <% if (albums.length===0 && !locals.hasActiveFilters) { %>
            <div
                class="text-center py-16 md:py-20 card-theme rounded-xl border-dashed opacity-80 transition-colors shadow-sm">
                <i class="fa-regular fa-heart text-5xl md:text-6xl opacity-20 mb-4 transition-colors"></i>
                <p class="opacity-60 px-4">
                    <%= t('wishlist.empty_msg') %>
                </p>
                <% if (canAdd) { %>
                    <button type="button" onclick="openAddModal()"
                        class="text-primary-theme hover:underline mt-2 inline-block font-medium transition-colors">
                        <%= t('wishlist.search_link') %>
                    </button>
                    <% } %>
                    <% if (canScan) { %>
                    <span class="opacity-30 mx-2">|</span>
                    <a href="<%= scanHref || '#' %>" <%- scanHref ? '' : 'onclick="openScanPicker(); return false;"' %>
                        class="text-primary-theme hover:underline mt-2 inline-block font-medium transition-colors">
                        <%= t('wishlist.scan_link') %>
                    </a>
                    <% } %>
            </div>
            <% } else { %>
                <%- include('partials/albums-filters') %>
                <div id="shelfResults" class="transition-opacity duration-150">
                    <%- include('partials/shelf-results', { albums, isWishlist: true }) %>
                </div>
                <% } %>
    </div>

    <%- include('partials/wishlist-move-script') %>

    <%- include('partials/shelf-scroll-restore') %>

    <script src="<%= baseUrl %>/socket.io/socket.io.js"></script>
    <script>
    <% if (locals.canEditCollection) { %>
        const jsBaseUrl = '<%= baseUrl %>';
        const socket = io({ path: jsBaseUrl + '/socket.io' });

        // Behavior 'importer-sync': trigger an importer (e.g. Discogs wantlist sync) via socket.
        // The importer resolves the stored username server-side; no URL needed from the client.
        function runImporterSync(importerId, actionId) {
            const btn = document.querySelector(`[data-action-id="${actionId}"]`);
            const icon = btn ? btn.querySelector('i') : null;
            if (icon) icon.classList.add('fa-spin');
            if (btn) btn.disabled = true;

            socket.once('import_finished', () => window.location.reload());
            socket.once('import_error', (data) => {
                alert("import error: " + data.message);
                if (icon) icon.classList.remove('fa-spin');
                if (btn) btn.disabled = false;
            });

            const isWishlist = window.location.pathname.includes('wishlist');
            fetch(`${jsBaseUrl}/import/${importerId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ full: false, type: isWishlist ? 'wishlist' : 'collection' })
            }).then(res => {
                if (!res.ok) {
                    socket.off('import_finished');
                    socket.off('import_error');
                    if (icon) icon.classList.remove('fa-spin');
                    if (btn) btn.disabled = false;
                }
            }).catch(() => {
                if (icon) icon.classList.remove('fa-spin');
                if (btn) btn.disabled = false;
            });
        }
    <% } %>
    </script>


    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(100, 100, 100, 0.2);
            border-radius: 2px;
        }

        .dark .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
        }
    </style>

    <%- include('partials/footer') %>
