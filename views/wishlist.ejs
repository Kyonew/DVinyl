<%- include('partials/header') %>

    <%
        // Importer-sync actions (e.g. Discogs wantlist sync) declared by any plugin, rendered generically.
        const wishlistActions = locals.canEditCollection
            ? registry.getAll().flatMap(p => {
                const bucket = (user.pluginData && user.pluginData[p.id]) || {};
                return (p.collectionActions || [])
                    .filter(a => a.behavior === 'importer-sync' && (!a.requiresUserData || bucket[a.requiresUserData]));
              })
            : [];
    %>

    <div class="max-w-screen-xl mx-auto px-1 md:px-0 pb-12">

        <div class="flex items-center justify-between mb-6 md:mb-8 pt-6">

            <h1 class="text-3xl font-bold flex flex-col md:flex-row md:items-center gap-2 md:gap-3 transition-colors truncate mr-4">
                <span class="flex items-center gap-2 md:gap-3 text-primary-theme">
                    <i class="fa-solid fa-gift flex-shrink-0"></i>
                    <span class="truncate">
                        <%= t('wishlist.title') %>
                    </span>
                </span>
                <span
                    class="px-3 md:mt-1.5 py-1 bg-black/5 dark:bg-white/10 rounded-full text-sm font-medium opacity-70 w-fit">
                    <%= albums.length %>
                        <%= t('common.items') %>
                </span>
            </h1>

            <% wishlistActions.forEach(action => { %>
                <button type="button" data-action-id="<%= action.id %>"
                    onclick="runImporterSync('<%= action.importerId %>', '<%= action.id %>')"
                    class="flex-shrink-0 w-10 h-10 md:w-auto md:h-auto md:p-2.5 card-theme hover:text-primary-theme hover:border-primary-theme rounded-lg transition-all shadow-sm flex items-center justify-center active:scale-95 group"
                    title="<%= t(action.tooltip || action.label) %>">
                    <i class="fa-solid <%= action.icon %> group-hover:rotate-180 transition-transform duration-500"></i>
                </button>
                <% }) %>

        </div>

        <% if (albums.length===0) { %>
            <div
                class="text-center py-16 md:py-20 card-theme rounded-xl border-dashed opacity-80 transition-colors shadow-sm">
                <i class="fa-regular fa-heart text-5xl md:text-6xl opacity-20 mb-4 transition-colors"></i>
                <p class="opacity-60 px-4">
                    <%= t('wishlist.empty_msg') %>
                </p>
                <a href="<%= baseUrl %>/add-music"
                    class="text-primary-theme hover:underline mt-2 inline-block font-medium transition-colors">
                    <%= t('wishlist.search_link') %>
                </a>
            </div>
            <% } else { %>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-6">
                    <% albums.forEach(album=> { %>
                        <%
                            const itemPlugin = registry.getByKind(album.kind);
                            const routePrefix = itemPlugin ? itemPlugin.routePrefix : '/album';
                            const detailUrl = routePrefix + '/' + album._id;
                            const isPoster = itemPlugin ? itemPlugin.aspectRatioClass !== 'aspect-square' : true;
                            const badge = (itemPlugin && itemPlugin.cardBadge)
                                ? itemPlugin.cardBadge(album, settings)
                                : (function(){ var fmt=(album.format||album.media_type||'').toLowerCase(); var opt=itemPlugin?(itemPlugin.formats||[]).find(function(f){return f.value===fmt}):null; return { label: opt?opt.label:fmt, colorClass: (opt&&opt.color)||'bg-gray-600/90' }; })();
                        %>

                            <div
                                class="group relative card-theme rounded-xl hover:border-primary-theme transition-all duration-300 hover:shadow-lg hover:-translate-y-1 flex flex-col justify-between overflow-hidden">
                                <a href="<%= baseUrl + detailUrl %>" class="block flex-grow">
                                    <div
                                        class="aspect-square w-full relative overflow-hidden bg-black/5 dark:bg-white/5 flex items-center justify-center">

                                        <% if (isPoster) { %>
                                            <img src="<%= album.cover_image %>"
                                                class="absolute inset-0 w-full h-full object-cover blur-xl opacity-30 scale-110 pointer-events-none">
                                            <% } %>

                                                <img src="<%= album.cover_image %>"
                                                    class="relative z-10 w-full h-full <%= isPoster ? 'object-contain p-2 md:p-3' : 'object-cover' %> transition-transform duration-500 group-hover:scale-105"
                                                    loading="lazy">

                                                <% if (badge.label) { %>
                                                <span
                                                    class="absolute top-1.5 right-1.5 md:top-2 md:right-2 z-20 text-[10px] font-bold px-1.5 py-0.5 md:px-2 md:py-1 rounded backdrop-blur-md border border-white/10 shadow-sm <%= badge.colorClass %> text-white">
                                                    <%= t(badge.label, { defaultValue: badge.label }) %>
                                                </span>
                                                <% } %>
                                    </div>

                                    <%- include('partials/item-card-body', { item: album, plugin: itemPlugin, size: 'wishlist' }) %>
                                </a>

                                <% if (locals.canEditCollection) { %>
                                    <button onclick="moveToCollection('<%= album._id %>', '<%= routePrefix %>')"
                                        class="w-full py-2.5 md:py-2 bg-black/5 dark:bg-white/5 hover:bg-primary-theme hover:text-white text-primary-theme text-[10px] md:text-xs font-bold uppercase transition-colors flex items-center justify-center gap-1.5 border-t border-black/10 dark:border-white/10 active:brightness-90">
                                        <i class="fa-solid fa-check"></i>
                                        <span>
                                            <%= t('wishlist.btn_received') %>
                                        </span>
                                    </button>
                                    <% } %>
                            </div>
                            <% }) %>
                </div>
                <% } %>
    </div>

    <script src="<%= baseUrl %>/socket.io/socket.io.js"></script>
    <script>
        const wishlistTranslations = {
            confirmMove: <%- JSON.stringify(t('wishlist.confirm_move')) %>,
            serverError: <%- JSON.stringify(t('messages.generic_error')) %>
        };

        async function moveToCollection(id, routePrefix) {
            if (confirm(wishlistTranslations.confirmMove)) {
                try {
                    const res = await fetch(`<%= baseUrl %>/api${routePrefix || '/album'}/${id}/move-to-collection`, { method: 'POST' });
                    const data = await res.json();
                    if (data.success) {
                        window.location.reload();
                    }
                } catch (e) {
                    alert(wishlistTranslations.serverError);
                }
            }
        }

    <% if (locals.canEditCollection) { %>
        const jsBaseUrl = '<%= baseUrl %>';
        const socket = io({ path: jsBaseUrl + '/socket.io' });

        // Behavior 'importer-sync': trigger an importer (e.g. Discogs wantlist sync) via socket.
        // The importer resolves the stored username server-side; no URL needed from the client.
        function runImporterSync(importerId, actionId) {
            const btn = document.querySelector(`[data-action-id="${actionId}"]`);
            const icon = btn ? btn.querySelector('i') : null;
            if (icon) icon.classList.add('fa-spin');
            if (btn) btn.disabled = true;

            socket.once('import_finished', () => window.location.reload());
            socket.once('import_error', (data) => {
                alert("import error: " + data.message);
                if (icon) icon.classList.remove('fa-spin');
                if (btn) btn.disabled = false;
            });

            const isWishlist = window.location.pathname.includes('wishlist');
            fetch(`${jsBaseUrl}/import/${importerId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ full: false, type: isWishlist ? 'wishlist' : 'collection' })
            }).then(res => {
                if (!res.ok) {
                    socket.off('import_finished');
                    socket.off('import_error');
                    if (icon) icon.classList.remove('fa-spin');
                    if (btn) btn.disabled = false;
                }
            }).catch(() => {
                if (icon) icon.classList.remove('fa-spin');
                if (btn) btn.disabled = false;
            });
        }
    <% } %>
    </script>

    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(100, 100, 100, 0.2);
            border-radius: 2px;
        }

        .dark .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
        }
    </style>

    <%- include('partials/footer') %>
