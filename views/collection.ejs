<%- include('partials/header') %>

    <%
        // Collection-level action buttons are declared by the active plugin (collectionActions).
        // Filter by admin rights and per-user data requirements (e.g. a stored Discogs username).
        const _collectionPlugin = registry.getAll().find(p => p.collectionType === currentType);
        const _userBucket = (_collectionPlugin && user && user.pluginData && user.pluginData[_collectionPlugin.id]) || {};
        const collectionActions = (locals.canEditCollection && _collectionPlugin)
            ? (_collectionPlugin.collectionActions || []).filter(a => !a.requiresUserData || _userBucket[a.requiresUserData])
            : [];
        const hasEstimateAction = collectionActions.some(a => a.behavior === 'estimate');
    %>

    <div class="max-w-screen-xl mx-auto px-1 md:px-0 pb-12">

        <% if (locals.isShareView) { %>
            <div class="mt-6 flex items-center gap-3 bg-primary-theme/10 border border-primary-theme/30 rounded-2xl px-4 py-3">
                <i class="fa-solid fa-eye text-primary-theme"></i>
                <p class="text-xs font-bold text-primary-theme"><%= t('collection.share_view_banner') %></p>
            </div>
        <% } %>

        <div class="pt-6 mb-6 flex items-center justify-between">
            <h1 class="text-3xl font-bold transition-colors flex flex-col md:flex-row md:items-center gap-2 md:gap-3">
                <span>
                    <%= t('collection.title') %>
                </span>
                <span
                    class="px-3 md:mt-1.5 py-1 bg-black/5 dark:bg-white/10 rounded-full text-sm font-medium opacity-70 w-fit">
                    <%= totalItems %>
                        <%= t('common.items') %>
                </span>
            </h1>
            <% if (locals.canEditCollection) { %>
                <%
                    // Add button target: external-search page if the plugin has one, else manual entry
                    const currentPlugin = registry.getAll().find(p => p.collectionType === currentType);
                    let addRoute = null;
                    if (currentPlugin) {
                        addRoute = currentPlugin.searchProvider ? ('/add-' + currentPlugin.id) : ('/manual-add?type=' + currentPlugin.id);
                    }
                %>
                    <div class="flex gap-2">

                        <% if (addRoute) { %>
                            <a href="<%= baseUrl + addRoute %>"
                                class="flex-shrink-0 w-10 h-10 md:w-auto md:px-4 card-theme hover:text-primary-theme hover:border-primary-theme rounded-lg transition-all shadow-sm flex items-center justify-center gap-2 group"
                                title="<%= t('collection.add') %>">
                                <i class="fa-solid fa-plus group-hover:scale-110 transition-transform"></i>
                                <span class="hidden md:inline text-xs font-bold uppercase tracking-widest">
                                    <%= t('collection.add') %>
                                </span>
                            </a>
                            <% } %>

                                <% collectionActions.forEach(action => { %>
                                    <button type="button" data-action-id="<%= action.id %>"
                                        onclick="runCollectionAction('<%= action.id %>')"
                                        class="flex-shrink-0 w-10 h-10 md:w-auto md:px-4 card-theme hover:text-primary-theme hover:border-primary-theme rounded-lg transition-all shadow-sm flex items-center justify-center gap-2 group"
                                        title="<%= t(action.tooltip || action.label) %>">
                                        <i class="fa-solid <%= action.icon %> group-hover:scale-110 transition-transform"></i>
                                        <span class="hidden md:inline text-xs font-bold uppercase tracking-widest">
                                            <%= t(action.label) %>
                                        </span>
                                    </button>
                                <% }) %>

                    </div>
                    <% } %>

        </div>

        <%- include('partials/albums-filters') %>
        <%- include('partials/albums-grid', { albums, size: 'collection', gridId: 'albumGrid' }) %>
        <%- include('partials/albums-page-changer') %>
    </div>

    <% if (hasEstimateAction) { %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"
        integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC"
        crossorigin="anonymous"></script>
    <% } %>

    <% if (hasEstimateAction) { %>
    <div id="estimateModal"
        class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="card-theme rounded-2xl w-full max-w-lg p-6 md:p-8 shadow-2xl relative">
            <button onclick="closeEstimateModal()" class="absolute top-4 right-4 opacity-50 hover:opacity-100">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>

            <h3 class="text-2xl font-bold mb-2">
                <%= t('modal.estimate_title') %>
            </h3>
            <p class="opacity-60 text-sm mb-6">
                <%= t('modal.estimate_desc') %>
            </p>

            <div id="progressContainer" class="mb-6">
                <div class="w-full bg-gray-200 dark:bg-black/30 rounded-full h-4 mb-2 overflow-hidden">
                    <div id="estimateProgress" class="bg-primary-theme h-4 rounded-full transition-all duration-300"
                        style="width: 0%"></div>
                </div>
                <div class="flex justify-between text-xs opacity-60 font-mono">
                    <span id="estimateCount">0 / --</span>
                    <span id="estimatePercent">0%</span>
                </div>
            </div>

            <div id="estimateResult" class="hidden text-center space-y-4">
                <div class="p-6 bg-primary-theme/10 border border-primary-theme/30 rounded-xl">
                    <p class="text-primary-theme text-sm font-bold uppercase tracking-wider mb-1">
                        <%= t('modal.avg_label') %>
                    </p>
                    <h4 id="finalPrice" class="text-4xl md:text-5xl font-black">--</h4>
                    <p class="text-xs opacity-60 mt-2">
                        <%= t('modal.condition_hint') %>
                    </p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-gray-100 dark:bg-black/20 p-3 rounded-lg">
                        <span class="opacity-60 block text-[10px] uppercase font-bold">
                            <%= t('modal.min_label') %>
                        </span>
                        <span id="minPrice" class="font-bold text-lg">--</span>
                    </div>
                    <div class="bg-gray-100 dark:bg-black/20 p-3 rounded-lg">
                        <span class="opacity-60 block text-[10px] uppercase font-bold">
                            <%= t('modal.max_label') %>
                        </span>
                        <span id="maxPrice" class="font-bold text-lg">--</span>
                    </div>
                </div>
                <div class="mt-2">
                    <p class="opacity-60 text-xs uppercase font-bold tracking-wider mb-2 text-left">
                        <%= t('modal.history_title') %>
                    </p>
                    <canvas id="historyChart" height="120"></canvas>
                    <p id="historyEmpty" class="hidden text-xs opacity-50 text-center py-4">
                        <%= t('modal.history_empty') %>
                    </p>
                </div>
            </div>

            <div id="startEstimateBtn" class="mt-6 text-center">
                <button onclick="startEstimation()"
                    class="bg-primary-theme hover:brightness-110 text-white font-bold py-3 px-8 rounded-xl transition-colors">
                    <%= t('modal.start_btn') %>
                </button>
            </div>
        </div>
    </div>
    <% } %>

    <script src="<%= baseUrl %>/socket.io/socket.io.js"></script>
    <script>
    <% if (locals.canEditCollection) { %>
        // Collection-level actions declared by the active plugin (see CollectionAction).
        const COLLECTION_ACTIONS = <%- JSON.stringify(collectionActions) %>;
        const jsBaseUrl = '<%= baseUrl %>';
        const socket = io({ path: jsBaseUrl + '/socket.io' });

        function runCollectionAction(id) {
            const action = COLLECTION_ACTIONS.find(a => a.id === id);
            if (!action) return;
            if (action.behavior === 'estimate') return openEstimateModal(action);
            if (action.behavior === 'importer-sync') return runImporterSync(action, id);
        }

        // Behavior 'importer-sync': trigger an importer (e.g. Discogs sync) via socket, reload when done.
        function runImporterSync(action, id) {
            const btn = document.querySelector(`[data-action-id="${id}"]`);
            const icon = btn ? btn.querySelector('i') : null;
            if (icon) icon.classList.add('fa-spin');
            if (btn) btn.disabled = true;

            socket.once('import_finished', () => window.location.reload());
            socket.once('import_error', (data) => {
                alert("Erreur : " + data.message);
                if (icon) icon.classList.remove('fa-spin');
                if (btn) btn.disabled = false;
            });

            const isWishlist = window.location.pathname.includes('wishlist');
            fetch(`${jsBaseUrl}/import/${action.importerId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ full: false, type: isWishlist ? 'wishlist' : 'collection' })
            }).catch(() => {
                if (icon) icon.classList.remove('fa-spin');
                if (btn) btn.disabled = false;
            });
        }
    <% } %>

    <% if (hasEstimateAction) { %>
    const modal = document.getElementById('estimateModal');
        const startBtn = document.getElementById('startEstimateBtn');
        const resultDiv = document.getElementById('estimateResult');
        const progressBar = document.getElementById('estimateProgress');
        const countSpan = document.getElementById('estimateCount');
        const percentSpan = document.getElementById('estimatePercent');
        const estimateErrorMsg = <%- JSON.stringify(t('messages.estimate_error')) %>;
        const historyEmptyMsg = <%- JSON.stringify(t('modal.history_empty')) %>;
        const historyOtherCurrencyMsg = <%- JSON.stringify(t('modal.history_other_currency')) %>;
        const currentLocale = '<%= currentLng === "fr" ? "fr-FR" : "en-US" %>';
        const currentCurrency = '<%= user.currency || "USD" %>';

        let activeEstimate = null;
        let totalAlbums = 0;
        let currentProcessed = 0;
        let totalPriceVG = 0;
        let totalPriceMin = 0;
        let totalPriceMax = 0;
        // Albums that actually returned a usable price (as opposed to merely attempted):
        // used to decide whether the resulting total is representative enough to persist
        // as a history snapshot. See showResults().
        let pricedCount = 0;

        function openEstimateModal(action) {
            if (action && action.estimate) activeEstimate = action.estimate;
            modal.classList.remove('hidden');
        }

        function closeEstimateModal() {
            modal.classList.add('hidden');
        }

        async function startEstimation() {
            if (!activeEstimate) return;
            startBtn.classList.add('hidden');
            try {
                const res = await fetch('<%= baseUrl %>' + activeEstimate.idsEndpoint);
                const data = await res.json();

                if (!data.success) throw new Error("Server Error");

                const albumsToEstimate = data.albums;
                totalAlbums = albumsToEstimate.length;
                currentProcessed = 0;
                totalPriceVG = 0;
                totalPriceMin = 0;
                totalPriceMax = 0;
                pricedCount = 0;

                countSpan.innerText = `0 / ${totalAlbums}`;

                for (const album of albumsToEstimate) {
                    await estimateOneAlbum(album[activeEstimate.idField], album.quantity || 1);
                    currentProcessed++;

                    const percent = totalAlbums ? Math.round((currentProcessed / totalAlbums) * 100) : 100;
                    if (progressBar) progressBar.style.width = percent + '%';
                    if (percentSpan) percentSpan.innerText = percent + '%';

                    if (countSpan) countSpan.innerText = `${currentProcessed} / ${totalAlbums}`;

                    await new Promise(r => setTimeout(r, 500));
                }
                await showResults();
            } catch (err) {
                alert(`${estimateErrorMsg} : ${err.message}`);
                startBtn.classList.remove('hidden');
            }
        }

        async function estimateOneAlbum(id, quantity) {
            try {
                const res = await fetch(`<%= baseUrl %>${activeEstimate.estimateEndpoint}/${id}`);
                const data = await res.json();
                if (data.success && data.price) {
                    const val = data.price.value * quantity;
                    totalPriceVG += val;
                    totalPriceMin += val;
                    totalPriceMax += (val * (activeEstimate.maxMultiplier || 1.3));
                    pricedCount++;
                }
            } catch (e) { }
        }

        async function showResults() {
            const fmt = (val) => {
                try {
                    return new Intl.NumberFormat(currentLocale, {
                        style: 'currency',
                        currency: currentCurrency
                    }).format(val);
                } catch (e) {
                    return val.toFixed(2) + ' ' + currentCurrency;
                }
            };

            document.getElementById('finalPrice').innerText = fmt(totalPriceVG);
            document.getElementById('minPrice').innerText = fmt(totalPriceMin);
            document.getElementById('maxPrice').innerText = fmt(totalPriceMax);

            document.getElementById('progressContainer').classList.add('hidden');
            resultDiv.classList.remove('hidden');

            // A run where most albums failed to price (Discogs rate-limiting, a missing/expired
            // token, or a zero-item collection) produces a total that isn't representative of the
            // collection's real value. Persisting that as a permanent history point would read as
            // "the collection dropped in value" when really the estimate just mostly failed. Only
            // write a snapshot when at least half the attempted albums actually returned a price.
            // The on-screen result above still reflects whatever was priced, unconditionally.
            const shouldPersistSnapshot = pricedCount > 0 && pricedCount >= totalAlbums / 2;

            if (shouldPersistSnapshot) {
                try {
                    await fetch('<%= baseUrl %>/api/estimate/snapshot', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            value: totalPriceVG,
                            minValue: totalPriceMin,
                            maxValue: totalPriceMax,
                            itemCount: totalAlbums
                        })
                    });
                } catch (e) { /* history is a bonus, don't block the result on it */ }
            }

            const canvas = document.getElementById('historyChart');
            const emptyMsg = document.getElementById('historyEmpty');
            try {
                const histRes = await fetch('<%= baseUrl %>/api/estimate/history');
                const histData = await histRes.json();
                if (histData.success) {
                    // Already scoped to this reader's currency server-side, along with the list of
                    // the ones it left out (see getEstimateHistory): values are never converted, so
                    // a collection whose members differ on the setting keeps a series each.
                    renderHistoryChart(histData.snapshots || [], histData.otherCurrencies || []);
                } else {
                    canvas.classList.add('hidden');
                    emptyMsg.classList.remove('hidden');
                }
            } catch (e) {
                // The fetch itself failed (network error, etc.): show the same empty state as a
                // genuinely empty history rather than leaving a blank canvas under the heading.
                canvas.classList.add('hidden');
                emptyMsg.classList.remove('hidden');
            }
        }

        let historyChartInstance = null;

        function renderHistoryChart(snapshots, otherCurrencies) {
            const canvas = document.getElementById('historyChart');
            const emptyMsg = document.getElementById('historyEmpty');

            if (!snapshots || snapshots.length < 2) {
                canvas.classList.add('hidden');
                // "Run it twice" is the wrong thing to say to someone who already has a history
                // and only changed the currency it was recorded in.
                emptyMsg.textContent = (otherCurrencies && otherCurrencies.length > 0)
                    ? historyOtherCurrencyMsg.replace('{{currencies}}', otherCurrencies.join(', '))
                    : historyEmptyMsg;
                emptyMsg.classList.remove('hidden');
                return;
            }

            canvas.classList.remove('hidden');
            emptyMsg.classList.add('hidden');

            const labels = snapshots.map(s => new Date(s.capturedAt).toLocaleDateString(currentLocale));
            const values = snapshots.map(s => s.value);
            const mins = snapshots.map(s => s.minValue);
            const maxs = snapshots.map(s => s.maxValue);
            // Caller already filtered to a single currency, so any snapshot's currency stands
            // in for the whole series; fall back to the viewer's own currency if it's somehow absent.
            const seriesCurrency = (snapshots[0] && snapshots[0].currency) || currentCurrency;
            const fmtCurrency = (val) => {
                try {
                    return new Intl.NumberFormat(currentLocale, { style: 'currency', currency: seriesCurrency }).format(val);
                } catch (e) {
                    return val.toFixed(2) + ' ' + seriesCurrency;
                }
            };

            // Canvas 2D has no CSS cascade: Chart.js hands these strings straight to
            // ctx.strokeStyle/ctx.fillStyle, which silently ignores unresolved var(...) calls.
            // Resolve the custom property to its actual value here instead. --highlight-rgb is
            // stored as space-separated channels (e.g. "16 185 129", Tailwind-v3-style for use
            // inside rgb(... / <alpha-value>)), so it plugs directly into rgb()'s space/slash syntax.
            const highlightRgb = getComputedStyle(document.documentElement)
                .getPropertyValue('--highlight-rgb').trim() || '16 185 129';
            const accentColor = `rgb(${highlightRgb})`;
            const bandColor = `rgb(${highlightRgb} / 0.12)`;
            const tickColor = getComputedStyle(document.documentElement)
                .getPropertyValue('--text-sub').trim() || '#888888';
            // Gridlines are scaffolding, not text: painting them in the subtext colour puts a
            // full-strength grid over the panel in both themes. --border-color is the token the
            // rest of the UI already uses for that weight, and it flips with the theme.
            const gridColor = getComputedStyle(document.documentElement)
                .getPropertyValue('--border-color').trim() || 'rgba(128, 128, 128, 0.15)';

            if (historyChartInstance) historyChartInstance.destroy();

            historyChartInstance = new Chart(canvas, {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        {
                            label: 'Max',
                            data: maxs,
                            borderWidth: 0,
                            pointRadius: 0,
                            backgroundColor: bandColor,
                            fill: '+1'
                        },
                        {
                            label: 'Min',
                            data: mins,
                            borderWidth: 0,
                            pointRadius: 0,
                            backgroundColor: bandColor,
                            fill: false
                        },
                        {
                            label: 'Value',
                            data: values,
                            borderColor: accentColor,
                            backgroundColor: accentColor,
                            borderWidth: 2,
                            pointRadius: 3,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                // The axis only has room for the day, which repeats as soon as a
                                // collection is estimated twice in one: the hover says which run.
                                title: (items) => {
                                    const snapshot = snapshots[items[0].dataIndex];
                                    return snapshot
                                        ? new Date(snapshot.capturedAt).toLocaleString(currentLocale)
                                        : items[0].label;
                                },
                                label: (ctx) => `${ctx.dataset.label}: ${fmtCurrency(ctx.parsed.y)}`
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: tickColor },
                            grid: { color: gridColor }
                        },
                        y: {
                            beginAtZero: false,
                            ticks: {
                                color: tickColor,
                                callback: (val) => fmtCurrency(val)
                            },
                            grid: { color: gridColor }
                        }
                    }
                }
            });
        }
    <% } %>
    </script>

    <style>
        .no-spinner::-webkit-outer-spin-button,
        .no-spinner::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .no-spinner {
            -moz-appearance: textfield;
        }
    </style>

    <%- include('partials/footer') %>
</body>
</html>